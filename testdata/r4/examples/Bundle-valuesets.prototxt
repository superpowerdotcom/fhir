        }
      }
      concept {
        code {
          value: "busy-tentative"
        }
        display {
          value: "Busy (Tentative)"
        }
        definition {
          value: "Indicates that the time interval is busy because one or more events have been tentatively scheduled for that interval."
        }
      }
      concept {
        code {
