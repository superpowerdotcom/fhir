        }
        value {
          integer {
            value: 2
          }
        }
      }
      url {
        value: "http://hl7.org/fhir/specimen-status"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.4.472"
        }
      }
      version {
        value: "4.0.1"
      }
      name {
        value: "SpecimenStatus"
      }
      title {
        value: "SpecimenStatus"
      }
      status {
        value: DRAFT
      }
      experimental {
