          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>SlicingRules</h2><div><p>How slices are interpreted when evaluating an instance.</p>\n</div><p>This code system http://hl7.org/fhir/resource-slicing-rules defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">closed<a name=\"resource-slicing-rules-closed\"> </a></td><td>Closed</td><td>No additional content is allowed other than that described by the slices in this profile.</td></tr><tr><td style=\"white-space:nowrap\">open<a name=\"resource-slicing-rules-open\"> </a></td><td>Open</td><td>Additional content is allowed anywhere in the list.</td></tr><tr><td style=\"white-space:nowrap\">openAtEnd<a name=\"resource-slicing-rules-openAtEnd\"> </a></td><td>Open at End</td><td>Additional content is allowed, but only at the end of the list. Note that using this requires that the slices be ordered, which makes it hard to share uses. This should only be done where absolutely required.</td></tr></table></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
