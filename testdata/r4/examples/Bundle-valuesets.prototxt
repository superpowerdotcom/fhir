          value: "111352"
        }
        display {
          value: "Homogeneous fibroglandular echotexture"
        }
        definition {
          value: "A uniformly echogenic layer of fibroglandular tissue is seen beneath a thin layer of subcutaneous fat"
        }
      }
      concept {
        code {
          value: "111353"
        }
        display {
          value: "Heterogeneous echotexture"
        }
        definition {
          value: "The breast texture is characterized by multiple small areas of increased and decreased echogenicity"
