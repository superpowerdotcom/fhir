        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>MatchGrade</h2><div><p>A Master Patient Index (MPI) assessment of whether a candidate patient record is a match or not.</p>\n</div><p>This code system http://terminology.hl7.org/CodeSystem/match-grade defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">certain<a name=\"match-grade-certain\"> </a></td><td>Certain Match</td><td>This record meets the matching criteria to be automatically considered as a full match.</td></tr><tr><td style=\"white-space:nowrap\">probable<a name=\"match-grade-probable\"> </a></td><td>Probable Match</td><td>This record is a close match, but not a certain match. Additional review (e.g. by a human) may be required before using this as a match.</td></tr><tr><td style=\"white-space:nowrap\">possible<a name=\"match-grade-possible\"> </a></td><td>Possible Match</td><td>This record may be a matching one. Additional review (e.g. by a human) SHOULD be performed before using this as a match.</td></tr><tr><td style=\"white-space:nowrap\">certainly-not<a name=\"match-grade-certainly-not\"> </a></td><td>Certainly Not a Match</td><td>This record is known not to be a match. Note that usually non-matching records are not returned, but in some cases records previously or likely considered as a match may specifically be negated by the matching engine.</td></tr></table></div>"
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/match-grade"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.4.1289"
        }
      }
      version {
        value: "4.0.1"
      }
