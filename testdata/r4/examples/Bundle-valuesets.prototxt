entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/participantrequired"
  }
  resource {
    code_system {
      id {
        value: "participantrequired"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>ParticipantRequired</h2><div><p>Is the Participant required to attend the appointment.</p>\n</div><p>This code system http://hl7.org/fhir/participantrequired defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">required<a name=\"participantrequired-required\"> </a></td><td>Required</td><td>The participant is required to attend the appointment.</td></tr><tr><td style=\"white-space:nowrap\">optional<a name=\"participantrequired-optional\"> </a></td><td>Optional</td><td>The participant may optionally attend the appointment.</td></tr><tr><td style=\"white-space:nowrap\">information-only<a name=\"participantrequired-information-only\"> </a></td><td>Information Only</td><td>The participant is excluded from the appointment, and might not be informed of the appointment taking place. (Appointment is about them, not for them - such as 2 doctors discussing results about a patient\'s test).</td></tr></table></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
