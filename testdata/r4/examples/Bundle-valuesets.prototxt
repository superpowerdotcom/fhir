entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/immunization-evaluation-dose-status-reason"
  }
  resource {
    code_system {
      id {
        value: "immunization-evaluation-dose-status-reason"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>Immunization Evaluation Dose Status Reason codes</h2><div><p>The value set to instantiate this attribute should be drawn from a terminologically robust code system that consists of or contains concepts to support describing the reason why an administered dose has been assigned a particular status. Often, this reason describes why a dose is considered invalid. This value set is provided as a suggestive example.</p>\n</div><p>This code system http://terminology.hl7.org/CodeSystem/immunization-evaluation-dose-status-reason defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">advstorage<a name=\"immunization-evaluation-dose-status-reason-advstorage\"> </a></td><td>Adverse storage condition</td><td>The product was stored in a manner inconsistent with manufacturer guidelines potentially reducing the effectiveness of the product.</td></tr><tr><td style=\"white-space:nowrap\">coldchbrk<a name=\"immunization-evaluation-dose-status-reason-coldchbrk\"> </a></td><td>Cold chain break</td><td>The product was stored at a temperature inconsistent with manufacturer guidelines potentially reducing the effectiveness of the product.</td></tr><tr><td style=\"white-space:nowrap\">explot<a name=\"immunization-evaluation-dose-status-reason-explot\"> </a></td><td>Expired lot</td><td>The product was administered after the expiration date associated with lot of vaccine.</td></tr><tr><td style=\"white-space:nowrap\">outsidesched<a name=\"immunization-evaluation-dose-status-reason-outsidesched\"> </a></td><td>Administered outside recommended schedule</td><td>The product was administered at a time inconsistent with the documented schedule.</td></tr><tr><td style=\"white-space:nowrap\">prodrecall<a name=\"immunization-evaluation-dose-status-reason-prodrecall\"> </a></td><td>Product recall</td><td>The product administered has been recalled by the manufacturer.</td></tr></table></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "pher"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "draft"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 1
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/immunization-evaluation-dose-status-reason"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.4.1103"
        }
      }
      version {
        value: "4.0.1"
      }
      name {
        value: "ImmunizationEvaluationDoseStatusReasonCodes"
      }
      title {
        value: "Immunization Evaluation Dose Status Reason codes"
      }
      status {
        value: DRAFT
      }
      experimental {
      }
      publisher {
        value: "FHIR Project team"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org/fhir"
          }
        }
      }
      description {
        value: "The value set to instantiate this attribute should be drawn from a terminologically robust code system that consists of or contains concepts to support describing the reason why an administered dose has been assigned a particular status. Often, this reason describes why a dose is considered invalid. This value set is provided as a suggestive example."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://hl7.org/fhir/ValueSet/immunization-evaluation-dose-status-reason"
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "advstorage"
        }
        display {
          value: "Adverse storage condition"
        }
        definition {
          value: "The product was stored in a manner inconsistent with manufacturer guidelines potentially reducing the effectiveness of the product."
        }
      }
      concept {
        code {
          value: "coldchbrk"
        }
        display {
          value: "Cold chain break"
        }
        definition {
          value: "The product was stored at a temperature inconsistent with manufacturer guidelines potentially reducing the effectiveness of the product."
        }
      }
      concept {
        code {
          value: "explot"
        }
        display {
          value: "Expired lot"
        }
        definition {
          value: "The product was administered after the expiration date associated with lot of vaccine."
        }
      }
      concept {
        code {
          value: "outsidesched"
        }
        display {
          value: "Administered outside recommended schedule"
        }
        definition {
          value: "The product was administered at a time inconsistent with the documented schedule."
        }
      }
      concept {
        code {
          value: "prodrecall"
        }
        display {
          value: "Product recall"
        }
        definition {
          value: "The product administered has been recalled by the manufacturer."
        }
      }
    }
  }
}
entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/immunization-evaluation-dose-status"
  }
  resource {
