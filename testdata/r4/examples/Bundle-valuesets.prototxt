        }
        definition {
          value: "Method for calculating left ventricular volume from two orthogonal views containing the true long axis (usually the apical 4 and 2 chamber views). Volume = [pL1 / 6] * [(4A1) \303\267 (pL1) ] * [(4A2) \303\267 (pL2) ]"
        }
      }
      concept {
        code {
          value: "125205"
        }
        display {
          value: "Area-Length Single Plane"
        }
        definition {
          value: "Method for calculating left ventricular volume from a view containing the true long axis (usually the apical 4-chamber view). Volume = [8(A)2]\303\267[3pL]"
        }
      }
      concept {
        code {
          value: "125206"
        }
        display {
          value: "Cube"
        }
        definition {
          value: "Method (formula) for calculating left ventricle volumes and function derivatives (EF, SV, SI, etc.) that estimates the volume as the cube of diameter"
        }
      }
      concept {
        code {
          value: "125207"
        }
        display {
          value: "Method of Disks, Biplane"
        }
        definition {
          value: "Method of calculating volume based on the summation of disk volumes. The disk axis is parallel to the left ventricular long axis and using a disk diameter averaged from the two chamber and four chamber views"
        }
      }
      concept {
        code {
          value: "125208"
        }
        display {
          value: "Method of Disks, Single Plane"
        }
        definition {
          value: "Method of calculating volume based on the summation of disk volumes. The disk axis is parallel to the left ventricular long axis with disk diameter taken from the four-chamber view"
        }
      }
      concept {
        code {
          value: "125209"
        }
        display {
          value: "Teichholz"
        }
        definition {
          value: "Method (formula) for calculating left ventricle volumes and function derivatives (EF, SV, SI, etc.) Volume = [7.0/(2.4+D) ]*D3"
        }
      }
      concept {
        code {
          value: "125210"
        }
        display {
          value: "Area by Pressure Half-Time"
        }
        definition {
          value: "Mitral valve area (cm2) by Pressure Half-time = 220 (cm2.ms) / PHT (ms)"
        }
      }
      concept {
        code {
          value: "125211"
        }
        display {
          value: "Biplane Ellipse"
        }
        definition {
          value: "Area = P/4 X d1 X d2 d1 = anterior/posterior axis d2 = medial/lateral axis Hagen-Ansert, Sandra L., Textbook of Diagnostic Ultrasound, ed. 3, The C.V.Mosby Co., 1989, p. 73. "
        }
      }
      concept {
        code {
          value: "125212"
        }
        display {
          value: "Continuity Equation"
        }
        definition {
          value: "For conduits in series (\"in continuity\"), volume flow is equal: A1*V1 = A2*V2. where V is the velocity"
        }
      }
      concept {
        code {
          value: "125213"
        }
        display {
          value: "Continuity Equation by Mean Velocity"
        }
        definition {
          value: "For conduits in series (\"in continuity\"), volume flow is equal: A1*V1 = A2*V2. where V is the mean velocity"
        }
      }
      concept {
        code {
          value: "125214"
        }
        display {
          value: "Continuity Equation by Peak Velocity"
        }
        definition {
          value: "For conduits in series (\"in continuity\"), volume flow is equal: A1*V1 = A2*V2. where V is the peak velocity"
        }
      }
      concept {
        code {
          value: "125215"
        }
        display {
          value: "Continuity Equation by Velocity Time Integral"
        }
        definition {
          value: "For conduits in series (\"in continuity\"), volume flow is equal: A1*V1 = A2*V2. where V is the velocity time integral"
        }
      }
      concept {
        code {
          value: "125216"
        }
        display {
          value: "Proximal Isovelocity Surface Area"
        }
        definition {
          value: "Utilizes aliasing velocity (by color Doppler) of flow into an orifice (often regurgitant or stenotic) to measure instantaneous flow rate, orifice area, and flow volume. The instantaneous flow rate = (2\317\200r2vav ) * (\316\261 / \317\200) where vav is the constant velocity known as aliasing velocity at radius r, vp is the peak velocity at the orifice, and \316\261 is the angle in radians of the constant velocity surface. Estimated Orifice area = Flow rate / vp , where vp is the peak velocity at the orifice and the flow rate is the PISA peak flow rate. The volume flow is then the product of the orifice area and Velocity Time Integral"
        }
      }
      concept {
        code {
          value: "125217"
        }
        display {
          value: "Full Bernoulli"
        }
        definition {
          value: "\316\224P = 4*(V12 - V22)"
        }
      }
      concept {
        code {
          value: "125218"
        }
        display {
          value: "Simplified Bernoulli"
        }
        definition {
          value: "\316\224P = 4*V2"
        }
      }
      concept {
        code {
          value: "125219"
        }
        display {
          value: "Doppler Volume Flow"
        }
        definition {
          value: "Volume flow = Conduit CSA * (Velocity Time Integral)"
        }
      }
      concept {
        code {
          value: "125220"
        }
        display {
          value: "Planimetry"
        }
        definition {
          value: "Direct measurement of an area by tracing an irregular perimeter"
        }
      }
      concept {
        code {
          value: "125221"
        }
        display {
          value: "Left Ventricle Mass by M-mode"
        }
        definition {
          value: "Mass = 1.04 * [(ST+LVID+PWT)3 - LVID3] * 0.8+ 0.6. Mass unit is grams and length in cm"
        }
      }
      concept {
        code {
          value: "125222"
        }
        display {
          value: "Left Ventricle Mass by Truncated Ellipse"
        }
        definition {
          value: "Mass = 1.05P ((b + t)2 X (2/3 (a + t) + d - d3 /3(a + t)2) - b2 (2/3a + d - d3 /3a2)) a = Semi-major axis from widest minor axis radius to apex. b = Short axis radius calculated from short axis cavity area t = Myocardial thickness calculated from short axis epicardial and cavity areas d = Truncated semi-major axis from widest short axis diameter to plane of mitral annulus. Mass unit is grams and length in cm. Schiller NB et al: Recommendations for quantification of the left ventricle by two-dimensional echocardiography, American Society of Echocardiography 2:364, 1989. "
        }
      }
      concept {
        code {
          value: "125223"
        }
        display {
          value: "4 Point Segment Finding Scale"
        }
        definition {
          value: "A four point, echocardiographic numeric scoring scheme of myocardium segments based on evaluation of wall motion and ventricle morphology. Recommendations for Quantitation of the Left Ventricle by Two-Dimensional Echocardiography, Journal of the American Society of Echocardiography, 2:358-367, 1989"
        }
      }
      concept {
        code {
          value: "125224"
        }
        display {
          value: "5 Point Segment Finding Scale"
        }
        definition {
          value: "A five point, echocardiographic numeric scoring scheme of myocardium segments based on evaluation of wall motion and ventricle morphology. Recommendations for Quantitation of the Left Ventricle by Two-Dimensional Echocardiography, Journal of the American Society of Echocardiography, 2:358-367, 1989"
        }
      }
      concept {
        code {
          value: "125225"
        }
        display {
          value: "5 Point Segment Finding Scale With Graded Hypokinesis"
        }
        definition {
          value: "A five point, echocardiographic numeric scoring scheme of myocardium segments based on evaluation of wall motion and ventricle morphology, with severity of hypokinesis graded. Recommendations for Quantitation of the Left Ventricle by Two-Dimensional Echocardiography, Journal of the American Society of Echocardiography, 2:358-367, 1989"
        }
      }
      concept {
        code {
          value: "125226"
        }
        display {
          value: "Single Plane Ellipse"
        }
        definition {
          value: "Method of estimating volume from a planar ellipse. Equivalent to Biplane Ellipse with an assumption that the ellipse in the orthogonal plane has identical major and minor diameters"
        }
      }
      concept {
        code {
          value: "125227"
        }
        display {
          value: "Modified Simpson"
        }
        definition {
          value: "Modified Simpson\'s Method of estimating ventricular volume, based on the method of disks with paired apical views. Schiller NB, et al. \"Recommendations for quantitation of the left ventricle by two-dimensional echocardiography. American Society of Echocardiography Committee on Standards, Subcommittee on Quantitation of Two-Dimensional Echocardiograms\". J Am Soc Echocardiogr.1989 2(5):358-367. Sep-Oct"
        }
      }
      concept {
        code {
          value: "125228"
        }
        display {
          value: "Bullet Method"
        }
        definition {
          value: "Bullet method of estimating ventricular volume. Volume = 5/6 * L * S L: Left ventricle long axis length S: Left ventricle area, SAX view at level of Mitral Valve"
        }
      }
      concept {
