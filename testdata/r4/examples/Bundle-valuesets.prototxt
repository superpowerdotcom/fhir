        }
      }
      concept {
        code {
          value: "126020"
        }
        display {
          value: "Multiparametric MRI"
        }
        definition {
          value: "An MRI procedure in which multiple parameters including diffusion, dynamic contrast and T2 are measured"
        }
      }
      concept {
        code {
          value: "126021"
        }
        display {
          value: "Multiparametric MRI of prostate"
        }
        definition {
          value: "An MRI procedure of the prostate in which multiple parameters including diffusion, dynamic contrast and T2 are measured"
        }
      }
      concept {
        code {
          value: "126022"
        }
        display {
          value: "Multiparametric MRI of whole body"
        }
        definition {
          value: "An MRI procedure of the whole body in which multiple parameters including diffusion, dynamic contrast and T2 are measured"
        }
      }
      concept {
        code {
          value: "126030"
        }
        display {
          value: "Sum of segmented voxel volumes"
        }
        definition {
          value: "The volume derived by summing the volumes of all the voxels (and partial voxels if the segment contains partially occupied voxels) included in the segment"
        }
      }
      concept {
        code {
          value: "126031"
        }
        display {
          value: "Peak Value Within ROI"
        }
        definition {
          value: "Maximum average gray value that is calculated from a 1 cubic centimeter sphere placed within the region of interest. Reference Wahl et al PERCIST article"
        }
      }
      concept {
        code {
          value: "126032"
        }
        display {
          value: "Metabolic Volume"
        }
        definition {
          value: "The volume of a lesion (e.g. a tumor) ascertained through information about its metabolic activity (e.g. SUV on PET). Abbreviated \"MV\". Synonymous with Metabolic Tumor Volume (MTV)"
        }
      }
      concept {
        code {
          value: "126033"
        }
        display {
          value: "Total Lesion Glycolysis"
        }
        definition {
          value: "The total activity of a lesion obtained as the product of its volume and its glycolytic activity (on FDG-PET). The volume may be defined on the same modality (e.g. the MV on FDG-PET by some thresholding or other technique) or on another spatially registered modality (e.g. the lesion outline segmented on CT or MR). Does not apply to other radiopharmaceuticals than those involved in glucose metabolism. Abbreviated TLG. Synonymnous with \"Tumor Lesion Glycolysis\""
        }
      }
      concept {
        code {
          value: "126034"
        }
        display {
          value: "Glycolysis"
        }
        definition {
          value: "The amount glycolytic activity summed across all voxels in a defined region or within a defined range of SUV (on FDG-PET)"
        }
      }
      concept {
        code {
          value: "126035"
        }
        display {
          value: "Total Lesion Proliferation"
        }
        definition {
          value: "The total activity of a lesion obtained as the product of its volume and its proliferative activity (on FLT-PET). The volume may be defined on the same modality (e.g. the MV on FDG-PET by some thresholding or other technique) or on another spatially registered modality (e.g. the lesion outline segmented on CT or MR). Does not apply to other radiopharmaceuticals than those involved in cellular proliferation. Abbreviated TLP. Synonymnous with \"Tumor Lesion Proliferation\""
        }
      }
      concept {
        code {
          value: "126036"
        }
        display {
          value: "Proliferative Activity"
        }
        definition {
          value: "The amount proliferative activity summed across all voxels in a defined region or within a defined range of SUV (on FLT-PET)"
        }
      }
      concept {
        code {
          value: "126037"
        }
        display {
          value: "Standardized Added Metabolic Activity (SAM)"
        }
        definition {
          value: "A background-corrected, partial volume independent version of TLG. SAM is calculated by drawing a volume of interest (VOI1) around the tumour and a larger VOI (VOI2) around VOI1. Subtracting the background activity in VOI2-VOI1 from VOI1 yields SAM. See Mertens et al. \"Standardized added metabolic activity (SAM): a partial volume independent marker of total lesion glycolysis in liver metastases\". Eur J Nucl Med Mol Imaging (2012) 39:1441-1448"
        }
      }
      concept {
        code {
          value: "126038"
        }
        display {
          value: "Standardized Added Metabolic Activity (SAM) Background"
        }
        definition {
          value: "The background value (VOI2-VOI1) used to calculate Standardized Added Metabolic Activity (SAM). SAM is calculated by drawing a volume of interest (VOI1) around the tumour and a larger VOI (VOI2) around VOI1. Subtracting the background activity in VOI2-VOI1 from VOI1 yields SAM. See Mertens et al. \"Standardized added metabolic activity (SAM): a partial volume independent marker of total lesion glycolysis in liver metastases\". Eur J Nucl Med Mol Imaging (2012) 39:1441-1448"
        }
      }
      concept {
        code {
          value: "126039"
        }
        display {
          value: "Lesion to Background SUV Ratio"
        }
        definition {
          value: "The ratio of the SUV within a tumor to the SUV of a pre-defined background region. Need reference(s). A more general concept than Tumor to Background Ratio (TBR)"
        }
      }
      concept {
        code {
          value: "126040"
        }
        display {
          value: "Background for Lesion to Background SUV Ratio"
        }
        definition {
          value: "The SUV of a pre-defined background region used to compute Lesion to Background SUV Ratio. Need reference(s)"
        }
      }
      concept {
        code {
          value: "126050"
        }
        display {
          value: "Fractal Dimension"
        }
        definition {
          value: "A statistical index of complexity comparing how detail in a fractal pattern changes with the scale at which it is measured; a ratio of the change in detail to the change in scale"
        }
      }
      concept {
        code {
          value: "126051"
        }
        display {
          value: "Skewness"
        }
        definition {
          value: "Measure of the asymmetry of the probability distribution of a real-valued random variable about its mean"
        }
      }
      concept {
        code {
          value: "126052"
        }
        display {
          value: "Kurtosis"
        }
        definition {
          value: "Measure of the peakedness of the probability distribution of a real-valued random variable"
        }
      }
      concept {
        code {
          value: "126060"
        }
        display {
          value: "Entropy of GLCM"
        }
        definition {
          value: "The zero order entropy of a Gray Level Co-occurrence Matrix (GLCM). A measure of disorder. See http://www.fp.ucalgary.ca/mhallbey/equations.htm"
        }
      }
      concept {
        code {
          value: "126061"
        }
        display {
          value: "Energy of GLCM"
        }
        definition {
          value: "The energy (uniformity) (square root of the Angular Second Moment (ASM)) of a Gray Level Co-occurrence Matrix (GLCM). A measure of orderliness. See http://www.fp.ucalgary.ca/mhallbey/equations.htm"
        }
      }
      concept {
        code {
          value: "126062"
        }
        display {
          value: "Homogeneity of GLCM"
        }
        definition {
          value: "The Inverse Difference Moment of a Gray Level Co-occurrence Matrix (GLCM). See http://www.fp.ucalgary.ca/mhallbey/equations.htm"
        }
      }
      concept {
        code {
          value: "126063"
        }
        display {
          value: "Contrast of GLCM"
        }
        definition {
          value: "The sum of squares variance of a Gray Level Co-occurrence Matrix (GLCM). See http://www.fp.ucalgary.ca/mhallbey/equations.htm"
        }
      }
      concept {
        code {
          value: "126064"
        }
        display {
          value: "Dissimilarity of GLCM"
        }
        definition {
          value: "The dissimilarity of a Gray Level Co-occurrence Matrix (GLCM). See http://www.fp.ucalgary.ca/mhallbey/equations.htm"
        }
      }
      concept {
        code {
          value: "126065"
        }
        display {
          value: "ASM of GLCM"
        }
        definition {
          value: "The Angular Second Moment of a Gray Level Co-occurrence Matrix (GLCM). See http://www.fp.ucalgary.ca/mhallbey/equations.htm"
        }
      }
      concept {
        code {
          value: "126066"
        }
        display {
          value: "Correlation of GLCM"
        }
        definition {
          value: "A measure of the linear dependency of grey levels on those of neighbouring pixels of a Gray Level Co-occurrence Matrix (GLCM). See http://www.fp.ucalgary.ca/mhallbey/equations.htm"
        }
      }
      concept {
        code {
          value: "126067"
        }
        display {
          value: "Gray Level Co-occurrence Matrix (GLCM)"
        }
        definition {
          value: "A tabulation of how often different combinations of pixel values (grey levels) occur in an image. See http://www.fp.ucalgary.ca/mhallbey/the_glcm.htm"
        }
      }
      concept {
        code {
          value: "126070"
        }
        display {
          value: "Subject Time Point Identifier"
        }
        definition {
          value: "An identifier of a specific time point in a continuum, which is unique within an appropriate local context (such as an entire organization, system or treatment protocol), which identifies the time point for a specific patient"
        }
      }
      concept {
        code {
          value: "126071"
        }
        display {
          value: "Protocol Time Point Identifier"
        }
        definition {
          value: "An identifier of a specific time point in a continuum, which is unique within an appropriate local context (such as an entire organization, system or treatment protocol), which identifies the time point \"slot\" within a treatment protocol using the same value for all patients in the protocol"
        }
      }
      concept {
        code {
          value: "126072"
        }
        display {
          value: "Time Point Type"
        }
        definition {
          value: "A pre-defined type of a specific time point in a continuum"
        }
      }
      concept {
        code {
          value: "126073"
        }
        display {
          value: "Time Point Order"
        }
        definition {
          value: "A number indicating the order of a time point relative to other time points in the same continuum"
        }
      }
      concept {
        code {
          value: "126074"
        }
        display {
          value: "Posttreatment"
        }
        definition {
          value: "The time after the treatment of interest"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/valueset-concept-comments"
          }
          value {
            string_value {
              value: "Similar but not identical to (21954-3, LN, \"Protocol eligibility status Cancer\"), since not constrained to cancer, etc."
            }
          }
        }
        code {
          value: "126075"
        }
        display {
          value: "Eligibility"
        }
        definition {
          value: "For the purpose of determining eligibility for a protocol"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/valueset-concept-comments"
          }
          value {
            string_value {
              value: "More specific than (112022, DCM, \"RECIST\") or (C1709926, UMLS, \"RECIST\") or (C49164, NCIt, \"RECIST\") in that a specific version is specified."
            }
          }
        }
        code {
          value: "126080"
        }
        display {
          value: "RECIST 1.0"
        }
        definition {
          value: "Response Evaluation Criteria in Solid Tumors version 1.0. See [RECIST] in Normative References"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/valueset-concept-comments"
          }
          value {
            string_value {
              value: "More specific than (112022, DCM, \"RECIST\") or (C1709926, UMLS, \"RECIST\") or (C49164, NCIt, \"RECIST\") in that a specific version is specified."
            }
          }
        }
        code {
          value: "126081"
        }
        display {
          value: "RECIST 1.1"
        }
        definition {
          value: "Response Evaluation Criteria in Solid Tumors Version 1.1. See Eisenhauer et al. \"New Response Evaluation Criteria in Solid Tumours: Revised RECIST Guideline (version 1.1).\" European Journal of Cancer 45, no. 2 (n.d.): 228-47. doi:10.1016/j.ejca.2008.10.026."
        }
      }
      concept {
        code {
          value: "126100"
        }
        display {
          value: "Real World Value Map used for measurement"
        }
        definition {
          value: "A reference to the Real World Value Map applied to the stored image pixel values before their use for a measurement"
        }
      }
      concept {
        code {
          value: "126200"
        }
        display {
          value: "Image Library Group"
        }
        definition {
          value: "A container that groups common information about a set of images used as evidence to produce a report"
        }
      }
      concept {
        code {
          value: "126201"
        }
        display {
          value: "Acquisition Date"
        }
        definition {
          value: "The date the acquisition of data started"
        }
      }
      concept {
        code {
          value: "126202"
        }
        display {
          value: "Acquisition Time"
        }
        definition {
          value: "The time the acquisition of data started"
        }
      }
      concept {
        code {
          value: "126203"
        }
        display {
          value: "PET Radionuclide Incubation Time"
        }
        definition {
          value: "The time between the start of injection of the PET radionuclide and the start of acquisition of the PET data"
        }
      }
      concept {
        code {
          value: "126220"
        }
        display {
          value: "R2-Coefficient"
        }
        definition {
          value: "Coefficient of determination, R2. An indication of goodness of fit"
        }
      }
      concept {
        code {
          value: "126300"
        }
        display {
          value: "Perfusion analysis by Stable Xenon CT technique"
        }
        definition {
          value: "Perfusion analysis by Stable Xenon CT technique"
        }
      }
      concept {
        code {
          value: "126301"
        }
        display {
          value: "Perfusion analysis by IV Iodinated Contrast CT technique"
        }
        definition {
          value: "Perfusion analysis by IV Iodinated Contrast CT technique"
        }
      }
      concept {
        code {
          value: "126302"
        }
        display {
          value: "Perfusion analysis by Arterial Spin Labeling MR technique"
        }
        definition {
          value: "Perfusion analysis by Arterial Spin Labeling (ASL) MR technique"
        }
      }
      concept {
        code {
          value: "126303"
        }
        display {
          value: "Perfusion analysis by Susceptibility MR technique"
        }
        definition {
          value: "Perfusion analysis by Susceptibility (T2*) MR technique"
        }
      }
      concept {
        code {
          value: "126310"
        }
        display {
          value: "Least Mean Square (LMS) deconvolution"
        }
        definition {
          value: "Least Mean Square (LMS) deconvolution"
        }
      }
      concept {
        code {
          value: "126311"
        }
        display {
          value: "Singular Value Decomposition (SVD) deconvolution"
        }
        definition {
          value: "Singular Value Decomposition (SVD) deconvolution"
        }
      }
      concept {
        code {
          value: "126312"
        }
        display {
          value: "Ktrans"
        }
        definition {
          value: "Ktrans, the volume transfer constant of a tracer diffusion kinetic model, specifically the volume transfer constant between blood plasma and extravascular extracellular space (EES) See Tofts et al, \"Estimating Kinetic Parameters From Dynamic Contrast-Enhanced T1-Weighted MRI of a Diffusable Tracer: Standardized Quantities and Symbols\", Journal of Magnetic Resonance Imaging, vol. 10, pp. 223-232, 1999"
        }
      }
      concept {
        code {
          value: "126313"
        }
        display {
          value: "kep"
        }
        definition {
          value: "kep, the rate constant between extravascular extracellular space (EES) and blood plasma See Tofts et al, \"Estimating Kinetic Parameters From Dynamic Contrast-Enhanced T1-Weighted MRI of a Diffusable Tracer: Standardized Quantities and Symbols\", Journal of Magnetic Resonance Imaging, vol. 10, pp. 223-232, 1999"
        }
      }
      concept {
        code {
          value: "126314"
        }
        display {
          value: "ve"
        }
        definition {
          value: "ve, the fractional (not absolute) volume of extravascular extracellular space (EES) per unit volume of tissue See Tofts et al, \"Estimating Kinetic Parameters From Dynamic Contrast-Enhanced T1-Weighted MRI of a Diffusable Tracer: Standardized Quantities and Symbols\", Journal of Magnetic Resonance Imaging, vol. 10, pp. 223-232, 1999"
        }
      }
      concept {
        code {
          value: "126320"
        }
        display {
          value: "IAUC"
        }
        definition {
          value: "The intial area under the contrast agent concentration-time curve"
        }
      }
      concept {
        code {
          value: "126321"
        }
        display {
          value: "IAUC60"
        }
        definition {
          value: "The intial area under the contrast agent concentration-time curve at 60 seconds after the onset time"
        }
      }
      concept {
        code {
          value: "126322"
        }
        display {
          value: "IAUC90"
        }
        definition {
          value: "The intial area under the contrast agent concentration-time curve at 90 seconds after the onset time"
        }
      }
      concept {
        code {
          value: "126330"
        }
        display {
          value: "tau_m"
        }
        definition {
          value: "\317\204m. The mean intracellular water lifetime (\317\204i). Used in the Shutter-Speed Model (SSM) of tracer kinetics"
        }
      }
      concept {
        code {
          value: "126331"
        }
        display {
          value: "vp"
        }
        definition {
          value: "vp. The fractional (not absolute) blood plasma volume per unit volume of tissue. See Tofts et al, \"Estimating Kinetic Parameters From Dynamic Contrast-Enhanced T1-Weighted MRI of a Diffusable Tracer: Standardized Quantities and Symbols\", Journal of Magnetic Resonance Imaging, vol. 10, pp. 223-232, 1999"
        }
      }
      concept {
        code {
          value: "126340"
        }
        display {
          value: "Standard Tofts Model"
        }
        definition {
          value: "A tracer diffusion kinetic model in which the permeability is assumed to be isodirectional. See P. Tofts, \"Modeling tracer kinetics in dynamic Gd-DTPA MR imaging\", Journal of Magnetic Resonance Imaging, vol. 7, pp. 91-101, 1997"
        }
      }
      concept {
        code {
          value: "126341"
        }
        display {
          value: "Extended Tofts Model"
        }
        definition {
          value: "A tracer diffusion kinetic model in which the permeability is not assumed to be isodirectional, and which includes the contribution of tracer in the blood plasma to the total tissue concentration. See P. Tofts, \"Modeling tracer kinetics in dynamic Gd-DTPA MR imaging\", Journal of Magnetic Resonance Imaging, vol. 7, pp. 91-101, 1997"
        }
      }
      concept {
        code {
          value: "126342"
        }
        display {
          value: "Model-free concentration-time quantitification"
        }
        definition {
          value: "A semiquantitative analysis of the contrast-enhancement concentration versus time curve that avoids the use of a pharmacokinetic model; e.g. integration to compute the initial area under the curve"
        }
      }
      concept {
        code {
          value: "126343"
        }
        display {
          value: "First Pass Leakage Profile (FPLP)"
        }
        definition {
          value: "A tracer diffusion kinetic model that accounts for the tumor leakage profile during the first pass of contrast. See Li, Ka-Loh, Xiao Ping Zhu, John Waterton, and Alan Jackson. \"Improved 3D Quantitative Mapping of Blood Volume and Endothelial Permeability in Brain Tumors.\" Journal of Magnetic Resonance Imaging 12, no. 2 (2000): 347-357. doi:10.1002/1522-2586(200008)12:2<347::AID-JMRI19>3.0.CO;2-7"
        }
      }
      concept {
        code {
          value: "126344"
        }
        display {
          value: "Shutter-Speed Model (SSM)"
        }
        definition {
          value: "A tracer diffusion kinetic model that does not assume that intercompartmental water molecule exchange is infinitely fast. See Li, Xin, Wei Huang, Thomas E. Yankeelov, Alina Tudorica, William D. Rooney, and Charles S. Springer. \"Shutter-Speed Analysis of Contrast Reagent Bolus-Tracking Data: Preliminary Observations in Benign and Malignant Breast Disease.\" Magnetic Resonance in Medicine 53, no. 3 (2005): 724-29. doi:10.1002/mrm.20405"
        }
      }
      concept {
        code {
          value: "126350"
        }
        display {
          value: "T1 by Multiple Flip Angles"
        }
        definition {
          value: "T1 measurement by Multiple Flip Angles (MFA) (variable saturation) method"
        }
      }
      concept {
        code {
          value: "126351"
        }
        display {
          value: "T1 by Inversion Recovery"
        }
        definition {
          value: "T1 measurement by Inversion Recovery (IR) method"
        }
      }
      concept {
        code {
          value: "126352"
        }
        display {
          value: "T1 by Fixed Value"
        }
        definition {
          value: "Calculation was performed using a fixed value of T1 rather than a measured value. The value could be encoded as the value of (126353, DCM, \"T1 Used For Calculation\")"
        }
      }
      concept {
        code {
          value: "126353"
        }
        display {
          value: "T1 Used For Calculation"
        }
        definition {
          value: "The fixed value of T1 used for a calculation"
        }
      }
      concept {
        code {
          value: "126360"
        }
        display {
          value: "AIF Ignored"
        }
        definition {
          value: "No Arterial Input Function was used"
        }
      }
      concept {
        code {
          value: "126361"
        }
        display {
          value: "Population Averaged AIF"
        }
        definition {
          value: "A population-averaged Arterial Input Function"
        }
      }
      concept {
        code {
          value: "126362"
        }
        display {
          value: "User-defined AIF ROI"
        }
        definition {
          value: "An Arterial Input Function computed from a user-defined Region of Interest"
        }
      }
      concept {
        code {
          value: "126363"
        }
        display {
          value: "Automatically Detected AIF ROI"
        }
        definition {
          value: "An Arterial Input Function computed from an automatically detected Region of Interest"
        }
      }
      concept {
        code {
          value: "126364"
        }
        display {
          value: "Blind Estimation of AIF"
        }
        definition {
          value: "A data-driven blind source separation (BSS) algorithm that estimates AIF from individuals without any presumed AIF model and initialization. See Lin, Yu-Chun, Tsung-Han Chan, Chong-Yung Chi, Shu-Hang Ng, Hao-Li Liu, Kuo-Chen Wei, Yau-Yau Wai, Chun-Chieh Wang, and Jiun-Jie Wang. \"Blind Estimation of the Arterial Input Function in Dynamic Contrast-Enhanced MRI Using Purity Maximization.\" Magnetic Resonance in Medicine 68, no. 5 (November 1, 2012): 1439-49. doi:10.1002/mrm.24144"
        }
      }
      concept {
        code {
          value: "126370"
        }
        display {
          value: "Time of Peak Concentration"
        }
        definition {
          value: "The time at which the concentration-time curve achieves its peak for the first time. Used as a concept name for a value or as a method; e.g. used as a method of calculation for BAT. See Shpilfoygel Med Phys 2008. doi: 10.1118/1.1288669"
        }
      }
      concept {
        code {
          value: "126371"
        }
        display {
          value: "Bolus Arrival Time"
        }
        definition {
          value: "The nominal time at which arrival of a contrast bolus is detected, which is used as a reference point for subsequent calculations. Used as a concept name for a value or as a method. No specific computational method is implied by this general definition. Abbreviated BAT"
        }
      }
      concept {
        code {
          value: "126372"
        }
        display {
          value: "Time of Leading Half-Peak Concentration"
        }
        definition {
          value: "The time at which the concentration-time curve achieves half of its peak density for the first time. Used as a concept name for a value or as a method; e.g. used as a method of calculation for BAT. See Shpilfoygel Med Phys 2008. doi: 10.1118/1.1288669"
        }
      }
      concept {
        code {
          value: "126373"
        }
        display {
          value: "Temporal Derivative Exceeds Threshold"
        }
        definition {
          value: "A method of determining BAT that involves computing the temporal derivative of the concentration-time curve and selecting the time when the temporal derivative exceeds a specified threshold. See Shpilfoygel Med Phys 2008. doi: 10.1118/1.1288669"
        }
      }
      concept {
        code {
          value: "126374"
        }
        display {
          value: "Temporal Derivative Threshold"
        }
        definition {
          value: "A threshold applied to the temporal derivative of the concentration-time curve; e.g. used to establish BAT. See Shpilfoygel Med Phys 2008. doi: 10.1118/1.1288669"
        }
      }
      concept {
        code {
          value: "126375"
        }
        display {
          value: "Maximum Slope"
        }
        definition {
          value: "The maximum rate of signal intensity change within a measured region of a time-activity curve. See Boonsirikamchai, Piyaporn, Harmeet Kaur, Deborah A. Kuban, Edward Jackson, Ping Hou, and Haesun Choi. \"Use of Maximum Slope Images Generated From Dynamic Contrast-Enhanced MRI to Detect Locally Recurrent Prostate Carcinoma After Prostatectomy: A Practical Approach.\" American Journal of Roentgenology 198, no. 3 (March 1, 2012): W228-W236. doi:10.2214/AJR.10.6387"
        }
      }
      concept {
        code {
          value: "126376"
        }
        display {
          value: "Maximum Difference"
        }
        definition {
          value: "The maximum degree of signal intensity change within a measured region of a time-activity curve. See Boonsirikamchai, Piyaporn, Harmeet Kaur, Deborah A. Kuban, Edward Jackson, Ping Hou, and Haesun Choi. \"Use of Maximum Slope Images Generated From Dynamic Contrast-Enhanced MRI to Detect Locally Recurrent Prostate Carcinoma After Prostatectomy: A Practical Approach.\" American Journal of Roentgenology 198, no. 3 (March 1, 2012): W228-W236. doi:10.2214/AJR.10.6387"
        }
      }
      concept {
        code {
          value: "126377"
        }
        display {
          value: "Tracer Concentration"
        }
        definition {
          value: "Tracer concentration in tissue; e.g. in a DCE-MR experiment, the concentration of contrast agent in mmol/l"
        }
      }
      concept {
        code {
          value: "126380"
        }
        display {
          value: "Contrast Longitudinal Relaxivity"
        }
        definition {
          value: "The degree to which a paramagnetic contrast agent can enhance the proton longitudinal relaxation rate constant (R1, 1/T1), normalized to the concentration of the contrast agent. Also referred to as r1. Typically expressed in units of l/mmol/s"
        }
      }
      concept {
        code {
          value: "126390"
        }
        display {
          value: "Regional Blood Flow"
        }
        definition {
          value: "The flow rate of blood perfusing a region as volume per mass per unit of time"
        }
      }
      concept {
        code {
          value: "126391"
        }
        display {
          value: "Regional Blood Volume"
        }
        definition {
          value: "The volume of blood perfusing a region as volume per mass"
        }
      }
      concept {
        code {
          value: "126392"
        }
        display {
          value: "Oxygen Extraction Fraction"
        }
        definition {
          value: "The percent of the oxygen removed from the blood by tissue during its passage through the capillary network. For example, as measured by blood oxygenation level dependent (BOLD) MR. See He, Xiang, and Dmitriy A. Yablonskiy. \"Quantitative BOLD: Mapping of Human Cerebral Deoxygenated Blood Volume and Oxygen Extraction Fraction: Default State.\" Magnetic Resonance in Medicine 57, no. 1 (2007): 115-26"
        }
      }
      concept {
        code {
          value: "126393"
        }
        display {
          value: "R1"
        }
        definition {
          value: "The longitiudinal relaxation rate constant. The inverse of longitudinal relaxation time, i.e., R1 = 1/T1"
        }
      }
      concept {
        code {
          value: "126394"
        }
        display {
          value: "R2"
        }
        definition {
          value: "The transverse relaxation rate constant. The inverse of transverse relaxation time, i.e., R2 = 1/T2"
        }
      }
      concept {
        code {
          value: "126400"
        }
        display {
          value: "Standardized Uptake Value"
        }
        definition {
          value: "A ratio of locally measured radioactivity concentration versus the injected radioactivity distributed evenly throughout the whole body. This general concept encompasses all specific methods of calculating the whole body volume of distribution, such as using body weight, lean body mass, body surface area, etc."
        }
      }
      concept {
        code {
          value: "126401"
        }
        display {
          value: "SUVbw"
        }
        definition {
          value: "Standardized Uptake Value calculated using body weight. The patient size correction factor for males and females is body weight. Defined in Sugawara et al. Reevaluation of the Standardized Uptake Value for FDG: Variations with Body Weight and Methods for Correction.Radiology, 1999 at http://radiology.rsna.org/content/213/2/521"
        }
      }
      concept {
        code {
          value: "126402"
        }
        display {
          value: "SUVlbm"
        }
        definition {
          value: "Standardized Uptake Value calculated using lean body mass. The patient size correction factor for males is 1.10 * weight - 120 * (weight/height) ^2, and for females is 1.07 * weight - 148 * (weight/height) ^2. Defined in Sugawara et al. Reevaluation of the Standardized Uptake Value for FDG: Variations with Body Weight and Methods for Correction.Radiology, 1999 at http://radiology.rsna.org/content/213/2/521"
        }
      }
