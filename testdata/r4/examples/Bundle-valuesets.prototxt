        }
        display {
          value: "if (age > 60y) P50 = 29.3"
        }
        definition {
          value: "Estimate of Oxygen partial pressure at 50% saturation for patients more than 60 years old: P50 = 29.3"
        }
      }
      concept {
        code {
          value: "122262"
        }
        display {
          value: "Area = Flow / 44.5 * sqrt(Gradient[mmHg])"
        }
        definition {
          value: "Cardiac valve area computed from flow and pressure gradient: Area = Flow / 44.5 * sqrt(Gradient[mmHg]) [Gorlin and Gorlin, Am Heart J, 1951]"
        }
      }
      concept {
        code {
          value: "122263"
        }
        display {
          value: "MVA = Flow / 38.0 * sqrt(Gradient[mmHg])"
        }
        definition {
          value: "Mitral valve area computed from flow and pressure gradient: Mitral valve Area = Flow / 38.0 * sqrt(Gradient[mmHg]) [Gorlin and Gorlin, Am Heart J, 1951]"
        }
      }
      concept {
        code {
          value: "122265"
        }
        display {
          value: "BMI = Wt / Ht ^ 2"
        }
        definition {
          value: "Body Mass Index computed from weight and height: BMI = Wt/Ht^2"
        }
      }
      concept {
        code {
          value: "122266"
        }
        display {
          value: "BSA = 0.007358 * WT ^ 0.425 * HT ^ 0.725"
        }
        definition {
          value: "Body Surface Area computed from patient height and weight: BSA = 0.007358 * WT[kg] ^ 0.425 * HT[cm] ^ 0.725 (for East Asian adult, aged 15+ years) [Kanai Izumi, Masamitsu Kanai, \'Clinical examination method summary\']"
        }
      }
      concept {
        code {
          value: "122267"
        }
        display {
          value: "BSA = 0.010265 * WT ^ 0.423 * HT ^ 0.651"
        }
        definition {
          value: "Body Surface Area computed from patient height and weight: BSA = 0.010265 * WT[kg] ^ 0.423 * HT[cm] ^ 0.651 (For East Asian child aged 12-14 years)"
        }
      }
      concept {
        code {
          value: "122268"
        }
        display {
          value: "BSA = 0.008883 * WT ^ 0.444 * HT ^ 0.663"
        }
        definition {
          value: "Body Surface Area computed from patient height and weight: BSA = 0.008883* WT[kg] ^ 0.444 * HT[cm] ^ 0.663 (For East Asian child aged 6-11 years)"
        }
      }
      concept {
        code {
          value: "122269"
        }
        display {
          value: "BSA = 0.038189 * WT ^ 0.423 * HT ^ 0.362"
        }
        definition {
          value: "Body Surface Area computed from patient height and weight: BSA = 0.038189 * WT[kg] ^ 0.423 * HT[cm] ^ 0.362 (For East Asian child aged 1-5 years)"
        }
      }
      concept {
        code {
          value: "122270"
        }
        display {
          value: "BSA = 0.009568 * WT ^ 0.473 * HT ^ 0.655"
        }
        definition {
          value: "Body Surface Area computed from patient height and weight: BSA = 0.009568* WT[kg] ^ 0.473 * HT[cm] ^ 0.655 (For East Asian child aged 0-12 months)"
        }
      }
