          value: "Direction of the base of a horizontal prism -- either in (toward the nose), or out (away from the nose)"
        }
      }
      concept {
        code {
          value: "111677"
        }
        display {
          value: "Vertical Prism Power"
        }
        definition {
          value: "The power of a prism to bend light in the vertical direction, in prism diopters"
        }
      }
      concept {
        code {
          value: "111678"
        }
        display {
          value: "Vertical Prism Base"
        }
