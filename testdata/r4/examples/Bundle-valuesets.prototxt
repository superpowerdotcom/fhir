entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/guide-page-generation"
  }
  resource {
    code_system {
      id {
        value: "guide-page-generation"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>GuidePageGeneration</h2><div><p>A code that indicates how the page is generated.</p>\n</div><p>This code system http://hl7.org/fhir/guide-page-generation defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">html<a name=\"guide-page-generation-html\"> </a></td><td>HTML</td><td>Page is proper xhtml with no templating.  Will be brought across unchanged for standard post-processing.</td></tr><tr><td style=\"white-space:nowrap\">markdown<a name=\"guide-page-generation-markdown\"> </a></td><td>Markdown</td><td>Page is markdown with templating.  Will use the template to create a file that imports the markdown file prior to post-processing.</td></tr><tr><td style=\"white-space:nowrap\">xml<a name=\"guide-page-generation-xml\"> </a></td><td>XML</td><td>Page is xml with templating.  Will use the template to create a file that imports the source file and run the nominated XSLT transform (see parameters) if present prior to post-processing.</td></tr><tr><td style=\"white-space:nowrap\">generated<a name=\"guide-page-generation-generated\"> </a></td><td>Generated</td><td>Page will be generated by the publication process - no source to bring across.</td></tr></table></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "fhir"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "trial-use"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 1
          }
        }
      }
      url {
        value: "http://hl7.org/fhir/guide-page-generation"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.4.999"
        }
      }
      version {
        value: "4.0.1"
      }
      name {
        value: "GuidePageGeneration"
      }
      title {
        value: "GuidePageGeneration"
      }
      status {
        value: DRAFT
      }
      experimental {
      }
      date {
        value_us: 1572560963000000
        timezone: "+11:00"
        precision: SECOND
      }
      publisher {
        value: "HL7 (FHIR Project)"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org/fhir"
          }
        }
        telecom {
          system {
            value: EMAIL
          }
          value {
            value: "fhir@lists.hl7.org"
          }
        }
      }
      description {
        value: "A code that indicates how the page is generated."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://hl7.org/fhir/ValueSet/guide-page-generation"
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "html"
        }
        display {
          value: "HTML"
        }
        definition {
          value: "Page is proper xhtml with no templating.  Will be brought across unchanged for standard post-processing."
        }
      }
      concept {
        code {
          value: "markdown"
        }
        display {
          value: "Markdown"
        }
        definition {
          value: "Page is markdown with templating.  Will use the template to create a file that imports the markdown file prior to post-processing."
        }
      }
      concept {
        code {
          value: "xml"
        }
        display {
          value: "XML"
        }
        definition {
          value: "Page is xml with templating.  Will use the template to create a file that imports the source file and run the nominated XSLT transform (see parameters) if present prior to post-processing."
        }
      }
      concept {
        code {
          value: "generated"
        }
        display {
          value: "Generated"
        }
        definition {
          value: "Page will be generated by the publication process - no source to bring across."
        }
      }
    }
  }
}
