        value_us: 1572560963000000
        timezone: "+11:00"
        precision: SECOND
      }
      publisher {
        value: "ASTM"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://www.astm.org/"
          }
        }
      }
      description {
        value: "The Digital Signature Purposes, an indication of the reason an entity signs a document. This is included in the signed information and can be used when determining accountability for various actions concerning the document. Examples include: author, transcriptionist/recorder, and witness."
      }
