      concept {
        code {
          value: "not-done"
        }
        display {
          value: "Not Done"
        }
        definition {
          value: "The administration was terminated prior to any impact on the subject (though preparatory actions may have been taken)"
        }
      }
      concept {
        code {
          value: "on-hold"
        }
        display {
          value: "On Hold"
        }
        definition {
          value: "Actions implied by the administration have been temporarily halted, but are expected to continue later. May also be called \'suspended\'."
        }
      }
      concept {
        code {
          value: "completed"
        }
        display {
          value: "Completed"
        }
        definition {
          value: "All actions that are implied by the administration have occurred."
        }
      }
      concept {
        code {
          value: "entered-in-error"
        }
        display {
          value: "Entered in Error"
        }
        definition {
          value: "The administration was entered in error and therefore nullified."
        }
      }
      concept {
        code {
          value: "stopped"
        }
        display {
          value: "Stopped"
        }
        definition {
          value: "Actions implied by the administration have been permanently halted, before all of them occurred."
        }
      }
      concept {
        code {
          value: "unknown"
        }
        display {
          value: "Unknown"
        }
        definition {
          value: "The authoring system does not know which of the status values currently applies for this request. Note: This concept is not to be used for \'other\' - one of the listed statuses is presumed to apply, it\'s just not known which one."
        }
      }
    }
  }
}
