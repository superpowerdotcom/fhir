      }
      concept {
        code {
          value: "113110"
        }
        display {
          value: "Retain UIDs Option"
        }
        definition {
          value: "Retention of information that would otherwise be removed during de-identification according to an option defined in PS3.15 that requires that UIDs be retained; e.g. SOP Instance UID"
