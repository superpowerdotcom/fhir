entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/postal-address-use"
  }
  resource {
    value_set {
      id {
        value: "postal-address-use"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: EXTENSIONS
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>PostalAddressUse</h2><div><p>Uses of an address not included in Address.use.</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include these codes as defined in <a href=\"v3/AddressUse/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-AddressUse</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-BAD\">BAD</a></td><td>bad address</td><td>A flag indicating that the address is bad, in fact, useless.</td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-CONF\">CONF</a></td><td>confidential address</td><td>Indicates that the address is considered sensitive and should only be shared or published in accordance with organizational controls governing patient demographic information with increased sensitivity. Uses of Addresses. Lloyd to supply more complete description.</td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-HP\">HP</a></td><td>primary home</td><td>The primary home, to reach a person after business hours.</td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-HV\">HV</a></td><td>vacation home</td><td>A vacation home, to reach a person while on vacation.</td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-DIR\">DIR</a></td><td>direct</td><td>Indicates a work place address or telecommunication address that reaches the individual or organization directly without intermediaries. For phones, often referred to as a \'private line\'.</td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-PUB\">PUB</a></td><td>public</td><td>Indicates a work place address or telecommunication address that is a \'standard\' address which may reach a reception service, mail-room, or other intermediary prior to the target entity.</td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-PHYS\">PHYS</a></td><td>physical visit address</td><td>Used primarily to visit an address.</td></tr><tr><td><a href=\"v3/AddressUse/cs.html#v3-AddressUse-PST\">PST</a></td><td>postal address</td><td>Used to send mail.</td></tr></table></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "fhir"
          }
        }
      }
      url {
        value: "http://hl7.org/fhir/ValueSet/postal-address-use"
      }
