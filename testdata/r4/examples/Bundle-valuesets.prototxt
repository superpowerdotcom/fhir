      concept {
        code {
          value: "111609"
        }
        display {
          value: "No filter"
        }
        definition {
          value: "No filter used"
        }
      }
      concept {
        code {
          value: "111621"
        }
        display {
          value: "Field 1 for Joslin 3 field"
        }
        definition {
          value: "Joslin NM-1 is a 45 degree field focused centrally between the temporal margin of optic disc and the center of the macula: Center the camera on the papillomacular bundle midway between the temporal margin of the optic disc and the center of the macula. The horizontal centerline of the image should pass directly through the center of the disc"
        }
      }
      concept {
        code {
          value: "111622"
        }
        display {
          value: "Field 2 for Joslin 3 field"
        }
        definition {
          value: "Joslin NM-2 is a 45 degree field focused superior temporal to the optic disc: Center the camera laterally approximately one-half disc diameter temporal to the center of the macula. The lower edge of the field is tangent to a horizontal line passing through the upper edge of the optic disc. The image is taken temporal to the macula but includes more retinal nasal and superior to the macula than standard field 2"
        }
      }
      concept {
        code {
          value: "111623"
        }
        display {
          value: "Field 3 for Joslin 3 field"
        }
        definition {
          value: "Joslin NM-3 is a 45 degree field focused nasal to the optic disc: This field is nasal to the optic disc and may include part of the optic disc. The horizontal centerline of the image should pass tangent to the lower edge of the optic disc"
        }
      }
      concept {
        code {
          value: "111625"
        }
        display {
          value: "Diffuse direct illumination"
        }
        definition {
          value: "A broad or \"soft\" light supplied from a single source"
        }
      }
      concept {
        code {
          value: "111626"
        }
        display {
          value: "Scheimpflug Camera"
        }
        definition {
          value: "A slit reflected light microscope, which has the ability to form an image of the back scattered light from the eye in a sagittal plane. Scheimpflug cameras are able to achieve a wide depth of focus by employing the \"Sheimpflug principle\" where the lens and image planes are not parallel with each other. Rotating Sheimplug cameras are able to generate three-dimensional images and calculate measurements of the anterior chamber of the eye"
        }
      }
      concept {
        code {
          value: "111627"
        }
        display {
          value: "Scotopic light"
        }
        definition {
          value: "Lighting condition approximately 0.04 lux"
        }
      }
      concept {
        code {
          value: "111628"
        }
        display {
          value: "Mesopic light"
        }
        definition {
          value: "Lighting condition approximately 4 lux"
        }
      }
      concept {
        code {
          value: "111629"
        }
        display {
          value: "Photopic light"
        }
        definition {
          value: "Lighting condition approximately 40 lux"
        }
      }
      concept {
        code {
          value: "111630"
        }
        display {
          value: "Dynamic light"
        }
        definition {
          value: "Acquisition preceded by intense light"
        }
      }
      concept {
        code {
          value: "111631"
        }
        display {
          value: "Average Glandular Dose"
        }
        definition {
          value: "Calculated from values of entrance exposure in air, the X-Ray beam quality (half-value layer), and compressed breast thickness, is the energy deposited per unit mass of glandular tissue averaged over all the glandular tissue in the breast"
        }
      }
      concept {
        code {
          value: "111632"
        }
        display {
          value: "Anode Target Material"
        }
        definition {
          value: "The primary material in the anode of an X-Ray source"
        }
      }
      concept {
        code {
          value: "111633"
        }
        display {
          value: "Compression Thickness"
        }
        definition {
          value: "The average thickness of the body part examined when compressed, if compression has been applied during X-Ray exposure"
        }
      }
      concept {
        code {
          value: "111634"
        }
        display {
          value: "Half Value Layer"
        }
        definition {
          value: "Thickness of Aluminum required to reduce the X-Ray output at the patient entrance surface by a factor of two"
        }
      }
      concept {
        code {
          value: "111635"
        }
        display {
          value: "X-Ray Grid"
        }
        definition {
          value: "An anti-scatter device based on radiation absorbing strips above the detector; e.g. in the patient support"
        }
      }
      concept {
        code {
          value: "111636"
        }
        display {
          value: "Entrance Exposure at RP"
        }
        definition {
          value: "Exposure measurement in air at the reference point that does not include back scatter, according to MQCM 1999"
        }
      }
      concept {
        code {
          value: "111637"
        }
        display {
          value: "Accumulated Average Glandular Dose"
        }
        definition {
          value: "Average Glandular Dose to a single breast accumulated over multiple images"
        }
      }
      concept {
        code {
          value: "111638"
        }
        display {
          value: "Patient Equivalent Thickness"
        }
        definition {
          value: "Value of the control variable used to parametrize the Automatic Exposure Control (AEC) closed loop; e.g. \"Water Value\""
        }
      }
      concept {
        code {
          value: "111641"
        }
        display {
          value: "Fixed grid"
        }
        definition {
          value: "An X-Ray Grid that does not move during exposure"
        }
      }
      concept {
        code {
          value: "111642"
        }
        display {
          value: "Focused grid"
        }
        definition {
          value: "An X-Ray Grid with radiation absorbing strips that are focused toward the focal spot, to eliminate grid cutoff"
        }
      }
      concept {
        code {
          value: "111643"
        }
        display {
          value: "Reciprocating grid"
        }
        definition {
          value: "An X-Ray Grid that is designed to move during exposure, to eliminate the appearance of grid lines on the image"
        }
      }
      concept {
        code {
          value: "111644"
        }
        display {
          value: "Parallel grid"
        }
        definition {
          value: "An X-Ray Grid with radiation absorbing strips that are parallel to each other and that is used only with long source to image distances"
        }
      }
      concept {
        code {
          value: "111645"
        }
        display {
          value: "Crossed grid"
        }
        definition {
          value: "An X-Ray Grid with crossed radiation absorbing strips used for more complete cleanup of scatter radiation"
        }
      }
      concept {
        code {
          value: "111646"
        }
        display {
          value: "No grid"
        }
        definition {
          value: "No X-Ray Grid was used due to low scatter conditions"
        }
      }
      concept {
        code {
          value: "111671"
        }
        display {
          value: "Spectacle Prescription Report"
        }
        definition {
          value: "The spectacle prescription for a patient"
        }
      }
