entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/medication-admin-status"
  }
  resource {
    code_system {
      id {
        value: "medication-admin-status"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>Medication administration  status  codes</h2><div><p>MedicationAdministration Status Codes</p>\n</div><p>This code system http://terminology.hl7.org/CodeSystem/medication-admin-status defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">in-progress<a name=\"medication-admin-status-in-progress\"> </a></td><td>In Progress</td><td>The administration has started but has not yet completed.</td></tr><tr><td style=\"white-space:nowrap\">not-done<a name=\"medication-admin-status-not-done\"> </a></td><td>Not Done</td><td>The administration was terminated prior to any impact on the subject (though preparatory actions may have been taken)</td></tr><tr><td style=\"white-space:nowrap\">on-hold<a name=\"medication-admin-status-on-hold\"> </a></td><td>On Hold</td><td>Actions implied by the administration have been temporarily halted, but are expected to continue later. May also be called \'suspended\'.</td></tr><tr><td style=\"white-space:nowrap\">completed<a name=\"medication-admin-status-completed\"> </a></td><td>Completed</td><td>All actions that are implied by the administration have occurred.</td></tr><tr><td style=\"white-space:nowrap\">entered-in-error<a name=\"medication-admin-status-entered-in-error\"> </a></td><td>Entered in Error</td><td>The administration was entered in error and therefore nullified.</td></tr><tr><td style=\"white-space:nowrap\">stopped<a name=\"medication-admin-status-stopped\"> </a></td><td>Stopped</td><td>Actions implied by the administration have been permanently halted, before all of them occurred.</td></tr><tr><td style=\"white-space:nowrap\">unknown<a name=\"medication-admin-status-unknown\"> </a></td><td>Unknown</td><td>The authoring system does not know which of the status values currently applies for this request. Note: This concept is not to be used for \'other\' - one of the listed statuses is presumed to apply, it\'s just not known which one.</td></tr></table></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "phx"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "trial-use"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 2
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/medication-admin-status"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
