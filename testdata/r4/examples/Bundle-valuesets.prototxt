        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>Iso 3166 Part 1: 2 Letter Codes</h2><div><p>This value set defines the ISO 3166 Part 1 2-letter codes</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include these codes as defined in <code>urn:iso:std:iso:3166</code><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td>AD</td><td>Andorra</td><td/></tr><tr><td>AE</td><td>United Arab Emirates</td><td/></tr><tr><td>AF</td><td>Afghanistan</td><td/></tr><tr><td>AG</td><td>Antigua and Barbuda</td><td/></tr><tr><td>AI</td><td>Anguilla</td><td/></tr><tr><td>AL</td><td>Albania</td><td/></tr><tr><td>AM</td><td>Armenia</td><td/></tr><tr><td>AO</td><td>Angola</td><td/></tr><tr><td>AQ</td><td>Antarctica</td><td/></tr><tr><td>AR</td><td>Argentina</td><td/></tr><tr><td>AS</td><td>American Samoa</td><td/></tr><tr><td>AT</td><td>Austria</td><td/></tr><tr><td>AU</td><td>Australia</td><td/></tr><tr><td>AW</td><td>Aruba</td><td/></tr><tr><td>AX</td><td>\303\205land Islands</td><td/></tr><tr><td>AZ</td><td>Azerbaijan</td><td/></tr><tr><td>BA</td><td>Bosnia and Herzegovina</td><td/></tr><tr><td>BB</td><td>Barbados</td><td/></tr><tr><td>BD</td><td>Bangladesh</td><td/></tr><tr><td>BE</td><td>Belgium</td><td/></tr><tr><td>BF</td><td>Burkina Faso</td><td/></tr><tr><td>BG</td><td>Bulgaria</td><td/></tr><tr><td>BH</td><td>Bahrain</td><td/></tr><tr><td>BI</td><td>Burundi</td><td/></tr><tr><td>BJ</td><td>Benin</td><td/></tr><tr><td>BL</td><td>Saint Barth\303\251lemy</td><td/></tr><tr><td>BM</td><td>Bermuda</td><td/></tr><tr><td>BN</td><td>Brunei Darussalam</td><td/></tr><tr><td>BO</td><td>Bolivia, Plurinational State of</td><td/></tr><tr><td>BQ</td><td>Bonaire, Sint Eustatius and Saba</td><td/></tr><tr><td>BR</td><td>Brazil</td><td/></tr><tr><td>BS</td><td>Bahamas</td><td/></tr><tr><td>BT</td><td>Bhutan</td><td/></tr><tr><td>BV</td><td>Bouvet Island</td><td/></tr><tr><td>BW</td><td>Bo