        }
      }
      concept {
        code {
          value: "113768"
        }
        display {
          value: "Number of Pulses"
        }
        definition {
          value: "Number of pulses applied by X-Ray systems during an irradiation event (acquisition run or pulsed fluoro)"
        }
      }
      concept {
        code {
          value: "113769"
        }
        display {
          value: "Irradiation Event UID"
        }
        definition {
          value: "Unique identification of a single irradiation event"
        }
      }
      concept {
        code {
          value: "113770"
        }
        display {
          value: "Column Angulation"
        }
        definition {
          value: "Angle of the X-Ray beam in degree relative to an orthogonal axis to the detector plane"
        }
      }
      concept {
        code {
          value: "113771"
        }
        display {
          value: "X-Ray Filters"
        }
        definition {
          value: "Devices used to modify the energy or energy distribution of X-Rays"
        }
      }
      concept {
        code {
          value: "113772"
        }
        display {
          value: "X-Ray Filter Type"
        }
        definition {
          value: "Type of filter(s) inserted into the X-Ray beam; e.g. wedges"
        }
      }
      concept {
        code {
          value: "113773"
        }
        display {
          value: "X-Ray Filter Thickness Maximum"
        }
        definition {
          value: "The maximum thickness of the X-Ray absorbing material used in the filters"
        }
      }
      concept {
        code {
          value: "113780"
        }
        display {
          value: "Reference Point Definition"
        }
        definition {
          value: "System provided definition of the Reference Point used for Dose calculations"
        }
      }
      concept {
        code {
          value: "113788"
        }
        display {
          value: "Collimated Field Height"
        }
        definition {
          value: "Distance between the collimator blades in pixel column direction as projected at the detector plane"
        }
      }
      concept {
        code {
          value: "113789"
        }
        display {
          value: "Collimated Field Width"
        }
        definition {
          value: "Distance between the collimator blades in pixel row direction as projected at the detector plane"
        }
      }
      concept {
        code {
          value: "113790"
        }
        display {
          value: "Collimated Field Area"
        }
        definition {
          value: "Collimated field area at image receptor. Area for compatibility with IEC 60601-2-43"
        }
      }
      concept {
        code {
          value: "113791"
        }
        display {
          value: "Pulse Rate"
        }
        definition {
          value: "Pulse rate applied by equipment during Fluoroscopy"
        }
      }
      concept {
        code {
          value: "113792"
        }
        display {
          value: "Distance Source to Table Plane"
        }
        definition {
          value: "Measured or calculated distance from the X-Ray source to the table plane in the center of the beam"
        }
      }
      concept {
        code {
          value: "113793"
        }
        display {
          value: "Pulse Width"
        }
        definition {
          value: "(Average) X-Ray pulse width"
        }
      }
      concept {
        code {
          value: "113794"
        }
        display {
          value: "Dose Measurement Device"
        }
        definition {
          value: "Calibrated device to perform dose measurements"
        }
      }
      concept {
        code {
          value: "113795"
        }
        display {
          value: "Acquired Image"
        }
        definition {
          value: "Image acquired during a specified event"
        }
      }
      concept {
        code {
          value: "113800"
        }
        display {
          value: "DLP to E conversion via MC computation"
        }
        definition {
          value: "Effective Dose evaluation from the product of Dose Length Product (DLP) and the Effective Dose Conversion Factor (E/DLP in units of mSv/mGy-cm), where the ratio is derived by means of Monte Carlo computations"
        }
      }
      concept {
        code {
          value: "113801"
        }
        display {
          value: "CTDIfreeair to E conversion via MC computation"
        }
        definition {
          value: "Effective Dose evaluation from the product of the Mean CTDIfreeair and the ratio E/CTDIfreeair (mSv/mGy), where the ratio is derived by means of Monte Carlo computations"
        }
      }
      concept {
        code {
          value: "113802"
        }
        display {
          value: "DLP to E conversion via measurement"
        }
        definition {
          value: "Effective Dose evaluation from the product of Dose Length Product (DLP) and the Effective Dose Conversion Factor (E/DLP in units of mSv/mGy-cm), where the ratio is derived by means of dosimetric measurements with an anthropomorphic phantom"
        }
      }
      concept {
        code {
          value: "113803"
        }
        display {
          value: "CTDIfreeair to E conversion via measurement"
        }
        definition {
          value: "Effective Dose evaluation from the product of the Mean CTDIfreeair and the ratio E/CTDIfreeair (mSv/mGy), where the ratio is derived by means of dosimetric measurements with an anthropomorphic phantom"
        }
      }
      concept {
        code {
          value: "113804"
        }
        display {
          value: "Sequenced Acquisition"
        }
        definition {
          value: "The CT acquisition was performed by acquiring single or multi detector data while rotating the source about the gantry while the table is not moving. Additional slices are acquired by incrementing the table position and again rotating the source about the gantry while the table is not moving"
        }
      }
      concept {
        code {
          value: "113805"
        }
        display {
          value: "Constant Angle Acquisition"
        }
        definition {
          value: "The CT acquisition was performed by holding the source at a constant angle and moving the table to obtain a projection image; e.g. localizer"
        }
      }
      concept {
        code {
          value: "113806"
        }
        display {
          value: "Stationary Acquisition"
        }
        definition {
          value: "The CT acquisition was performed by holding the table at a constant position and acquiring multiple slices over time at the same location"
        }
      }
      concept {
        code {
          value: "113807"
        }
        display {
          value: "Free Acquisition"
        }
        definition {
          value: "The CT acquisition was performed while rotating the source about the gantry while the table movement is under direct control of a human operator or under the control of an analysis application; e.g. fluoro"
        }
      }
      concept {
        code {
          value: "113808"
        }
        display {
          value: "ICRP Pub 60"
        }
        definition {
          value: "Reference authority 1990 Recommendations of the International Commission on Radiological Protection (ICRP Publication 60, published as the Annals of the ICRP Vol. 21, No. 1-3, Pergamon Press,1991)"
        }
      }
      concept {
        code {
          value: "113809"
        }
        display {
          value: "Start of X-Ray Irradiation"
        }
        definition {
          value: "Start, DateTime of the first X-Ray Irradiation Event of the accumulation within a Study"
        }
      }
      concept {
        code {
          value: "113810"
        }
        display {
          value: "End of X-Ray Irradiation"
        }
        definition {
          value: "End, DateTime of the last X-Ray Irradiation Event of the accumulation within a Study"
        }
      }
      concept {
        code {
          value: "113811"
        }
        display {
          value: "CT Accumulated Dose Data"
        }
        definition {
          value: "X-Ray dose accumulated over multiple CT irradiation events; e.g. for a study or a performed procedure step"
        }
      }
      concept {
        code {
          value: "113812"
        }
        display {
          value: "Total Number of Irradiation Events"
        }
        definition {
          value: "Total number of events during the defined scope of accumulation"
        }
      }
      concept {
        code {
          value: "113813"
        }
        display {
          value: "CT Dose Length Product Total"
        }
        definition {
          value: "The total dose length product defined scope of accumulation"
        }
      }
      concept {
        code {
          value: "113814"
        }
        display {
          value: "CT Effective Dose Total"
        }
        definition {
          value: "The total Effective Dose at the defined scope of accumulation"
        }
      }
      concept {
        code {
          value: "113815"
        }
        display {
          value: "Patient Model"
        }
        definition {
          value: "Identification of the reference-patient model used when Effective Dose is evaluated via Monte Carlo calculations or from a Dose Length Product conversion factor based on Monte Carlo calculations"
        }
      }
      concept {
        code {
          value: "113816"
        }
        display {
          value: "Condition Effective Dose measured"
        }
        definition {
          value: "References the physical phantom and the type of dosimeter used when measurements are done to establish Effective Dose Conversion Factors (E/DLP) or ratios E/CTDIfreeair"
        }
      }
      concept {
        code {
          value: "113817"
        }
        display {
          value: "Effective Dose Phantom Type"
        }
        definition {
          value: "Type of Effective Dose phantom used"
        }
      }
      concept {
        code {
          value: "113818"
        }
        display {
          value: "Dosimeter Type"
        }
        definition {
          value: "Type of dosimeter used"
        }
      }
      concept {
        code {
          value: "113819"
        }
        display {
          value: "CT Acquisition"
        }
        definition {
          value: "General description of the CT Irradiation event"
        }
      }
      concept {
        code {
          value: "113820"
        }
        display {
          value: "CT Acquisition Type"
        }
        definition {
          value: "Method of the CT acquisition"
        }
      }
      concept {
        code {
          value: "113821"
        }
        display {
          value: "X-Ray Filter Aluminum Equivalent"
        }
        definition {
          value: "Thickness of an equivalent filter in mm in Aluminum"
        }
      }
      concept {
        code {
          value: "113822"
        }
        display {
          value: "CT Acquisition Parameters"
        }
        definition {
          value: "General description of the acquisition parameters"
        }
      }
      concept {
        code {
          value: "113823"
        }
        display {
          value: "Number of X-Ray Sources"
        }
        definition {
          value: "Number of X-Ray sources"
        }
      }
      concept {
        code {
          value: "113824"
        }
        display {
          value: "Exposure Time"
        }
        definition {
          value: "Total time the patient has received X-Ray exposure during the irradiation event"
        }
      }
      concept {
        code {
          value: "113825"
        }
        display {
          value: "Scanning Length"
        }
        definition {
          value: "Length of the table travel during the entire tube loading, according to IEC 60601-2-44 Note Scanning Length might be longer than the programmed acquisition length (Length of Reconstructable Volume)"
        }
      }
      concept {
        code {
          value: "113826"
        }
        display {
          value: "Nominal Single Collimation Width"
        }
        definition {
          value: "The value of the nominal width referenced to the location of the isocenter along the z axis of a single row of acquired data in mm"
        }
      }
      concept {
        code {
          value: "113827"
        }
        display {
          value: "Nominal Total Collimation Width"
        }
        definition {
          value: "The value of the nominal width referenced to the location of the isocenter along the z axis of the total collimation in mm over the area of active X-Ray detection"
        }
      }
      concept {
        code {
          value: "113828"
        }
        display {
          value: "Pitch Factor"
        }
        definition {
          value: "For Spiral scanning: Pitch Factor = (Table Feed per Rotation (mm)) /(Nominal Total Collimation Width (mm)) For Sequenced scanning: Pitch Factor = (Table Feed per single Sequenced scan (mm)) /(Nominal Total Collimation Width (mm))"
        }
      }
      concept {
        code {
          value: "113829"
        }
        display {
          value: "CT Dose"
        }
        definition {
          value: "General description of CT dose values"
        }
      }
      concept {
        code {
          value: "113830"
        }
        display {
          value: "Mean CTDIvol"
        }
        definition {
          value: "\"Mean CTDIvol\" refers to the average value of the CTDIvol associated with this acquisition"
        }
      }
      concept {
        code {
          value: "113831"
        }
        display {
          value: "CT X-Ray Source Parameters"
        }
        definition {
          value: "Identification, tube-potential, tube-current, and exposure-time parameters associated with an X-Ray source during an acquisition"
        }
      }
      concept {
        code {
          value: "113832"
        }
        display {
          value: "Identification of the X-Ray Source"
        }
        definition {
          value: "Identifies the particular X-Ray source (in a multi-source CT system) for which the set of X-Ray source parameter values is reported"
        }
      }
      concept {
        code {
          value: "113833"
        }
        display {
          value: "Maximum X-Ray Tube Current"
        }
        definition {
          value: "Maximum X-Ray tube current"
        }
      }
      concept {
        code {
          value: "113834"
        }
        display {
          value: "Exposure Time per Rotation"
        }
        definition {
          value: "The exposure time for one rotation of the source around the object in s"
        }
      }
      concept {
        code {
          value: "113835"
        }
        display {
          value: "CTDIw Phantom Type"
        }
        definition {
          value: "A label describing the type of phantom used for CTDIW measurement according to IEC 60601-2-44 (Head 16 cm diameter PMMA, Body 32 cm diameter PMMA)"
        }
      }
      concept {
        code {
          value: "113836"
        }
        display {
          value: "CTDIfreeair Calculation Factor"
        }
        definition {
          value: "The CTDIfreeair Calculation Factor is the CTDIfreeair per mAs, expressed in units of mGy/mAs. The CTDIfreeair Calculation Factor may be used in one method calculating Dose"
        }
      }
      concept {
        code {
          value: "113837"
        }
        display {
          value: "Mean CTDIfreeair"
        }
        definition {
          value: "The average value of the free-in-air CTDI associated with this acquisition"
        }
      }
      concept {
        code {
          value: "113838"
        }
        display {
          value: "DLP"
        }
        definition {
          value: "Dose Length Product (DLP), expressed in mGy-cm, is an index characterizing the product of the CTDIvol and the length scanned. For Spiral scanning, DLP = CTDIvol x Scanning Length. For Sequenced scanning, DLP = CTDIvol x Nominal Total Collimation Width x Cumulative Exposure Time / Exposure Time per Rotation. For Stationary and Free scanning, DLP = CTDIvol x Nominal Total Collimation Width"
        }
      }
      concept {
        code {
          value: "113839"
        }
        display {
          value: "Effective Dose"
        }
        definition {
          value: "Effective dose in mSv"
        }
      }
      concept {
        code {
          value: "113840"
        }
        display {
          value: "Effective Dose Conversion Factor"
        }
        definition {
          value: "Effective Dose per DLP, reference value for Effective Dose calculation, expressed in mSv/mGY.cm"
        }
      }
      concept {
        code {
          value: "113841"
        }
        display {
          value: "ICRP Pub 103"
        }
        definition {
          value: "Effective Dose Reference authority 2007 Recommendations of the International Commission on Radiological Protection (ICRP Publication 103, published as the Annals of the ICRP Vol. 37, No. 2-4, Elsevier, 2007)"
        }
      }
      concept {
        code {
          value: "113842"
        }
        display {
          value: "X-Ray Modulation Type"
        }
        definition {
          value: "The type of exposure modulation used for the purpose of limiting the dose"
        }
      }
      concept {
        code {
          value: "113845"
        }
        display {
          value: "Exposure Index"
        }
        definition {
          value: "Measure of the detector response to radiation in the relevant image region of an image acquired with a digital X-Ray imaging system as defined in IEC 62494-1; see PS3.3 definition of Exposure Index Macro"
        }
      }
      concept {
        code {
          value: "113846"
        }
        display {
          value: "Target Exposure Index"
        }
        definition {
          value: "The target value used to calculate the Deviation Index as defined in IEC 62494-1; see PS3.3 definition of Exposure Index Macro"
        }
      }
      concept {
        code {
          value: "113847"
        }
        display {
          value: "Deviation Index"
        }
        definition {
          value: "A scaled representation of the accuracy of the Exposure Index compared to the Target Exposure Index as defined in IEC 62494-1; see PS3.3 definition of Exposure Index Macro"
        }
      }
      concept {
        code {
          value: "113850"
        }
        display {
          value: "Irradiation Authorizing"
        }
        definition {
          value: "The clinician responsible for determining that the irradiating procedure was appropriate for the indications"
        }
      }
      concept {
        code {
          value: "113851"
        }
        display {
          value: "Irradiation Administering"
        }
        definition {
          value: "The person responsible for the administration of radiation"
        }
      }
      concept {
        code {
          value: "113852"
        }
        display {
          value: "Irradiation Event"
        }
        definition {
          value: "An irradiation event is the loading of X-Ray equipment caused by a single continuous actuation of the equipment\'s irradiation switch, from the start of the loading time of the first pulse until the loading time trailing edge of the final pulse. Any automatic on-off switching of the irradiation source during the event is not treated as separate events, rather the event includes the time between start and stop of irradiation as triggered by the user; e.g. a pulsed fluoro X-Ray acquisition shall be treated as a single irradiation event"
        }
      }
      concept {
        code {
          value: "113853"
        }
        display {
          value: "Irradiation Event UID"
        }
        definition {
          value: "Unique Identifier of an Irradiation Event"
        }
      }
      concept {
        code {
          value: "113854"
        }
        display {
          value: "Source of Dose Information"
        }
        definition {
          value: "Method by which dose-related details of an Irradiation Event were obtained"
        }
      }
      concept {
        code {
          value: "113855"
        }
        display {
          value: "Total Acquisition Time"
        }
        definition {
          value: "Total accumulated acquisition clock time in the scope of the including report (i.e., the sum of the Irradiation Duration values for accumulated acquisition irradiation events)"
        }
      }
      concept {
        code {
          value: "113856"
        }
        display {
          value: "Automated Data Collection"
        }
        definition {
          value: "Direct recording of data by a relevant system"
        }
      }
      concept {
        code {
          value: "113857"
        }
        display {
          value: "Manual Entry"
        }
        definition {
          value: "Recording of data by a human operator, including manual transcription of electronic data"
        }
      }
      concept {
        code {
          value: "113858"
        }
        display {
          value: "MPPS Content"
        }
        definition {
          value: "The data is taken from an MPPS SOP Instance"
        }
      }
      concept {
        code {
          value: "113859"
        }
        display {
          value: "Irradiating Device"
        }
        definition {
          value: "A device exposing a patient to ionizing radiation"
        }
      }
      concept {
        code {
          value: "113860"
        }
        display {
          value: "15cm from Isocenter toward Source"
        }
        definition {
          value: "15cm from the isocenter towards the X-Ray source; See IEC 60601-2-43"
        }
      }
      concept {
        code {
          value: "113861"
        }
        display {
          value: "30cm in Front of Image Input Surface"
        }
        definition {
          value: "30cm in front (towards the tube) of the input surface of the image receptor; See FDA Federal Performance Standard for Diagnostic X-Ray Systems \302\2471020.32(d) (7)"
        }
      }
      concept {
        code {
          value: "113862"
        }
        display {
          value: "1cm above Tabletop"
        }
        definition {
          value: "1cm above the patient tabletop or cradle; See FDA Federal Performance Standard for Diagnostic X-Ray Systems \302\2471020.32(d) (7)"
        }
      }
      concept {
        code {
          value: "113863"
        }
        display {
          value: "30cm above Tabletop"
        }
        definition {
          value: "30cm above the patient tabletop of cradle; See FDA Federal Performance Standard for Diagnostic X-Ray Systems \302\2471020.32(d) (7)"
        }
      }
      concept {
        code {
          value: "113864"
        }
        display {
          value: "15cm from Table Centerline"
        }
        definition {
          value: "15cm from the centerline of the X-Ray table and in the direction of the X-Ray source; See FDA Federal Performance Standard for Diagnostic X-Ray Systems \302\2471020.32(d) (7)"
        }
      }
      concept {
        code {
          value: "113865"
        }
        display {
          value: "Entrance exposure to a 4.2 cm breast thickness"
        }
        definition {
          value: "Standard breast means a 4.2 centimeter (cm) thick compressed breast consisting of 50 percent glandular and 50 percent adipose tissue. See Department of Health and Human Services, Food and Drug Administration. Mammography quality standards; final rule. Federal Register. Oct. 28, 1997; 68(208):55852-55994; see 900.2(uu)"
        }
      }
      concept {
        code {
          value: "113866"
        }
        display {
          value: "Copied From Image Attributes"
        }
        definition {
          value: "The data is copied from information present in the image attributes; e.g. dose attributes such as CTDIvol (0018,9345)"
        }
      }
      concept {
        code {
          value: "113867"
        }
        display {
          value: "Computed From Image Attributes"
        }
        definition {
          value: "The data is computed from information present in the image attributes; e.g. by using dosimetry information for the specific irradiating device make and model, applied to technique information such as KVP and mAs"
        }
      }
      concept {
        code {
          value: "113868"
        }
        display {
          value: "Derived From Human-Readable Reports"
        }
        definition {
          value: "The data is derived from human-readable reports; e.g. by natural language parsing of text reports, or optical character recognition from reports saved as images by the irradiating device"
        }
      }
      concept {
        code {
          value: "113870"
        }
        display {
          value: "Person Name"
        }
        definition {
          value: "The name of a specific person"
        }
      }
      concept {
        code {
          value: "113871"
        }
        display {
          value: "Person ID"
        }
        definition {
          value: "An identification number or code for a specific person"
        }
      }
      concept {
        code {
          value: "113872"
        }
        display {
          value: "Person ID Issuer"
        }
        definition {
          value: "The organization that issued a Person ID"
        }
      }
      concept {
        code {
          value: "113873"
        }
        display {
          value: "Organization Name"
        }
        definition {
          value: "The name of an organization"
        }
      }
      concept {
        code {
          value: "113874"
        }
        display {
          value: "Person Role in Organization"
        }
        definition {
          value: "The role played by a person in an organization"
        }
      }
      concept {
        code {
          value: "113875"
        }
        display {
          value: "Person Role in Procedure"
        }
        definition {
          value: "The role played by a person in a procedure"
        }
      }
      concept {
        code {
          value: "113876"
        }
        display {
          value: "Device Role in Procedure"
        }
        definition {
          value: "The role played by a device in a procedure"
        }
      }
      concept {
        code {
          value: "113877"
        }
        display {
          value: "Device Name"
        }
        definition {
          value: "The name used to refer to a device; usually locally unique"
        }
      }
      concept {
        code {
          value: "113878"
        }
        display {
          value: "Device Manufacturer"
        }
        definition {
          value: "Manufacturer of a device"
        }
      }
      concept {
        code {
          value: "113879"
        }
        display {
          value: "Device Model Name"
        }
        definition {
          value: "Model Name of a device"
        }
      }
      concept {
        code {
          value: "113880"
        }
        display {
          value: "Device Serial Number"
        }
        definition {
          value: "Serial Number of a device"
        }
      }
      concept {
        code {
          value: "113890"
        }
        display {
          value: "All Planes"
        }
        definition {
          value: "All planes of a multi-plane acquisition equipment"
        }
      }
      concept {
        code {
          value: "113893"
        }
        display {
          value: "Length of Reconstructable Volume"
        }
        definition {
          value: "The length from which images may be reconstructed (i.e., excluding any overranging performed in a spiral acquisition that is required for data interpolation). Value is distinct from (1113825, DCM, \"Scanning Length\"), which is the actual length of the table travel during the entire tube loading, according to IEC 60601-2-44, and includes overranging. Also distinct from any actual Reconstructed Volume, which may depend on the slice thickness chosen for a particular reconstruction"
        }
      }
      concept {
        code {
          value: "113895"
        }
        display {
          value: "Top Z Location of Reconstructable Volume"
        }
        definition {
          value: "The Z location that is the top (highest Z value) of the Reconstructable Volume. Specified as the Z component within the Patient Coordinate System defined by a specified Frame of Reference"
        }
      }
      concept {
        code {
          value: "113896"
        }
        display {
          value: "Bottom Z Location of Reconstructable Volume"
        }
        definition {
          value: "The Z location that is the bottom (lowest Z value) of the Reconstructable Volume. Specified as the Z component within the Patient Coordinate System defined by a specified Frame of Reference"
        }
      }
      concept {
        code {
          value: "113897"
        }
        display {
          value: "Top Z Location of Scanning Length"
        }
        definition {
          value: "The Z location that is the top (highest Z value) of the scanning length. Specified as the Z component within the Patient Coordinate System defined by a specified Frame of Reference"
        }
      }
      concept {
        code {
          value: "113898"
        }
        display {
          value: "Bottom Z Location of Scanning Length"
        }
        definition {
          value: "The Z location that is the bottom (lowest Z value) of the scanning length. Specified as the Z component within the Patient Coordinate System defined by a specified Frame of Reference"
        }
      }
      concept {
        code {
          value: "113899"
        }
        display {
          value: "Exposed Range"
        }
        definition {
          value: "The range along the z axis of the total volume irradiated, per IEC 60601-2-44, Ed. 3, 203.115(b). The start and stop of loading corresponding to the outer edge of the full width half maximum of the free-in-air dose profile for the beam collimation used"
        }
      }
      concept {
        code {
          value: "113900"
        }
        display {
          value: "Dose Check Alert Details"
        }
        definition {
          value: "Report section about cumulative dose alerts during an examination"
        }
      }
      concept {
        code {
          value: "113901"
        }
        display {
          value: "DLP Alert Value Configured"
        }
        definition {
          value: "Flag denoting whether a DLP Alert Value was configured"
        }
      }
      concept {
        code {
          value: "113902"
        }
        display {
          value: "CTDIvol Alert Value Configured"
        }
        definition {
          value: "Flag denoting whether a CTDIvol Alert Value was configured"
        }
      }
      concept {
        code {
          value: "113903"
        }
        display {
          value: "DLP Alert Value"
        }
        definition {
          value: "Cumulative Dose Length Product value configured to trigger an alert; see NEMA XR 25-2010 Dose Check Standard"
        }
      }
      concept {
        code {
          value: "113904"
        }
        display {
          value: "CTDIvol Alert Value"
        }
        definition {
          value: "Cumulative CTDIvol value configured to trigger an alert; see NEMA XR 25-2010 Dose Check Standard"
        }
      }
      concept {
        code {
          value: "113905"
        }
        display {
          value: "Accumulated DLP Forward Estimate"
        }
        definition {
          value: "A forward estimate of the accumulated DLP plus the estimated DLP for the next Protocol Element Group; see NEMA XR 25-2010 Dose Check Standard"
        }
      }
      concept {
        code {
          value: "113906"
        }
        display {
          value: "Accumulated CTDIvol Forward Estimate"
        }
        definition {
          value: "A forward estimate at a given location of the accumulated CTDIvol plus the estimated CTDIvol for the next Protocol Element Group; see NEMA XR 25-2010 Dose Check Standard"
        }
      }
      concept {
        code {
          value: "113907"
        }
        display {
          value: "Reason for Proceeding"
        }
        definition {
          value: "Reason provided for proceeding with a procedure that is projected to exceed a configured dose value"
        }
      }
      concept {
        code {
          value: "113908"
        }
        display {
          value: "Dose Check Notification Details"
        }
        definition {
          value: "Report section about dose notifications during a protocol element"
        }
      }
      concept {
        code {
          value: "113909"
        }
        display {
          value: "DLP Notification Value Configured"
        }
        definition {
          value: "Flag denoting whether a DLP Notification Value was configured"
        }
      }
      concept {
        code {
          value: "113910"
        }
        display {
          value: "CTDIvol Notification Value Configured"
        }
        definition {
          value: "Flag denoting whether a CTDIvol Notification Value was configured"
        }
      }
      concept {
        code {
          value: "113911"
        }
        display {
          value: "DLP Notification Value"
        }
        definition {
          value: "Dose Length Product value configured to trigger a notification for a given protocol element"
        }
      }
      concept {
        code {
          value: "113912"
        }
        display {
          value: "CTDIvol Notification Value"
        }
        definition {
          value: "CTDIvol value configured to trigger a notification for a given protocol element"
        }
      }
      concept {
        code {
          value: "113913"
        }
        display {
          value: "DLP Forward Estimate"
        }
        definition {
          value: "A forward estimate of the DLP for the next Protocol Element Group; see NEMA XR 25-2010 Dose Check Standard"
        }
      }
      concept {
        code {
          value: "113914"
        }
        display {
          value: "CTDIvol Forward Estimate"
        }
        definition {
          value: "A forward estimate of the CTDIvol for the next Protocol Element Group; see NEMA XR 25-2010 Dose Check Standard"
        }
      }
      concept {
        code {
          value: "113921"
        }
        display {
          value: "Radiation Exposure"
        }
        definition {
          value: "The amount of ionizing radiation to which the patient was exposed"
        }
      }
      concept {
        code {
          value: "113922"
        }
        display {
          value: "Radioactive Substance Administered"
        }
        definition {
          value: "Type, amount and route of radioactive substance administered"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-replacedby"
          }
          value {
            coding {
              system {
                value: "http://loinc.org"
              }
              code {
                value: "73569-6"
              }
              display {
                value: "Radiation Exposure and Protection Information"
              }
            }
          }
        }
        code {
          value: "113923"
        }
        display {
          value: "Radiation Exposure and Protection Information"
        }
        definition {
          value: "Exposure to ionizing radiation and associated preventive measures used to reduce the exposure of parts of the body like lead apron or eye, thyroid gland or gonad protection"
        }
        property {
          code {
            value: "status"
          }
          value {
            code {
              value: "deprecated"
            }
          }
        }
      }
      concept {
        code {
          value: "113930"
        }
        display {
          value: "Size Specific Dose Estimation"
        }
        definition {
          value: "The Size-Specific Dose Estimate is a patient dose estimate that takes into account the size of the patient, such as described in AAPM Report 204 by using linear dimensions measured on the patient or patient images or estimated from patient age"
        }
      }
      concept {
        code {
          value: "113931"
        }
        display {
          value: "Measured Lateral Dimension"
        }
        definition {
          value: "The side-to-side (left to right) dimension of the body part being scanned (per AAPM Report 204)"
        }
      }
      concept {
        code {
          value: "113932"
        }
        display {
          value: "Measured AP Dimension"
        }
        definition {
          value: "The thickness of the body part being scanned, in the antero-posterior dimension (per AAPM Report 204)"
        }
      }
      concept {
        code {
          value: "113933"
        }
        display {
          value: "Derived Effective Diameter"
        }
        definition {
          value: "The diameter of the patient at a given location along the Z-axis of the patient, assuming that the patient has a circular cross-section (per AAPM Report 204)"
        }
      }
      concept {
        code {
          value: "113934"
        }
        display {
          value: "AAPM 204 Lateral Dimension"
        }
        definition {
          value: "The Size Specific Dose Estimation is computed using Table 1B (32cm phantom) or Table 2B (16cm phantom) of AAPM Report 204"
        }
      }
      concept {
        code {
          value: "113935"
        }
        display {
          value: "AAPM 204 AP Dimension"
        }
        definition {
          value: "The Size Specific Dose Estimation is computed using Table 1C (32cm phantom) or Table 2C (16cm phantom) of AAPM Report 204"
        }
      }
      concept {
        code {
          value: "113936"
        }
        display {
          value: "AAPM 204 Sum of Lateral and AP Dimension"
        }
        definition {
          value: "The Size Specific Dose Estimation is computed using Table 1A (32cm phantom) or Table 2A (16cm phantom) of AAPM Report 204"
        }
      }
      concept {
        code {
          value: "113937"
        }
        display {
          value: "AAPM 204 Effective Diameter Estimated From Patient Age"
        }
        definition {
          value: "The Size Specific Dose Estimation is computed using Table 1D (32cm phantom) or Table 2D (16cm phantom) using an effective diameter estimated from the patient\'s age using Table 3 of AAPM Report 204"
        }
      }
      concept {
        code {
          value: "113940"
        }
        display {
          value: "System Calculated"
        }
        definition {
          value: "Values calculated from other existing parameters"
        }
      }
      concept {
        code {
          value: "113941"
        }
        display {
          value: "In Detector Plane"
        }
        definition {
          value: "A segmented region of the detector surface within the irradiated area (but might not be near the center of the detector)"
        }
      }
      concept {
        code {
          value: "113942"
        }
        display {
          value: "X-Ray Reading Device"
        }
        definition {
          value: "A device that creates digital images from X-Ray detectors (Direct, Indirect or Storage)"
        }
      }
      concept {
        code {
          value: "113943"
        }
        display {
          value: "X-Ray Source Data Available"
        }
        definition {
          value: "Parameters related to the X-Ray source (generator, tube, etc.) are available to the recording application"
        }
      }
      concept {
        code {
          value: "113944"
        }
        display {
          value: "X-Ray Mechanical Data Available"
        }
        definition {
          value: "Parameters related to the X-Ray Mechanical System (Stand, Table) are available to the recording application"
        }
      }
      concept {
        code {
          value: "113945"
        }
        display {
          value: "X-Ray Detector Data Available"
        }
        definition {
          value: "Parameters related to the X-Ray Detector are available to the recording application"
        }
      }
      concept {
        code {
          value: "113946"
        }
        display {
          value: "Projection Eponymous Name"
        }
        definition {
          value: "Describes the radiographic method of patient, tube and detector positioning to achieve a well described projection or view"
        }
      }
      concept {
        code {
          value: "113947"
        }
        display {
          value: "Detector Type"
        }
        definition {
          value: "Type of Detector used to acquire data; e.g. Images"
        }
      }
      concept {
        code {
          value: "113948"
        }
        display {
          value: "Direct Detector"
        }
        definition {
          value: "Detector that directly transforms the input signal to pixel values"
        }
      }
      concept {
        code {
          value: "113949"
        }
        display {
          value: "Indirect Detector"
        }
        definition {
          value: "Detector that transforms an intermediate signal into pixel values; e.g. a scintillator-based detector"
        }
      }
      concept {
        code {
          value: "113950"
        }
        display {
          value: "Storage Detector"
        }
        definition {
          value: "Storage detector that stores a signal that is later transformed by a reader into pixel values; e.g. a phosphor-based detector"
        }
      }
      concept {
        code {
          value: "113951"
        }
        display {
          value: "Film"
        }
        definition {
          value: "Film that is scanned to create pixel values"
        }
      }
      concept {
        code {
          value: "113952"
        }
        display {
          value: "Table Mount"
        }
        definition {
          value: "The cassette/detector is mounted in the patient table"
        }
      }
      concept {
        code {
          value: "113953"
        }
        display {
          value: "Unmounted Detector"
        }
        definition {
          value: "The cassette/detector is not mounted.; e.g. a cassette placed underneath the patient"
        }
      }
      concept {
        code {
          value: "113954"
        }
        display {
          value: "Upright Stand Mount"
        }
        definition {
          value: "The cassette/detector is mounted in an upright stand"
        }
      }
      concept {
        code {
          value: "113955"
        }
        display {
          value: "C-Arm Mount"
        }
        definition {
          value: "The cassette/detector is mounted on a c-arm"
        }
      }
      concept {
        code {
          value: "113956"
        }
        display {
          value: "CR/DR Mechanical Configuration"
        }
        definition {
          value: "Method of mounting or positioning a CR/DR cassette or detector"
        }
      }
      concept {
        code {
          value: "113957"
        }
        display {
          value: "Fluoroscopy-Guided Projection Radiography System"
        }
        definition {
          value: "An integrated projection radiography system capable of fluoroscopy"
        }
      }
      concept {
        code {
          value: "113958"
        }
        display {
          value: "Integrated Projection Radiography System"
        }
        definition {
          value: "A projection radiography system where the X-Ray detector, X-Ray Source and gantry components are integrated and the managing system is able to access details of each component"
        }
      }
      concept {
        code {
          value: "113959"
        }
        display {
          value: "Cassette-based Projection Radiography System"
        }
        definition {
          value: "A projection radiography system where the X-Ray detector, X-Ray Source and gantry components are not integrated; e.g. cassette-based CR and DR systems"
        }
      }
      concept {
        code {
          value: "113961"
        }
        display {
          value: "Reconstruction Algorithm"
        }
        definition {
          value: "Description of the algorithm used when reconstructing the image from the data acquired during the acquisition process"
        }
      }
      concept {
        code {
          value: "113962"
        }
        display {
          value: "Filtered Back Projection"
        }
        definition {
          value: "An algorithm for reconstructing an image from multiple projections by back-projecting the measured values along the line of the projection and filtering the result to reduce blurring"
        }
      }
      concept {
        code {
          value: "113963"
        }
        display {
          value: "Iterative Reconstruction"
        }
        definition {
          value: "An algorithm for reconstructing an image from multiple projections by starting with an assumed reconstructed image, computing projections from the image, comparing the original projection data and updating the reconstructed image based upon the difference between the calculated and the actual projections"
        }
      }
      concept {
        code {
          value: "113970"
        }
        display {
          value: "Procedure Step To This Point"
        }
        definition {
          value: "The period of time from the start of a Procedure Step until the time point established by the context of the reference"
        }
      }
      concept {
        code {
          value: "114000"
        }
        display {
          value: "Not a number"
        }
        definition {
          value: "Measurement not available: Not a number (per IEEE 754)"
        }
      }
      concept {
        code {
          value: "114001"
        }
        display {
          value: "Negative Infinity"
        }
        definition {
          value: "Measurement not available: Negative Infinity (per IEEE 754)"
        }
      }
      concept {
        code {
          value: "114002"
        }
        display {
          value: "Positive Infinity"
        }
        definition {
          value: "Measurement not available: Positive Infinity (per IEEE 754)"
        }
      }
      concept {
        code {
          value: "114003"
        }
        display {
          value: "Divide by zero"
        }
        definition {
          value: "Measurement not available: Divide by zero (per IEEE 754)"
        }
      }
      concept {
        code {
          value: "114004"
        }
        display {
          value: "Underflow"
        }
        definition {
          value: "Measurement not available: Underflow (per IEEE 754)"
        }
      }
      concept {
        code {
          value: "114005"
        }
        display {
          value: "Overflow"
        }
        definition {
          value: "Measurement not available: Overflow (per IEEE 754)"
        }
      }
      concept {
        code {
          value: "114006"
        }
        display {
          value: "Measurement failure"
        }
        definition {
          value: "Measurement not available: Measurement failure"
        }
      }
      concept {
        code {
          value: "114007"
        }
        display {
          value: "Measurement not attempted"
        }
        definition {
          value: "Measurement not available: Measurement not attempted"
        }
      }
      concept {
        code {
          value: "114008"
        }
        display {
          value: "Calculation failure"
        }
        definition {
          value: "Measurement not available: Calculation failure"
        }
      }
      concept {
        code {
          value: "114009"
        }
        display {
          value: "Value out of range"
        }
        definition {
          value: "Measurement not available: Value out of range"
        }
      }
      concept {
        code {
          value: "114010"
        }
        display {
          value: "Value unknown"
        }
        definition {
          value: "Measurement not available: Value unknown"
        }
      }
      concept {
        code {
          value: "114011"
        }
        display {
          value: "Value indeterminate"
        }
        definition {
          value: "Measurement not available: Value indeterminate"
        }
      }
      concept {
        code {
          value: "114201"
        }
        display {
          value: "Time of flight"
        }
        definition {
          value: "Measures the time-of-flight of a light signal between the camera and the subject for each point of the image"
        }
      }
      concept {
        code {
          value: "114202"
        }
        display {
          value: "Interferometry"
        }
        definition {
          value: "Interferometry is a family of techniques in which waves are superimposed in order to extract depth information about the scanned object"
        }
      }
      concept {
        code {
          value: "114203"
        }
        display {
          value: "Laser scanning"
        }
        definition {
          value: "Laser scanning describes the general method to sample or scan a surface using laser technology"
        }
      }
      concept {
        code {
          value: "114204"
        }
        display {
          value: "Pattern projection"
        }
        definition {
          value: "Projecting a narrow band of light onto a three-dimensionally shaped surface produces a line of illumination that appears distorted from other perspectives than that of the projector. It can be used for an exact geometric reconstruction of the surface shape"
        }
      }
      concept {
        code {
          value: "114205"
        }
        display {
          value: "Shape from shading"
        }
        definition {
          value: "A technique for estimating the surface normal of an object by observing that object under different lighting conditions"
        }
      }
      concept {
        code {
          value: "114206"
        }
        display {
          value: "Shape from motion"
        }
        definition {
          value: "A technique for estimating the surface normal of an object by observing that object under different motions"
        }
      }
      concept {
        code {
          value: "114207"
        }
        display {
          value: "Confocal imaging"
        }
        definition {
          value: "An optical imaging technique used to increase optical resolution and contrast of a micrograph by using point illumination and a spatial pinhole to eliminate out-of-focus light in specimens that are thicker than the focal plane. It enables the reconstruction of 3D structures from the obtained images"
        }
      }
      concept {
        code {
          value: "114208"
        }
        display {
          value: "Point Cloud Algorithmic"
        }
        definition {
          value: "Point cloud that was calculated by an algorithm"
        }
      }
      concept {
        code {
          value: "114209"
        }
        display {
          value: "Turntable Scan Method"
        }
        definition {
          value: "Scanning the object from different views by placing it on a rotating table"
        }
      }
      concept {
        code {
          value: "114210"
        }
        display {
          value: "High resolution"
        }
        definition {
          value: "Higher resolution with a longer acquisition time"
        }
      }
      concept {
        code {
          value: "114211"
        }
        display {
          value: "Fast mode"
        }
        definition {
          value: "Lower resolution with a shorter acquisition time"
        }
      }
      concept {
        code {
          value: "114213"
        }
        display {
          value: "Iterative Closest Point"
        }
        definition {
          value: "An algorithm employed to minimize the difference between two clouds of points. It iteratively revises the transformation (translation, rotation) needed to minimize the distance between the points of two point clouds"
        }
      }
      concept {
        code {
          value: "114215"
        }
        display {
          value: "Freehand"
        }
        definition {
          value: "Human controlled minimization of the distance between the points of two point clouds"
        }
      }
      concept {
        code {
          value: "114216"
        }
        display {
          value: "Checkerboard"
        }
        definition {
          value: "Scanning the object from different views by placing it in front of a checkerboard pattern"
        }
      }
      concept {
        code {
          value: "121001"
        }
        display {
          value: "Quotation Mode"
        }
        definition {
          value: "Type of source for observations quoted from an external source"
        }
      }
      concept {
        code {
          value: "121002"
        }
        display {
          value: "Quoted Source"
        }
        definition {
          value: "Reference to external source of quoted observations"
        }
      }
      concept {
        code {
          value: "121003"
        }
        display {
          value: "Document"
        }
        definition {
          value: "Documentary source of quoted observations"
        }
      }
      concept {
        code {
          value: "121004"
        }
        display {
          value: "Verbal"
        }
        definition {
          value: "Verbal source of quoted observations"
        }
      }
      concept {
        code {
          value: "121005"
        }
        display {
          value: "Observer Type"
        }
        definition {
          value: "Type of observer that created the observations"
        }
      }
      concept {
        code {
          value: "121006"
        }
        display {
          value: "Person"
        }
        definition {
          value: "Human observer created the observations"
        }
      }
      concept {
        code {
          value: "121007"
        }
        display {
          value: "Device"
        }
        definition {
          value: "Automated device created the observations"
        }
      }
      concept {
        code {
          value: "121008"
        }
        display {
          value: "Person Observer Name"
        }
        definition {
          value: "Name of human observer that created the observations"
        }
      }
      concept {
        code {
          value: "121009"
        }
        display {
          value: "Person Observer\'s Organization Name"
        }
        definition {
          value: "Organization or institution with which the human observer is affiliated for the context of the current observation"
        }
      }
      concept {
        code {
          value: "121010"
        }
        display {
          value: "Person Observer\'s Role in the Organization"
        }
        definition {
          value: "Organizational role of human observer for the context of the current observation"
        }
      }
      concept {
        code {
          value: "121011"
        }
        display {
          value: "Person Observer\'s Role in this Procedure"
        }
        definition {
          value: "Procedural role of human observer for the context of the current observation"
        }
      }
      concept {
        code {
          value: "121012"
        }
        display {
          value: "Device Observer UID"
        }
