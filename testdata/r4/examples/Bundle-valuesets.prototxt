      concept {
        code {
          value: "111760"
        }
        display {
          value: "Haigis"
        }
        definition {
          value: "The Haigis IOL calculation formula. Haigis W, Lege B, Miller N, Schneider B. Comparison of immersion ultrasound biometry and partial coherence interferometry for intraocular lens calculation according to Haigis. Graefes Arch Clin Exp Ophthalmol 2000;238:765-73"
        }
      }
      concept {
        code {
          value: "111761"
        }
        display {
          value: "Haigis-L"
        }
        definition {
          value: "The Haigis-L IOL calculation formula. Haigis W. Intraocular lens calculation after refractive surgery for myopia: Haigis-L formula. J Cataract Refract Surg. 2008 Oct;34(10):1658-63"
        }
      }
      concept {
        code {
          value: "111762"
        }
        display {
          value: "Holladay 1"
        }
        definition {
          value: "The Holladay 1 IOL calculation formula. Holladay JT, Prager TC, Chandler TY, Musgrove KH, Lewis JW, Ruiz RS. A three-part system for refining intraocular lens power calculations. J Cataract Refract Surg. 1988; 14:17-24"
        }
      }
      concept {
        code {
          value: "111763"
        }
        display {
          value: "Holladay 2"
        }
        definition {
          value: "The Holladay 2 IOL calculation formula"
        }
      }
      concept {
        code {
          value: "111764"
        }
        display {
          value: "Hoffer Q"
        }
        definition {
          value: "The Hoffer Q IOL calculation formula. Hoffer KJ. The Hoffer Q formula: a comparison of theoretic and regression formulas. J Cataract Refract Surg 1993;19:700-12. Errata. J Cataract Refract Surg 1994;20:677 and 2007;33:2-3"
        }
      }
      concept {
        code {
          value: "111765"
        }
        display {
          value: "Olsen"
        }
        definition {
          value: "The Olsen IOL calculation formula. Olsen T. Calculation of intraocular lens power: a review. Acta Ophthalmol. Scand. 2007: 85: 472-485"
        }
      }
      concept {
        code {
          value: "111766"
        }
        display {
          value: "SRKII"
        }
        definition {
          value: "The SRKII IOL calculation formula. Sanders DR, Retzlaff J, Kraff MC. Comparison of the SRK II formula and other second generation formulas. J Cataract Refract Surg. 1988 Mar;14(2):136-41"
        }
      }
      concept {
        code {
          value: "111767"
        }
        display {
          value: "SRK-T"
        }
        definition {
          value: "The SRK-T IOL calculation formula. Retzlaff JA, Sanders DR, Kraff MC. Development of the SRK/T intraocular lens implant power calculation formula. J Cataract Refract Surg 1990;16:333-40. Erratum 1990;16:528"
        }
      }
      concept {
        code {
          value: "111768"
        }
        display {
          value: "ACD Constant"
        }
        definition {
          value: "The \"ACD Constant\" used in IOL calculation"
        }
      }
      concept {
        code {
          value: "111769"
        }
        display {
          value: "Haigis a0"
        }
        definition {
          value: "The \"Haigis a0\" constant used in IOL calculation"
        }
      }
      concept {
        code {
          value: "111770"
        }
        display {
          value: "Haigis a1"
        }
        definition {
          value: "The \"Haigis a1\" constant used in IOL calculation"
        }
      }
      concept {
        code {
          value: "111771"
        }
        display {
          value: "Haigis a2"
        }
        definition {
          value: "The \"Haigis a2\" constant used in IOL calculation"
        }
      }
      concept {
        code {
          value: "111772"
        }
        display {
          value: "Hoffer pACD Constant"
        }
        definition {
          value: "The \"Hoffer pACD Constant\" used in IOL calculation"
        }
      }
      concept {
        code {
          value: "111773"
        }
        display {
          value: "Surgeon Factor"
        }
        definition {
          value: "The \"Surgeon Factor\" constant used in IOL calculation"
        }
      }
      concept {
        code {
          value: "111776"
        }
        display {
          value: "Front Of Cornea To Front Of Lens"
        }
        definition {
          value: "Anterior chamber depth defined as the front of the cornea to the front of the lens"
        }
      }
      concept {
        code {
          value: "111777"
        }
        display {
          value: "Back Of Cornea To Front Of Lens"
        }
        definition {
          value: "Anterior chamber depth defined as the back of the cornea to the front of the lens"
        }
      }
      concept {
        code {
          value: "111778"
        }
        display {
          value: "Single or Anterior Lens"
        }
        definition {
          value: "Refers to the anterior lens when there are two lenses in the eye. The distance, in mm, from the anterior surface of the lens to the posterior surface of the lens"
        }
      }
      concept {
        code {
          value: "111779"
        }
        display {
          value: "Posterior Lens"
        }
        definition {
          value: "Refers to the posterior lens when there are two lenses in the eye. The distance, in mm, from the anterior surface of the lens to the posterior surface of the lens"
        }
      }
      concept {
        code {
          value: "111780"
        }
        display {
          value: "Measurement From This Device"
        }
        definition {
          value: "Value obtained from measurements taken by the device creating this SOP Instance"
        }
      }
      concept {
        code {
          value: "111781"
        }
        display {
          value: "External Data Source"
        }
        definition {
          value: "Value obtained by data transfer from an external source - not from measurements taken by the device providing the value"
        }
      }
      concept {
        code {
          value: "111782"
        }
        display {
          value: "Axial Measurements SOP Instance"
        }
        definition {
          value: "Axial Measurements DICOM SOP Instance"
        }
      }
      concept {
        code {
          value: "111783"
        }
        display {
          value: "Refractive Measurements SOP Instance"
        }
        definition {
          value: "Refractive Measurements DICOM SOP Instance"
        }
      }
      concept {
        code {
          value: "111786"
        }
        display {
          value: "Standard Deviation of measurements used"
        }
        definition {
          value: "Standard Deviation is a simple measure of the variability of a data set"
        }
      }
      concept {
        code {
          value: "111787"
        }
        display {
          value: "Signal to Noise Ratio"
        }
        definition {
          value: "Signal to Noise Ratio of the data samples taken to create a measurement"
        }
      }
      concept {
        code {
          value: "111791"
        }
        display {
          value: "Spherical projection"
        }
        definition {
          value: "Projection from 2D image pixels to 3D Cartesian coordinates based on a spherical mathematical model"
        }
      }
      concept {
        code {
          value: "111792"
        }
        display {
          value: "Surface contour mapping"
        }
        definition {
          value: "Mapping from 2D image pixels to 3D Cartesian coordinates based on measurements of the retinal surface; e.g. of the retina, derived via a measurement technology such as Optical Coherence Tomography, Ultrasound etc."
        }
      }
      concept {
        code {
          value: "111800"
        }
        display {
          value: "Visual Field 24-2 Test Pattern"
        }
        definition {
          value: "Test pattern, nominally covering an area within 24\302\260 of fixation. Consists of 54 test points a minimum of 3\302\260 from each meridian and placed 6\302\260 apart. The \"-2\" distinguishes this from another 24\302\260 pattern (no longer supported)"
        }
      }
      concept {
        code {
          value: "111801"
        }
        display {
          value: "Visual Field 10-2 Test Pattern"
        }
        definition {
          value: "Test pattern, nominally covering an area within 10\302\260 of fixation. Consists of 68 test points a minimum of 1\302\260 from each meridian and placed 2\302\260 apart. The \"-2\" in this case indicates its point layout to be similar to the 30-2 and 24-2"
        }
      }
      concept {
        code {
          value: "111802"
        }
        display {
          value: "Visual Field 30-2 Test Pattern"
        }
        definition {
          value: "Test pattern consisting of test point locations within 30\302\260 of fixation. Consists of 76 test points a minimum of 3\302\260 from each meridian and placed 6\302\260 apart. The \"-2\" distinguishes this from another 30\302\260 pattern (no longer supported)"
        }
      }
      concept {
        code {
          value: "111803"
        }
        display {
          value: "Visual Field 60-4 Test Pattern"
        }
        definition {
          value: "Test pattern consisting of 60 test point locations between 30\302\260 and 60\302\260 of fixation a minimum of 6\302\260 from each meridian and placed 12\302\260 apart. The \"-4\" distinguishes this from a similar 60\302\260 pattern having 4 additional points"
        }
      }
      concept {
        code {
          value: "111804"
        }
        display {
          value: "Visual Field Macula Test Pattern"
        }
        definition {
          value: "Test pattern consisting of 16 test point locations within 10\302\260 of fixation a minimum of 1\302\260 from each meridian and placed 2\302\260 apart"
        }
      }
      concept {
        code {
          value: "111805"
        }
        display {
          value: "Visual Field Central 40 Point Test Pattern"
        }
        definition {
          value: "Test pattern consisting of 40 test point locations within 30\302\260 of fixation that spread out radially from fixation"
        }
      }
      concept {
        code {
          value: "111806"
        }
        display {
          value: "Visual Field Central 76 Point Test Pattern"
        }
        definition {
          value: "Test pattern consisting of 76 test point locations within 30\302\260 of fixation a minimum of 3\302\260 from each meridian and placed 6\302\260 apart"
        }
      }
      concept {
        code {
          value: "111807"
        }
        display {
          value: "Visual Field Peripheral 60 Point Test Pattern"
        }
        definition {
          value: "Test pattern consisting of 60 test point locations between 30\302\260 and 60\302\260 of fixation a minimum of 6\302\260 from each meridian and placed 12\302\260 apart"
        }
      }
      concept {
        code {
          value: "111808"
        }
        display {
          value: "Visual Field Full Field 81 Point Test Pattern"
        }
        definition {
          value: "Test pattern consisting of 81 test point locations within 60\302\260 of fixation that spread out radially from fixation"
        }
      }
      concept {
        code {
          value: "111809"
        }
        display {
          value: "Visual Field Full Field 120 Point Test Pattern"
        }
        definition {
          value: "Test pattern consisting of 120 test point locations within 60\302\260 of fixation that spread out radially from fixation, concentrated in the nasal hemisphere"
        }
      }
      concept {
        code {
          value: "111810"
        }
        display {
          value: "Visual Field G Test Pattern"
        }
        definition {
          value: "Test pattern for Glaucoma and general visual field assessment with 59 test locations of which 16 test locations are in the macular area (up to 10\302\260 eccentricity) and where the density of test location is reduced with eccentricity. The test can be extended with the inclusion of 14 test locations between 30\302\260 and 60\302\260 eccentricity, 6 of which are located at the nasal step"
        }
      }
      concept {
        code {
          value: "111811"
        }
        display {
          value: "Visual Field M Test Pattern"
        }
        definition {
          value: "Test pattern for the macular area. Orthogonal test pattern with 0.7\302\260 spacing within the central 4\302\260 of eccentricity and reduced density of test locations between 4 and 10, 5\302\260 of eccentricity. 81 test locations over all. The test can be extended to include the test locations of the Visual Field G Test Pattern between 10, 5\302\260 and 60\302\260"
        }
      }
      concept {
        code {
          value: "111812"
        }
        display {
          value: "Visual Field 07 Test Pattern"
        }
        definition {
          value: "Full field test pattern with 48 test locations from 0-30\302\260 and 82 test locations from 30-70\302\260. Reduced test point density with increased eccentricity. Can be combined with screening and threshold strategies"
        }
      }
      concept {
        code {
          value: "111813"
        }
        display {
          value: "Visual Field LVC Test Pattern"
        }
        definition {
          value: "Low Vision Central. Orthogonal off-center test pattern with 6\302\260 spacing. 75 test locations within the central 30\302\260. Corresponds with the 32/30-2 excluding the 2 locations at the blind spot, including a macular test location. The LVC is linked with a staircase threshold strategy starting at 0 dB intensity and applies stimulus area V"
        }
      }
      concept {
        code {
          value: "111814"
        }
        display {
          value: "Visual Field Central Test Pattern"
        }
        definition {
          value: "General test corresponding to the 30-2 but excluding the 2 test locations in the blind spot area, hence with 74 instead of 76 test locations"
        }
      }
      concept {
        code {
          value: "111815"
        }
        display {
          value: "Visual Field SITA-Standard Test Strategy"
        }
        definition {
          value: "Swedish Interactive Thresholding Algorithm (SITA). Strategy gains testing efficiency through use of visual field and information theory models. In: Bengtsson B, Olsson J, Heijl A, Rootzen H. A new generation of algorithms for computerized threshold perimetry, SITA. Acta Ophthalmologica Scandinavica, 1997, 75: 368-375"
        }
      }
      concept {
        code {
          value: "111816"
        }
        display {
          value: "Visual Field SITA-SWAP Test Strategy"
        }
        definition {
          value: "Adaptation of SITA testing methods to Blue-Yellow testing"
        }
      }
      concept {
        code {
          value: "111817"
        }
        display {
          value: "Visual Field SITA-Fast Test Strategy"
        }
        definition {
          value: "Similar to SITA-Standard but with less strict criteria for closing test points. Intended for patients who must be tested in the shortest possible time. In: Bengtsson B, Hejl A. SITA Fast, a new rapid perimetric threshold test. Description of methods and evaluation in patients with manifest and suspect glaucoma. Acta Ophthalmologica Scandinavica, 1998, 76: 431-437"
        }
      }
      concept {
        code {
          value: "111818"
        }
        display {
          value: "Visual Field Full Threshold Test Strategy"
        }
        definition {
          value: "Threshold test algorithm that determines a patient\'s sensitivity at each test point in the threshold test pattern by adjusting intensity by 4 dB steps until the patient changes their response, and then adjusts the intensity in the opposite direction by 2 dB steps until the patient changes their response again. The last stimulus seen by the patient is recognized as the threshold for that point. The starting values are determined by first thresholding a \"primary\" point in each quadrant then using the results of each primary point to determine the starting values for neighboring points"
        }
      }
      concept {
        code {
          value: "111819"
        }
        display {
          value: "Visual Field FastPac Test Strategy"
        }
        definition {
          value: "Similar to the Full Threshold algorithm except that it steps by 3 dB and only crosses the threshold only once. In: Flanagan JG, Wild JM, Trope GE. Evaluation of FASTPAC, a new strategy for threshold estimation with the Humphrey Field Analyzer, in a glaucomatous population. Ophthalmology, 1993, 100: 949-954"
        }
      }
      concept {
        code {
          value: "111820"
        }
        display {
          value: "Visual Field Full From Prior Test Strategy"
        }
        definition {
          value: "Identical to Full Threshold except that starting values are determined by the results of a previous test performed using the same test pattern and the Full Threshold test strategy"
        }
      }
      concept {
        code {
          value: "111821"
        }
        display {
          value: "Visual Field Optima Test Strategy"
        }
        definition {
          value: "Similar to FastPac except that the steps are pseudo-dynamic (differ based on the intensity of the last presentation)"
        }
      }
      concept {
        code {
          value: "111822"
        }
        display {
          value: "Visual Field Two-Zone Test Strategy"
        }
        definition {
          value: "Suprathreshold testing strategy, in which each point is initially tested using stimulus that is 6 dB brighter than the expected hill of vision. If the patient does not respond, the stimulus is presented a second time at the same brightness. If the patient sees either presentation, the point is marked as \"seen\"; otherwise it is marked as \"not seen\""
        }
      }
      concept {
        code {
          value: "111823"
        }
        display {
          value: "Visual Field Three-Zone Test Strategy"
        }
        definition {
          value: "An extension of the two-zone strategy in which test points where the second stimulus is not seen are presented with a third stimulus at maximum brightness"
        }
      }
      concept {
        code {
          value: "111824"
        }
        display {
          value: "Visual Field Quantify-Defects Test Strategy"
        }
        definition {
          value: "An extension of the two-zone strategy, in which test points where the second stimulus is not seen receive threshold testing to quantify the depth of any detected scotomas"
        }
      }
      concept {
        code {
          value: "111825"
        }
        display {
          value: "Visual Field TOP Test Strategy"
        }
        definition {
          value: "Tendency Oriented Perimetry. Fast thresholding algorithm. Test strategy makes use of the interaction between neighboring test locations to reduce the test time compared to normal full threshold strategy by 60-80%. In: Morales J, Weitzman ML, Gonzalez de la Rosa M. Comparison between Tendency-Oriented Perimetry (TOP) and octopus threshold perimetry. Ophthalmology, 2000, 107: 134-142"
        }
      }
      concept {
        code {
          value: "111826"
        }
        display {
          value: "Visual Field Dynamic Test Strategy"
        }
        definition {
          value: "Dynamic strategy is a fast thresholding strategy reducing test duration by adapting the dB step sizes according to the frequency-of-seeing curve of the threshold. Reduction of test time compared to normal full threshold strategy 30-50%"
        }
      }
      concept {
        code {
          value: "111827"
        }
        display {
          value: "Visual Field Normal Test Strategy"
        }
        definition {
          value: "Traditional full threshold staircase strategy. Initial intensities are presented, based on anchor point sensitivities in each quadrant and based on already known neighboring sensitivities. In a first run, thresholds are changed in 4dB steps until the first response reversal. Then the threshold is changed in 2 dB steps until the second response reversal. The threshold is calculated as the average between the last seen and last not-seen stimulus, supposed to correspond with the 50% point in the frequency-of-seeing curve"
        }
      }
      concept {
        code {
          value: "111828"
        }
        display {
          value: "Visual Field 1-LT Test Strategy"
        }
        definition {
          value: "One level screening test: Each test location is tested with a single intensity. The result is shown as seen or not-seen. The intensity can either be a 0 dB stimulus or a predefined intensity"
        }
      }
      concept {
        code {
          value: "111829"
        }
        display {
          value: "Visual Field 2-LT Test Strategy"
        }
        definition {
          value: "Two level screening test: Each test location is initially tested 6 dB brighter than the age corrected normal value"
        }
      }
      concept {
        code {
          value: "111830"
        }
        display {
          value: "Visual Field LVS Test Strategy"
        }
        definition {
          value: "Low Vision Strategy is a full threshold normal strategy with the exception that it starts at 0 dB intensity and applies stimulus area V"
        }
      }
      concept {
        code {
          value: "111831"
        }
        display {
          value: "Visual Field GATE Test Strategy"
        }
        definition {
          value: "German Adaptive Threshold Estimation is a fast strategy based on a modified 4-2 staircase algorithm, using prior visual fields to calculate the starting intensity. In: Chiefer U, Pascual JP, Edmunds B, Feudner E, Hoffmann EM, Johnson CA, Lagreze WA, Pfeiffer N, Sample PA, Staubach F, Weleber RG, Vonthein R, Krapp E, Paetzold J. Comparison of the new perimetric GATE strategy with conventional full-threshold and SITA standard strategies. Investigative Ophthalmology and Visual Science, 2009, 51: 488-494"
        }
      }
      concept {
        code {
          value: "111832"
        }
        display {
          value: "Visual Field GATEi Test Strategy"
        }
        definition {
          value: "Similar to GATE. The i stands for initial. If there was no prior visual field test to calculate the starting values, an anchor point method is used to define the local start values"
        }
      }
      concept {
        code {
          value: "111833"
        }
        display {
          value: "Visual Field 2LT-Dynamic Test Strategy"
        }
        definition {
          value: "A test started as two level screening test. In the course of the test, the threshold of relative defects and/or normal test locations has been quantified using the dynamic threshold strategy"
        }
      }
      concept {
        code {
          value: "111834"
        }
        display {
          value: "Visual Field 2LT-Normal Test Strategy"
        }
        definition {
          value: "A test started as two level screening test. In the course of the test, the threshold of relative defects and/or normal test locations has been quantified using the normal full threshold strategy"
        }
      }
      concept {
        code {
          value: "111835"
        }
        display {
          value: "Visual Field Fast Threshold Test Strategy"
        }
        definition {
          value: "Takes neighborhood test point results into account and offers stimuli with an adapted value to save time"
        }
      }
      concept {
        code {
          value: "111836"
        }
        display {
          value: "Visual Field CLIP Test Strategy"
        }
        definition {
          value: "Continuous Luminance Incremental Perimetry, which measures at first the individual reaction time of the patient and threshold values in every quadrant. The starting value for the main test is slightly below in individual threshold"
        }
      }
      concept {
        code {
          value: "111837"
        }
        display {
          value: "Visual Field CLASS Strategy"
        }
        definition {
          value: "A supra threshold screening strategy. The starting stimuli intensities depend on the classification of the patient\'s visual hill by measuring the central (fovea) or peripheral (15\302\260 meridian) threshold. The result of each dot slightly underestimates the sensitivity value (within 5 dB)"
        }
      }
      concept {
        code {
          value: "111838"
        }
        display {
          value: "Age corrected"
        }
        definition {
          value: "Mode for determining the starting luminance for screening test points - the starting luminance s is chosen based on the age of the patient"
        }
      }
      concept {
        code {
          value: "111839"
        }
        display {
          value: "Threshold related"
        }
        definition {
          value: "Mode for determining the starting luminance for screening test points - the starting luminance is chosen based on the results of thresholding a set of \"primary\" test points (one in each quadrant)"
        }
      }
      concept {
        code {
          value: "111840"
        }
        display {
          value: "Single luminance"
        }
        definition {
          value: "Mode for determining the starting luminance for screening test points - in this case, all starting luminance is set to the same value"
        }
      }
      concept {
        code {
          value: "111841"
        }
        display {
          value: "Foveal sensitivity related"
        }
        definition {
          value: "Mode for determining the starting luminance for screening test points - the starting luminance is chosen based on the result of the foveal threshold value"
        }
      }
      concept {
        code {
          value: "111842"
        }
        display {
          value: "Related to non macular sensitivity"
        }
        definition {
          value: "Mode for determining the starting luminance for screening test points - the starting luminance is chosen based on the result of four threshold values measured near the 15\302\260 meridian (one in each quadrant)"
        }
      }
      concept {
        code {
          value: "111843"
        }
        display {
          value: "Automated Optical"
        }
        definition {
          value: "Real time evaluation of the camera image to recognize blinks and fixation losses with influence on the test procedure. Blinks that interfere with stimuli presentation cause the automated repetition of such stimulus presentations. Fixation losses can be used to delay the stimulus presentation until correct fixation is regained"
        }
      }
      concept {
        code {
          value: "111844"
        }
        display {
          value: "Blind Spot Monitoring"
        }
        definition {
          value: "A method of monitoring the patient\'s fixation by periodically presenting stimulus in a location on the background surface that corresponds to the patient\'s blind spot"
        }
      }
      concept {
        code {
          value: "111845"
        }
        display {
          value: "Macular Fixation Testing"
        }
        definition {
          value: "A method of monitoring the patient\'s fixation by presenting the stimulus to the patient\'s macula"
        }
      }
      concept {
        code {
          value: "111846"
        }
        display {
          value: "Observation by Examiner"
        }
        definition {
          value: "A method of monitoring the patient\'s fixation by observation from the examiner of the patient"
        }
      }
      concept {
        code {
          value: "111847"
        }
        display {
          value: "Outside normal limits"
        }
        definition {
          value: "Analysis Results are outside normal limits"
        }
      }
      concept {
        code {
          value: "111848"
        }
        display {
          value: "Borderline"
        }
        definition {
          value: "Analysis Results are borderline"
        }
      }
      concept {
        code {
          value: "111849"
        }
        display {
          value: "Abnormally high sensitivity"
        }
        definition {
          value: "Analysis Results identify abnormally high sensitivity"
        }
      }
      concept {
        code {
          value: "111850"
        }
        display {
          value: "General reduction in sensitivity"
        }
        definition {
          value: "Analysis Results identify general reduction in sensitivity"
        }
      }
      concept {
        code {
          value: "111851"
        }
        display {
          value: "Borderline and general reduction in sensitivity"
        }
        definition {
          value: "Analysis Results identify Borderline and general reduction in sensitivity"
        }
      }
      concept {
        code {
          value: "111852"
        }
        display {
          value: "Visual Field Index"
        }
        definition {
          value: "Index of a patient\'s remaining visual field normalized for both age and generalized defect"
        }
      }
      concept {
        code {
          value: "111853"
        }
        display {
          value: "Visual Field Loss Due to Diffuse Defect"
        }
        definition {
          value: "Estimate of the portion of a patient\'s visual field loss that is diffuse (i.e., spread evenly across all portions of the visual field)"
        }
      }
      concept {
        code {
          value: "111854"
        }
        display {
          value: "Visual Field Loss Due to Local Defect"
        }
        definition {
          value: "Estimate of the portion of a patient\'s visual field loss that is local (i.e., not spread evenly across all portions of the visual field)"
        }
      }
      concept {
        code {
          value: "111855"
        }
        display {
          value: "Glaucoma Hemifield Test Analysis"
        }
        definition {
          value: "An analysis of asymmetry between zones of the superior and inferior visual field. It is designed to be specific for defects due to glaucoma"
        }
      }
      concept {
        code {
          value: "111856"
        }
        display {
          value: "Optical Fixation Measurements"
        }
        definition {
          value: "The data output of an optical fixation monitoring process, consisting of a list of positive and negative numbers indicating the quality of patient fixation over the course of a visual field test. The value 0 represents the initial fixation. Negative numbers indicate a measuring error (i.e., the patient blinked). Positive numbers quantify the degree of eccentricity from initial fixation"
        }
      }
      concept {
        code {
          value: "111900"
        }
        display {
          value: "Macula centered"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend that is centered on the macula; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111901"
        }
        display {
          value: "Disc centered"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend that is centered on the optic disc; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111902"
        }
        display {
          value: "Lesion centered"
        }
        definition {
          value: "An image of any angular subtend that is centered on a lesion located in any region of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111903"
        }
        display {
          value: "Disc-macula centered"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend centered midway between the disc and macula and containing at least a portion of the disc and both the disc and the macula; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111904"
        }
        display {
          value: "Mid-peripheral-superior"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator, and spanning both the superior-temporal and superior-nasal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111905"
        }
        display {
          value: "Mid-peripheral-superior temporal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator in the superior-temporal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111906"
        }
        display {
          value: "Mid-peripheral-temporal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator, and spanning both the superior-temporal and inferior-temporal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111907"
        }
        display {
          value: "Mid-peripheral-inferior temporal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator in the inferior-temporal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111908"
        }
        display {
          value: "Mid-peripheral-inferior"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator, and spanning both the inferior-temporal and inferior-nasal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111909"
        }
        display {
          value: "Mid-peripheral-inferior nasal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator in the inferior-nasal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111910"
        }
        display {
          value: "Mid-peripheral-nasal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator, and spanning both the superior-nasal and inferior-nasal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111911"
        }
        display {
          value: "Mid-peripheral-superior nasal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the central zone and the equator in the superior-nasal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111912"
        }
        display {
          value: "Peripheral-superior"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and the ora serrata, and spanning both the superior temporal and superior nasal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111913"
        }
        display {
          value: "Peripheral-superior temporal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and ora serrata in the superior-temporal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111914"
        }
        display {
          value: "Peripheral-temporal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and ora serrata, and spanning both the superior-temporal and inferior-temporal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111915"
        }
        display {
          value: "Peripheral-inferior temporal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and ora serrata in the inferior-temporal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111916"
        }
        display {
          value: "Peripheral-inferior"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and ora serrata, and spanning both the inferior-temporal and inferior-nasal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111917"
        }
        display {
          value: "Peripheral-inferior nasal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and ora serrata in the inferior-nasal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111918"
        }
        display {
          value: "Peripheral-nasal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and ora serrata, and spanning both the superior-nasal and inferior-nasal quadrants of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111919"
        }
        display {
          value: "Peripheral-superior nasal"
        }
        definition {
          value: "An image of at least 15\302\260 angular subtend positioned between the equator and ora serrata in the superior-nasal quadrant of the fundus; see Section U.1.8 \"Relative Image Position Definitions\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111920"
        }
        display {
          value: "Time domain"
        }
        definition {
          value: "Identifies the use of physical signals with respect to time to capture information"
        }
      }
      concept {
        code {
          value: "111921"
        }
        display {
          value: "Spectral domain"
        }
        definition {
          value: "Identifies the use of physical signals with respect to multiple frequencies to capture information"
        }
      }
      concept {
        code {
          value: "111922"
        }
        display {
          value: "No corneal compensation"
        }
        definition {
          value: "No compensation algorithm for corneal birefringence"
        }
      }
      concept {
        code {
          value: "111923"
        }
        display {
          value: "Corneal birefringence compensation"
        }
        definition {
          value: "Algorithm to compensate for variability in corneal birefringence"
        }
      }
      concept {
        code {
          value: "111924"
        }
        display {
          value: "Retinal topography"
        }
        definition {
          value: "Measurement of the retinal surface contour relative to an assigned datum plane"
        }
      }
      concept {
        code {
          value: "111925"
        }
        display {
          value: "Retinal nerve fiber layer thickness"
        }
        definition {
          value: "Measurement approximating the distance related to the structure between the internal limiting membrane (ILM) and the outer boarder of the retinal nerve fiber layer (RNFL); see Section III.6 \"Retinal Thickness Definition\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111926"
        }
        display {
          value: "Ganglion cell complex thickness"
        }
        definition {
          value: "Measurement approximating the distance related to the structure between the ILM and the outer border of the inner plexiform layer (IPL), called the ganglion cell complex (GCC); see Section III.6 \"Retinal Thickness Definition\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111927"
        }
        display {
          value: "Total retinal thickness (ILM to IS-OS)"
        }
        definition {
          value: "Measurement approximating the distance related to the structure between the ILM and the inner-outer segment junction (IS-OS); see Section III.6 \"Retinal Thickness Definition\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111928"
        }
        display {
          value: "Total retinal thickness (ILM to RPE)"
        }
        definition {
          value: "Measurement approximating the distance related to the structure between the ILM and the retinal pigment epithelium (RPE); see Section III.6 \"Retinal Thickness Definition\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111929"
        }
        display {
          value: "Total retinal thickness (ILM to BM)"
        }
        definition {
          value: "Measurement approximating the distance related to the structure between the ILM and the Bruch\'s membrane (BM); see Section III.6 \"Retinal Thickness Definition\" in PS3.17"
        }
      }
      concept {
        code {
          value: "111930"
        }
        display {
          value: "Absolute ophthalmic thickness"
        }
        definition {
          value: "Thickness of a component of the posterior segment of the eye; e.g. thickness of retina, choroid, etc."
        }
      }
      concept {
        code {
          value: "111931"
        }
        display {
          value: "Thickness deviation category from normative data"
        }
        definition {
          value: "Ophthalmic Thickness map based upon statistical significance category (such as percentile) from a normative data set"
        }
      }
      concept {
        code {
          value: "111932"
        }
        display {
          value: "Thickness deviation from normative data"
        }
        definition {
          value: "Ophthalmic Thickness map based upon deviation (such as microns) from a normative data set"
        }
      }
      concept {
        code {
          value: "111933"
        }
        display {
          value: "Related ophthalmic thickness map"
        }
        definition {
          value: "Ophthalmic Thickness Map related to another Ophthalmic Thickness Map or another SOP Instance"
        }
      }
      concept {
        code {
          value: "111934"
        }
        display {
          value: "Disc-Fovea"
        }
        definition {
          value: "An anatomic point centered midway between the disc and fovea centralis"
        }
      }
      concept {
        code {
          value: "111935"
        }
        display {
          value: "p>5%"
        }
        definition {
          value: "Assuming the null hypothesis is true, the conditional percent probability of observing this result is not statistically significant"
        }
      }
      concept {
        code {
          value: "111936"
        }
        display {
          value: "p<5%"
        }
        definition {
          value: "Assuming the null hypothesis is true, the conditional percent probability of observing this result is statistically significant, 95% unlikely to happen by chance"
        }
      }
      concept {
        code {
          value: "111937"
        }
        display {
          value: "p<2%"
        }
        definition {
          value: "Assuming the null hypothesis is true, the conditional percent probability of observing this result is statistically significant, 98% unlikely to happen by chance"
        }
      }
      concept {
        code {
          value: "111938"
        }
        display {
          value: "p<1%"
        }
        definition {
          value: "Assuming the null hypothesis is true, the conditional percent probability of observing this result is statistically significant, 99% unlikely to happen by chance"
        }
      }
      concept {
        code {
          value: "111939"
        }
        display {
          value: "p<0.5%"
        }
        definition {
          value: "Assuming the null hypothesis is true, the conditional percent probability of observing this result is statistically significant, 99.5% unlikely to happen by chance"
        }
      }
      concept {
        code {
          value: "111940"
        }
        display {
          value: "Corneal axial power map"
        }
        definition {
          value: "A two dimensional representation of the axial curvature of the cornea. Axial curvature is calculated from the reciprocal of the distance from a point on a meridian normal at the point to the corneal topographer axis. Also known as sagittal curvature"
        }
      }
      concept {
        code {
          value: "111941"
        }
        display {
          value: "Corneal instantaneous power map"
        }
        definition {
          value: "A two dimensional representation of the instantaneous curvature of the cornea. Instantaneous curvature is calculated from the reciprocal of the distance from a point on a meridian normal at the point to the center of curvature of that point. Also called tangential curvature"
        }
      }
      concept {
        code {
          value: "111942"
        }
        display {
          value: "Corneal refractive power map"
        }
        definition {
          value: "A two dimensional representation of the refractive power of the cornea. Corneal refractive power is calculated using Snell\'s Law"
        }
      }
      concept {
        code {
          value: "111943"
        }
        display {
          value: "Corneal elevation map"
        }
        definition {
          value: "A two dimensional representation of the elevation of the cornea. Elevation is calculated as the distance from a point on the corneal surface to a point on a reference surface along a line parallel to the corneal topographer axis. For the purpose of visualization the reference surface is usually a sphere or an ellipse"
        }
      }
      concept {
        code {
          value: "111944"
        }
        display {
          value: "Corneal wavefront map"
        }
        definition {
          value: "A two dimensional representation of a wavefront aberration surface of the cornea. Wavefront aberration surface is calculated from the corneal elevation data fit with either the Zernike polynomial series or the Fourier Series. Maps generally display total aberrations and selectable higher order aberrations"
        }
      }
      concept {
        code {
          value: "111945"
        }
        display {
          value: "Elevation-based corneal tomographer"
        }
        definition {
          value: "A device that measures corneal anterior surface shape using elevation-based methods (stereographic and light slit-based). Rasterstereography images a grid pattern illuminating the fluorescein dyed tear film with 2 cameras to produce 3D. Slit-based devices scan the cornea, usually by rotation about the instrument axis centered on the cornea vertex"
        }
      }
      concept {
        code {
          value: "111946"
        }
        display {
          value: "Reflection-based corneal topographer"
        }
        definition {
          value: "A reflection-based device that projects a pattern of light onto the cornea and an image of the reflection of that pattern from the tear film is recorded in one video frame. Light patterns include the circular mire pattern (Placido disc) and spot matrix patterns. Sequential scanning of light spots reflected from the corneal surface is also used requiring multiple video frames for recording"
        }
      }
      concept {
        code {
          value: "111947"
        }
        display {
          value: "Interferometry-based corneal tomographer"
        }
        definition {
          value: "An Interference-based device that projects a beam of light onto and through the cornea. Light reflected from within the cornea is combined with a reference beam giving rise to an interference pattern. Appropriately scanned, this imaging is used to construct 3-dimensional images of the cornea from anterior to posterior surfaces; e.g. swept source OCT"
        }
      }
      concept {
        code {
          value: "112000"
        }
        display {
          value: "Chest CAD Report"
        }
        definition {
          value: "A structured report containing the results of computer-aided detection or diagnosis applied to chest imaging and associated clinical information"
        }
      }
      concept {
        code {
          value: "112001"
        }
        display {
          value: "Opacity"
        }
        definition {
          value: "The shadow of an absorber that attenuates the X-Ray beam more effectively than do surrounding absorbers. In a radiograph, any circumscribed area that appears more nearly white (of lesser photometric density) than its surround [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112002"
        }
        display {
          value: "Series Instance UID"
        }
        definition {
          value: "A unique identifier for a series of DICOM SOP instances"
        }
      }
      concept {
        code {
          value: "112003"
        }
        display {
          value: "Associated Chest Component"
        }
        definition {
          value: "A named anatomic region within the chest cavity"
        }
      }
      concept {
        code {
          value: "112004"
        }
        display {
          value: "Abnormal interstitial pattern"
        }
        definition {
          value: "A collection of opacities detected within the continuum of loose connective tissue throughout the lung, that is not expected in a diagnostically normal radiograph"
        }
      }
      concept {
        code {
          value: "112005"
        }
        display {
          value: "Radiographic anatomy"
        }
        definition {
          value: "A type of anatomy that is expected to be detectable on a radiographic (X-Ray based) image"
        }
      }
      concept {
        code {
          value: "112006"
        }
        display {
          value: "Distribution Descriptor"
        }
        definition {
          value: "Characteristic of the extent of spreading of a finding or feature"
        }
      }
      concept {
        code {
          value: "112007"
        }
        display {
          value: "Border definition"
        }
        definition {
          value: "Characteristic of the clarity of the boundary or edges of a finding or feature"
        }
      }
      concept {
        code {
          value: "112008"
        }
        display {
          value: "Site involvement"
        }
        definition {
          value: "The part(s) of the anatomy affected or encompassed by a finding or feature"
        }
      }
      concept {
        code {
          value: "112009"
        }
        display {
          value: "Type of Content"
        }
        definition {
          value: "Characteristic of the matter or substance within a finding or feature"
        }
      }
      concept {
        code {
          value: "112010"
        }
        display {
          value: "Texture Descriptor"
        }
        definition {
          value: "Characteristic of the surface or consistency of a finding or feature"
        }
      }
      concept {
        code {
          value: "112011"
        }
        display {
          value: "Positioner Primary Angle"
        }
        definition {
          value: "Position of the X-Ray beam about the patient from the RAO to LAO direction where movement from RAO to vertical is positive"
        }
      }
      concept {
        code {
          value: "112012"
        }
        display {
          value: "Positioner Secondary Angle"
        }
        definition {
          value: "Position of the X-Ray beam about the patient from the caudal to cranial direction where movement from caudal to vertical is positive"
        }
      }
      concept {
        code {
          value: "112013"
        }
        display {
          value: "Location in Chest"
        }
        definition {
          value: "The zone, lobe or segment within the chest cavity in which a finding or feature is situated"
        }
      }
      concept {
        code {
          value: "112014"
        }
        display {
          value: "Orientation Descriptor"
        }
        definition {
          value: "Vertical refers to orientation parallel to the superior-inferior (cephalad-caudad) axis of the body, with horizontal being perpendicular to this, and an oblique orientation having projections in both the horizontal and vertical"
        }
      }
      concept {
        code {
          value: "112015"
        }
        display {
          value: "Border shape"
        }
        definition {
          value: "Characteristic of the shape formed by the boundary or edges of a finding or feature"
        }
      }
      concept {
        code {
          value: "112016"
        }
        display {
          value: "Baseline Category"
        }
        definition {
          value: "Indicates whether a finding was considered a target lesion, non-target lesion, or non-lesion during evaluation of a baseline series, according to a method such as RECIST"
        }
      }
      concept {
        code {
          value: "112017"
        }
        display {
          value: "Cavity extent as percent of volume"
        }
        definition {
          value: "The extent of a detected cavity, represented as the percent of the surrounding volume that it occupies"
        }
      }
      concept {
        code {
          value: "112018"
        }
        display {
          value: "Calcification extent as percent of surface"
        }
        definition {
          value: "The extent of a detected calcification, represented as the percent of the surrounding surface that it occupies"
        }
      }
      concept {
        code {
          value: "112019"
        }
        display {
          value: "Calcification extent as percent of volume"
        }
        definition {
          value: "The extent of a detected calcification, represented as the percent of the surrounding volume that it occupies"
        }
      }
      concept {
        code {
          value: "112020"
        }
        display {
          value: "Response Evaluation"
        }
        definition {
          value: "A heading for the reporting of response evaluation for treatment of solid tumors"
        }
      }
      concept {
        code {
          value: "112021"
        }
        display {
          value: "Response Evaluation Method"
        }
        definition {
          value: "The system applied in the reporting of response evaluation for treatment of solid tumors"
        }
      }
      concept {
        code {
          value: "112022"
        }
        display {
          value: "RECIST"
        }
        definition {
          value: "Response Evaluation Criteria In Solid Tumors; see Normative References"
        }
      }
      concept {
        code {
          value: "112023"
        }
        display {
          value: "Composite Feature Modifier"
        }
        definition {
          value: "A term that further specifies the name of an item that is an inferred correlation relating two or more individual findings or features"
        }
      }
      concept {
        code {
          value: "112024"
        }
        display {
          value: "Single Image Finding Modifier"
        }
        definition {
          value: "A term that further specifies the name of an item that was detected on one image"
        }
      }
      concept {
        code {
          value: "112025"
        }
        display {
          value: "Size Descriptor"
        }
        definition {
          value: "A qualitative descriptor for the extent of a finding or feature"
        }
      }
      concept {
        code {
          value: "112026"
        }
        display {
          value: "Width Descriptor"
        }
        definition {
          value: "A qualitative descriptor for the thickness of tubular structures, such as blood vessels"
        }
      }
      concept {
        code {
          value: "112027"
        }
        display {
          value: "Opacity Descriptor"
        }
        definition {
          value: "A characteristic that further describes the nature of an opacity"
        }
      }
      concept {
        code {
          value: "112028"
        }
        display {
          value: "Abnormal Distribution of Anatomic Structure"
        }
        definition {
          value: "The type of adverse affect that a finding or feature is having on the surrounding anatomy"
        }
      }
      concept {
        code {
          value: "112029"
        }
        display {
          value: "WHO"
        }
        definition {
          value: "Response evaluation method as defined in chapter 5, \"Reporting of Response\" of the WHO Handbook for Reporting Results for Cancer Treatment; see Normative References"
        }
      }
      concept {
        code {
          value: "112030"
        }
        display {
          value: "Calcification Descriptor"
        }
        definition {
          value: "Identification of the morphology of detected calcifications"
        }
      }
      concept {
        code {
          value: "112031"
        }
        display {
          value: "Attenuation Coefficient"
        }
        definition {
          value: "A quantitative numerical statement of the relative attenuation of the X-Ray beam at a specified point. Coefficient that describes the fraction of a beam of X-Rays or gamma rays that is absorbed or scattered per unit thickness of the absorber. This value basically accounts for the number of atoms in a cubic cm volume of material and the probability of a photon being scattered or absorbed from the nucleus or an electron of one of these atoms. Usually expressed in Hounsfield units [referred to as CT Number in Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112032"
        }
        display {
          value: "Threshold Attenuation Coefficient"
        }
        definition {
          value: "An X-Ray attenuation coefficient that is used as a threshold; e.g. in calcium scoring"
        }
      }
      concept {
        code {
          value: "112033"
        }
        display {
          value: "Abnormal opacity"
        }
        definition {
          value: "An opacity that is not expected in a diagnostically normal radiograph"
        }
      }
      concept {
        code {
          value: "112034"
        }
        display {
          value: "Calculation Description"
        }
        definition {
          value: "A textual description of the mathematical method of calculation that resulted in a calculated value"
        }
      }
      concept {
        code {
          value: "112035"
        }
        display {
          value: "Performance of Pediatric and Adult Chest Radiography, ACR"
        }
        definition {
          value: "American College of Radiology. ACR Standard for the Performance of Pediatric and Adult Chest Radiography. In: Standards. Reston, Va: 2001:95-98"
        }
      }
      concept {
        code {
          value: "112036"
        }
        display {
          value: "ACR Position Statement"
        }
        definition {
          value: "American College of Radiology. ACR Position Statement for Quality Control and Improvement, Safety, Infection Control, and Patient Concerns. In: Practice Guidelines and Technical Standards. Reston, Va: 2001:iv"
        }
      }
      concept {
        code {
          value: "112037"
        }
        display {
          value: "Non-lesion Modifier"
        }
        definition {
          value: "A descriptor for a non-lesion object finding or feature, used to indicate whether the object was detected as being internal or external to the patient\'s body"
        }
      }
      concept {
        code {
          value: "112038"
        }
        display {
          value: "Osseous Modifier"
        }
        definition {
          value: "A concept modifier for an Osseous Anatomy, or bone related, finding"
        }
      }
      concept {
        code {
          value: "112039"
        }
        display {
          value: "Tracking Identifier"
        }
        definition {
          value: "A text label used for tracking a finding or feature, potentially across multiple reporting objects, over time. This label shall be unique within the domain in which it is used"
        }
      }
      concept {
        code {
          value: "112040"
        }
        display {
          value: "Tracking Unique Identifier"
        }
        definition {
          value: "A unique identifier used for tracking a finding or feature, potentially across multiple reporting objects, over time"
        }
      }
      concept {
        code {
          value: "112041"
        }
        display {
          value: "Target Lesion Complete Response"
        }
        definition {
          value: "Disappearance of all target lesions"
        }
      }
      concept {
        code {
          value: "112042"
        }
        display {
          value: "Target Lesion Partial Response"
        }
        definition {
          value: "At least a 30% decrease in the sum of the Longest Diameter of target lesions, taking as reference the baseline sum Longest Diameter"
        }
      }
      concept {
        code {
          value: "112043"
        }
        display {
          value: "Target Lesion Progressive Disease"
        }
        definition {
          value: "At least a 20% increase in the sum of the Longest Diameter of target lesions, taking as reference the smallest sum Longest Diameter recorded since the treatment started, or the appearance of one or more new lesions"
        }
      }
      concept {
        code {
          value: "112044"
        }
        display {
          value: "Target Lesion Stable Disease"
        }
        definition {
          value: "Neither sufficient shrinkage to qualify for Partial Response nor sufficient increase to qualify for Progressive Disease, taking as reference the smallest sum Longest Diameter since the treatment started"
        }
      }
      concept {
        code {
          value: "112045"
        }
        display {
          value: "Non-Target Lesion Complete Response"
        }
        definition {
          value: "Disappearance of all non-target lesions and normalization of tumor marker level"
        }
      }
      concept {
        code {
          value: "112046"
        }
        display {
          value: "Non-Target Lesion Incomplete Response or Stable Disease"
        }
        definition {
          value: "Persistence of one or more non-target lesions and/or maintenance of tumor marker level above the normal limits"
        }
      }
      concept {
        code {
          value: "112047"
        }
        display {
          value: "Non-Target Lesion Progressive Disease"
        }
        definition {
          value: "Appearance of one or more new lesions and/or unequivocal progression of existing non-target lesions"
        }
      }
      concept {
        code {
          value: "112048"
        }
        display {
          value: "Current Response"
        }
        definition {
          value: "The current response evaluation for treatment of solid tumors, according to a method such as RECIST"
        }
      }
      concept {
        code {
          value: "112049"
        }
        display {
          value: "Best Overall Response"
        }
        definition {
          value: "Best response recorded from the start of the treatment until disease progression/recurrence, taking as reference for Progressive Disease the smallest measurements recorded since the treatment started, according to a method such as RECIST"
        }
      }
      concept {
        code {
          value: "112050"
        }
        display {
          value: "Anatomic Identifier"
        }
        definition {
          value: "A text identifier of an anatomic feature when a multiplicity of features of that type may be present, such as \"Rib 1\", \"Rib 2\" or thoracic vertebrae \"T1\" or \"T2\""
        }
      }
      concept {
        code {
          value: "112051"
        }
        display {
          value: "Measurement of Response"
        }
        definition {
          value: "A measured or calculated evaluation of response; e.g. according to a method such as RECIST, the value would be the calculated sum of the lengths of the longest axes of a set of target lesions"
        }
      }
      concept {
        code {
          value: "112052"
        }
        display {
          value: "Bronchovascular"
        }
        definition {
          value: "Of or relating to a bronchial (lung) specific channel for the conveyance of a body fluid"
        }
      }
      concept {
        code {
          value: "112053"
        }
        display {
          value: "Osseous"
        }
        definition {
          value: "Of, relating to, or composed of bone"
        }
      }
      concept {
        code {
          value: "112054"
        }
        display {
          value: "Secondary pulmonary lobule"
        }
        definition {
          value: "The smallest unit of lung surrounded by connective tissue septa; the unit of lung subtended by any bronchiole that gives off three to five terminal bronchioles [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112055"
        }
        display {
          value: "Agatston scoring method"
        }
        definition {
          value: "A method of calculating an overall calcium score, reflecting the calcification of coronary arteries, based on the maximum X-Ray attenuation coefficient and the area of calcium deposits"
        }
      }
      concept {
        code {
          value: "112056"
        }
        display {
          value: "Volume scoring method"
        }
        definition {
          value: "A method of calculating an overall calcium score, reflecting the calcification of coronary arteries, based on the volume of each calcification, typically expressed in mm3"
        }
      }
      concept {
        code {
          value: "112057"
        }
        display {
          value: "Mass scoring method"
        }
        definition {
          value: "A method of calculating an overall calcium score, reflecting the calcification of coronary arteries, based on the total mass of calcification, typically expressed in mg"
        }
      }
      concept {
        code {
          value: "112058"
        }
        display {
          value: "Calcium score"
        }
        definition {
          value: "A measure often arrived at through calculation of findings from CT examination, which is a common predictor of significant stenosis of the coronary arteries"
        }
      }
      concept {
        code {
          value: "112059"
        }
        display {
          value: "Primary complex"
        }
        definition {
          value: "The combination of a focus of pneumonia due to a primary infection with granulomas in the draining hilar or mediastinal lymph nodes [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112060"
        }
        display {
          value: "Oligemia"
        }
        definition {
          value: "General or local decrease in the apparent width of visible pulmonary vessels, suggesting less than normal blood flow (reduced blood flow) [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112061"
        }
        display {
          value: "Abnormal lines (1D)"
        }
        definition {
          value: "Linear opacity of very fine width, i.e., a nearly one dimensional opacity"
        }
      }
      concept {
        code {
          value: "112062"
        }
        display {
          value: "Abnormal lucency"
        }
        definition {
          value: "Area of abnormal very low X-Ray attenuation, typically lower than aerated lung when occurring in or projecting over lung, or lower than soft tissue when occurring in or projecting over soft tissue"
        }
      }
      concept {
        code {
          value: "112063"
        }
        display {
          value: "Abnormal calcifications"
        }
        definition {
          value: "A calcific opacity within the lung that may be organized, but does not display the trabecular organization of true bone [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112064"
        }
        display {
          value: "Abnormal texture"
        }
        definition {
          value: "Relatively homogeneous, extended, pattern of abnormal opacity in the lung, typically low in contrast"
        }
      }
      concept {
        code {
          value: "112065"
        }
        display {
          value: "Reticulonodular pattern"
        }
        definition {
          value: "A collection of innumerable small, linear, and nodular opacities that together produce a composite appearance resembling a net with small superimposed nodules. The reticular and nodular elements are dimensionally of similar magnitude [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112066"
        }
        display {
          value: "Beaded septum sign"
        }
        definition {
          value: "Irregular septal thickening that suggests the appearance of a row of beads; usually a sign of lymphangitic carcinomatosis, but may also occur rarely in sarcoidosis [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112067"
        }
        display {
          value: "Nodular pattern"
        }
        definition {
          value: "A collection of innumerable, small discrete opacities ranging in diameter from 2-10 mm, generally uniform in size and widespread in distribution, and without marginal spiculation [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112068"
        }
        display {
          value: "Pseudoplaque"
        }
        definition {
          value: "An irregular band of peripheral pulmonary opacity adjacent to visceral pleura that simulates the appearance of a pleural plaque and is formed by coalescence of small nodules [Fraser and Pare] "
        }
      }
      concept {
        code {
          value: "112069"
        }
        display {
          value: "Signet-ring sign"
        }
        definition {
          value: "A ring of opacities (usually representing a dilated, thick-walled bronchus) in association with a smaller, round, soft tissue opacity (the adjacent pulmonary artery) suggesting a \"signet ring\" [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112070"
        }
        display {
          value: "Air bronchiologram"
        }
        definition {
          value: "Equivalent of air bronchogram, but in airways assumed to be bronchioles because of peripheral location and diameter [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112071"
        }
        display {
          value: "Air bronchogram"
        }
        definition {
          value: "Radiographic shadow of an air-containing bronchus; presumed to represent an air-containing segment of the bronchial tree (identity often inferred) [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112072"
        }
        display {
          value: "Air crescent"
        }
        definition {
          value: "Air in a crescentic shape in a nodule or mass, in which the air separates the outer wall of the lesion from an inner sequestrum, which most commonly is a fungus ball of Aspergillusspecies [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112073"
        }
        display {
          value: "Halo sign"
        }
        definition {
          value: "Ground-glass opacity surrounding the circumference of a nodule or mass. May be a sign of invasive aspergillosis or hemorrhage of various causes [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112074"
        }
        display {
          value: "Target Lesion at Baseline"
        }
        definition {
          value: "Flag denoting that this lesion was identified, at baseline, as a target lesion intended for tracking over time [RECIST]"
        }
      }
      concept {
        code {
          value: "112075"
        }
        display {
          value: "Non-Target Lesion at Baseline"
        }
        definition {
          value: "Flag denoting that this lesion was not identified, at baseline, as a target lesion, and was not intended for tracking over time [RECIST]"
        }
      }
      concept {
        code {
          value: "112076"
        }
        display {
          value: "Non-Lesion at Baseline"
        }
        definition {
          value: "Flag denoting that this finding was identified, at baseline, as a category other than a lesion, and was not intended for tracking over time [RECIST]"
        }
      }
      concept {
        code {
          value: "112077"
        }
        display {
          value: "Vasoconstriction"
        }
        definition {
          value: "Local or general reduction in the caliber of visible pulmonary vessels, presumed to result from decreased flow occasioned by contraction of muscular pulmonary arteries [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112078"
        }
        display {
          value: "Vasodilation"
        }
        definition {
          value: "Local or general increase in the width of visible pulmonary vessels resulting from increased pulmonary blood flow [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112079"
        }
        display {
          value: "Architectural distortion"
        }
        definition {
          value: "A manifestation of lung disease in which bronchi, pulmonary vessels, a fissure or fissures, or septa of secondary pulmonary lobules are abnormally displaced [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112080"
        }
        display {
          value: "Mosaic perfusion"
        }
        definition {
          value: "A patchwork of regions of varied attenuation, interpreted as secondary to regional differences in perfusion [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112081"
        }
        display {
          value: "Pleonemia"
        }
        definition {
          value: "Increased blood flow to the lungs or a portion thereof, manifested by a general or local increase in the width of visible pulmonary vessels [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112082"
        }
        display {
          value: "Interface"
        }
        definition {
          value: "The common boundary between the shadows of two juxtaposed structures or tissues of different texture or opacity (edge, border) [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112083"
        }
        display {
          value: "Line"
        }
        definition {
          value: "A longitudinal opacity no greater than 2 mm in width [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112084"
        }
        display {
          value: "Lucency"
        }
        definition {
          value: "The shadow of an absorber that attenuates the primary X-Ray beam less effectively than do surrounding absorbers. In a radiograph, any circumscribed area that appears more nearly black (of greater photometric density) than its surround [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112085"
        }
        display {
          value: "Midlung window"
        }
        definition {
          value: "A midlung region, characterized by the absence of large blood vessels and by a paucity of small blood vessels, that corresponds to the minor fissure and adjacent peripheral lung [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112086"
        }
        display {
          value: "Carina angle"
        }
        definition {
          value: "The angle formed by the right and left main bronchi at the tracheal bifurcation [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112087"
        }
        display {
          value: "Centrilobular structures"
        }
        definition {
          value: "The pulmonary artery and its immediate branches in a secondary lobule; HRCT depicts these vessels in certain cases; a.k.a. core structures or lobular core structures [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112088"
        }
        display {
          value: "Anterior junction line"
        }
        definition {
          value: "A vertically oriented linear or curvilinear opacity approximately 1-2 mm wide, commonly projected on the tracheal air shadow [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112089"
        }
        display {
          value: "Posterior junction line"
        }
        definition {
          value: "A vertically oriented, linear or curvilinear opacity approximately 2 mm wide, commonly projected on the tracheal air shadow, and usually slightly concave to the right [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112090"
        }
        display {
          value: "Azygoesophageal recess interface"
        }
        definition {
          value: "A space in the right side of the mediastinum into which the medial edge of the right lower lobe extends [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112091"
        }
        display {
          value: "Paraspinal line"
        }
        definition {
          value: "A vertically oriented interface usually seen in a frontal chest radiograph to the left of the thoracic vertebral column [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112092"
        }
        display {
          value: "Posterior tracheal stripe"
        }
        definition {
          value: "A vertically oriented linear opacity ranging in width from 2-5 mm, extending from the thoracic inlet to the bifurcation of the trachea, and visible only on lateral radiographs of the chest [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112093"
        }
        display {
          value: "Right tracheal stripe"
        }
        definition {
          value: "A vertically oriented linear opacity approximately 2-3 mm wide extending from the thoracic inlet to the right tracheobronchial angle [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112094"
        }
        display {
          value: "Stripe"
        }
        definition {
          value: "A longitudinal composite opacity measuring 2-5 mm in width; acceptable when limited to anatomic structures within the mediastinum [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112095"
        }
        display {
          value: "Hiatus"
        }
        definition {
          value: "A gap or passage through an anatomical part or organ; especially : a gap through which another part or organ passes"
        }
      }
      concept {
        code {
          value: "112096"
        }
        display {
          value: "Rib Scalene Tubercle"
        }
        definition {
          value: "A small rounded elevation or eminence on the first rib for the attachment of the scalenus anterior"
        }
      }
      concept {
        code {
          value: "112097"
        }
        display {
          value: "Vertebral Intervertebral Notch"
        }
        definition {
          value: "A groove that serves for the transmission of the vertebral artery"
        }
      }
      concept {
        code {
          value: "112098"
        }
        display {
          value: "Subscapular Fossa"
        }
        definition {
          value: "The concave depression of the anterior surface of the scapula"
        }
      }
      concept {
        code {
          value: "112099"
        }
        display {
          value: "Scapular Spine"
        }
        definition {
          value: "A sloping ridge dividing the dorsal surface of the scapula into the supraspinatous fossa (above), and the infraspinatous fossa (below)"
        }
      }
      concept {
        code {
          value: "112100"
        }
        display {
          value: "Scapular Supraspinatus Fossa"
        }
        definition {
          value: "The portion of the dorsal surface of the scapula above the scapular spine"
        }
      }
      concept {
        code {
          value: "112101"
        }
        display {
          value: "Scapular Infraspinatus Fossa"
        }
        definition {
          value: "The portion of the dorsal surface of the scapula below the scapular spine"
        }
      }
      concept {
        code {
          value: "112102"
        }
        display {
          value: "Aortic knob"
        }
        definition {
          value: "The portion of the aortic arch that defines the transition between its ascending and descending limbs"
        }
      }
      concept {
        code {
          value: "112103"
        }
        display {
          value: "Arch of the Azygos vein"
        }
        definition {
          value: "Section of Azygos vein near the fourth thoracic vertebra, where it arches forward over the root of the right lung, and ends in the superior vena cava, just before that vessel pierces the pericardium"
        }
      }
      concept {
        code {
          value: "112104"
        }
        display {
          value: "Air-fluid level"
        }
        definition {
          value: "A local collection of gas and liquid that, when traversed by a horizontal X-Ray beam, creates a shadow characterized by a sharp horizontal interface between gas density above and liquid density below [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112105"
        }
        display {
          value: "Corona radiata"
        }
        definition {
          value: "A circumferential pattern of fine linear spicules, approximately 5 mm long, extending outward from the margin of a solitary pulmonary nodule through a zone of relative lucency [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112106"
        }
        display {
          value: "Honeycomb pattern"
        }
        definition {
          value: "A number of closely approximated ring shadows representing air spaces 5-10 mm in diameter with walls 2-3 mm thick that resemble a true honeycomb; implies \"end-stage\" lung [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112107"
        }
        display {
          value: "Fleischner\'s line(s)"
        }
        definition {
          value: "A straight, curved, or irregular linear opacity that is visible in multiple projections; usually situated in the lower half of the lung; vary markedly in length and width [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112108"
        }
        display {
          value: "Intralobular lines"
        }
        definition {
          value: "Fine linear opacities present in a lobule when the intralobular interstitium is thickened. When numerous, they may appear as a fine reticular pattern [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112109"
        }
        display {
          value: "Kerley A line"
        }
        definition {
          value: "Essentially straight linear opacity 2-6 cm in length and 1-3 mm in width, usually in an upper lung zone [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112110"
        }
        display {
          value: "Kerley B line"
        }
        definition {
          value: "A straight linear opacity 1.5-2 cm in length and 1-2 mm in width, usually at the lung base [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112111"
        }
        display {
          value: "Kerley C lines"
        }
        definition {
          value: "A group of branching, linear opacities producing the appearing of a fine net, at the lung base [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112112"
        }
        display {
          value: "Parenchymal band"
        }
        definition {
          value: "Elongated opacity, usually several millimeters wide and up to about 5 cm long, often extending to the pleura, which may be thickened and retracted at the site of contact [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112113"
        }
        display {
          value: "Reticular pattern"
        }
        definition {
          value: "A collection of innumerable small linear opacities that together produce an appearance resembling a net [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112114"
        }
        display {
          value: "Septal line(s)"
        }
        definition {
          value: "Usually used in the plural, a generic term for linear opacities of varied distribution produced when the interstitium between pulmonary lobules is thickened [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112115"
        }
        display {
          value: "Subpleural line"
        }
        definition {
          value: "A thin curvilinear opacity, a few millimeters or less in thickness, usually less than 1 cm from the pleural surface and paralleling the pleura [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112116"
        }
        display {
          value: "Tramline shadow"
        }
        definition {
          value: "Parallel or slightly convergent linear opacities that suggest the planar projection of tubular structures and that correspond in location and orientation to elements of the bronchial tree [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112117"
        }
        display {
          value: "Tubular shadow"
        }
        definition {
          value: "Paired, parallel, or slightly convergent linear opacities presumed to represent the walls of a tubular structure seen en face; used if the anatomic nature of a shadow is obscure [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112118"
        }
        display {
          value: "Density"
        }
        definition {
          value: "The opacity of a radiographic shadow to visible light; film blackening; the term should never be used to mean an \"opacity\" or \"radiopacity\" [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112119"
        }
        display {
          value: "Dependent opacity"
        }
        definition {
          value: "Subpleural increased attenuation in dependent lung. The increased attenuation disappears when the region of lung is nondependent; a.k.a. dependent increased attenuation [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112120"
        }
        display {
          value: "Ground glass opacity"
        }
        definition {
          value: "Hazy increased attenuation of lung, but with preservation of bronchial and vascular margins; caused by partial filling of air spaces, interstitial thickening, partial collapse of alveoli, normal expiration, or increased capillary blood volume [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112121"
        }
        display {
          value: "Infiltrate"
        }
        definition {
          value: "Any ill-defined opacity in the lung [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112122"
        }
        display {
          value: "Micronodule"
        }
        definition {
          value: "Discrete, small, round, focal opacity of at least soft tissue attenuation and with a diameter no greater than 7 mm [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112123"
        }
        display {
          value: "Phantom tumor (pseudotumor)"
        }
        definition {
          value: "A shadow produced by a local collection of fluid in one of the interlobar fissures, usually elliptic in one radiographic projection and rounded in the other, resembling a tumor [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112124"
        }
        display {
          value: "Shadow"
        }
        definition {
          value: "Any perceptible discontinuity in film blackening attributed to the attenuation of the X-Ray beam by a specific anatomic absorber or lesion on or within the body of the patient; to be employed only when more specific identification is not possible [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112125"
        }
        display {
          value: "Small irregular opacities"
        }
        definition {
          value: "Term used to define a reticular pattern specific to pneumoconioses [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112126"
        }
        display {
          value: "Small rounded opacities"
        }
        definition {
          value: "Term used to define a nodular pattern specific to pneumoconioses [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112127"
        }
        display {
          value: "Tree-in-bud sign"
        }
        definition {
          value: "Nodular dilation of centrilobular branching structures that resembles a budding tree and represents exudative bronchiolar dilation [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112128"
        }
        display {
          value: "Granular pattern"
        }
        definition {
          value: "Any extended, finely granular pattern of pulmonary opacity within which normal anatomic details are partly obscured [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112129"
        }
        display {
          value: "Miliary pattern"
        }
        definition {
          value: "A collection of tiny discrete opacities in the lungs, each measuring 2 mm or less in diameter, generally uniform in size and widespread in distribution [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112130"
        }
        display {
          value: "Mosaic pattern"
        }
        definition {
          value: "Generalized pattern of relatively well defined areas in the lung having different X-Ray attenuations due to a longstanding underlying pulmonary disease"
        }
      }
      concept {
        code {
          value: "112131"
        }
        display {
          value: "Extremely small"
        }
        definition {
          value: "A qualitative descriptor of a size that is dramatically less than typical"
        }
      }
      concept {
        code {
          value: "112132"
        }
        display {
          value: "Very small"
        }
        definition {
          value: "A qualitative descriptor of a size that is considerably less than typical"
        }
      }
      concept {
        code {
          value: "112133"
        }
        display {
          value: "Too small"
        }
        definition {
          value: "A qualitative descriptor of a size that is so small as to be abnormal versus expected size"
        }
      }
      concept {
        code {
          value: "112134"
        }
        display {
          value: "Elliptic"
        }
        definition {
          value: "Shaped like an ellipse (oval)"
        }
      }
      concept {
        code {
          value: "112135"
        }
        display {
          value: "Lobulated"
        }
        definition {
          value: "A border shape that is made up of, provided with, or divided into lobules (small lobes, curved or rounded projections or divisions)"
        }
      }
      concept {
        code {
          value: "112136"
        }
        display {
          value: "Spiculated"
        }
        definition {
          value: "Radially orientated border shape"
        }
      }
      concept {
        code {
          value: "112137"
        }
        display {
          value: "Sharply defined"
        }
        definition {
          value: "The border of a shadow (opacity) is sharply defined [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112138"
        }
        display {
          value: "Distinctly defined"
        }
        definition {
          value: "The border of a shadow (opacity) is distinctly defined [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112139"
        }
        display {
          value: "Well demarcated"
        }
        definition {
          value: "The border of a shadow (opacity) is well distinct from adjacent structures [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112140"
        }
        display {
          value: "Sharply demarcated"
        }
        definition {
          value: "The border of a shadow (opacity) is sharply distinct from adjacent structures [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112141"
        }
        display {
          value: "Poorly demarcated"
        }
        definition {
          value: "The border of a shadow (opacity) is poorly distinct from adjacent structures [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112142"
        }
        display {
          value: "Circumscribed"
        }
        definition {
          value: "A shadow (opacity) possessing a complete or nearly complete visible border [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112143"
        }
        display {
          value: "Air"
        }
        definition {
          value: "Inspired atmospheric gas. The word is sometimes used to describe gas within the body regardless of its composition or site [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112144"
        }
        display {
          value: "Soft tissue"
        }
        definition {
          value: "Material having X-Ray attenuation properties similar to muscle"
        }
      }
      concept {
        code {
          value: "112145"
        }
        display {
          value: "Calcium"
        }
        definition {
          value: "Material having X-Ray attenuation properties similar to calcium, a silver-white bivalent metallic element occurring in plants and animals"
        }
      }
      concept {
        code {
          value: "112146"
        }
        display {
          value: "Acinar"
        }
        definition {
          value: "A pulmonary opacity 4-8 mm in diameter, presumed to represent anatomic acinus, or a collection of opacities in the lung, each measuring 4-8 mm in diameter, and together producing an extended, homogeneous shadow [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112147"
        }
        display {
          value: "Air space"
        }
        definition {
          value: "The gas-containing portion of the lung parenchyma, including the acini and excluding the interstitium [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112148"
        }
        display {
          value: "Fibronodular"
        }
        definition {
          value: "Sharply defined, approximately circular opacities occurring singly or in clusters, usually in the upper lobes [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112149"
        }
        display {
          value: "Fluffy"
        }
        definition {
          value: "A shadow (opacity) that is ill-defined, lacking clear-cut margins [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112150"
        }
        display {
          value: "Linear"
        }
        definition {
          value: "A shadow resembling a line; any elongated opacity of approximately uniform width [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112151"
        }
        display {
          value: "Profusion"
        }
        definition {
          value: "The number of small opacities per unit area or zone of lung. In the International Labor Organization (ILO) classification of radiographs of the pneumoconioses, the qualifiers 0 through 3 subdivide the profusion into 4 categories. The profusion categories may be further subdivided by employing a 12-point scale [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112152"
        }
        display {
          value: "Silhouette sign"
        }
        definition {
          value: "The effacement of an anatomic soft tissue border by either a normal anatomic structure or a pathologic state such as airlessness of adjacent lung or accumulation of fluid in the contiguous pleural space; useful in detecting and localizing an opacity along the axis of the X-Ray beam [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112153"
        }
        display {
          value: "Subpleural"
        }
        definition {
          value: "Situated or occurring between the pleura and the body wall"
        }
      }
      concept {
        code {
          value: "112154"
        }
        display {
          value: "Bat\'s wing distribution"
        }
        definition {
          value: "Spatial arrangement of opacities that bears vague resemblance to the shape of a bat in flight; bilaterally symmetric [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112155"
        }
        display {
          value: "Butterfly distribution"
        }
        definition {
          value: "Spatial arrangement of opacities that bears vague resemblance to the shape of a butterfly in flight; bilaterally symmetric [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112156"
        }
        display {
          value: "Centrilobular"
        }
        definition {
          value: "Referring to the region of the bronchioloarteriolar core of a secondary pulmonary lobule [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112157"
        }
        display {
          value: "Coalescent"
        }
        definition {
          value: "The joining together of a number of opacities into a single opacity [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112158"
        }
        display {
          value: "Lobar"
        }
        definition {
          value: "Of or relating to a lobe (a curved or rounded projection or division); e.g. involving an entire lobe of the lung"
        }
      }
      concept {
        code {
          value: "112159"
        }
        display {
          value: "Hyper-acute"
        }
        definition {
          value: "Extremely or excessively acute, as a qualitative measure of severity"
        }
      }
      concept {
        code {
          value: "112160"
        }
        display {
          value: "Homogeneous (uniform opacity)"
        }
        definition {
          value: "Of uniform opacity or texture throughout [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112161"
        }
        display {
          value: "Inhomogeneous"
        }
        definition {
          value: "Lack of homogeneity in opacity or texture"
        }
      }
      concept {
        code {
          value: "112162"
        }
        display {
          value: "Target"
        }
        definition {
          value: "Discrete opacity centrally within a larger opacity, as a calcification descriptor"
        }
      }
      concept {
        code {
          value: "112163"
        }
        display {
          value: "Fibrocalcific"
        }
        definition {
          value: "Pertaining to sharply defined, linear, and/or nodular opacities containing calcification(s) [Fraser and Pare]"
        }
      }
      concept {
        code {
          value: "112164"
        }
        display {
          value: "Flocculent"
        }
        definition {
          value: "Calcifications made up of loosely aggregated particles, resembling wool"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-replacedby"
          }
