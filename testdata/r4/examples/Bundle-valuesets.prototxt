      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>SupplyRequestReason</h2><div><p>The reason why the supply item was requested.</p>\n</div><p>This code system http://terminology.hl7.org/CodeSystem/supplyrequest-reason defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">patient-care<a name=\"supplyrequest-reason-patient-care\"> </a></td><td>Patient Care</td><td>The supply has been requested for use in direct patient care.</td></tr><tr><td style=\"white-space:nowrap\">ward-stock<a name=\"supplyrequest-reason-ward-stock\"> </a></td><td>Ward Stock</td><td>The supply has been requested for creating or replenishing ward stock.</td></tr></table></div>"
        }
      }
