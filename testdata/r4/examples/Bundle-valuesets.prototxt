          value: "Capture Only"
        }
        definition {
          value: "Render the item only when capturing data."
        }
      }
      concept {
        code {
          value: "display"
        }
        display {
          value: "Display Only"
        }
        definition {
          value: "Render the item only when displaying a completed form."
