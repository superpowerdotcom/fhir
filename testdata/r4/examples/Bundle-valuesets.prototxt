      }
      concept {
        code {
          value: "in-progress"
        }
        display {
          value: "In Progress"
        }
        definition {
          value: "The task has been started but is not yet complete."
        }
      }
      concept {
        code {
          value: "on-hold"
        }
        display {
          value: "On Hold"
        }
        definition {
          value: "The task has been started but work has been paused."
        }
      }
      concept {
        code {
          value: "failed"
        }
        display {
          value: "Failed"
        }
        definition {
          value: "The task was attempted but could not be completed due to some error."
        }
      }
      concept {
        code {
          value: "completed"
        }
        display {
          value: "Completed"
        }
        definition {
          value: "The task has been completed."
        }
      }
      concept {
        code {
          value: "entered-in-error"
        }
        display {
          value: "Entered in Error"
        }
        definition {
          value: "The task should never have existed and is retained only because of the possibility it may have used."
        }
      }
    }
  }
}
