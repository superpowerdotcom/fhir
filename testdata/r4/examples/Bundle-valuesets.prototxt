        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.4.1102"
        }
      }
      version {
        value: "4.0.1"
      }
      name {
        value: "ImmunizationEvaluationDoseStatusCodes"
      }
      title {
        value: "Immunization Evaluation Dose Status codes"
      }
      status {
        value: DRAFT
      }
      experimental {
      }
      publisher {
        value: "FHIR Project team"
      }
      contact {
        telecom {
          system {
            value: URL
