        }
        definition {
          value: "The species to which an artifact applies. For example, SNOMED - 387961004 | Kingdom Animalia (organism)."
        }
      }
      concept {
        code {
          value: "program"
        }
        display {
          value: "Program"
        }
        definition {
          value: "A program/project of work for which this artifact is applicable."
        }
      }
    }
  }
