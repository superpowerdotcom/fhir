        }
      }
      concept {
        code {
          value: "125251"
        }
        display {
          value: "Non-imaging Doppler ultrasound transducer geometry"
        }
        definition {
          value: "Ultrasound transducer geometry characterized by a single scan line used for PW or CW Doppler scanning"
        }
      }
      concept {
        code {
          value: "125252"
        }
        display {
          value: "Linear ultrasound transducer geometry"
        }
        definition {
          value: "Ultrasonic transducer geometry characterized by parallel lines"
        }
      }
      concept {
        code {
          value: "125253"
        }
        display {
          value: "Curved linear ultrasound transducer geometry"
        }
        definition {
          value: "Ultrasonic transducer geometry characterized by radial lines normal to the outside of a curved surface"
        }
      }
      concept {
        code {
          value: "125254"
        }
        display {
          value: "Sector ultrasound transducer geometry"
        }
        definition {
          value: "Ultrasonic transducer geometry characterized by lines originating from a common apex"
        }
      }
      concept {
        code {
          value: "125255"
        }
        display {
          value: "Radial ultrasound transducer geometry"
        }
        definition {
          value: "Ultrasonic transducer geometry characterized by lines emanating radially from a single point"
        }
      }
      concept {
        code {
          value: "125256"
        }
        display {
          value: "Ring ultrasound transducer geometry"
        }
        definition {
          value: "Ultrasonic transducer geometry characterized by a circular ring of transducer elements"
        }
      }
      concept {
        code {
          value: "125257"
        }
        display {
          value: "Fixed beam direction"
        }
        definition {
          value: "Ultrasonic steering technique consisting of a single beam normal to the transducer face steered by the orientation of the probe"
        }
      }
      concept {
        code {
          value: "125258"
        }
        display {
          value: "Mechanical beam steering"
        }
        definition {
          value: "Ultrasonic steering technique consisting of mechanically directing the beam"
        }
      }
      concept {
        code {
          value: "125259"
        }
        display {
          value: "Phased beam steering"
        }
        definition {
          value: "Ultrasonic steering technique consisting of electronically-steered beams"
        }
      }
      concept {
        code {
          value: "125261"
        }
        display {
          value: "External Transducer"
        }
        definition {
          value: "Transducer is designed to be placed onto the surface of the subject"
        }
      }
      concept {
        code {
          value: "125262"
        }
        display {
          value: "Transesophageal Transducer"
        }
        definition {
          value: "Transducer is designed for insertion into the esophagus"
        }
      }
      concept {
        code {
          value: "125263"
        }
        display {
          value: "Endovaginal Transducer"
        }
        definition {
          value: "Transducer is designed for insertion into the vagina"
        }
      }
      concept {
        code {
          value: "125264"
        }
        display {
          value: "Endorectal Transducer"
        }
        definition {
          value: "Transducer is designed for insertion into the rectum"
        }
      }
      concept {
        code {
          value: "125265"
        }
        display {
          value: "Intravascular Transducer"
        }
        definition {
          value: "Transducer is designed for insertion via a catheter"
        }
      }
      concept {
        code {
          value: "125270"
        }
        display {
          value: "Left Ventricle Mass by Area Length"
        }
        definition {
          value: "method to measure the mass of the Left Ventricle via the ASE area-length method at end diastole. LV Mass = 1.05*(5/6*(A1*(L+t)) - 5/6*(A2*L)) A1 = Left Ventricle epicardial SAX area at the level of the papillary muscle tips at end diastole. A2 = Left Ventricle endocardial SAX area cavity area at the level of the papillary muscle tips at end diastole. L = Left Ventricle apical view long axis length at end diastole. t = Myocardial thickness can be computed as: t = sqrt (A1/3.14) - sqrt (A2/3.14) Reference: 1) Schiller, N.B., et al. \"Recommendations for Quantification of the LV by Two-dimensional Echocardiography.\" J Am Soc Echo, Vol. 2, No. 5: 358-367, Sep-Oct 1989. 2) Reichek, N., et al. \"Anatomic Validation of Left Ventricular Mass Estimates from Clinical Two-dimensional Echocardiography: Initial Results.\" Circulation, Vol. 67, No. 2: 348-52, February 1983"
        }
      }
      concept {
        code {
          value: "125271"
        }
        display {
          value: "Left Ventricle Mass by M-mode - adjusted by Height"
        }
        definition {
          value: "Equation = Left Ventricle Mass by M-mode (in gram) / (Height (in meter)) ^2.7 Reference: Giovanni De Simone, et al. \"Effect of Growth on Variability of Left Ventricular Mass: Assessment of Allometric Signals in Adults and Children and Their Capacity to Predict Cardiovascular Risk\". New York, New York and Cincinnati, Ohio"
        }
      }
      concept {
        code {
          value: "125272"
        }
        display {
          value: "Left Ventricle Mass by Truncated Ellipse - adjusted by Height"
        }
        definition {
          value: "Equation = Left Ventricle Mass by Truncated Ellipse / Height^2.7 Reference: Giovanni De Simone, et al. \"Effect of Growth on Variability of Left Ventricular Mass: Assessment of Allometric Signals in Adults and Children and Their Capacity to Predict Cardiovascular Risk\". New York, New York and Cincinnati, Ohio"
        }
      }
      concept {
        code {
          value: "125273"
        }
        display {
          value: "Left Ventricle Mass by Area Length - adjusted by Height"
        }
        definition {
          value: "Equation = Left Ventricle Mass by Area Length / Height^2.7 Reference: Giovanni De Simone, et al. \"Effect of Growth on Variability of Left Ventricular Mass: Assessment of Allometric Signals in Adults and Children and Their Capacity to Predict Cardiovascular Risk\". New York, New York and Cincinnati, Ohio"
        }
      }
      concept {
        code {
          value: "125901"
        }
        display {
          value: "CARDIOsphere"
        }
        definition {
          value: "CARDIOsphere\302\231 ultrasonic contrast agent produced by POINT Biomedical"
        }
      }
