entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/tldc"
  }
  resource {
    code_system {
      id {
        value: "tldc"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>TemplateStatusCode LifeCycle</h2><div><p>Life cycle of the Status Code of a Template Design (Version)</p>\n</div><p>This code system urn:oid:2.16.840.1.113883.3.1937.98.5.8 defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">draft<a name=\"tldc-draft\"> </a></td><td>Draft</td><td>Design is under development (nascent).</td></tr><tr><td style=\"white-space:nowrap\">pending<a name=\"tldc-pending\"> </a></td><td>Under pre-publication review</td><td>Design is completed and is being reviewed.</td></tr><tr><td style=\"white-space:nowrap\">active<a name=\"tldc-active\"> </a></td><td>active</td><td>Design has been deemed fit for the intended purpose and is published by the governance group.</td></tr><tr><td style=\"white-space:nowrap\">review<a name=\"tldc-review\"> </a></td><td>In Review</td><td>Design is active, but is under review. The review may result in a change to the design. The change may necessitate a new version to be created. This in turn may result in the prior version of the template to be retired. Alternatively, the review may result in a change to the design that does not require a new version to be created, or it may result in no change to the design at all.</td></tr><tr><td style=\"white-space:nowrap\">cancelled<a name=\"tldc-cancelled\"> </a></td><td>Cancelled</td><td>A drafted design is determined to be erroneous or not fit for intended purpose and is discontinued before ever being published in an active state.</td></tr><tr><td style=\"white-space:nowrap\">rejected<a name=\"tldc-rejected\"> </a></td><td>Rejected</td><td>A previously drafted design is determined to be erroneous or not fit for intended purpose and is discontinued before ever being published for consideration in a pending state.</td></tr><tr><td style=\"white-space:nowrap\">retired<a name=\"tldc-retired\"> </a></td><td>retired</td><td>A previously active design is discontinued from use. It should no longer be used for future designs, but for historical purposes may be used to process data previously recorded using this design. A newer design may or may not exist. The design is published in the retired state.</td></tr><tr><td style=\"white-space:nowrap\">terminated<a name=\"tldc-terminated\"> </a></td><td>Terminated</td><td>A design is determined to be erroneous or not fit for the intended purpose and should no longer be used, even for historical purposes. No new designs can be developed for this template. The associated template no longer needs to be published, but if published, is shown in the terminated state.</td></tr></table></div>"
        }
      }
      url {
        value: "urn:oid:2.16.840.1.113883.3.1937.98.5.8"
      }
      name {
        value: "TemplateStatusCodeLifeCycle"
      }
      title {
        value: "TemplateStatusCode LifeCycle"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1386162000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "Art-Decor"
      }
      description {
        value: "Life cycle of the Status Code of a Template Design (Version)"
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "urn:oid:2.16.840.1.113883.3.1937.98.11.8"
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "draft"
        }
        display {
          value: "Draft"
        }
        definition {
          value: "Design is under development (nascent)."
        }
      }
      concept {
        code {
          value: "pending"
        }
        display {
          value: "Under pre-publication review"
        }
        definition {
          value: "Design is completed and is being reviewed."
        }
      }
      concept {
        code {
          value: "active"
        }
        display {
          value: "active"
        }
        definition {
          value: "Design has been deemed fit for the intended purpose and is published by the governance group."
        }
      }
      concept {
        code {
          value: "review"
        }
        display {
          value: "In Review"
        }
        definition {
          value: "Design is active, but is under review. The review may result in a change to the design. The change may necessitate a new version to be created. This in turn may result in the prior version of the template to be retired. Alternatively, the review may result in a change to the design that does not require a new version to be created, or it may result in no change to the design at all."
        }
      }
      concept {
        code {
          value: "cancelled"
        }
        display {
          value: "Cancelled"
        }
        definition {
          value: "A drafted design is determined to be erroneous or not fit for intended purpose and is discontinued before ever being published in an active state."
        }
      }
      concept {
        code {
          value: "rejected"
        }
        display {
          value: "Rejected"
        }
        definition {
          value: "A previously drafted design is determined to be erroneous or not fit for intended purpose and is discontinued before ever being published for consideration in a pending state."
        }
      }
      concept {
        code {
          value: "retired"
        }
        display {
          value: "retired"
        }
        definition {
          value: "A previously active design is discontinued from use. It should no longer be used for future designs, but for historical purposes may be used to process data previously recorded using this design. A newer design may or may not exist. The design is published in the retired state."
        }
      }
      concept {
        code {
          value: "terminated"
        }
        display {
          value: "Terminated"
        }
        definition {
          value: "A design is determined to be erroneous or not fit for the intended purpose and should no longer be used, even for historical purposes. No new designs can be developed for this template. The associated template no longer needs to be published, but if published, is shown in the terminated state."
        }
      }
    }
  }
}
