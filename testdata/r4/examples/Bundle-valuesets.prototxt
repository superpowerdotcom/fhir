          value: "Follow-up"
        }
        definition {
          value: "A person is no longer receiving study intervention and/or being evaluated with tests and procedures according to the protocol, but they are being monitored on a protocol-prescribed schedule."
        }
      }
      concept {
        code {
          value: "ineligible"
        }
        display {
          value: "Ineligible"
        }
