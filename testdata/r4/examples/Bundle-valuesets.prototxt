        }
      }
      concept {
        code {
          value: "Distance"
        }
        display {
          value: "Distance"
        }
        definition {
          value: "A length - a value with a unit that is a physical distance."
        }
      }
      concept {
        code {
          value: "Dosage"
        }
        display {
          value: "Dosage"
        }
        definition {
          value: "Indicates how the medication is/was taken or should be taken by the patient."
        }
      }
      concept {
        code {
          value: "Duration"
        }
        display {
          value: "Duration"
        }
        definition {
          value: "A length of time."
        }
      }
      concept {
        code {
          value: "Element"
        }
        display {
