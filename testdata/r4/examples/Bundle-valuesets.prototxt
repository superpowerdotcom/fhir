          value: "112249"
        }
        display {
          value: "ACR Standard, CT medical physics performance monitoring"
        }
        definition {
          value: "American College of Radiology Technical Standard for Diagnostic Medical Physics Performance Monitoring of Computed Tomography (CT) Equipment. In: Practice Guidelines and Technical Standards.Reston, Va: American College of Radiology;2006:945-948"
        }
      }
