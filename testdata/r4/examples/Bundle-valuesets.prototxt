        }
      }
      concept {
        code {
          value: "intolerance"
        }
        display {
          value: "Intolerance"
        }
        definition {
          value: "A propensity for adverse reactions to a substance that is not judged to be allergic or \"allergy-like\".  These reactions are typically (but not necessarily) non-immune.  They are to some degree idiosyncratic and/or patient-specific (i.e. are not a reaction that is expected to occur with most or all patients given similar circumstances)."
        }
      }
