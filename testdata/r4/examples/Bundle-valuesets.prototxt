        }
      }
      concept {
        code {
          value: "instance-order"
        }
        display {
          value: "Instance Order"
        }
        definition {
          value: "The request represents an instance for the particular order, for example a medication administration record."
        }
      }
      concept {
        code {
          value: "option"
        }
        display {
          value: "Option"
        }
        definition {
          value: "The request represents a component or option for a RequestGroup that establishes timing, conditionality and/or  other constraints among a set of requests."
        }
      }
    }
