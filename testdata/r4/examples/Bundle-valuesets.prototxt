          value: "111673"
        }
        display {
          value: "Add Intermediate"
        }
        definition {
          value: "Refractive measurements of the eye to correct for inability to focus at intermediate distance while wearing the distance prescription"
        }
      }
      concept {
        code {
          value: "111674"
        }
        display {
          value: "Add Other"
        }
        definition {
          value: "Refractive measurements of the eye to correct for inability to focus at the specified distance while wearing the distance prescription"
        }
      }
