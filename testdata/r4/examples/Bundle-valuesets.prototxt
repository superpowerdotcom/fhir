      concept {
        code {
          value: "113100"
        }
        display {
          value: "Basic Application Confidentiality Profile"
        }
        definition {
          value: "De-identification using a profile defined in PS3.15 that requires removing all information related to the identity and demographic characteristics of the patient, any responsible parties or family members, any personnel involved in the procedure, the organizations involved in ordering or performing the procedure, additional information that could be used to match instances if given access to the originals, such as UIDs, dates and times, and private attributes, when that information is present in the non-Pixel Data Attributes, including graphics or overlays"
        }
      }
      concept {
        code {
          value: "113101"
        }
        display {
          value: "Clean Pixel Data Option"
        }
        definition {
          value: "Additional de-identification according to an option defined in PS3.15 that requires any information burned in to the Pixel Data corresponding to the Attribute information specified to be removed by the Profile and any other Options specified also be removed"
        }
      }
      concept {
        code {
          value: "113102"
        }
        display {
          value: "Clean Recognizable Visual Features Option"
        }
        definition {
          value: "Additional de-identification according to an option defined in PS3.15 that requires that sufficient removal or distortion of the Pixel Data shall be applied to prevent recognition of an individual from the instances themselves or a reconstruction of a set of instances"
        }
      }
      concept {
        code {
          value: "113103"
        }
        display {
          value: "Clean Graphics Option"
        }
        definition {
          value: "Additional de-identification according to an option defined in PS3.15 that requires that any information encoded in graphics, text annotations or overlays corresponding to the Attribute information specified to be removed by the Profile and any other Options specified also be removed"
        }
      }
      concept {
        code {
          value: "113104"
        }
        display {
          value: "Clean Structured Content Option"
        }
        definition {
          value: "Additional de-identification according to an option defined in PS3.15 that requires that any information encoded in SR Content Items or Acquisition Context Sequence Items corresponding to the Attribute information specified to be removed by the Profile and any other Options specified also be removed"
        }
      }
      concept {
        code {
          value: "113105"
        }
        display {
          value: "Clean Descriptors Option"
        }
        definition {
          value: "Additional de-identification according to an option defined in PS3.15 that requires that any information that is embedded in text or string Attributes corresponding to the Attribute information specified to be removed by the Profile and any other Options specified also be removed"
        }
      }
      concept {
        code {
          value: "113106"
        }
        display {
          value: "Retain Longitudinal Temporal Information Full Dates Option"
        }
        definition {
          value: "Retention of information that would otherwise be removed during de-identification according to an option defined in PS3.15 that requires that any dates and times be retained,"
        }
      }
      concept {
        code {
          value: "113107"
        }
        display {
          value: "Retain Longitudinal Temporal Information Modified Dates Option"
        }
        definition {
          value: "Retention of information that would otherwise be removed during de-identification according to an option defined in PS3.15 that requires that any dates and times be modified in a manner that preserves temporal relationships; e.g. Study Date and Time"
        }
      }
      concept {
        code {
          value: "113108"
        }
        display {
          value: "Retain Patient Characteristics Option"
        }
        definition {
          value: "Retention of information that would otherwise be removed during de-identification according to an option defined in PS3.15 that requires that any physical characteristics of the patient, which are descriptive rather than identifying information per se, be retained; e.g. Patient\'s Age, Sex, Size (height) and Weight"
        }
      }
      concept {
        code {
          value: "113109"
        }
        display {
          value: "Retain Device Identity Option"
        }
        definition {
          value: "Retention of information that would otherwise be removed during de-identification according to an option defined in PS3.15 that requires that any information that identifies a device be retained; e.g. Device Serial Number"
