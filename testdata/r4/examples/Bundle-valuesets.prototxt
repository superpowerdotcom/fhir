      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 2
          }
        }
      }
      url {
        value: "http://hl7.org/fhir/map-target-list-mode"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
