      date {
        value_us: 1572560963000000
        timezone: "+11:00"
        precision: SECOND
      }
      description {
        value: "A list of all the definition resource types defined in this version of the FHIR specification."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://hl7.org/fhir/ValueSet/definition-resource-types"
      }
      content {
        value: COMPLETE
      }
      concept {
