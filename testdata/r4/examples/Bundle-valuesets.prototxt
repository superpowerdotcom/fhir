        definition {
          value: "The information is submitted/retrieved manually (e.g. by phone, fax, paper-based)"
        }
      }
      concept {
        code {
          value: "portal"
        }
        display {
          value: "Portal"
        }
        definition {
          value: "The information is submitted/retrieved via a portal"
        }
      }
      concept {
        code {
          value: "pull"
        }
        display {
          value: "Pull"
        }
        definition {
          value: "The information is retrieved (i.e. pulled) from a source (e.g. over an API)"
        }
      }
      concept {
