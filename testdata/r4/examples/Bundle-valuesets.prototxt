          value: "111364"
        }
        display {
          value: "Hypoechoic"
        }
        definition {
          value: "Defined relative to fat; masses are characterized by low-level echoes throughout; e.g. appearance of a complicated cyst or fibroadenoma"
        }
      }
      concept {
        code {
          value: "111365"
