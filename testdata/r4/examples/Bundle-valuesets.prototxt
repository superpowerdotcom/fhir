          value: "available"
        }
        display {
          value: "Available"
        }
        definition {
          value: "The physical specimen is present and in good condition."
        }
      }
      concept {
        code {
          value: "unavailable"
        }
        display {
          value: "Unavailable"
        }
        definition {
          value: "There is no physical specimen because it is either lost, destroyed or consumed."
        }
      }
      concept {
        code {
          value: "unsatisfactory"
        }
        display {
          value: "Unsatisfactory"
