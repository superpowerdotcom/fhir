        value: COMPLETE
      }
      concept {
        code {
          value: "fax"
        }
        display {
          value: "Fax"
        }
        definition {
          value: "Referrals may be accepted by fax."
        }
      }
      concept {
        code {
          value: "phone"
        }
        display {
          value: "Phone"
        }
        definition {
          value: "Referrals may be accepted over the phone from a practitioner."
        }
      }
      concept {
        code {
          value: "elec"
        }
        display {
          value: "Secure Messaging"
        }
        definition {
          value: "Referrals may be accepted via a secure messaging system. To determine the types of secure messaging systems supported, refer to the identifiers collection. Callers will need to understand the specific identifier system used to know that they are able to transmit messages."
        }
      }
      concept {
        code {
