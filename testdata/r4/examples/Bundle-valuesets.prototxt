        }
      }
      concept {
        code {
          value: "off-study"
        }
        display {
          value: "Off-study"
        }
        definition {
          value: "A person that has ended their participation on a study either because their treatment/observation is complete or through not\nresponding, withdrawal, non-compliance and/or adverse event."
        }
      }
      concept {
        code {
          value: "on-study"
        }
        display {
          value: "On-study"
        }
        definition {
          value: "A person that is enrolled or registered on a study."
        }
      }
      concept {
        code {
          value: "on-study-intervention"
        }
        display {
          value: "On-study-intervention"
        }
        definition {
          value: "The person is receiving the treatment or participating in an activity (e.g. yoga, diet, etc.) that the study is evaluating."
        }
      }
      concept {
        code {
          value: "on-study-observation"
        }
        display {
          value: "On-study-observation"
        }
        definition {
          value: "The subject is being evaluated via tests and assessments according to the study calendar, but is not receiving any intervention. Note that this state is study-dependent and might not exist in all studies.  A synonym for this is \"short-term follow-up\"."
        }
      }
      concept {
        code {
          value: "pending-on-study"
        }
        display {
          value: "Pending on-study"
        }
        definition {
          value: "A person is pre-registered for a study."
        }
      }
      concept {
        code {
          value: "potential-candidate"
        }
        display {
          value: "Potential Candidate"
        }
        definition {
          value: "A person that is potentially eligible for participation in the study."
        }
      }
      concept {
        code {
          value: "screening"
        }
        display {
          value: "Screening"
        }
        definition {
          value: "A person who is being evaluated for eligibility for a study."
        }
      }
      concept {
        code {
          value: "withdrawn"
        }
        display {
          value: "Withdrawn"
        }
        definition {
          value: "The person has withdrawn their participation in the study before registration."
        }
      }
    }
  }
}
entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/participationstatus"
