        }
        display {
          value: "Orientation"
        }
        definition {
          value: "Referential relationship of the finding to the imaging device as noted on sonography"
        }
      }
      concept {
        code {
          value: "111355"
        }
        display {
          value: "Parallel"
        }
        definition {
          value: "The long axis of a lesion parallels the skin line (\"wider-than-tall\" or in a horizontal orientation)"
        }
      }
      concept {
        code {
          value: "111356"
        }
        display {
          value: "Not parallel"
        }
        definition {
          value: "The anterior-posterior or vertical dimension is greater than the transverse or horizontal dimension"
        }
      }
      concept {
        code {
          value: "111357"
        }
        display {
          value: "Lesion boundary"
        }
        definition {
          value: "The lesion boundary describes the transition zone between themas and the surrounding tissue"
        }
      }
      concept {
        code {
          value: "111358"
        }
        display {
          value: "Abrupt interface"
        }
        definition {
          value: "The sharp demarcation between the lesion and surrounding tissue can be imperceptible or a distinct well-defined echogenic rim of any thickness"
        }
      }
      concept {
        code {
          value: "111359"
        }
        display {
          value: "Echogenic halo"
        }
        definition {
          value: "There is no sharp demarcation between the mass and the surrounding tissue, which is bridged by an echogenic transition zone"
        }
      }
      concept {
        code {
          value: "111360"
        }
        display {
          value: "Echo pattern"
        }
        definition {
          value: "An imaging characteristic of resonance noted during sonography"
        }
      }
