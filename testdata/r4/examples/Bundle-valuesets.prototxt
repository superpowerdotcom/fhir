      concept {
        code {
          value: "110849"
        }
        display {
          value: "Echogenicity"
        }
        definition {
          value: "The ability of a material to create an ultrasound return echo"
        }
      }
      concept {
        code {
          value: "110850"
        }
        display {
          value: "X-Ray Attenuation"
        }
        definition {
          value: "Decrease in the number of photons in an X-Ray beam due to interactions with the atoms of a material substance. Attenuation is due primarily to two processes, absorption and scattering"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-replacedby"
          }
          value {
            coding {
              system {
                value: "http://dicom.nema.org/resources/ontology/DCM"
              }
              code {
                value: "112031"
              }
              display {
                value: "Attenuation Coefficient"
              }
            }
          }
        }
        code {
          value: "110851"
        }
        display {
          value: "X-Ray Attenuation Coefficient"
        }
        definition {
          value: "Coefficient that describes the fraction of a beam of X-Rays or gamma rays that is absorbed or scattered per unit thickness of the absorber. This value basically accounts for the number of atoms in a cubic cm volume of material and the probability of a photon being scattered or absorbed from the nucleus or an electron of one of these atoms"
        }
        property {
          code {
            value: "status"
          }
          value {
            code {
              value: "deprecated"
            }
          }
        }
      }
      concept {
        code {
          value: "110852"
        }
        display {
          value: "MR signal intensity"
        }
        definition {
          value: "Signal intensity of an MR image, not otherwise specified"
        }
      }
      concept {
        code {
          value: "110853"
        }
        display {
          value: "Binary Segmentation"
        }
        definition {
          value: "Binary value denoting that the segmented property is present"
        }
      }
