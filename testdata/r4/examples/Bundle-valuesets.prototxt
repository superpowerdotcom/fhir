        }
      }
      concept {
        code {
          value: "112172"
        }
        display {
          value: "Portacath"
        }
        definition {
          value: "Connected to an injection chamber placed under the skin in the upper part of the chest. When it is necessary to inject some drug, a specific needle is put in the chamber through the skin and a silicon membrane. The advantage of a portacath is that it may be left in place several months contrarily of \"classical\" catheters"
        }
      }
      concept {
        code {
          value: "112173"
        }
        display {
          value: "Chest tube"
        }
        definition {
          value: "A tube inserted into the chest wall from outside the body, for drainage. Sometimes used for collapsed lung. Usually connected to a receptor placed lower than the insertion site"
        }
      }
      concept {
        code {
          value: "112174"
        }
        display {
          value: "Central line"
        }
        definition {
          value: "A tube placed into the subclavian vein to deliver medication directly into the venous system"
        }
      }
      concept {
        code {
          value: "112175"
        }
        display {
          value: "Kidney stent"
        }
        definition {
          value: "A stent is a tube inserted into another tube. Kidney stent is a tube that is inserted into the kidney, ureter, and bladder, to help drain urine. Usually inserted through a scoping device presented through the urethra"
        }
      }
      concept {
        code {
          value: "112176"
        }
        display {
          value: "Pancreatic stent"
        }
        definition {
          value: "A stent is a tube inserted into another tube. Pancreatic stent is inserted through the common bile duct to the pancreatic duct, to drain bile"
        }
      }
      concept {
        code {
          value: "112177"
        }
        display {
          value: "Nipple ring"
        }
        definition {
          value: "A non-lesion object that appears to be a circular band, attached to the body via pierced nipple"
        }
      }
      concept {
        code {
          value: "112178"
        }
        display {
          value: "Coin"
        }
        definition {
          value: "A non-lesion object that appears to be a flat round piece of metal"
        }
      }
      concept {
        code {
          value: "112179"
        }
        display {
          value: "Minimum Attenuation Coefficient"
        }
        definition {
          value: "The least quantity assignable, admissible, or possible; the least of a set of X-Ray attenuation coefficients"
        }
      }
      concept {
        code {
          value: "112180"
        }
        display {
          value: "Maximum Attenuation Coefficient"
        }
        definition {
          value: "The greatest quantity or value attainable or attained; the largest of a set of X-Ray attenuation coefficients"
        }
      }
      concept {
        code {
          value: "112181"
        }
        display {
          value: "Mean Attenuation Coefficient"
        }
        definition {
          value: "The value that is computed by dividing the sum of a set of X-Ray attenuation coefficients by the number of values "
        }
      }
      concept {
        code {
          value: "112182"
        }
        display {
          value: "Median Attenuation Coefficient"
        }
        definition {
          value: "The value in an ordered set of X-Ray attenuation coefficients, below and above which there is an equal number of values"
        }
      }
      concept {
        code {
          value: "112183"
        }
        display {
          value: "Standard Deviation of Attenuation Coefficient"
        }
        definition {
          value: "For a set of X-Ray attenuation coefficients: 1) a measure of the dispersion of a frequency distribution that is the square root of the arithmetic mean of the squares of the deviation of each of the class frequencies from the arithmetic mean of the frequency distribution; 2) a parameter that indicates the way in which a probability function or a probability density function is centered around its mean and that is equal to the square root of the moment in which the deviation from the mean is squared"
        }
      }
