        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "trial-use"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 2
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/composite-measure-scoring"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.4.1235"
        }
      }
      version {
        value: "4.0.1"
      }
      name {
        value: "CompositeMeasureScoring"
