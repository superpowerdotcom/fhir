        definition {
          value: "A primitive type that has a value and an extension. These can be used throughout complex datatype, Resource and extension definitions. Only the base specification can define primitive types."
        }
      }
      concept {
        code {
          value: "complex-type"
        }
        display {
          value: "Complex Data Type"
        }
        definition {
          value: "A  complex structure that defines a set of data elements that is suitable for use in \'resources\'. The base specification defines a number of complex types, and other specifications can define additional types. These structures do not have a maintained identity."
        }
      }
      concept {
        code {
          value: "resource"
