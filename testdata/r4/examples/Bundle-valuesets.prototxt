entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/medicationrequest-status"
  }
  resource {
    code_system {
      id {
        value: "medicationrequest-status"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>Medicationrequest  status</h2><div><p>MedicationRequest Status Codes</p>\n</div><p>This code system http://hl7.org/fhir/CodeSystem/medicationrequest-status defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">active<a name=\"medicationrequest-status-active\"> </a></td><td>Active</td><td>The prescription is \'actionable\', but not all actions that are implied by it have occurred yet.</td></tr><tr><td style=\"white-space:nowrap\">on-hold<a name=\"medicationrequest-status-on-hold\"> </a></td><td>On Hold</td><td>Actions implied by the prescription are to be temporarily halted, but are expected to continue later.  May also be called \'suspended\'.</td></tr><tr><td style=\"white-space:nowrap\">cancelled<a name=\"medicationrequest-status-cancelled\"> </a></td><td>Cancelled</td><td>The prescription has been withdrawn before any administrations have occurred</td></tr><tr><td style=\"white-space:nowrap\">completed<a name=\"medicationrequest-status-completed\"> </a></td><td>Completed</td><td>All actions that are implied by the prescription have occurred.</td></tr><tr><td style=\"white-space:nowrap\">entered-in-error<a name=\"medicationrequest-status-entered-in-error\"> </a></td><td>Entered in Error</td><td>Some of the actions that are implied by the medication request may have occurred.  For example, the medication may have been dispensed and the patient may have taken some of the medication.  Clinical decision support systems should take this status into account</td></tr><tr><td style=\"white-space:nowrap\">stopped<a name=\"medicationrequest-status-stopped\"> </a></td><td>Stopped</td><td>Actions implied by the prescription are to be permanently halted, before all of the administrations occurred. This should not be used if the original order was entered in error</td></tr><tr><td style=\"white-space:nowrap\">draft<a name=\"medicationrequest-status-draft\"> </a></td><td>Draft</td><td>The prescription is not yet \'actionable\', e.g. it is a work in progress, requires sign-off, verification\302\240or\302\240needs to be run through decision support process.</td></tr><tr><td style=\"white-space:nowrap\">unknown<a name=\"medicationrequest-status-unknown\"> </a></td><td>Unknown</td><td>The authoring/source system does not know which of the status values currently applies for this observation. Note: This concept is not to be used for \'other\' - one of the listed statuses is presumed to apply, but the authoring/source system does not know which.</td></tr></table></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "phx"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "trial-use"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 3
          }
        }
      }
      url {
        value: "http://hl7.org/fhir/CodeSystem/medicationrequest-status"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.4.1377"
        }
      }
      version {
        value: "4.0.1"
      }
      name {
        value: "medicationrequest Status"
      }
      title {
        value: "Medicationrequest  status"
      }
      status {
        value: DRAFT
      }
      experimental {
      }
      publisher {
        value: "FHIR Project team"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org/fhir"
          }
        }
      }
      description {
        value: "MedicationRequest Status Codes"
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://hl7.org/fhir/ValueSet/medicationrequest-status"
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "active"
        }
        display {
          value: "Active"
        }
        definition {
          value: "The prescription is \'actionable\', but not all actions that are implied by it have occurred yet."
        }
      }
      concept {
        code {
          value: "on-hold"
        }
        display {
          value: "On Hold"
        }
        definition {
          value: "Actions implied by the prescription are to be temporarily halted, but are expected to continue later.  May also be called \'suspended\'."
        }
      }
      concept {
        code {
          value: "cancelled"
        }
        display {
          value: "Cancelled"
        }
        definition {
          value: "The prescription has been withdrawn before any administrations have occurred"
        }
      }
      concept {
        code {
          value: "completed"
        }
        display {
          value: "Completed"
        }
        definition {
          value: "All actions that are implied by the prescription have occurred."
        }
      }
      concept {
        code {
          value: "entered-in-error"
        }
        display {
          value: "Entered in Error"
        }
        definition {
          value: "Some of the actions that are implied by the medication request may have occurred.  For example, the medication may have been dispensed and the patient may have taken some of the medication.  Clinical decision support systems should take this status into account"
        }
      }
      concept {
        code {
          value: "stopped"
        }
        display {
          value: "Stopped"
        }
        definition {
          value: "Actions implied by the prescription are to be permanently halted, before all of the administrations occurred. This should not be used if the original order was entered in error"
        }
      }
      concept {
        code {
          value: "draft"
        }
        display {
          value: "Draft"
        }
        definition {
          value: "The prescription is not yet \'actionable\', e.g. it is a work in progress, requires sign-off, verification\302\240or\302\240needs to be run through decision support process."
        }
      }
      concept {
        code {
          value: "unknown"
        }
        display {
          value: "Unknown"
        }
        definition {
          value: "The authoring/source system does not know which of the status values currently applies for this observation. Note: This concept is not to be used for \'other\' - one of the listed statuses is presumed to apply, but the authoring/source system does not know which."
        }
      }
    }
  }
}
