      }
      concept {
        code {
          value: "122322"
        }
        display {
          value: "Calibration Factor"
        }
        definition {
          value: "Factor by which a measured or calculated value is multiplied to obtain the estimated real-world value"
        }
      }
      concept {
        code {
          value: "122325"
        }
        display {
          value: "IVUS Report"
        }
        definition {
          value: "Intravascular Ultrasound Report"
        }
      }
      concept {
        code {
          value: "122330"
        }
        display {
          value: "EEM Diameter"
        }
        definition {
          value: "External Elastic Membrane (EEM) diameter measured through the center point of the vessel. Center point of the vessel is defined as the center of gravity of the EEM area. The EEM is a discrete interface at the border between the media and the adventitia"
        }
      }
      concept {
        code {
          value: "122331"
        }
        display {
          value: "Plaque Plus Media Thickness"
        }
        definition {
          value: "The distance from intimal leading edge to the external elastic membrane along any line passing through the luminal center, which is defined as the center of gravity of the lumen area"
        }
      }
      concept {
        code {
          value: "122332"
        }
        display {
          value: "Lumen Perimeter"
        }
        definition {
          value: "Planimetered perimeter of the lumen"
        }
      }
      concept {
        code {
          value: "122333"
        }
        display {
          value: "EEM Cross-Sectional Area"
        }
        definition {
          value: "Vessel area measured at the External Elastic Membrane (EEM), a discrete interface at the border between the media and the adventitia"
        }
      }
      concept {
        code {
          value: "122334"
        }
        display {
          value: "Plaque plus Media Cross-Sectional Area"
        }
        definition {
          value: "Area within the EEM occupied by atheroma, regardless of lumen compromise. Plaque plus Media Area = EEM cross-sectional area - vessel lumen cross-sectional area"
        }
      }
      concept {
        code {
          value: "122335"
        }
        display {
          value: "In-Stent Neointimal Cross-Sectional Area"
        }
        definition {
          value: "Measurement of in-stent restenosis. In-Stent Intimal Area = Stent cross-sectional area - vessel lumen cross-sectional area"
        }
      }
      concept {
        code {
          value: "122336"
        }
        display {
          value: "Vascular Volume measurement length"
        }
        definition {
          value: "Longitudinal extent of the Vascular Volume Measurement. This is the distance from the distal edge to the proximal edge of the Volume measurement"
        }
      }
      concept {
        code {
          value: "122337"
        }
        display {
          value: "Relative position"
        }
        definition {
          value: "Longitudinal distance from the closest edge of a fiducial feature or reference location to the start of the vascular measurement. This value will be a positive if the measurement is distal to the fiducial feature or reference location, or negative if the measurement is proximal to the fiducial feature or reference location"
        }
      }
      concept {
        code {
          value: "122339"
        }
        display {
          value: "Stent Volume Obstruction"
        }
        definition {
          value: "In-Stent Neointimal Volume / Stent Volume"
        }
      }
      concept {
        code {
          value: "122340"
        }
        display {
          value: "Fiducial feature"
        }
        definition {
          value: "Reference, normally anatomical, which is used for locating the position of a measurement"
        }
      }
      concept {
        code {
          value: "122341"
        }
        display {
          value: "Calcium Length"
        }
        definition {
          value: "Longitudinal calcium length measurement"
        }
      }
      concept {
        code {
          value: "122343"
        }
        display {
          value: "Lumen Eccentricity Index"
        }
        definition {
          value: "Measurement of vessel lumen eccentricity. Lumen Eccentricity Index = (maximum vessel lumen diameter - minimum vessel lumen diameter) / maximum vessel lumen diameter. Lumen diameters are measured through the center point of the lumen, which is defined as the center of gravity of the lumen area"
        }
      }
      concept {
        code {
          value: "122344"
        }
        display {
          value: "Plaque plus Media Eccentricity Index"
        }
        definition {
          value: "Plaque plus Media Eccentricity Index = (maximum Plaque plus media thickness - minimum Plaque plus media thickness) / maximum Plaque plus media thickness"
        }
      }
      concept {
        code {
          value: "122345"
        }
        display {
          value: "Remodeling Index"
        }
        definition {
          value: "Measurement of increase or decrease in EEM area that occurs during the development of atherosclerosis. Remodeling Index = Lesion EEM area / reference EEM area"
        }
      }
      concept {
        code {
          value: "122346"
        }
        display {
          value: "Stent Symmetry Index"
        }
        definition {
          value: "Measurement of stent circularity. Stent Symmetry Index = (maximum stent diameter - minimum stent diameter) / maximum stent diameter"
        }
      }
      concept {
        code {
          value: "122347"
        }
        display {
          value: "Stent Expansion Index"
        }
        definition {
          value: "Measurement of stent area relative to the reference lumen area. Stent Expansion Index = Minimum stent area / reference vessel lumen cross-sectional area"
        }
      }
      concept {
        code {
          value: "122348"
        }
        display {
          value: "Lumen Shape Index"
        }
        definition {
          value: "Measurement of vessel lumen eccentricity. Lumen Shape Index = (2p * sqrt(Vessel lumen cross-sectional area / p) / Lumen Perimeter) 2 Reference: Tobis & Yock, \"Intravascular Ultrasound Imaging\", Chapter 7"
        }
      }
      concept {
        code {
          value: "122350"
        }
        display {
          value: "Lumen Diameter Ratio"
        }
        definition {
          value: "Lumen diameter ratio = minimum vessel lumen diameter / maximum vessel lumen diameter, measured at the same cross section in the vessel. Lumen diameters are measured through the center point of the lumen, which is defined as the center of gravity of the lumen area"
        }
      }
      concept {
        code {
          value: "122351"
        }
        display {
          value: "Stent Diameter Ratio"
        }
        definition {
          value: "Stent diameter ratio = Minimum stent diameter / Maximum stent diameter, measured at the same cross section in the vessel. Stent diameters are measured through the center point of the stent, which is defined as the center of gravity of the stent area"
        }
      }
      concept {
        code {
          value: "122352"
        }
        display {
          value: "EEM Diameter Ratio"
        }
        definition {
          value: "EEM diameter ratio = minimum EEM diameter / maximum EEM diameter. Measured at the same cross section in the vessel"
        }
      }
      concept {
        code {
          value: "122354"
        }
        display {
          value: "Plaque Burden"
        }
        definition {
          value: "Fractional area within the External Elastic Membrane (EEM) occupied by atheroma. Plaque Burden = (EEM area - vessel lumen cross-sectional area) / EEM area"
        }
      }
      concept {
        code {
          value: "122355"
        }
        display {
          value: "Arc of Calcium"
        }
        definition {
          value: "Angular measurement of a Calcium deposit with the apex located at the center of the lumen, which is defined as the center of gravity of the lumen area"
        }
      }
      concept {
        code {
          value: "122356"
        }
        display {
          value: "Soft plaque"
        }
        definition {
          value: "Plaque characterized by low density or echogenicity"
        }
      }
      concept {
        code {
          value: "122357"
        }
        display {
          value: "In-Stent Neointima"
        }
        definition {
          value: "Abnormal thickening of the intima within the stented segment"
        }
      }
      concept {
        code {
          value: "122360"
        }
        display {
          value: "True Lumen"
        }
        definition {
          value: "Lumen surrounded by all three layers of the vessel-intima, media, and adventitia"
        }
      }
      concept {
        code {
          value: "122361"
        }
        display {
          value: "False Lumen"
        }
        definition {
          value: "A channel, usually parallel to the true lumen, which does not communicate with the true lumen over a portion of its length"
        }
      }
      concept {
        code {
          value: "122363"
        }
        display {
          value: "Plaque Rupture"
        }
        definition {
          value: "Plaque ulceration with a tear detected in a fibrous cap"
        }
      }
      concept {
        code {
          value: "122364"
        }
        display {
          value: "Stent Gap"
        }
        definition {
          value: "Length of gap between two consecutive stents"
        }
      }
      concept {
        code {
          value: "122367"
        }
        display {
          value: "T-1 Worst"
        }
        definition {
          value: "Worst stenosis - the stenosis with the smallest lumen size within a vessel segment"
        }
      }
      concept {
        code {
          value: "122368"
        }
        display {
          value: "T-2 Secondary"
        }
        definition {
          value: "2nd most severe stenosis within a vessel segment"
        }
      }
      concept {
        code {
          value: "122369"
        }
        display {
          value: "T-3 Secondary"
        }
        definition {
          value: "3rd most severe stenosis within a vessel segment"
        }
      }
      concept {
        code {
          value: "122370"
        }
        display {
          value: "T-4 Secondary"
        }
        definition {
          value: "4th most severe stenosis within a vessel segment"
        }
      }
      concept {
        code {
          value: "122371"
        }
        display {
          value: "EEM Volume"
        }
        definition {
          value: "External Elastic Membrane (EEM) volume measured within a specified region. The EEM is a discrete interface at the border between the media and the Adventitia"
        }
      }
      concept {
        code {
          value: "122372"
        }
        display {
          value: "Lumen Volume"
        }
        definition {
          value: "Lumen volume measured within a specified region"
        }
      }
      concept {
        code {
          value: "122374"
        }
        display {
          value: "In-Stent Neointimal Volume"
        }
        definition {
          value: "The amount of plaque between the lumen and stent, within the stent region; In-stent restenosis. In-Stent Neointimal Volume = Stent Volume - Lumen Volume"
        }
      }
      concept {
        code {
          value: "122375"
        }
        display {
          value: "Native Plaque Volume"
        }
        definition {
          value: "The amount of plaque between the stent and the EEM, within the stent region. Native Plaque Volume = EEM Volume - Stent Volume"
        }
      }
      concept {
        code {
          value: "122376"
        }
        display {
          value: "Total Plaque Volume"
        }
        definition {
          value: "Total amount of plaque between the EEM and the Lumen, over the entire region that is measured. Total Plaque Volume = EEM Volume - Lumen Volume"
        }
      }
      concept {
        code {
          value: "122380"
        }
        display {
          value: "Proximal Reference"
        }
        definition {
          value: "Proximal reference segment measurement site. Typically the site with the largest lumen proximal to a stenosis but within the same segment (usually within 10 mm of the stenosis with no major intervening branches)"
        }
      }
      concept {
        code {
          value: "122381"
        }
        display {
          value: "Distal Reference"
        }
        definition {
          value: "Distal reference segment measurement site. Typically the site with the largest lumen distal to a stenosis but within the same segment (usually within 10 mm of the stenosis with no major intervening branches)"
        }
      }
      concept {
        code {
          value: "122382"
        }
        display {
          value: "Site of Lumen Minimum"
        }
        definition {
          value: "Site of the smallest lumen in a vessel; e.g. due to a stenotic lesion"
        }
      }
      concept {
        code {
          value: "122383"
        }
        display {
          value: "Entire Pullback"
        }
        definition {
          value: "Measurement region that encompasses the entire vessel imaged in a single pullback acquisition"
        }
      }
      concept {
        code {
          value: "122384"
        }
        display {
          value: "Stented Region"
        }
        definition {
          value: "Measurement region occupied by the stent"
        }
      }
      concept {
        code {
          value: "122385"
        }
        display {
          value: "Proximal Stent Margin"
        }
        definition {
          value: "Region starting at the proximal edge of the Stent and extending several millimeters (usually 5 mm) proximal to the Stent edge"
        }
      }
      concept {
        code {
          value: "122386"
        }
        display {
          value: "Distal Stent Margin"
        }
        definition {
          value: "Region starting at the distal edge of the Stent and extending several millimeters (usually 5 mm) distal to the Stent edge"
        }
      }
      concept {
        code {
          value: "122387"
        }
        display {
          value: "Dissection Classification"
        }
        definition {
          value: "Classification of dissections in a vessel"
        }
      }
      concept {
        code {
          value: "122388"
        }
        display {
          value: "Intra-stent Dissection"
        }
        definition {
          value: "Separation of neointimal hyperplasia from stent struts, usually seen only after treatment of in-stent restenosis"
        }
      }
      concept {
        code {
          value: "122389"
        }
        display {
          value: "Vulnerable Plaque"
        }
        definition {
          value: "Plaque with a thin cap fibrous atheroma that is at increased risk of rupture and thrombosis (or re-thrombosis) and rapid stenosis progression"
        }
      }
      concept {
        code {
          value: "122390"
        }
        display {
          value: "Eroded Plaque"
        }
        definition {
          value: "Plaque erosions with no structural defect (beyond endothelial injury) or gap in the plaque"
        }
      }
      concept {
        code {
          value: "122391"
        }
        display {
          value: "Relative Stenosis Severity"
        }
        definition {
          value: "Stenosis severity classifications of multiple lesions in a vessel"
        }
      }
      concept {
        code {
          value: "122393"
        }
        display {
          value: "Restenotic Lesion"
        }
        definition {
          value: "A finding of a previously treated lesion in which stenosis has reoccurred"
        }
      }
      concept {
        code {
          value: "122394"
        }
        display {
          value: "Fibro-Lipidic Plaque"
        }
        definition {
          value: "Loosely packed bundles of collagen fibers with regions of lipid deposition present. Region is cellular and no cholesterol clefts or necrosis are present. Some macrophage infiltration. Increase in extra cellular matrix"
        }
      }
      concept {
        code {
          value: "122395"
        }
        display {
          value: "Necrotic-Lipidic Plaque"
        }
        definition {
          value: "Area within the plaque with very low echogenicity separated from the lumen and surrounded by more echogenic structures (fibrous cap). Highly lipidic necrotic region with remnants of foam cells and dead lymphocytes present. No collagen fibers are visible and mechanical integrity is poor. Cholesterol clefts and micro calcifications are visible"
        }
      }
      concept {
        code {
          value: "122398"
        }
        display {
          value: "Intimal Dissection"
        }
        definition {
          value: "Dissection limited to the intima or atheroma, and not extending to the media"
        }
      }
      concept {
        code {
          value: "122399"
        }
