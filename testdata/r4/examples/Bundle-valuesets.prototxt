        display {
          value: "Ready"
        }
        definition {
          value: "The task is ready to be performed, but no action has yet been taken.  Used in place of requested/received/accepted/rejected when request assignment and acceptance is a given."
        }
      }
      concept {
        code {
          value: "cancelled"
