        value: "http://hl7.org/fhir/ValueSet/composite-measure-scoring"
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "opportunity"
        }
        display {
          value: "Opportunity"
        }
        definition {
          value: "Opportunity scoring combines the scores from component measures by combining the numerators and denominators for each component."
        }
      }
      concept {
        code {
          value: "all-or-nothing"
        }
        display {
          value: "All-or-nothing"
        }
        definition {
          value: "All-or-nothing scoring includes an individual in the numerator of the composite measure if they are in the numerators of all of the component measures in which they are in the denominator."
        }
      }
      concept {
        code {
          value: "linear"
        }
        display {
          value: "Linear"
        }
        definition {
          value: "Linear scoring gives an individual a score based on the number of numerators in which they appear."
        }
      }
      concept {
        code {
          value: "weighted"
        }
        display {
          value: "Weighted"
        }
        definition {
          value: "Weighted scoring gives an individual a score based on a weighted factor for each component numerator in which they appear."
        }
      }
    }
