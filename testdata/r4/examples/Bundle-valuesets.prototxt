        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>EncounterLocationStatus</h2><div><p>The status of the location.</p>\n</div><p>This code system http://hl7.org/fhir/encounter-location-status defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">planned<a name=\"encounter-location-status-planned\"> </a></td><td>Planned</td><td>The patient is planned to be moved to this location at some point in the future.</td></tr><tr><td style=\"white-space:nowrap\">active<a name=\"encounter-location-status-active\"> </a></td><td>Active</td><td>The patient is currently at this location, or was between the period specified.\r\rA system may update these records when the patient leaves the location to either reserved, or completed.</td></tr><tr><td style=\"white-space:nowrap\">reserved<a name=\"encounter-location-status-reserved\"> </a></td><td>Reserved</td><td>This location is held empty for this patient.</td></tr><tr><td style=\"white-space:nowrap\">completed<a name=\"encounter-location-status-completed\"> </a></td><td>Completed</td><td>The patient was at this location during the period specified.\r\rNot to be used when the patient is currently at the location.</td></tr></table></div>"
        }
