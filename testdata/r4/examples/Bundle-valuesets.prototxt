          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>Jurisdiction</h2><div><p>This value set defines a base set of codes for country, country subdivision and region    for indicating where a resource is intended to be used.</p>\n<p>Note: The codes for countries and country subdivisions are taken from    <a href=\"https://www.iso.org/iso-3166-country-codes.html\">ISO 3166</a>    while the codes for &quot;supra-national&quot; regions are from    <a href=\"http://unstats.un.org/unsd/methods/m49/m49.htm\">UN Standard country or area codes for statistical use (M49)</a>.</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include all codes defined in <code>urn:iso:std:iso:3166</code></li><li>Include all codes defined in <code>urn:iso:std:iso:3166:-2</code></li><li>Include codes from <code>http://unstats.un.org/unsd/methods/m49/m49.htm</code> where class  =  region</li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "normative"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 5
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-normative-version"
        }
        value {
          code {
            value: "4.0.0"
          }
        }
      }
      url {
        value: "http://hl7.org/fhir/ValueSet/jurisdiction"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.3.48"
        }
      }
      version {
        value: "4.0.1"
      }
      name {
        value: "Jurisdiction ValueSet"
      }
      title {
        value: "Jurisdiction"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1572560963000000
        timezone: "+11:00"
        precision: SECOND
      }
      publisher {
        value: "FHIR Project team"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org/fhir"
          }
        }
      }
      description {
        value: "This value set defines a base set of codes for country, country subdivision and region    for indicating where a resource is intended to be used.   \r\n   \r\n   Note: The codes for countries and country subdivisions are taken from    [ISO 3166](https://www.iso.org/iso-3166-country-codes.html)    while the codes for \"supra-national\" regions are from    [UN Standard country or area codes for statistical use (M49)](http://unstats.un.org/unsd/methods/m49/m49.htm)."
      }
      compose {
        include {
          system {
            value: "urn:iso:std:iso:3166"
          }
        }
        include {
          system {
            value: "urn:iso:std:iso:3166:-2"
          }
        }
        include {
          system {
            value: "http://unstats.un.org/unsd/methods/m49/m49.htm"
          }
          filter {
            property {
