        value: IS_A
      }
      compositional {
        value: true
      }
      version_needed {
      }
      content {
        value: NOT_PRESENT
      }
      filter {
        code {
          value: "concept"
        }
        description {
          value: "Filter that includes concepts based on their logical definition. e.g. [concept] [is-a] [x] - include all concepts with an is-a relationship to concept x, or [concept] [in] [x]- include all concepts in the reference set identified by concept x"
        }
        operator {
          value: IS_A
        }
        operator {
          value: IN
        }
        value {
          value: "A SNOMED CT code"
        }
      }
      filter {
        code {
          value: "expression"
        }
        description {
          value: "The result of the filter is the result of executing the given SNOMED CT Expression Constraint"
        }
        operator {
          value: EQUALS
        }
        value {
          value: "A SNOMED CT ECL expression (see http://snomed.org/ecl)"
        }
      }
      filter {
        code {
          value: "expressions"
        }
        description {
          value: "Whether post-coordinated expressions are included in the value set"
        }
        operator {
          value: EQUALS
        }
        value {
          value: "true or false"
        }
