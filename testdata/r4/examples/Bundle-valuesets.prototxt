          value: "ParameterDefinition"
        }
        display {
          value: "ParameterDefinition"
        }
        definition {
          value: "The parameters to the module. This collection specifies both the input and output parameters. Input parameters are provided by the caller as part of the $evaluate operation. Output parameters are included in the GuidanceResponse."
        }
      }
      concept {
        code {
          value: "Period"
        }
        display {
          value: "Period"
