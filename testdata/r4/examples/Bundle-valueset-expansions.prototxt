        value: "4.0.1"
      }
      name {
        value: "ObservationInterpretationCodes"
      }
      title {
        value: "Observation Interpretation Codes"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1572560963000000
        timezone: "+11:00"
        precision: SECOND
