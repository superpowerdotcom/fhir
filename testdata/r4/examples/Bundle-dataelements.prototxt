          }
          definition {
            value: "If true, indicates that this slice definition is constraining a slice definition with the same name in an inherited profile. If false, the slice is not overriding any slice in an inherited profile. If missing, the slice might or might not be overriding a slice in an inherited profile, depending on the sliceName."
          }
          comment {
            value: "If set to true, an ancestor profile SHALL have a slicing definition with this name.  If set to false, no ancestor profile is permitted to have a slicing definition with this name."
          }
          requirements {
            value: "Allows detection of a situation where an ancestor profile adds or removes slicing with the same name where that might impact the child profile."
          }
