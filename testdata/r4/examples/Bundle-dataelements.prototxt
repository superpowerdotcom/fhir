        value: "Contract.type"
      }
      base_definition {
        value: "http://hl7.org/fhir/StructureDefinition/Element"
      }
      derivation {
        value: SPECIALIZATION
      }
      snapshot {
        element {
          id {
            value: "Contract.type"
          }
          path {
            value: "Contract.type"
          }
          short {
            value: "Legal instrument category"
          }
          definition {
            value: "A high-level category for the legal instrument, whether constructed as a Contract definition, derivative, or instance in any legal state.  Provides additional information about its content within the context of the Contract\'s scope to distinguish the kinds of systems that would be interested in the contract."
          }
          min {
          }
          max {
            value: "1"
          }
          base {
            path {
              value: "Contract.type"
            }
            min {
            }
