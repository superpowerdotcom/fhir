          }
          definition {
            value: "The name of the organization or individual that published the naming system."
          }
          comment {
            value: "Usually an organization but may be an individual. The publisher (or steward) of the naming system is the organization or individual primarily responsible for the maintenance and upkeep of the naming system. This is not necessarily the same individual or organization that developed and initially authored the content. The publisher is the primary point of contact for questions or issues with the naming system. This item SHOULD be populated unless the information is available from context."
          }
          requirements {
            value: "Helps establish the \"authority/credibility\" of the naming system.  May also allow for contact."
          }
