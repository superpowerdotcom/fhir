            }
            value {
              url {
                value: "http://www.acme.com/logo-small.png"
              }
            }
          }
          is_modifier {
          }
          is_summary {
            value: true
          }
          mapping {
            identity {
              value: "v2"
            }
            map {
              value: "RP.1+RP.2 - if they refer to a URL (see v2.6)"
            }
          }
