            value: true
          }
          is_modifier_reason {
            value: "This element is labelled as a modifier because it is a status element that contains status entered-in-error which means that the activity should not be treated as valid"
          }
          is_summary {
          }
          binding {
            extension {
              url {
                value: "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"
              }
              value {
