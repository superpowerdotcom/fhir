          is_summary {
          }
          binding {
            extension {
              url {
                value: "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"
              }
              value {
                string_value {
                  value: "ObservationValueAbsentReason"
                }
              }
            }
            strength {
              value: EXTENSIBLE
            }
            description {
              value: "Codes specifying why the result (`Observation.value[x]`) is missing."
            }
