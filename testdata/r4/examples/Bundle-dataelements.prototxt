        element {
          id {
            value: "Subscription.status"
          }
          path {
            value: "Subscription.status"
          }
          short {
            value: "requested | active | error | off"
          }
          definition {
            value: "The status of the subscription, which marks the server state for managing the subscription."
          }
          comment {
            value: "A client can only submit subscription resources in the requested or off state. Only the server can  move a subscription from requested to active, and then to error. Either the server or the client can turn a subscription off.\n\nThis element is labeled as a modifier because the status contains codes that mark the resource as not currently valid."
          }
          min {
            value: 1
          }
          max {
            value: "1"
          }
          base {
            path {
              value: "Subscription.status"
            }
            min {
