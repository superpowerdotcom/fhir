                boolean {
                  value: true
                }
              }
            }
            strength {
              value: PREFERRED
            }
            description {
              value: "A human language."
            }
            value_set {
              value: "http://hl7.org/fhir/ValueSet/languages"
            }
          }
          mapping {
            identity {
              value: "v2"
            }
            map {
              value: "PID-15, LAN-2"
            }
          }
          mapping {
            identity {
              value: "rim"
            }
            map {
              value: "player[classCode=PSN|ANM and determinerCode=INSTANCE]/languageCommunication/code"
            }
          }
