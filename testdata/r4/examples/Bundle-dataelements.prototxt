entry {
  full_url {
    value: "http://hl7.org/fhir/StructureDefinition/de-Reference.identifier"
  }
  resource {
    structure_definition {
      id {
        value: "de-Reference.identifier"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
