              }
              value {
                boolean {
                  value: true
                }
              }
            }
            strength {
              value: REQUIRED
            }
            description {
              value: "The gender of a person used for administrative purposes."
            }
            value_set {
              value: "http://hl7.org/fhir/ValueSet/administrative-gender|4.0.1"
            }
          }
