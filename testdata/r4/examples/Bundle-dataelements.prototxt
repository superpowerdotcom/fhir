            }
          }
          type {
            code {
              value: "uri"
            }
          }
          is_modifier {
            value: true
          }
          is_modifier_reason {
            value: "This element is labeled as a modifier because the implicit rules may provide additional knowledge about the resource that modifies it\'s meaning or interpretation"
          }
          is_summary {
            value: true
          }
        }
      }
    }
  }
}
