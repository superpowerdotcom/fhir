          }
          short {
            value: "The entity that links the sugar residues together should also be captured for nearly all naturally occurring nucleic acid the linkage is a phosphate group. For many synthetic oligonucleotides phosphorothioate linkages are often seen. Linkage connectivity is assumed to be 3\342\200\231-5\342\200\231. If the linkage is either 3\342\200\231-3\342\200\231 or 5\342\200\231-5\342\200\231 this should be specified"
          }
          definition {
            value: "The entity that links the sugar residues together should also be captured for nearly all naturally occurring nucleic acid the linkage is a phosphate group. For many synthetic oligonucleotides phosphorothioate linkages are often seen. Linkage connectivity is assumed to be 3\342\200\231-5\342\200\231. If the linkage is either 3\342\200\231-3\342\200\231 or 5\342\200\231-5\342\200\231 this should be specified."
          }
          min {
          }
