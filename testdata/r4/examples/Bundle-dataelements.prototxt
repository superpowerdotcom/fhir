            }
          }
          type {
            code {
              value: "code"
            }
          }
          is_modifier {
            value: true
          }
          is_modifier_reason {
            value: "Some of the values mean that there is no mapping from the source to the target, particularly \'disjoint\', and the mapping cannot be interpreted without knowing this value as it could mean the elements are equivalent, totally mismatched or anything in between"
          }
          is_summary {
          }
          binding {
            extension {
              url {
                value: "http://hl7.org/fhir/StructureDefinition/elementdefinition-bindingName"
              }
