              }
              value {
                boolean {
                  value: true
                }
              }
            }
            strength {
              value: EXTENSIBLE
            }
            description {
              value: "Security Labels from the Healthcare Privacy and Security Classification System."
            }
            value_set {
              value: "http://hl7.org/fhir/ValueSet/security-labels"
            }
          }
