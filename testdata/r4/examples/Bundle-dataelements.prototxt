            value: "EffectEvidenceSynthesis.date"
          }
          path {
            value: "EffectEvidenceSynthesis.date"
          }
          short {
            value: "Date last changed"
          }
          definition {
            value: "The date  (and optionally time) when the effect evidence synthesis was published. The date must change when the business version changes and it must change if the status code changes. In addition, it should change when the substantive content of the effect evidence synthesis changes."
          }
          comment {
            value: "Note that this is not the same as the resource last-modified-date, since the resource may be a secondary representation of the effect evidence synthesis. Additional specific dates may be added as extensions or be found by consulting Provenances associated with past versions of the resource."
          }
          alias {
            value: "Revision Date"
          }
          min {
          }
          max {
            value: "1"
