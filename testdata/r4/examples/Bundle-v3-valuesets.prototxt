              display {
                value: "Rectal Suppository"
              }
              definition {
                value: "Rectal Suppository"
              }
            }
            concept {
              code {
                value: "URETHSUPP"
              }
              display {
                value: "Urethral suppository"
              }
              definition {
                value: "Urethral suppository"
              }
            }
            concept {
