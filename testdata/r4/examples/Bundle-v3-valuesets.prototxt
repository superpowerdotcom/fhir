      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_HumanActSite)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ActSite-_HumanActSite\">\302\240</a></td><td>\n                        An anatomical location on a human which can be the focus of an act.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_HumanSubstanceAdministrationSite)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ActSite-_HumanSubstanceAdministrationSite\">\302\240</a></td><td>\n                        The set of body locations to or through which a drug product may be administered.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BE<a name=\"v3-ActSite-BE\"> </a></td><td>bilateral ears</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BN<a name=\"v3-ActSite-BN\"> </a></td><td>bilateral nares</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BU<a name=\"v3-ActSite-BU\"> </a></td><td>buttock</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LA<a name=\"v3-ActSite-LA\"> </a></td><td>left arm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LAC<a name=\"v3-ActSite-LAC\"> </a></td><td>left anterior chest</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LACF<a name=\"v3-ActSite-LACF\"> </a></td><td>left antecubital fossa</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LD<a name=\"v3-ActSite-LD\"> </a></td><td>left deltoid</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LE<a name=\"v3-ActSite-LE\"> </a></td><td>left ear</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LEJ<a name=\"v3-ActSite-LEJ\"> </a></td><td>left external jugular</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LF<a name=\"v3-ActSite-LF\"> </a></td><td>left foot</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LG<a name=\"v3-ActSite-LG\"> </a></td><td>left gluteus medius</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LH<a name=\"v3-ActSite-LH\"> </a></td><td>left hand</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LIJ<a name=\"v3-ActSite-LIJ\"> </a></td><td>left internal jugular</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LLAQ<a name=\"v3-ActSite-LLAQ\"> </a></td><td>left lower abd quadrant</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LLFA<a name=\"v3-ActSite-LLFA\"> </a></td><td>left lower forearm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LMFA<a name=\"v3-ActSite-LMFA\"> </a></td><td>left mid forearm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LN<a name=\"v3-ActSite-LN\"> </a></td><td>left naris</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LPC<a name=\"v3-ActSite-LPC\"> </a></td><td>left posterior chest</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LSC<a name=\"v3-ActSite-LSC\"> </a></td><td>left subclavian</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LT<a name=\"v3-ActSite-LT\"> </a></td><td>left thigh</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LUA<a name=\"v3-ActSite-LUA\"> </a></td><td>left upper arm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LUAQ<a name=\"v3-ActSite-LUAQ\"> </a></td><td>left upper abd quadrant</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LUFA<a name=\"v3-ActSite-LUFA\"> </a></td><td>left upper forearm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LVG<a name=\"v3-ActSite-LVG\"> </a></td><td>left ventragluteal</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LVL<a name=\"v3-ActSite-LVL\"> </a></td><td>left vastus lateralis</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240OD<a name=\"v3-ActSite-OD\"> </a></td><td>right eye</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240OS<a name=\"v3-ActSite-OS\"> </a></td><td>left eye</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240OU<a name=\"v3-ActSite-OU\"> </a></td><td>bilateral eyes</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PA<a name=\"v3-ActSite-PA\"> </a></td><td>perianal</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PERIN<a name=\"v3-ActSite-PERIN\"> </a></td><td>perineal</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RA<a name=\"v3-ActSite-RA\"> </a></td><td>right arm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RAC<a name=\"v3-ActSite-RAC\"> </a></td><td>right anterior chest</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RACF<a name=\"v3-ActSite-RACF\"> </a></td><td>right antecubital fossa</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RD<a name=\"v3-ActSite-RD\"> </a></td><td>right deltoid</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RE<a name=\"v3-ActSite-RE\"> </a></td><td>right ear</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240REJ<a name=\"v3-ActSite-REJ\"> </a></td><td>right external jugular</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RF<a name=\"v3-ActSite-RF\"> </a></td><td>right foot</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RG<a name=\"v3-ActSite-RG\"> </a></td><td>right gluteus medius</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RH<a name=\"v3-ActSite-RH\"> </a></td><td>right hand</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RIJ<a name=\"v3-ActSite-RIJ\"> </a></td><td>right internal jugular</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RLAQ<a name=\"v3-ActSite-RLAQ\"> </a></td><td>right lower abd quadrant</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RLFA<a name=\"v3-ActSite-RLFA\"> </a></td><td>right lower forearm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RMFA<a name=\"v3-ActSite-RMFA\"> </a></td><td>right mid forearm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RN<a name=\"v3-ActSite-RN\"> </a></td><td>right naris</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RPC<a name=\"v3-ActSite-RPC\"> </a></td><td>right posterior chest</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RSC<a name=\"v3-ActSite-RSC\"> </a></td><td>right subclavian</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RT<a name=\"v3-ActSite-RT\"> </a></td><td>right thigh</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RUA<a name=\"v3-ActSite-RUA\"> </a></td><td>right upper arm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RUAQ<a name=\"v3-ActSite-RUAQ\"> </a></td><td>right upper abd quadrant</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RUFA<a name=\"v3-ActSite-RUFA\"> </a></td><td>right upper forearm</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RVG<a name=\"v3-ActSite-RVG\"> </a></td><td>right ventragluteal</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RVL<a name=\"v3-ActSite-RVL\"> </a></td><td>right vastus lateralis</td><td/></tr>\r\n</table>\r\n</div>"
