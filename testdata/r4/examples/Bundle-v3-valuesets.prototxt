                  display {
                    value: "Buccal Tablet"
                  }
                  definition {
                    value: "Buccal Tablet"
                  }
                  concept {
                    code {
                      value: "SRBUCTAB"
                    }
                    display {
                      value: "Sustained Release Buccal Tablet"
                    }
                    definition {
                      value: "Sustained Release Buccal Tablet"
                    }
                  }
                }
                concept {
                  code {
                    value: "CAPLET"
