                }
                definition {
                  value: "To be stationary, upright, vertical, on one\'s legs.\r\n\n                        \n                           \n                              Deprecation Comment: \n                           This concept has been deprecated because it does not describe a type of Act (as it should in the ActClass code system), but rather encodes the result or value of an observation.  The same code has been added to the ObservationValue code system."
                }
                property {
                  code {
