            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-DataOperation"
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.DataOperation"
      }
      title {
        value: "v3 Code System DataOperation"
      }
      status {
        value: ACTIVE
      }
      experimental {
