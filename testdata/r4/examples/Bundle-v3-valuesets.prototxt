        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " Identifies what sort of change is permitted or has occurred between the item that was ordered/requested and the one that was/will be provided."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-SubstitutionCondition"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      property {
        code {
          value: "notSelectable"
        }
        uri {
          value: "http://hl7.org/fhir/concept-properties#notSelectable"
        }
        description {
          value: "Indicates that the code is abstract - only intended to be used as a selector for other concepts"
        }
        type {
          value: BOOLEAN
        }
      }
      concept {
        code {
          value: "_Conditional"
        }
        display {
          value: "Conditional"
        }
        definition {
          value: "Some conditions may be attached to an allowable substitution.  An allowable substitution is based on a match to any other attributes that may be specified."
        }
        property {
          code {
            value: "notSelectable"
          }
          value {
            boolean {
              value: true
            }
          }
        }
        concept {
          code {
            value: "CONFIRM"
          }
          display {
            value: "Confirm first"
          }
          definition {
            value: "Confirmation with Contact Person prior to making any substitutions has or will occur."
          }
        }
        concept {
          code {
            value: "NOTIFY"
          }
          display {
            value: "Notify first"
          }
          definition {
            value: "Notification to the Contact Person, prior to substitution and through normal institutional procedures, has or will be made."
          }
        }
      }
      concept {
        code {
          value: "NOSUB"
        }
        display {
          value: "No substitution"
        }
        definition {
          value: "Substitution is not permitted."
        }
      }
      concept {
        code {
          value: "UNCOND"
        }
        display {
          value: "Unconditional"
        }
        definition {
          value: "No conditions are required."
        }
      }
    }
  }
