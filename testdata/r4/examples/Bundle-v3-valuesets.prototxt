      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.EntityNameUseR2"
      }
      title {
        value: "v3 Code System EntityNameUseR2"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "  Description:\r\nA set of codes advising a system or user which name in a set of names to select for a given purpose."
      }
      immutable {
        value: true
      }
      compose {
        include {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-EntityNameUseR2"
          }
        }
      }
    }
