              value: "SUPP"
            }
            display {
              value: "Suppository"
            }
            definition {
              value: "A solid body of various weights and shapes, adapted for introduction into the rectal, vaginal, or urethral orifice of the human body; they usually melt, soften, or dissolve at body temperature."
            }
            concept {
              code {
                value: "RECSUPP"
