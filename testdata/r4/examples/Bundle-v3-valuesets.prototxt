      concept {
        code {
          value: "I"
        }
        display {
          value: "intended"
        }
        definition {
          value: "The particpant intends to provide a signature."
        }
      }
      concept {
        code {
          value: "S"
        }
        display {
          value: "signed"
        }
        definition {
          value: "Signature has been affixed, either written on file, or electronic (incl. digital) signature in Participation.signatureText."
        }
      }
      concept {
        code {
          value: "X"
        }
        display {
          value: "required"
        }
        definition {
          value: "A signature for the service is required of this actor."
        }
      }
    }
  }
}
