entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-MilitaryRoleType"
  }
  resource {
    value_set {
      id {
        value: "v3-MilitaryRoleType"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
