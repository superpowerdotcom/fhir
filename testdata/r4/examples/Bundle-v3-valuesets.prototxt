entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-MaritalStatus"
  }
  resource {
    value_set {
      id {
        value: "v3-MaritalStatus"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>A<a name=\"v3-MaritalStatus-A\"> </a></td><td>Annulled</td><td>\n                        Marriage contract has been declared null and to not have existed<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>D<a name=\"v3-MaritalStatus-D\"> </a></td><td>Divorced</td><td>\n                        Marriage contract has been declared dissolved and inactive<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>I<a name=\"v3-MaritalStatus-I\"> </a></td><td>Interlocutory</td><td>\n                        Subject to an Interlocutory Decree.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>L<a name=\"v3-MaritalStatus-L\"> </a></td><td>Legally Separated</td><td/></tr>\r\n <tr><td>1</td><td>M<a name=\"v3-MaritalStatus-M\"> </a></td><td>Married</td><td>\n                        A current marriage contract is active<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>P<a name=\"v3-MaritalStatus-P\"> </a></td><td>Polygamous</td><td>\n                        More than 1 current spouse<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>S<a name=\"v3-MaritalStatus-S\"> </a></td><td>Never Married</td><td>\n                        No marriage contract has ever been entered<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>T<a name=\"v3-MaritalStatus-T\"> </a></td><td>Domestic partner</td><td>\n                        Person declares that a domestic partner relationship exists.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>U<a name=\"v3-MaritalStatus-U\"> </a></td><td>unmarried</td><td>\n                        Currently not in a marriage contract.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>W<a name=\"v3-MaritalStatus-W\"> </a></td><td>Widowed</td><td>\n                        The spouse has died<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-MaritalStatus"
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.MaritalStatus"
      }
      title {
        value: "v3 Code System MaritalStatus"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
