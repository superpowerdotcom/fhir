      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetMilitaryRoleType</h2><div><p>Definition:\nA person playing the role of program eligible under a program based on military status.  Discussion:\nThis CoveredPartyRoleType.code is typically used when the CoveredPartyRole class code is either &quot;program eligible&quot; or &quot;subscriber&quot; and the person\'s status as a member of the military meets jurisdictional or program criteria</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include codes from <a href=\"../../v3/RoleCode/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-RoleCode</code></a> where concept  is-a  <a href=\"../../v3/RoleCode/cs.html#v3-RoleCode-MIL\">MIL</a></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-MilitaryRoleType"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.19812"
        }
      }
      version {
        value: "2014-03-26"
      }
      name {
        value: "v3.MilitaryRoleType"
      }
      title {
        value: "V3 Value SetMilitaryRoleType"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7 v3"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://www.hl7.org"
          }
        }
      }
      description {
        value: "  Definition:\r\nA person playing the role of program eligible under a program based on military status.  Discussion:\r\nThis CoveredPartyRoleType.code is typically used when the CoveredPartyRole class code is either \"program eligible\" or \"subscriber\" and the person\'s status as a member of the military meets jurisdictional or program criteria"
      }
      immutable {
      }
      compose {
