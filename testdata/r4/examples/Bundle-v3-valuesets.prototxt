td>2</td><td>\302\240\302\24046<a name=\"v3-TribalEntityUS-46\"> </a></td><td>Chitimacha Tribe of Louisiana</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24047<a name=\"v3-TribalEntityUS-47\"> </a></td><td>Choctaw Nation of Oklahoma</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24048<a name=\"v3-TribalEntityUS-48\"> </a></td><td>Citizen Potawatomi Nation, Oklahoma</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24049<a name=\"v3-TribalEntityUS-49\"> </a></td><td>Cloverdale Rancheria of Pomo Indians of California</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\2405<a name=\"v3-TribalEntityUS-5\"> </a></td><td>Alabama-Quassarte Tribal Town, Oklahoma</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24050<a name=\"v3-TribalEntityUS-50\"> </a></td><td>Cocopah Tribe of Arizona</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24051<a name=\"v3-TribalEntityUS-51\"> </a></td><td>Coeur D\'Alene Tribe of the Coeur D\'Alene Reservati</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24052<a name=\"v3-TribalEntityUS-52\"> </a></td><td>Cold Springs Rancheria of Mono Indians of Californ</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24053<a name=\"v3-TribalEntityUS-53\"> </a></td><td>Colorado River Indian Tribes of the Colorado River</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24054<a name=\"v3-TribalEntityUS-54\"> </a></td><td>Comanche Indian Tribe, Oklahoma</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24055<a name=\"v3-TribalEntityUS-55\"> </a></td><td>Confederated Salish &amp; Kootenai Tribes of the Flath</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24056<a name=\"v3-TribalEntityUS-56\"> </a></td><td>Confederated Tribes of the Chehalis Reservation, W</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24057<a name=\"v3-TribalEntityUS-57\"> </a></td><td>Confederated Tribes of the Colville Reservation, W</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24058<a name=\"v3-TribalEntityUS-58\"> </a></td><td>Confederated Tribes of the Coos, Lower Umpqua and</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24059<a name=\"v3-TribalEntityUS-59\"> </a></td><td>Confederated Tribes of the Goshute Reservation, Ne</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\2406<a name=\"v3-TribalEntityUS-6\"> </a></td><td>Alturas Indian Rancheria, California</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24060<a name=\"v3-TribalEntityUS-60\"> </a></td><td>Confederated Tribes of the Grand Ronde Community o</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24061<a name=\"v3-TribalEntityUS-61\"> </a></td><td>Confederated Tribes of the Siletz Reservation, Ore</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24062<a name=\"v3-TribalEntityUS-62\"> </a></td><td>Confederated Tribes of the Umatilla Reservation, O</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24063<a name=\"v3-TribalEntityUS-63\"> </a></td><td>Confederated Tribes of the Warm Springs Reservatio</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24064<a name=\"v3-TribalEntityUS-64\"> </a></td><td>Confederated Tribes and Bands of the Yakama Indian</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24065<a name=\"v3-TribalEntityUS-65\"> </a></td><td>Coquille Tribe of Oregon</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24066<a name=\"v3-TribalEntityUS-66\"> </a></td><td>Cortina Indian Rancheria of Wintun Indians of Cali</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24067<a name=\"v3-TribalEntityUS-67\"> </a></td><td>Coushatta Tribe of Louisiana</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24068<a name=\"v3-TribalEntityUS-68\"> </a></td><td>Cow Creek Band of Umpqua Indians of Oregon</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24069<a name=\"v3-TribalEntityUS-69\"> </a></td><td>Coyote Valley Band of Pomo Indians of California</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\2407<a name=\"v3-TribalEntityUS-7\"> </a></td><td>Apache Tribe of Oklahoma</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\24070<a name=\"v3-TribalEntityUS-70\"> </a></td><td>Crow T