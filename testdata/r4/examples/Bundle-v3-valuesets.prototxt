          concept {
            code {
              value: "JHCHRGFR"
            }
            display {
              value: "JHCHRGFR"
            }
            definition {
              value: "Good Friday, is the Friday right before Easter Sunday."
            }
          }
          concept {
            code {
              value: "JHCHRNEW"
            }
            display {
              value: "JHCHRNEW"
            }
            definition {
              value: "New Year\'s Day (January 1)"
            }
          }
          concept {
