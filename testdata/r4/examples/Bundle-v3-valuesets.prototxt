          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_NativeEntityAlaska)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-TribalEntityUS-_NativeEntityAlaska\">\302\240</a></td><td>\n                        NATIVE ENTITIES WITHIN THE STATE OF ALASKA RECOGNIZED AND ELIGIBLE TO RECEIVE SERVICES FROM THE UNITED STATES BUREAU OF INDIAN AFFAIRS<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240338<a name=\"v3-TribalEntityUS-338\"> </a></td><td>Village of Afognak</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240339<a name=\"v3-TribalEntityUS-339\"> </a></td><td>Agdaagux Tribe of King Cove</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240340<a name=\"v3-TribalEntityUS-340\"> </a></td><td>Native Village of Akhiok</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240341<a name=\"v3-TribalEntityUS-341\"> </a></td><td>Akiachak Native Community</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240342<a name=\"v3-TribalEntityUS-342\"> </a></td><td>Akiak Native Community</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240343<a name=\"v3-TribalEntityUS-343\"> </a></td><td>Native Village of Akutan</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240344<a name=\"v3-TribalEntityUS-344\"> </a></td><td>Village of Alakanuk</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240345<a name=\"v3-TribalEntityUS-345\"> </a></td><td>Alatna Village</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240346<a name=\"v3-TribalEntityUS-346\"> </a></td><td>Native Village of Aleknagik</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240347<a name=\"v3-TribalEntityUS-347\"> </a></td><td>Algaaciq Native Village (St. Mary\'s)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240348<a name=\"v3-TribalEntityUS-348\"> </a></td><td>Allakaket