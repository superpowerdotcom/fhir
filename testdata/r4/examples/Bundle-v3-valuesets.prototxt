          }
          display {
            value: "sensitive"
          }
          definition {
            value: "Description: \n                        \r\nInformation for which the patient seeks heightened confidentiality. Sensitive information is not to be shared with family members.  Information reported by the patient about family members is sensitive by default. Flag can be set or cleared on patient\'s request.\n                           Deprecation Comment:Deprecated due to updated confidentiality codes under ActCode"
          }
          property {
