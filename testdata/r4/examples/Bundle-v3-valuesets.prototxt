        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>INSTANCE<a name=\"v3-EntityDeterminer-INSTANCE\"> </a></td><td>specific</td><td>\n                        \n                           Description:A determiner that specifies that the Entity object represents a particular physical thing (as opposed to a universal, kind, or class of physical thing).<br/>\r\n\n                        \n                           Discussion: It does not matter whether an INSTANCE still exists as a whole at the point in time (or process) when we mention it, for example, a drug product lot is an INSTANCE even though it has been portioned out for retail purpose.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240GROUP<a name=\"v3-EntityDeterminer-GROUP\"> </a></td><td>specific group</td><td>\n                        A determiner that specifies that the Entity object represents a particular collection of physical things (as opposed to a universal, kind, or class of physical thing).  While the collection may resolve to having only a single individual (or even no individuals), the potential should exist for it to cover multiple individuals.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>KIND<a name=\"v3-EntityDeterminer-KIND\"> </a></td><td>described</td><td>\n                        \n                           Description:A determiner that specifies that the Entity object represents a universal, kind or class of physical thing (as opposed to a particular thing).<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240GROUPKIND<a name=\"v3-EntityDeterminer-GROUPKIND\"> </a></td><td>described group</td><td>\n                        A determiner that specifies that the Entity object represents a universal, kind or class of collections physical things.  While the collection may resolve to having only a single individual (or even no individuals), the potential should exist for it to cover multiple individuals.<br/>\r\n\n                     </td></tr>\r\n <tr style=\"background: #EFEFEF\"><td>2</td><td>\302\240\302\240QUANTIFIED_KIND<a name=\"v3-EntityDeterminer-QUANTIFIED_KIND\"> </a> <b><i>Deprecated</i></b></td><td>described quantified</td><td>\n                        The described quantified determiner indicates that the given Entity is taken as a general description of a specific amount of a thing. For example, QUANTIFIED_KIND of syringe (quantity = 3,) stands for exactly three syringes.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-EntityDeterminer"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.10878"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.EntityDeterminer"
      }
      title {
        value: "v3 Code System EntityDeterminer"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " EntityDeterminer in natural language grammar is the class of words that comprises articles, demonstrative pronouns, and quantifiers. In the RIM, determiner is a structural code in the Entity class to distinguish whether any given Entity object stands for some, any one, or a specific thing."
      }
      immutable {
        value: true
      }
      compose {
        include {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-EntityDeterminer"
          }
        }
      }
    }
  }
}
entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-WorkClassificationODH"
  }
  resource {
    value_set {
      id {
        value: "v3-WorkClassificationODH"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>PWAF<a name=\"v3-WorkClassificationODH-PWAF\"> </a></td><td>Paid work, Armed Forces</td><td>\n                        A situation in which an individual serves in a government-sponsored military force.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PWFG<a name=\"v3-WorkClassificationODH-PWFG\"> </a></td><td>Paid work, national government, not armed forces</td><td>\n                        A situation in which an individual works for a national government organization, not including armed forces, and receives a paid salary or wage.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PWLG<a name=\"v3-WorkClassificationODH-PWLG\"> </a></td><td>Paid work, local government, not armed forces</td><td>\n                        A situation in which an individual works for a government organization with jurisdiction below the level of state/provincial/territorial/tribal government (e.g., city, town, township), not armed forces, and receives a paid salary or wage.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PWNSE<a name=\"v3-WorkClassificationODH-PWNSE\"> </a></td><td>Paid non-governmental work, not self-employed</td><td>\n                        A situation in which an individual works for a business (not government) that they do not own and receives a paid salary or wage.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PWSE<a name=\"v3-WorkClassificationODH-PWSE\"> </a></td><td>Paid work, self-employed</td><td>\n                        A situation in which an individual earns a salary or wage working for himself or herself instead of working for an employer.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PWSG<a name=\"v3-WorkClassificationODH-PWSG\"> </a></td><td>Paid work, state government, not armed forces</td><td>\n                        A situation in which an individual works for a government organization with jurisdiction immediately below the level of national government (between national government and local government), not armed forces and receives a paid salary or wage.  Often called a state, provincial, territorial, or tribal government.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>UWNSE<a name=\"v3-WorkClassificationODH-UWNSE\"> </a></td><td>Unpaid non-governmental work, not self-employed</td><td>\n                        A situation in which an individual works for a business (not government) that they do not own without receiving a paid salary or wage.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>UWSE<a name=\"v3-WorkClassificationODH-UWSE\"> </a></td><td>Unpaid work, self-employed</td><td>\n                        A situation in which an individual works for himself or herself without receiving a paid salary or wage.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>VW<a name=\"v3-WorkClassificationODH-VW\"> </a></td><td>Voluntary work</td><td>\n                        A situation in which an individual chooses to do something, especially for other people or for an organization, willingly and without being forced or compensated to do it.  This can include formal activity undertaken through public, private and voluntary organizations as well as informal community participation.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-WorkClassificationODH"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.20560"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.WorkClassificationODH"
      }
