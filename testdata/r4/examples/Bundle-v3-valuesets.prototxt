        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_QueryRequestLimit)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-QueryRequestLimit-_QueryRequestLimit\">\302\240</a></td><td>\n                        \n                           Definition: The number of matching instances (number of focal classes). The document header class is the focal class of a document, a record would therefore be equal to a document.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240RD<a name=\"v3-QueryRequestLimit-RD\"> </a></td><td>record</td><td>\n                        \n                           Definition: The number of matching instances (number of focal classes). The document header class is the focal class of a document, a record would therefore be equal to a document.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
