entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-hl7VoteResolution"
  }
  resource {
    value_set {
      id {
        value: "v3-hl7VoteResolution"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(affirmativeResolution)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-hl7VoteResolution-affirmativeResolution\">\302\240</a></td><td>\n                        \n                           Description: An abstract concept grouping resolutions that can be applied to affirmative ballot comments.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240affdef<a name=\"v3-hl7VoteResolution-affdef\"> </a></td><td>affirmative-deferred</td><td>\n                        \n                           Description: The recommended change has been deferred to consideration for a future release.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240affi<a name=\"v3-hl7VoteResolution-affi\"> </a></td><td>affirmative-incorporated</td><td>\n                        \n                           Description: The recommended change has been incorporated or identified issue has been answered.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240affr<a name=\"v3-hl7VoteResolution-affr\"> </a></td><td>affirmative-rejected</td><td>\n                        \n                           Description: The recommended change has been refused and is not expected to be incorporated.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(negativeResolution)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-hl7VoteResolution-negativeResolution\">\302\240</a></td><td>\n                        \n                           Description: An abstract concept grouping resolutions that can be applied to negative ballot comments.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240nonsubp<a name=\"v3-hl7VoteResolution-nonsubp\"> </a></td><td>non-substantive proposed</td><td>\n                        \n                           Description: Responsible group has recommended that the negative vote be considered non-substantive.  (Issue raised does not provide sufficiently convincing reason to make changes to the item under ballot, or otherwise impede its adoption.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240nonsubv<a name=\"v3-hl7VoteResolution-nonsubv\"> </a></td><td>non-substantive voted</td><td>\n                        \n                           Description: Ballot group has voted and declared the negative vote non-substantive.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240notrelp<a name=\"v3-hl7VoteResolution-notrelp\"> </a></td><td>not related proposed</td><td>\n                        \n                           Description: Responsible group has recommended that the negative vote be considered not-related.  (Issue raised is not related to the current scope of the item under ballot, or does not prevent the item under ballot for being used for its defined intent.  Recommended changes may be considered as part of future versions.)  (Perhaps after further reading or explanation).<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240notrelv<a name=\"v3-hl7VoteResolution-notrelv\"> </a></td><td>not related voted</td><td>\n                        \n                           Description: Ballot group has voted and declared the negative vote non-related.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240prevcons<a name=\"v3-hl7VoteResolution-prevcons\"> </a></td><td>previously considered</td><td>\n                        \n                           Description: Committee identifies that the same issue has been raised as part of a previous ballot on the same element version and was found by the ballot group to be non-substantive or not related.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240retract<a name=\"v3-hl7VoteResolution-retract\"> </a></td><td>retracted</td><td>\n                        \n                           Description: Voter has formally withdrawn their vote or comment as having been in error.  (Perhaps after further reading or explanation).<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240unresolved<a name=\"v3-hl7VoteResolution-unresolved\"> </a></td><td>unresolved</td><td>\n                        \n                           Description: Vote has not yet gone through resolution.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240withdraw<a name=\"v3-hl7VoteResolution-withdraw\"> </a></td><td>withdrawn</td><td>\n                        \n                           Description: Voter has formally withdrawn their vote or comment on the basis of agreed changes or proposed future changes.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
