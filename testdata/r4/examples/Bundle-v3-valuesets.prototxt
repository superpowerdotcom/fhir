entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-ObservationMethod"
  }
  resource {
    value_set {
      id {
        value: "v3-ObservationMethod"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_DecisionObservationMethod)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ObservationMethod-_DecisionObservationMethod\">\302\240</a></td><td>\n                        Provides codes for decision methods, initially for assessing the causality of events.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ALGM<a name=\"v3-ObservationMethod-ALGM\"> </a></td><td>algorithm</td><td>\n                        Reaching a decision through the application of an algorithm designed to weigh the different factors involved.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BYCL<a name=\"v3-ObservationMethod-BYCL\"> </a></td><td>bayesian calculation</td><td>\n                        Reaching a decision through the use of Bayesian statistical analysis.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240GINT<a name=\"v3-ObservationMethod-GINT\"> </a></td><td>global introspection</td><td>\n                        Reaching a decision by consideration of the totality of factors involved in order to reach a judgement.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_GeneticObservationMethod)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ObservationMethod-_GeneticObservationMethod\">\302\240</a></td><td>\n                        A code that provides additional detail about the means or technique used to ascertain the genetic analysis. Example, PCR, Micro Array<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PCR<a name=\"v3-ObservationMethod-PCR\"> </a></td><td>PCR</td><td>\n                        \n                           Description: Polymerase Chain Reaction<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_ObservationMethodAggregate)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ObservationMethod-_ObservationMethodAggregate\">\302\240</a></td><td>\n                        Provides additional detail about the aggregation methods used to compute the aggregated values for an observation. This is an abstract code.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240AVERAGE<a name=\"v3-ObservationMethod-AVERAGE\"> </a></td><td>average</td><td>\n                        Average of non-null values in the referenced set of values<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240COUNT<a name=\"v3-ObservationMethod-COUNT\"> </a></td><td>count</td><td>\n                        Count of non-null values in the referenced set of values<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MAX<a name=\"v3-ObservationMethod-MAX\"> </a></td><td>maxima</td><td>\n                        Largest of all non-null values in the referenced set of values.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MEDIAN<a name=\"v3-ObservationMethod-MEDIAN\"> </a></td><td>median</td><td>\n                        The median of all non-null values in the referenced set of values.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MIN<a name=\"v3-ObservationMethod-MIN\"> </a></td><td>minima</td><td>\n                        Smallest of all non-null values in the referenced set of values.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MODE<a name=\"v3-ObservationMethod-MODE\"> </a></td><td>mode</td><td>\n                        The most common value of all non-null values in the referenced set of values.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240STDEV.P<a name=\"v3-ObservationMethod-STDEV.46P\"> </a></td><td>population standard deviation</td><td>\n                        Standard Deviation of the values in the referenced set of values, computed over the population.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240STDEV.S<a name=\"v3-ObservationMethod-STDEV.46S\"> </a></td><td>sample standard deviation</td><td>\n                        Standard Deviation of the values in the referenced set of values, computed over a sample of the population.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SUM<a name=\"v3-ObservationMethod-SUM\"> </a></td><td>sum</td><td>\n                        Sum of non-null values in the referenced set of values<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240VARIANCE.P<a name=\"v3-ObservationMethod-VARIANCE.46P\"> </a></td><td>population variance</td><td>\n                        Variance of the values in the referenced set of values, computed over the population.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240VARIANCE.S<a name=\"v3-ObservationMethod-VARIANCE.46S\"> </a></td><td>sample variance</td><td>\n                        Variance of the values in the referenced set of values, computed over a sample of the population.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_VerificationMethod)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ObservationMethod-_VerificationMethod\">\302\240</a></td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240VDOC<a name=\"v3-ObservationMethod-VDOC\"> </a></td><td>document verification</td><td>\n                        Verification by means of document.<br/>\r\n\n                        \n                           Example: Fax, letter, attachment to e-mail.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240VREG<a name=\"v3-ObservationMethod-VREG\"> </a></td><td>registry verification</td><td>\n                        verification by means of  a response to an electronic query<br/>\r\n\n                        \n                           Example: query message to a Covered Party registry application or Coverage Administrator.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240VTOKEN<a name=\"v3-ObservationMethod-VTOKEN\"> </a></td><td>electronic token verification</td><td>\n                        Verification by means of electronic token.<br/>\r\n\n                        \n                           Example: smartcard, magnetic swipe card, RFID device.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240VVOICE<a name=\"v3-ObservationMethod-VVOICE\"> </a></td><td>voice-based verification</td><td>\n                        Verification by means of voice.<br/>\r\n\n                        \n                           Example: By speaking with or calling the Coverage Administrator or Covered Party<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0001<a name=\"v3-ObservationMethod-0001\"> </a></td><td>Complement fixation</td><td>\n                        Complement fixation<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0002<a name=\"v3-ObservationMethod-0002\"> </a></td><td>Computed axial tomography</td><td>\n                        Computed axial tomography<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0003<a name=\"v3-ObservationMethod-0003\"> </a></td><td>HLAR agar test</td><td>\n                        Susceptibility, High Level Aminoglycoside Resistance agar test<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0004<a name=\"v3-ObservationMethod-0004\"> </a></td><td>Macroscopic observation</td><td>\n                        Visual, Macroscopic observation<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0005<a name=\"v3-ObservationMethod-0005\"> </a></td><td>Magnetic resonance</td><td>\n                        Computed, Magnetic resonance<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0006<a name=\"v3-ObservationMethod-0006\"> </a></td><td>Morphometry</td><td>\n                        Computed, Morphometry<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0007<a name=\"v3-ObservationMethod-0007\"> </a></td><td>Positron emission tomography</td><td>\n                        Computed, Positron emission tomography<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0008<a name=\"v3-ObservationMethod-0008\"> </a></td><td>SAMHSA confirmation</td><td>\n                        SAMHSA drug assay confirmation<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0009<a name=\"v3-ObservationMethod-0009\"> </a></td><td>SAMHSA screening</td><td>\n                        SAMHSA drug assay screening<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0010<a name=\"v3-ObservationMethod-0010\"> </a></td><td>Serum Neutralization</td><td>\n                        Serum Neutralization<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0011<a name=\"v3-ObservationMethod-0011\"> </a></td><td>Titration</td><td>\n                        Titration<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0012<a name=\"v3-ObservationMethod-0012\"> </a></td><td>Ultrasound</td><td>\n                        Ultrasound<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0013<a name=\"v3-ObservationMethod-0013\"> </a></td><td>X-ray crystallography</td><td>\n                        X-ray crystallography<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0014<a name=\"v3-ObservationMethod-0014\"> </a></td><td>Agglutination</td><td>\n                        Agglutination<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>0015<a name=\"v3-ObservationMethod-0015\"> </a></td><td>Buffered acidified plate agglutination</td><td>\n                  