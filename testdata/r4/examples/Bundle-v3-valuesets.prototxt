entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-AddressUse"
  }
  resource {
    value_set {
      id {
        value: "v3-AddressUse"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_GeneralAddressUse)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AddressUse-_GeneralAddressUse\">\302\240</a></td><td>\n                        \n                           Description: Address uses that can apply to both postal and telecommunication addresses.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240BAD<a name=\"v3-AddressUse-BAD\"> </a></td><td>bad address</td><td>\n                        \n                           Description: A flag indicating that the address is bad, in fact, useless.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CONF<a name=\"v3-AddressUse-CONF\"> </a></td><td>confidential address</td><td>\n                        \n                           Description: Indicates that the address is considered sensitive and should only be shared or published in accordance with organizational controls governing patient demographic information with increased sensitivity. Uses of Addresses.   Lloyd to supply more complete description.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240H<a name=\"v3-AddressUse-H\"> </a></td><td>home address</td><td>\n                        \n                           Description: A communication address at a home, attempted contacts for business purposes might intrude privacy and chances are one will contact family or other household members instead of the person one wishes to call. Typically used with urgent cases, or if no other contacts are available.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HP<a name=\"v3-AddressUse-HP\"> </a></td><td>primary home</td><td>\n                        \n                           Description: The primary home, to reach a person after business hours.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HV<a name=\"v3-AddressUse-HV\"> </a></td><td>vacation home</td><td>\n                        \n                           Description: A vacation home, to reach a person while on vacation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240OLD<a name=\"v3-AddressUse-OLD\"> </a></td><td>no longer in use</td><td>\n                        This address is no longer in use.<br/>\r\n\n                        \n                           Usage Note: Address may also carry valid time ranges. This code is used to cover the situations where it is known that the address is no longer valid, but no particular time range for its use is known.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TMP<a name=\"v3-AddressUse-TMP\"> </a></td><td>temporary address</td><td>\n                        \n                           Description: A temporary address, may be good for visit or mailing. Note that an address history can provide more detailed information.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240WP<a name=\"v3-AddressUse-WP\"> </a></td><td>work place</td><td>\n                        \n                           Description: An office address. First choice for business related contacts during business hours.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240DIR<a name=\"v3-AddressUse-DIR\"> </a></td><td>direct</td><td>\n                        \n                           Description: Indicates a work place address or telecommunication address that reaches the individual or organization directly without intermediaries. For phones, often referred to as a \'private line\'.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PUB<a name=\"v3-AddressUse-PUB\"> </a></td><td>public</td><td>\n                        \n                           Description: Indicates a work place address or telecommunication address that is a \'standard\' address which may reach a reception service, mail-room, or other intermediary prior to the target entity.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_PostalAddressUse)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AddressUse-_PostalAddressUse\">\302\240</a></td><td>\n                        \n                           Description: Address uses that only apply to postal addresses, not telecommunication addresses.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PHYS<a name=\"v3-AddressUse-PHYS\"> </a></td><td>physical visit address</td><td>\n                        \n                           Description: Used primarily to visit an address.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PST<a name=\"v3-AddressUse-PST\"> </a></td><td>postal address</td><td>\n                        \n                           Description: Used to send mail.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_TelecommunicationAddressUse)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AddressUse-_TelecommunicationAddressUse\">\302\240</a></td><td>\n                        \n                           Description: Address uses that only apply to telecommunication addresses, not postal addresses.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240AS<a name=\"v3-AddressUse-AS\"> </a></td><td>answering service</td><td>\n                        \n                           Description: An automated answering machine used for less urgent cases and if the main purpose of contact is to leave a message or access an automated announcement.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240EC<a name=\"v3-AddressUse-EC\"> </a></td><td>emergency contact</td><td>\n                        \n                           Description: A contact specifically designated to be used for emergencies. This is the first choice in emergencies, independent of any other use codes.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MC<a name=\"v3-AddressUse-MC\"> </a></td><td>mobile contact)</td><td>\n                        \n                           Description: A telecommunication device that moves and stays with its owner. May have characteristics of all other use codes, suitable for urgent matters, not the first choice for routine business.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PG<a name=\"v3-AddressUse-PG\"> </a></td><td>pager</td><td>\n                        \n                           Description: A paging device suitable to solicit a callback or to leave a very short message.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-AddressUse"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.190"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.AddressUse"
      }
      title {
        value: "v3 Code System AddressUse"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " Codes that provide guidance around the circumstances in which a given address should be used."
      }
      immutable {
        value: true
      }
      compose {
        include {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-AddressUse"
          }
        }
      }
    }
  }
}
entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-HL7UpdateMode"
  }
  resource {
    value_set {
      id {
        value: "v3-HL7UpdateMode"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>A<a name=\"v3-HL7UpdateMode-A\"> </a></td><td>Add</td><td>\n                        \n                           Description:The item was (or is to be) added, having not been present immediately before. (If it is already present, this may be treated as an error condition.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>AR<a name=\"v3-HL7UpdateMode-AR\"> </a></td><td>Add or Replace</td><td>\n                        \n                           Description:The item was (or is to be) either added or replaced. <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>D<a name=\"v3-HL7UpdateMode-D\"> </a></td><td>Remove</td><td>\n                        \n                           Description:The item was (or is to be) removed (sometimes referred to as deleted). If the item is part of a collection, delete any matching items.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>K<a name=\"v3-HL7UpdateMode-K\"> </a></td><td>Key</td><td>\n                        \n                           Description:This item is part of the identifying information for this object.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>N<a name=\"v3-HL7UpdateMode-N\"> </a></td><td>No Change</td><td>\n                        \n                           Description:There was (or is to be) no change to the item. This is primarily used when this element has not changed, but other attributes in the instance have changed. <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>R<a name=\"v3-HL7UpdateMode-R\"> </a></td><td>Replace</td><td>\n                        \n                           Description:The item existed previously and has (or is to be) revised. (If an item does not already exist, this may be treated as an error condition.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>REF<a name=\"v3-HL7UpdateMode-REF\"> </a></td><td>Reference</td><td>\n                        \n                           Description:This item provides enough information to allow a processing system to locate the full applicable record by identifying the object.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>U<a name=\"v3-HL7UpdateMode-U\"> </a></td><td>Unknown</td><td>\n                        \n                           Description:Description:&lt;/b&gt;It is not specified whether or what kind of change has occurred to the item, or whether the item is present as a reference or identifying property. <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_SetUpdateMode)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-HL7UpdateMode-_SetUpdateMode\">\302\240</a></td><td>\n                        These concepts apply when the element and/or message is updating a set of items.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ESA<a name=\"v3-HL7UpdateMode-ESA\"> </a></td><td>Set Add</td><td>\n                        Add the message element to the collection of items on the receiving system that correspond to the message element.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ESAC<a name=\"v3-HL7UpdateMode-ESAC\"> </a></td><td>Set Add or Change</td><td>\n                        Change the item on the receiving system that corresponds to this message element; if a matching element does not exist, add a new one created with the values in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ESC<a name=\"v3-HL7UpdateMode-ESC\"> </a></td><td>Set Change</td><td>\n                        Change the item on the receiving system that corresponds to this message element; do not process if a matching element does not exist.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ESD<a name=\"v3-HL7UpdateMode-ESD\"> </a></td><td>Set Delete</td><td>\n                        Delete the item on the receiving system that corresponds to this message element.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>AU<a name=\"v3-HL7UpdateMode-AU\"> </a></td><td>Add or Update</td><td>\n                        \n                           Description: AU: If this item exists, update it with these values. If it does not exist, create it with these values. If the item is part of the collection, update each item that matches this item, and if no items match, add a new item to the collection.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>I<a name=\"v3-HL7UpdateMode-I\"> </a></td><td>Ignore</td><td>\n                        Ignore this role, it is not relevant to the update.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>V<a name=\"v3-HL7UpdateMode-V\"> </a></td><td>Verify</td><td>\n                        Verify - this message element must match a value already in the receiving systems database in order to process the message.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
