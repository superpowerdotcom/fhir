        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1123"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.DataOperation"
      }
      title {
        value: "v3 Code System DataOperation"
      }
      status {
        value: ACTIVE
