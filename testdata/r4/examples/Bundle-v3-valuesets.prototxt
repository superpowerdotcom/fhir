        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>COD<a name=\"v3-PaymentTerms-COD\"> </a></td><td>Cash on Delivery</td><td>\n                        Payment in full for products and/or services is required as soon as the service is performed or goods delivered.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>N30<a name=\"v3-PaymentTerms-N30\"> </a></td><td>Net 30 days</td><td>\n                        Payment in full for products and/or services is required 30 days from the time the service is performed or goods delivered.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>N60<a name=\"v3-PaymentTerms-N60\"> </a></td><td>Net 60 days</td><td>\n                        Payment in full for products and/or services is required 60 days from the time the service is performed or goods delivered.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>N90<a name=\"v3-PaymentTerms-N90\"> </a></td><td>Net 90 days</td><td>\n                        Payment in full for products and/or services is required 90 days from the time the service is performed or goods delivered.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
