          value: "QueryRequestLimit"
        }
        definition {
          value: "Definition: The number of matching instances (number of focal classes). The document header class is the focal class of a document, a record would therefore be equal to a document."
        }
        property {
          code {
            value: "notSelectable"
          }
          value {
            boolean {
              value: true
            }
          }
        }
        concept {
