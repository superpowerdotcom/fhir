entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-EntityCode"
  }
  resource {
    value_set {
      id {
        value: "v3-EntityCode"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_MaterialEntityClassType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_MaterialEntityClassType\">\302\240</a></td><td>\n                        Types of Material for EntityClass &quot;MAT&quot;<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_ContainerEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_ContainerEntityType\">\302\240</a></td><td>\n                        Material intended to hold another material for purpose of storage or transport.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PKG<a name=\"v3-EntityCode-PKG\"> </a></td><td>Package</td><td>\n                        A material intended to hold other materials for purposes of storage or transportation<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_NonRigidContainerEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_NonRigidContainerEntityType\">\302\240</a></td><td>\n                        A container having dimensions that adjust somewhat based on the amount and shape of the material placed within it.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BAG<a name=\"v3-EntityCode-BAG\"> </a></td><td>Bag</td><td>\n                        A pouched or pendulous container.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240PACKT<a name=\"v3-EntityCode-PACKT\"> </a></td><td>Packet</td><td>\n                        A paper<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240PCH<a name=\"v3-EntityCode-PCH\"> </a></td><td>Pouch</td><td>\n                        A small bag or container made of a soft material.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240SACH<a name=\"v3-EntityCode-SACH\"> </a></td><td>Sachet</td><td>\n                        A small bag or packet containing a small portion of a substance.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_RigidContainerEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_RigidContainerEntityType\">\302\240</a></td><td>\n                        A container having a fixed and inflexible dimensions and volume<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_IndividualPackageEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_IndividualPackageEntityType\">\302\240</a></td><td>\n                        Container intended to contain sufficient material for only one use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240AMP<a name=\"v3-EntityCode-AMP\"> </a></td><td>Ampule</td><td>\n                        A small sealed glass container that holds a measured amount of a medicinal substance.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240MINIM<a name=\"v3-EntityCode-MINIM\"> </a></td><td>Minim</td><td>\n                        Individually dosed ophthalmic solution.  One time eye dropper dispenser.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240NEBAMP<a name=\"v3-EntityCode-NEBAMP\"> </a></td><td>Nebuamp</td><td>\n                        Individually dosed inhalation solution.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240OVUL<a name=\"v3-EntityCode-OVUL\"> </a></td><td>Ovule</td><td>\n                        A container either glass or plastic and a narrow neck, for storing liquid.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_MultiUseContainerEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_MultiUseContainerEntityType\">\302\240</a></td><td>\n                        A container intended to contain sufficient material for more than one use.  (I.e. Material is intended to be removed from the container at more than one discrete time period.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BOT<a name=\"v3-EntityCode-BOT\"> </a></td><td>Bottle</td><td>\n                        A container, typically rounded, either glass or plastic with a narrow neck and capable of storing liquid.<br/>\r\n\n                     </td></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BOTA<a name=\"v3-EntityCode-BOTA\"> </a></td><td>Amber Bottle</td><td>\n                        A bottle of yellow to brown color.  Used to store light-sensitive materials<br/>\r\n\n                     </td></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BOTD<a name=\"v3-EntityCode-BOTD\"> </a></td><td>Dropper Bottle</td><td>\n                        A bottle with a cap designed to release the contained liquid in droplets of a specific size.<br/>\r\n\n                     </td></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BOTG<a name=\"v3-EntityCode-BOTG\"> </a></td><td>Glass Bottle</td><td>\n                        A bottle made of glass<br/>\r\n\n                     </td></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BOTP<a name=\"v3-EntityCode-BOTP\"> </a></td><td>Plastic Bottle</td><td>\n                        A bottle made of plastic<br/>\r\n\n                     </td></tr>\r\n <tr><td>8</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BOTPLY<a name=\"v3-EntityCode-BOTPLY\"> </a></td><td>Polyethylene Bottle</td><td>\n                        A bottle made of polyethylene<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BOX<a name=\"v3-EntityCode-BOX\"> </a></td><td>Box</td><td>\n                        A 6-sided container commonly made from paper or cardboard used for solid forms.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CAN<a name=\"v3-EntityCode-CAN\"> </a></td><td>Can</td><td>\n                        A metal container in which a material is hermetically sealed to enable storage over long periods.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CART<a name=\"v3-EntityCode-CART\"> </a></td><td>Cartridge</td><td>\n                        A sealed container of liquid or powder intended to be loaded into a device.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CNSTR<a name=\"v3-EntityCode-CNSTR\"> </a></td><td>Canister</td><td>\n                        A pressurized metal container holding a substance released as a spray or aerosol.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240JAR<a name=\"v3-EntityCode-JAR\"> </a></td><td>Jar</td><td>\n                        A container of glass, earthenware, plastic, etc.  Top of the container has a diameter of similar size to the diameter of the container as a whole<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240JUG<a name=\"v3-EntityCode-JUG\"> </a></td><td>Jug</td><td>\n                        A deep vessel  for holding liquids, with a handle and often with a spout or lip shape for pouring.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TIN<a name=\"v3-EntityCode-TIN\"> </a></td><td>Tin</td><td>\n                        A lidded container made of thin sheet metal.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TUB<a name=\"v3-EntityCode-TUB\"> </a></td><td>Tub</td><td>\n                        An open flat bottomed round container.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TUBE<a name=\"v3-EntityCode-TUBE\"> </a></td><td>Tube</td><td>\n                        A long hollow rigid or flexible cylinder.  Material is extruded by squeezing the container.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240VIAL<a name=\"v3-EntityCode-VIAL\"> </a></td><td>Vial</td><td>\n                        A small cylindrical glass for holding liquid medicines.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BLSTRPK<a name=\"v3-EntityCode-BLSTRPK\"> </a></td><td>Blister Pack</td><td>\n                        A bubblepack.  Medications sealed individually, separated into doses.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CARD<a name=\"v3-EntityCode-CARD\"> </a></td><td>Card</td><td>\n                        A bubble pack card.  Multiple individual/separated doses.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240COMPPKG<a name=\"v3-EntityCode-COMPPKG\"> </a></td><td>Compliance Package</td><td>\n                        A container intended to contain sufficient material for more than one use, but grouped or organized to provide individual access to sufficient material for a single use.  Often used to ensure that the proper type and amount of material is consumed/expended for each use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240<a href=\"#BLSTRPK\">BLSTRPK</a></td><td/><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DIALPK<a name=\"v3-EntityCode-DIALPK\"> </a></td><td>Dial Pack</td><td>\n                        Rotatable dispenser.  Eg. Birth control package.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DISK<a name=\"v3-EntityCode-DISK\"> </a></td><td>Disk</td><td>\n                        Object that is thin, flat, and circular.  Doses of medication often contained in bubbles on the disk.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DOSET<a name=\"v3-EntityCode-DOSET\"> </a></td><td>Dosette</td><td>\n                        Special packaging that will help patients take their medications on a regular basis.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240STRIP<a name=\"v3-EntityCode-STRIP\"> </a></td><td>Strip</td><td>\n                        A continuous strip of plastic sectioned into individual pouches, each one containing the quantity of 1 or more medications intended to be administered at a specific time<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240KIT<a name=\"v3-EntityCode-KIT\"> </a></td><td>Kit</td><td>\n                        A container for a diverse collection of products intended to be used together for some purpose (e.g. Medicinal kits often contain a syringe, a needle and the injectable medication).<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240SYSTM<a name=\"v3-EntityCode-SYSTM\"> </a></td><td>System</td><td>\n                        A kit in which the components are interconnected.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_MedicalDevice)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_MedicalDevice\">\302\240</a></td><td>\n                        A device with direct or indirect therapeutic purpose.  Values for EntityCode when EntityClass = &quot;DEV&quot;<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_AccessMedicalDevice)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_AccessMedicalDevice\">\302\240</a></td><td>\n                        A device used to allow access to a part of a body<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240LINE<a name=\"v3-EntityCode-LINE\"> </a></td><td>Line</td><td>\n                        A hollow tube used to administer a substance into a vein, artery or body cavity<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240IALINE<a name=\"v3-EntityCode-IALINE\"> </a></td><td>Intra-arterial Line</td><td>\n                        A line used to administer a substance into an artery<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240IVLINE<a name=\"v3-EntityCode-IVLINE\"> </a></td><td>Intraveneous Line</td><td>\n                        A line used to administer a substance into a vein<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_AdministrationMedicalDevice)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_AdministrationMedicalDevice\">\302\240</a></td><td>\n                        A device intended to administer a substance to a subject<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_InjectionMedicalDevice)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_InjectionMedicalDevice\">\302\240</a></td><td>\n                        A device intended to administer liquid into a subject via a<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240AINJ<a name=\"v3-EntityCode-AINJ\"> </a></td><td>AutoInjector</td><td>\n                        Automatically injects medication.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240PEN<a name=\"v3-EntityCode-PEN\"> </a></td><td>Pen</td><td>\n                        A device which can contain a cartridge for injection purposes.  Eg. Insulin pen.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240SYR<a name=\"v3-EntityCode-SYR\"> </a></td><td>Syringe</td><td>\n                        A barrel with a plunger.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240APLCTR<a name=\"v3-EntityCode-APLCTR\"> </a></td><td>Applicator</td><td>\n                        A device used to apply a liquid or powder to a surface.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240INH<a name=\"v3-EntityCode-INH\"> </a></td><td>Inhaler</td><td>\n                        A small device used for inhaling medicine in the form of a vapour or gas in order to ease a respiratory condition such as asthma or to relieve nasal congestion.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DSKS<a name=\"v3-EntityCode-DSKS\"> </a></td><td>Diskus</td><td>\n                        The device used to inhale the doses of medication contained in the disk form.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DSKUNH<a name=\"v3-EntityCode-DSKUNH\"> </a></td><td>Diskhaler</td><td>\n                        The device used to inhale the doses of medication contained in the disk form.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TRBINH<a name=\"v3-EntityCode-TRBINH\"> </a></td><td>Turbuhaler</td><td>\n                        Asthma medication delivery device.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240PMP<a name=\"v3-EntityCode-PMP\"> </a></td><td>Pump</td><td>\n                        A device that is used to raise, compress, or transfer liquids or gases and is operated by a piston or similar mechanism.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_SpecimenAdditiveEntity)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_SpecimenAdditiveEntity\">\302\240</a></td><td>\n                        Set of codes related to specimen additives<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ACDA<a name=\"v3-EntityCode-ACDA\"> </a></td><td>ACD Solution A</td><td>\n                        ACD Solution A of trisodium citrate, 22.0g/L; citric acid, 8.0 g/L; and dextrose 24.5 g/L. Used in Blood banking and histocompatibilty testing<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ACDB<a name=\"v3-EntityCode-ACDB\"> </a></td><td>ACD Solution B</td><td>\n                        ACD Solution B of trisodium citrate, 13.2g/L; citric acid, 4.8 g/L; and dextrose 14.7 g/L. Used in Blood banking and histocompatibilty testing.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ACET<a name=\"v3-EntityCode-ACET\"> </a></td><td>Acetic Acid</td><td>\n                        50% V/V acetic acid in water.  Used as  a urine preservative<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240AMIES<a name=\"v3-EntityCode-AMIES\"> </a></td><td>Amies transport medium</td><td>\n                        Sodium Chloride 3.0g, Potassium Chloride 0.2g, Calcium Chloride 0.1g, Magnesium Chloride 0.1g, Monopotassium Phosphate 0.2g, Disodium Phosphate 1.15g, Sodium Thiogly collate 1.0g, Distilled Water 1 liter<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BACTM<a name=\"v3-EntityCode-BACTM\"> </a></td><td>Bacterial Transport medium</td><td>\n                        Any medium used to maintain bacterial viability (e.g. Stuart\'s, Cary-Blair, Amies)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BF10<a name=\"v3-EntityCode-BF10\"> </a></td><td>Buffered 10% formalin</td><td>\n                        Formaldehyde 4% w/v; methyl alcohol 1% w/v; phosphate buffering salts. Tissue preservative<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BOR<a name=\"v3-EntityCode-BOR\"> </a></td><td>Boric Acid</td><td>\n                        Powdered boric acid (usually 10 g) added to 24-hour urine collections as a preservative.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BOUIN<a name=\"v3-EntityCode-BOUIN\"> </a></td><td>Bouin\'s solution</td><td>\n                        Picric acid, saturated aqueous solution (750.0 ml), 37-40% formalin (250.0 ml), glacial acetic acid (50.0 ml). Tissue preservative.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BSKM<a name=\"v3-EntityCode-BSKM\"> </a></td><td>Buffered skim milk</td><td>\n                        50% skim milk in 0.01 M phosphate-buffered saline.  Maintain virus viability<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240C32<a name=\"v3-EntityCode-C32\"> </a></td><td>3.2% Citrate</td><td>\n                        A 3.2% solution of Sodium Citrate in water.  Used as a blood preservative<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240C38<a name=\"v3-EntityCode-C38\"> </a></td><td>3.8% Citrate</td><td>\n                        A 3.8% solution of Sodium Citrate in water. Used as a blood preservative<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CARS<a name=\"v3-EntityCode-CARS\"> </a></td><td>Carson\'s Modified 10% formalin</td><td>\n                        A modification of buffered 10% formalin used as a general tissue preservative.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CARY<a name=\"v3-EntityCode-CARY\"> </a></td><td>Cary Blair Medium</td><td>\n                        Sodium Thioglycollate 1.5 g, Disodium Hydrogen Phosphate 1.1 g, Sodium Chloride 5.0 g, Calcium Chloride 0.09 g, Agar 5.0 g, per Liter of Water<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CHLTM<a name=\"v3-EntityCode-CHLTM\"> </a></td><td>Chlamydia transport medium</td><td>\n                        Any of a number of non-nutritive buffered media used to maintain Chlamydia viability during transportation to the laboratory<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CTAD<a name=\"v3-EntityCode-CTAD\"> </a></td><td>CTAD</td><td>\n                        Buffered tri-sodium citrate solution with theophylline, adenosine and dipyridamole<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240EDTK15<a name=\"v3-EntityCode-EDTK15\"> </a></td><td>Potassium/K EDTA 15%</td><td>\n                        Potassium EDTA 15% solution in water<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240EDTK75<a name=\"v3-EntityCode-EDTK75\"> </a></td><td>Potassium/K EDTA 7.5%</td><td>\n                        Potassium EDTA 7.5% solution in water<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240EDTN<a name=\"v3-EntityCode-EDTN\"> </a></td><td>Sodium/Na EDTA</td><td>\n                        Sodium fluoride and Disodium EDTA<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ENT<a name=\"v3-EntityCode-ENT\"> </a></td><td>Enteric bacteria transport medium</td><td>\n                        Any of a number of non-nutritive buffered media used to maintain enteric bacterial viability during transportation to the laboratory<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240F10<a name=\"v3-EntityCode-F10\"> </a></td><td>10% Formalin</td><td>\n                        A 10% v/v solution in water of formalin( a 37% solution of formaldehyde and water).  Used for tissue preservation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240FDP<a name=\"v3-EntityCode-FDP\"> </a></td><td>Thrombin NIH; soybean trypsin inhibitor</td><td>\n                        Thrombin plus soybean trypsin inhibitor.  For use in identifying fibrn degredation products.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240FL10<a name=\"v3-EntityCode-FL10\"> </a></td><td>Sodium Fluoride, 10mg</td><td>\n                        Sodium fluoride, 10mg added as a urine preservative.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240FL100<a name=\"v3-EntityCode-FL100\"> </a></td><td>Sodium Fluoride, 100mg</td><td>\n                        Sodium fluoride, 100mg added as a urine preservative.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HCL6<a name=\"v3-EntityCode-HCL6\"> </a></td><td>6N HCL</td><td>\n                        A solution of HCl containing 6moles of hydrogen ion/L. Used as a Urine Preservative.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HEPA<a name=\"v3-EntityCode-HEPA\"> </a></td><td>Ammonium heparin</td><td>\n                        Ammonium heparin<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HEPL<a name=\"v3-EntityCode-HEPL\"> </a></td><td>Lithium/Li Heparin</td><td>\n                        Lithium heparin salt<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HEPN<a name=\"v3-EntityCode-HEPN\"> </a></td><td>Sodium/Na Heparin</td><td>\n                        Sodium heparin salt<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HNO3<a name=\"v3-EntityCode-HNO3\"> </a></td><td>Nitric Acid</td><td>\n                        6N Nitric acid used to preserve urine for heavy metal analysis.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JKM<a name=\"v3-EntityCode-JKM\"> </a></td><td>Jones Kendrick Medium</td><td>\n                        A transport medium formulated to maintain Bordetella pertussis viability.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240KARN<a name=\"v3-EntityCode-KARN\"> </a></td><td>Karnovsky\'s fixative</td><td>\n                        5% Glutaraldehyde, 4% Formaldehyde in 0.08M buffer. Tissue preservation<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240KOX<a name=\"v3-EntityCode-KOX\"> </a></td><td>Potassium Oxalate</td><td>\n                        Potassium oxalate and sodium fluoride in a 1.25:1 ratio<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LIA<a name=\"v3-EntityCode-LIA\"> </a></td><td>Lithium iodoacetate</td><td>\n                        Iodoacetate lithium salt<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240M4<a name=\"v3-EntityCode-M4\"> </a></td><td>M4</td><td>\n                        Modified Hank\'s balanced salt solution supplemented with bovine serum albumin, gelatin, sucrose and glutamic acid. It is buffered to pH 7.3+ or - 0.2 with HEPES buffer. Phenol red is used to indicate pH. Vancomycin, Amphotericin B and Colistin are used to<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240M4RT<a name=\"v3-EntityCode-M4RT\"> </a></td><td>M4-RT</td><td>\n                        Modified Hank\'s balanced salt solution supplemented with bovine serum albumin, gelatin, sucrose and glutamic acid. It is buffered to pH 7.3+ or - 0.2 with Hepes buffer. Phenol red is used to indicate pH. Gentamicin and amphotericin B are used to inhibit c<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240M5<a name=\"v3-EntityCode-M5\"> </a></td><td>M5</td><td>\n                        Modified Hank\'s balanced salt solution supplemented with protein stabilizers, sucrose and glutamic acid. It is buffered to pH 7.3+ or - 0.2 with Hepes buffer. Phenol red is used to indicate pH. Vancomycin, Amphotericin B and Colistin are used to inhibit c<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240MICHTM<a name=\"v3-EntityCode-MICHTM\"> </a></td><td>Michel\'s transport medium</td><td>\n                        1M potassium citrate, pH 7.0 2.5 ml, 0.1M magnesium sulfate 5.0 ml, 0.1M N-ethyl malemide  5.0 ml, dH2O 87.5 ml, ammonium sulfate 55gm. Preserve antigens for Immunofluorescence procedures<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240MMDTM<a name=\"v3-EntityCode-MMDTM\"> </a></td><td>MMD transport medium</td><td>\n                        A buffered medium with ammonium sulfate added to preserve antigens for Immunofluorescence procedures<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240NAF<a name=\"v3-EntityCode-NAF\"> </a></td><td>Sodium Fluoride</td><td>\n                        Sodium fluoride<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240NONE<a name=\"v3-EntityCode-NONE\"> </a></td><td>None</td><td>\n                        No additive. Specifically identifes the specimen as having no additives.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PAGE<a name=\"v3-EntityCode-PAGE\"> </a></td><td>Page\'s Saline</td><td>\n                        0.12 g NaCl, 0.004 g MgSO, 0.004 g, CaCl, 0.142 g Na2HPO4 and 0.136 g KH2PO4 per liter of distilled water. Maintain Acanthaoemba viability.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PHENOL<a name=\"v3-EntityCode-PHENOL\"> </a></td><td>Phenol</td><td>\n                        Phenol. Urine preservative<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PVA<a name=\"v3-EntityCode-PVA\"> </a></td><td>Polyvinylalcohol</td><td>\n                        Polyvinyl alcohol<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RLM<a name=\"v3-EntityCode-RLM\"> </a></td><td>Reagan Lowe Medium</td><td>\n                        A transport medium formulated to maintain Bordetella pertussis viability.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SILICA<a name=\"v3-EntityCode-SILICA\"> </a></td><td>Siliceous earth</td><td>\n                        Diatomaceous earth. For glucose determination blood samples<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SPS<a name=\"v3-EntityCode-SPS\"> </a></td><td>Sodium polyanethol sulfonate 0.35% in 0.85% sodium chloride</td><td>\n                        Sodium polyanethol sulfonate in saline. Anticomplementary and antiphagocytic properties. Used in blood culture collection.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SST<a name=\"v3-EntityCode-SST\"> </a></td><td>Serum Separator Tube</td><td>\n                        Polymer separator gel with clot activator<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240STUTM<a name=\"v3-EntityCode-STUTM\"> </a></td><td>Stuart transport medium</td><td>\n                        Sodium Glycerophosphate 10.0g, Calcium Chloride 0.1g, Mercaptoacetic Acid 1.0ml, Distilled Water 1 liter<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240THROM<a name=\"v3-EntityCode-THROM\"> </a></td><td>Thrombin</td><td>\n                        Thrombin. Accelerates clotting.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240THYMOL<a name=\"v3-EntityCode-THYMOL\"> </a></td><td>Thymol</td><td>\n                        2-Isopropyl-5-methyl phenol. A preservative for 24 Hr Urine samples<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240THYO<a name=\"v3-EntityCode-THYO\"> </a></td><td>Thyoglycolate broth</td><td>\n                        A nutritive medium with a reducing agent  (sodium thioglycolate) which, due to a chemical reaction, removes oxygen from the broth.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240TOLU<a name=\"v3-EntityCode-TOLU\"> </a></td><td>Toluene</td><td>\n                        Also known as Methylbenzene; Toluol; Phenylmethane. A preservative for 24 Hr Urine samples<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240URETM<a name=\"v3-EntityCode-URETM\"> </a></td><td>Ureaplasma transport medium</td><td>\n                        A buffered salt solution with antifungal agents added for the collection and transport of Ureaplasma specimens.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240VIRTM<a name=\"v3-EntityCode-VIRTM\"> </a></td><td>Viral Transport medium</td><td>\n                        Sucrose 74.6g, Potassium hydrogenphosphate 0.52g, L-glutamic acid 0.72g, Bovine serum albumin 5.0g, Gentamicin 50mg, Potassium dihydrogenphosphate 1.25g, L-15 medium 9.9L, Water to 10L. Maintain Virus viability.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240WEST<a name=\"v3-EntityCode-WEST\"> </a></td><td>Buffered Citrate</td><td>\n                        3.8% Citrate buffered to a pH of 5.5 for Westergren Sedimentation Rate<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240BLDPRD<a name=\"v3-EntityCode-BLDPRD\"> </a></td><td>Blood Product</td><td>\n                        A manufactured product that is produced from the raw blood oi a donor with the intention of using it in a recipient transfusion.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240VCCNE<a name=\"v3-EntityCode-VCCNE\"> </a></td><td>Vaccine</td><td>\n                        A Type of medicine that creates an immune protection without the recipient experiencing the disease.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_DrugEntity)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_DrugEntity\">\302\240</a></td><td>\n                        A substance whose therapeutic effect is produced by chemical action within the body.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_ClinicalDrug)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_ClinicalDrug\">\302\240</a></td><td>\n                        Any substance or mixture of substances manufactured, sold or represented for use in: (a) the diagnosis, treatment, mitigation or prevention of a disease, disorder, abnormal physical state, or its symptoms, in human beings or animals; (b) restoring, correcting or modifying organic functions in human beings or animals.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_NonDrugAgentEntity)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_NonDrugAgentEntity\">\302\240</a></td><td>\n                        Indicates types of allergy and intolerance agents which are non-drugs.  (E.g. foods, latex, etc.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA01<a name=\"v3-EntityCode-NDA01\"> </a></td><td>egg</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA02<a name=\"v3-EntityCode-NDA02\"> </a></td><td>fish</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA03<a name=\"v3-EntityCode-NDA03\"> </a></td><td>lactose</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA04<a name=\"v3-EntityCode-NDA04\"> </a></td><td>peanut</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA05<a name=\"v3-EntityCode-NDA05\"> </a></td><td>soy</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA06<a name=\"v3-EntityCode-NDA06\"> </a></td><td>sulfites</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA07<a name=\"v3-EntityCode-NDA07\"> </a></td><td>wheat or gluten</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA08<a name=\"v3-EntityCode-NDA08\"> </a></td><td>isocyanates</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA09<a name=\"v3-EntityCode-NDA09\"> </a></td><td>solvents</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA10<a name=\"v3-EntityCode-NDA10\"> </a></td><td>oils</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA11<a name=\"v3-EntityCode-NDA11\"> </a></td><td>venoms</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA12<a name=\"v3-EntityCode-NDA12\"> </a></td><td>latex</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA13<a name=\"v3-EntityCode-NDA13\"> </a></td><td>shellfish</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA14<a name=\"v3-EntityCode-NDA14\"> </a></td><td>strawberries</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA15<a name=\"v3-EntityCode-NDA15\"> </a></td><td>tomatoes</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA16<a name=\"v3-EntityCode-NDA16\"> </a></td><td>dust</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240NDA17<a name=\"v3-EntityCode-NDA17\"> </a></td><td>dust mites</td><td/></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_OrganizationEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_OrganizationEntityType\">\302\240</a></td><td>\n                        Further classifies entities of classCode ORG.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240HHOLD<a name=\"v3-EntityCode-HHOLD\"> </a></td><td>household</td><td>\n                        The group of persons who occupy a single housing unit.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NAT<a name=\"v3-EntityCode-NAT\"> </a></td><td>NationEntityType</td><td>\n                        Codes identifying nation states.  Allows for finer grained specification of Entity with classcode &lt;= NAT<br/>\r\n\n                        \n                           Example:ISO3166 country codes.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240RELIG<a name=\"v3-EntityCode-RELIG\"> </a></td><td>religious institution</td><td>\n                        An organization that provides religious rites of worship.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_PlaceEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_PlaceEntityType\">\302\240</a></td><td>\n                        Types of places for EntityClass &quot;PLC&quot;<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240BED<a name=\"v3-EntityCode-BED\"> </a></td><td>Bed Location</td><td>\n                        The location of a bed<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240BLDG<a name=\"v3-EntityCode-BLDG\"> </a></td><td>Building Location</td><td>\n                        The location of a building<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240FLOOR<a name=\"v3-EntityCode-FLOOR\"> </a></td><td>Floor Location</td><td>\n                        The location of a floor of a building<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ROOM<a name=\"v3-EntityCode-ROOM\"> </a></td><td>Room Location</td><td>\n                        The location of a room<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240WING<a name=\"v3-EntityCode-WING\"> </a></td><td>Wing Location</td><td>\n                        The location of a wing of a building (e.g. East Wing).  The same room number for the same floor number can be distinguished by wing number in some situations<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_ResourceGroupEntityType)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityCode-_ResourceGroupEntityType\">\302\240</a></td><td>\n                        Codes to characterize a Resource Group using categories that typify its membership and/or function<br/>\r\n\n                        .<br/>\r\n\n                        \n                           Example: PractitionerGroup<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PRAC<a name=\"v3-EntityCode-PRAC\"> </a></td><td>PractitionerGroup</td><td/></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
