            }
            definition {
              value: "Master Card"
            }
          }
          concept {
            code {
              value: "V"
            }
            display {
              value: "Visa"
            }
            definition {
              value: "Visa"
            }
          }
        }
        concept {
          code {
            value: "PBILLACCT"
          }
          display {
            value: "patient billing account"
          }
          definition {
            value: "An account representing charges and credits (financial transactions) for a patient\'s encounter."
          }
        }
