      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>ArtificialDentition<a name=\"v3-Dentition-ArtificialDentition\"> </a></td><td>Artificial dentition</td><td>\n                        Artificial dentition, artificial subsitutes for the natural dentition<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10a<a name=\"v3-Dentition-TID10a\"> </a></td><td>10a</td><td>\n                        Maxillary left lateral incisor abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10i<a name=\"v3-Dentition-TID10i\"> </a></td><td>10i</td><td>\n                        Maxillary left lateral incisor implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10p<a name=\"v3-Dentition-TID10p\"> </a></td><td>10p</td><td>\n                        Maxillary left lateral incisor prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10pd<a name=\"v3-Dentition-TID10pd\"> </a></td><td>10pd</td><td>\n                        Maxillary left lateral incisor distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10pm<a name=\"v3-Dentition-TID10pm\"> </a></td><td>10pm</td><td>\n                        Maxillary left lateral incisor mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID11a<a name=\"v3-Dentition-TID11a\"> </a></td><td>11a</td><td>\n                        Maxillary left canine abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID11i<a name=\"v3-Dentition-TID11i\"> </a></td><td>11i</td><td>\n                        Maxillary left canine implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID11p<a name=\"v3-Dentition-TID11p\"> </a></td><td>11p</td><td>\n                        Maxillary left canine prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID11pd<a name=\"v3-Dentition-TID11pd\"> </a></td><td>11pd</td><td>\n                        Maxillary left canine distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID11pm<a name=\"v3-Dentition-TID11pm\"> </a></td><td>11pm</td><td>\n                        Maxillary left canine mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID12a<a name=\"v3-Dentition-TID12a\"> </a></td><td>12a</td><td>\n                        Maxillary left first premolar abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID12i<a name=\"v3-Dentition-TID12i\"> </a></td><td>12i</td><td>\n                        Maxillary left first premolar implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID12p<a name=\"v3-Dentition-TID12p\"> </a></td><td>12p</td><td>\n                        Maxillary left first premolar prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID12pd<a name=\"v3-Dentition-TID12pd\"> </a></td><td>12pd</td><td>\n                        Maxillary left first premolar distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID12pm<a name=\"v3-Dentition-TID12pm\"> </a></td><td>12pm</td><td>\n                        Maxillary left first premolar mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID13a<a name=\"v3-Dentition-TID13a\"> </a></td><td>13a</td><td>\n                        Maxillary left second premolar abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID13i<a name=\"v3-Dentition-TID13i\"> </a></td><td>13i</td><td>\n                        Maxillary left second premolar implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID13p<a name=\"v3-Dentition-TID13p\"> </a></td><td>13p</td><td>\n                        Maxillary left second premolar prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID13pd<a name=\"v3-Dentition-TID13pd\"> </a></td><td>13pd</td><td>\n                        Maxillary left second premolar distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID13pm<a name=\"v3-Dentition-TID13pm\"> </a></td><td>13pm</td><td>\n                        Maxillary left second premolar mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID14a<a name=\"v3-Dentition-TID14a\"> </a></td><td>14a</td><td>\n                        Maxillary left first molar abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID14i<a name=\"v3-Dentition-TID14i\"> </a></td><td>14i</td><td>\n                        Maxillary left first molar implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID14p<a name=\"v3-Dentition-TID14p\"> </a></td><td>14p</td><td>\n                        Maxillary left first molar prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID14pd<a name=\"v3-Dentition-TID14pd\"> </a></td><td>14pd</td><td>\n                        Maxillary left first molar distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID14pm<a name=\"v3-Dentition-TID14pm\"> </a></td><td>14pm</td><td>\n                        Maxillary left first molar mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID15a<a name=\"v3-Dentition-TID15a\"> </a></td><td>15a</td><td>\n                        Maxillary left second molar abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID15i<a name=\"v3-Dentition-TID15i\"> </a></td><td>15i</td><td>\n                        Maxillary left second molar implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID15p<a name=\"v3-Dentition-TID15p\"> </a></td><td>15p</td><td>\n                        Maxillary left second molar prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID15pd<a name=\"v3-Dentition-TID15pd\"> </a></td><td>15pd</td><td>\n                        Maxillary left second molar distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID15pm<a name=\"v3-Dentition-TID15pm\"> </a></td><td>15pm</td><td>\n                        Maxillary left second molar mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID16a<a name=\"v3-Dentition-TID16a\"> </a></td><td>16a</td><td>\n                        Maxillary left third molar abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID16i<a name=\"v3-Dentition-TID16i\"> </a></td><td>16i</td><td>\n                        Maxillary left third molar implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID16p<a name=\"v3-Dentition-TID16p\"> </a></td><td>16p</td><td>\n                        Maxillary left third molar prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID16pd<a name=\"v3-Dentition-TID16pd\"> </a></td><td>16pd</td><td>\n                        Maxillary left third molar distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID16pm<a name=\"v3-Dentition-TID16pm\"> </a></td><td>16pm</td><td>\n                        Maxillary left third molar mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID17a<a name=\"v3-Dentition-TID17a\"> </a></td><td