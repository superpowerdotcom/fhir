      }
      property {
        code {
          value: "notSelectable"
        }
        uri {
          value: "http://hl7.org/fhir/concept-properties#notSelectable"
        }
        description {
          value: "Indicates that the code is abstract - only intended to be used as a selector for other concepts"
        }
        type {
          value: BOOLEAN
        }
      }
      concept {
        code {
          value: "_AcknowledgementDetailNotSupportedCode"
        }
        display {
          value: "AcknowledgementDetailNotSupportedCode"
        }
        definition {
          value: "Refelects rejections because elements of the communication are not supported in the current context."
        }
        property {
          code {
            value: "notSelectable"
          }
          value {
            boolean {
              value: true
            }
          }
        }
        concept {
          code {
            value: "NS200"
          }
          display {
            value: "Unsupported interaction"
          }
          definition {
            value: "The interaction (or: this version of the interaction) is not supported."
          }
