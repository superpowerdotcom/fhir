        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.20547"
        }
      }
      version {
        value: "2014-08-07"
      }
      name {
        value: "v3.ProvenanceEventCurrentState"
      }
      title {
        value: "V3 Value SetProvenanceEventCurrentState"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7 v3"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://www.hl7.org"
          }
        }
