entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-HL7ContextConductionStyle"
  }
  resource {
    code_system {
      id {
        value: "v3-HL7ContextConductionStyle"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>C<a name=\"v3-HL7ContextConductionStyle-C\"> </a></td><td>conduction-indicator-based</td><td>\n                        \n                           Definition: Context conduction is defined using the contextConductionCode and contextConductionInd attributes on ActRelationship and Participation.<br/>\r\n\n                        \n                           UsageNotes: This approach is deprecated as of March, 2010.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>I<a name=\"v3-HL7ContextConductionStyle-I\"> </a></td><td>inferred</td><td>\n                        \n                           Definition: Context conduction is not explicitly defined.  The recipient of an instance must infer conduction based on the semantics of the model and what is deemed &quot;reasonable&quot;.<br/>\r\n\n                        \n                           UsageNotes: Because this approach can lead to variation in instance interpretation, its use is discouraged.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>V<a name=\"v3-HL7ContextConductionStyle-V\"> </a></td><td>vocabulary-based</td><td>\n                        \n                           Definition: Context conduction is defined using the ActRelationship.blockedContextActRelationshipType and blockedContextParticipationType attributes and the &quot;conductible&quot; property on the ActRelationshipType and ParticipationType code systems.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-HL7ContextConductionStyle"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1129"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.HL7ContextConductionStyle"
      }
      title {
        value: "v3 Code System HL7ContextConductionStyle"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "The styles of context conduction usable by relationships within a static model derived from tyhe HL7 Reference Information Model."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-HL7ContextConductionStyle"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "C"
        }
        display {
          value: "conduction-indicator-based"
        }
        definition {
          value: "Definition: Context conduction is defined using the contextConductionCode and contextConductionInd attributes on ActRelationship and Participation.\r\n\n                        \n                           UsageNotes: This approach is deprecated as of March, 2010."
        }
      }
      concept {
        code {
          value: "I"
        }
        display {
          value: "inferred"
        }
        definition {
          value: "Definition: Context conduction is not explicitly defined.  The recipient of an instance must infer conduction based on the semantics of the model and what is deemed \"reasonable\".\r\n\n                        \n                           UsageNotes: Because this approach can lead to variation in instance interpretation, its use is discouraged."
        }
      }
      concept {
        code {
          value: "V"
        }
        display {
          value: "vocabulary-based"
        }
        definition {
          value: "Definition: Context conduction is defined using the ActRelationship.blockedContextActRelationshipType and blockedContextParticipationType attributes and the \"conductible\" property on the ActRelationshipType and ParticipationType code systems."
        }
      }
    }
  }
}
