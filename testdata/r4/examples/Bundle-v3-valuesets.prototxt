      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>1002-5<a name=\"v3-Race-1002-5\"> </a></td><td>American Indian or Alaska Native</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\2401004-1<a name=\"v3-Race-1004-1\"> </a></td><td>American Indian</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401006-6<a name=\"v3-Race-1006-6\"> </a></td><td>Abenaki</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401008-2<a name=\"v3-Race-1008-2\"> </a></td><td>Algonquian</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401010-8<a name=\"v3-Race-1010-8\"> </a></td><td>Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401011-6<a name=\"v3-Race-1011-6\"> </a></td><td>Chiricahua</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401012-4<a name=\"v3-Race-1012-4\"> </a></td><td>Fort Sill Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401013-2<a name=\"v3-Race-1013-2\"> </a></td><td>Jicarilla Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401014-0<a name=\"v3-Race-1014-0\"> </a></td><td>Lipan Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401015-7<a name=\"v3-Race-1015-7\"> </a></td><td>Mescalero Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401016-5<a name=\"v3-Race-1016-5\"> </a></td><td>Oklahoma Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401017-3<a name=\"v3-Race-1017-3\"> </a></td><td>Payson Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401018-1<a name=\"v3-Race-1018-1\"> </a></td><td>San Carlos Apache</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401019-9<a name=\"v3-Race-1019-9\"> </a></td><td>White Mountain Apache</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401021-5<a name=\"v3-Race-1021-5\"> </a></td><td>Arapaho</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401022-3<a name=\"v3-Race-1022-3\"> </a></td><td>Northern Arapaho</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401023-1<a name=\"v3-Race-1023-1\"> </a></td><td>Southern Arapaho</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401024-9<a name=\"v3-Race-1024-9\"> </a></td><td>Wind River Arapaho</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401026-4<a name=\"v3-Race-1026-4\"> </a></td><td>Arikara</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401028-0<a name=\"v3-Race-1028-0\"> </a></td><td>Assiniboine</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401030-6<a name=\"v3-Race-1030-6\"> </a></td><td>Assiniboine Sioux</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401031-4<a name=\"v3-Race-1031-4\"> </a></td><td>Fort Peck Assiniboine Sioux</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401033-0<a name=\"v3-Race-1033-0\"> </a></td><td>Bannock</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401035-5<a name=\"v3-Race-1035-5\"> </a></td><td>Blackfeet</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401037-1<a name=\"v3-Race-1037-1\"> </a></td><td>Brotherton</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401039-7<a name=\"v3-Race-1039-7\"> </a></td><td>Burt Lake Band</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401041-3<a name=\"v3-Race-1041-3\"> </a></td><td>Caddo</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401042-1<a name=\"v3-Race-1042-1\"> </a></td><td>Oklahoma Cado</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401044-7<a name=\"v3-Race-1044-7\"> </a></td><td>Cahuilla</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401045-4<a name=\"v3-Race-1045-4\"> </a></td><td>Agua Caliente Cahuilla</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401046-2<a name=\"v3-Race-1046-2\"> </a></td><td>Augustine</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401047-0<a name=\"v3-Race-1047-0\"> </a></td><td>Cabazon</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401048-8<a name=\"v3-Race-1048-8\"> </a></td><td>Los Coyotes</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401049-6<a name=\"v3-Race-1049-6\"> </a></td><td>Morongo</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401050-4<a name=\"v3-Race-1050-4\"> </a></td><td>Santa Rosa Cahuilla</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401051-2<a name=\"v3-Race-1051-2\"> </a></td><td>Torres-Martinez</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401053-8<a name=\"v3-Race-1053-8\"> </a></td><td>California Tribes</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401054-6<a name=\"v3-Race-1054-6\"> </a></td><td>Cahto</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401055-3<a name=\"v3-Race-1055-3\"> </a></td><td>Chimariko</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401056-1<a name=\"v3-Race-1056-1\"> </a></td><td>Coast Miwok</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401057-9<a name=\"v3-Race-1057-9\"> </a></td><td>Digger</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401058-7<a name=\"v3-Race-1058