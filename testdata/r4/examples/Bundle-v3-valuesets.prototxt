entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-HtmlLinkType"
  }
  resource {
    code_system {
      id {
        value: "v3-HtmlLinkType"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>alternate<a name=\"v3-HtmlLinkType-alternate\"> </a></td><td>alternate</td><td>\n                        Designates substitute versions for the document in which the link occurs. When used together with the lang attribute, it implies a translated version of the document. When used together with the media attribute, it implies a version designed for a different medium (or media).<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>appendix<a name=\"v3-HtmlLinkType-appendix\"> </a></td><td>appendix</td><td>\n                        Refers to a document serving as an appendix in a collection of documents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>bookmark<a name=\"v3-HtmlLinkType-bookmark\"> </a></td><td>bookmark</td><td>\n                        Refers to a bookmark. A bookmark is a link to a key entry point within an extended document. The title attribute may be used, for example, to label the bookmark. Note that several bookmarks may be defined in each document.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>chapter<a name=\"v3-HtmlLinkType-chapter\"> </a></td><td>chapter</td><td>\n                        Refers to a document serving as a chapter in a collection of documents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>contents<a name=\"v3-HtmlLinkType-contents\"> </a></td><td>contents</td><td>\n                        Refers to a document serving as a table of contents. Some user agents also support the synonym ToC (from &quot;Table of Contents&quot;).<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>copyright<a name=\"v3-HtmlLinkType-copyright\"> </a></td><td>copyright</td><td>\n                        Refers to a copyright statement for the current document.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>glossary<a name=\"v3-HtmlLinkType-glossary\"> </a></td><td>glossary</td><td>\n                        Refers to a document providing a glossary of terms that pertain to the current document.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>help<a name=\"v3-HtmlLinkType-help\"> </a></td><td>help</td><td>\n                        Refers to a document offering help (more information, links to other sources of information, etc.).<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>index<a name=\"v3-HtmlLinkType-index\"> </a></td><td>index</td><td>\n                        Refers to a document providing an index for the current document.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>next<a name=\"v3-HtmlLinkType-next\"> </a></td><td>next</td><td>\n                        Refers to the next document in a linear sequence of documents. User agents may choose to preload the &quot;next&quot; document, to reduce the perceived load time.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>prev<a name=\"v3-HtmlLinkType-prev\"> </a></td><td>prev</td><td>\n                        Refers to the previous document in an ordered series of documents. Some user agents also support the synonym &quot;Previous&quot;.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>section<a name=\"v3-HtmlLinkType-section\"> </a></td><td>section</td><td>\n                        Refers to a document serving as a section in a collection of documents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>start<a name=\"v3-HtmlLinkType-start\"> </a></td><td>start</td><td>\n                        Refers to the first document in a collection of documents. This link type tells search engines which document is considered by the author to be the starting point of the collection.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>stylesheet<a name=\"v3-HtmlLinkType-stylesheet\"> </a></td><td>stylesheet</td><td>\n                        Refers to an external style sheet. See the section on external style sheets for details. This is used together with the link type &quot;Alternate&quot; for user-selectable alternate style sheets.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>subsection<a name=\"v3-HtmlLinkType-subsection\"> </a></td><td>subsection</td><td>\n                        Refers to a document serving as a subsection in a collection of documents.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-HtmlLinkType"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.58"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.HtmlLinkType"
      }
      title {
        value: "v3 Code System HtmlLinkType"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " HtmlLinkType values are drawn from HTML 4.0 and describe the relationship between the current document and the anchor that is the target of the link"
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-HtmlLinkType"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "alternate"
        }
        display {
          value: "alternate"
        }
        definition {
          value: "Designates substitute versions for the document in which the link occurs. When used together with the lang attribute, it implies a translated version of the document. When used together with the media attribute, it implies a version designed for a different medium (or media)."
        }
      }
      concept {
        code {
          value: "appendix"
        }
        display {
          value: "appendix"
        }
        definition {
          value: "Refers to a document serving as an appendix in a collection of documents."
        }
      }
      concept {
        code {
          value: "bookmark"
        }
        display {
          value: "bookmark"
        }
        definition {
          value: "Refers to a bookmark. A bookmark is a link to a key entry point within an extended document. The title attribute may be used, for example, to label the bookmark. Note that several bookmarks may be defined in each document."
        }
      }
      concept {
        code {
          value: "chapter"
        }
        display {
          value: "chapter"
        }
        definition {
          value: "Refers to a document serving as a chapter in a collection of documents."
        }
      }
      concept {
        code {
          value: "contents"
        }
        display {
          value: "contents"
        }
        definition {
          value: "Refers to a document serving as a table of contents. Some user agents also support the synonym ToC (from \"Table of Contents\")."
        }
      }
      concept {
        code {
          value: "copyright"
        }
        display {
          value: "copyright"
        }
        definition {
          value: "Refers to a copyright statement for the current document."
        }
      }
      concept {
        code {
          value: "glossary"
        }
        display {
          value: "glossary"
        }
        definition {
          value: "Refers to a document providing a glossary of terms that pertain to the current document."
        }
      }
      concept {
        code {
          value: "help"
        }
        display {
          value: "help"
        }
        definition {
          value: "Refers to a document offering help (more information, links to other sources of information, etc.)."
        }
      }
      concept {
        code {
          value: "index"
        }
        display {
          value: "index"
        }
        definition {
          value: "Refers to a document providing an index for the current document."
        }
      }
      concept {
        code {
          value: "next"
        }
        display {
          value: "next"
        }
        definition {
          value: "Refers to the next document in a linear sequence of documents. User agents may choose to preload the \"next\" document, to reduce the perceived load time."
        }
      }
      concept {
        code {
          value: "prev"
        }
        display {
          value: "prev"
        }
        definition {
          value: "Refers to the previous document in an ordered series of documents. Some user agents also support the synonym \"Previous\"."
        }
      }
      concept {
        code {
          value: "section"
        }
        display {
          value: "section"
        }
        definition {
          value: "Refers to a document serving as a section in a collection of documents."
        }
      }
      concept {
        code {
          value: "start"
        }
        display {
          value: "start"
        }
        definition {
          value: "Refers to the first document in a collection of documents. This link type tells search engines which document is considered by the author to be the starting point of the collection."
        }
      }
      concept {
        code {
          value: "stylesheet"
        }
        display {
          value: "stylesheet"
        }
        definition {
          value: "Refers to an external style sheet. See the section on external style sheets for details. This is used together with the link type \"Alternate\" for user-selectable alternate style sheets."
        }
      }
      concept {
        code {
          value: "subsection"
        }
        display {
          value: "subsection"
        }
        definition {
          value: "Refers to a document serving as a subsection in a collection of documents."
        }
      }
    }
  }
}
