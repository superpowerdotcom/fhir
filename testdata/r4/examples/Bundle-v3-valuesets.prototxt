          display {
            value: "enrollment"
          }
          definition {
            value: "Definition:The specific role being played by a research subject participating in the active treatment or primary data collection portion of a research study."
          }
        }
        concept {
          code {
            value: "SCN"
          }
          display {
            value: "screening"
          }
          definition {
            value: "Definition:The specific role being played by a research subject participating in the pre-enrollment evaluation portion of  a research study."
          }
        }
      }
