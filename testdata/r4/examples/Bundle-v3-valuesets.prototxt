entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-GTSAbbreviation"
  }
  resource {
    value_set {
      id {
        value: "v3-GTSAbbreviation"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>AM<a name=\"v3-GTSAbbreviation-AM\"> </a></td><td>AM</td><td>\n                        Every morning at institution specified times.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>BED<a name=\"v3-GTSAbbreviation-BED\"> </a></td><td>at bedtime</td><td>\n                        At bedtime (institution specified time).<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>BID<a name=\"v3-GTSAbbreviation-BID\"> </a></td><td>BID</td><td>\n                        Two times a day at institution specified time<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>JB<a name=\"v3-GTSAbbreviation-JB\"> </a></td><td>JB</td><td>\n                        Regular business days (Monday to Friday excluding holidays)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>JE<a name=\"v3-GTSAbbreviation-JE\"> </a></td><td>JE</td><td>\n                        Regular weekends (Saturday and Sunday excluding holidays)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>JH<a name=\"v3-GTSAbbreviation-JH\"> </a></td><td>GTSAbbreviationHolidays</td><td>\n                        Holidays<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_GTSAbbreviationHolidaysChristianRoman)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-GTSAbbreviation-_GTSAbbreviationHolidaysChristianRoman\">\302\240</a></td><td>\n                        Christian Holidays (Roman/Gregorian [Western] Tradition.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHCHREAS<a name=\"v3-GTSAbbreviation-JHCHREAS\"> </a></td><td>JHCHREAS</td><td>\n                        Easter Sunday.  The Easter date is a rather complex calculation based on Astronomical tables describing full moon dates.  Details can be found at [http://www.assa.org.au/edm.html, and http://aa.usno.navy.mil/AA/faq/docs/easter.html].  Note that the Christian Orthodox Holidays are based on the Julian calendar.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHCHRGFR<a name=\"v3-GTSAbbreviation-JHCHRGFR\"> </a></td><td>JHCHRGFR</td><td>\n                        Good Friday, is the Friday right before Easter Sunday.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHCHRNEW<a name=\"v3-GTSAbbreviation-JHCHRNEW\"> </a></td><td>JHCHRNEW</td><td>\n                        New Year\'s Day (January 1)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHCHRPEN<a name=\"v3-GTSAbbreviation-JHCHRPEN\"> </a></td><td>JHCHRPEN</td><td>\n                        Pentecost Sunday, is seven weeks after Easter (the 50th day of Easter).<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHCHRXME<a name=\"v3-GTSAbbreviation-JHCHRXME\"> </a></td><td>JHCHRXME</td><td>\n                        Christmas Eve (December 24)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHCHRXMS<a name=\"v3-GTSAbbreviation-JHCHRXMS\"> </a></td><td>JHCHRXMS</td><td>\n                        Christmas Day (December 25)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240JHNNL<a name=\"v3-GTSAbbreviation-JHNNL\"> </a></td><td>The Netherlands National Holidays</td><td>\n                        \n                           Description:The Netherlands National Holidays.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNNLLD<a name=\"v3-GTSAbbreviation-JHNNLLD\"> </a></td><td>Liberation day (May 5 every five years)</td><td>\n                        \n                           Description:Liberation day  (May 5 every five years)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNNLQD<a name=\"v3-GTSAbbreviation-JHNNLQD\"> </a></td><td>Queen\'s day (April 30)</td><td>\n                        \n                           Description:Queen\'s day (April 30)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNNLSK<a name=\"v3-GTSAbbreviation-JHNNLSK\"> </a></td><td>Sinterklaas (December 5)</td><td>\n                        \n                           Description:Sinterklaas (December 5)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240JHNUS<a name=\"v3-GTSAbbreviation-JHNUS\"> </a></td><td>GTSAbbreviationHolidaysUSNational</td><td>\n                        United States National Holidays (public holidays for federal employees established by U.S. Federal law 5 U.S.C. 6103).<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSCLM<a name=\"v3-GTSAbbreviation-JHNUSCLM\"> </a></td><td>JHNUSCLM</td><td>\n                        Columbus Day, the second Monday in October.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSIND<a name=\"v3-GTSAbbreviation-JHNUSIND\"> </a></td><td>JHNUSIND</td><td>\n                        Independence Day (4th of July)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSIND1<a name=\"v3-GTSAbbreviation-JHNUSIND1\"> </a></td><td>JHNUSIND1</td><td>\n                        Alternative Monday after 4th of July Weekend [5 U.S.C. 6103(b)].<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSIND5<a name=\"v3-GTSAbbreviation-JHNUSIND5\"> </a></td><td>JHNUSIND5</td><td>\n                        Alternative Friday before 4th of July Weekend [5 U.S.C. 6103(b)].<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSLBR<a name=\"v3-GTSAbbreviation-JHNUSLBR\"> </a></td><td>JHNUSLBR</td><td>\n                        Labor Day, the first Monday in September.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSMEM<a name=\"v3-GTSAbbreviation-JHNUSMEM\"> </a></td><td>JHNUSMEM</td><td>\n                        Memorial Day, the last Monday in May.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSMEM5<a name=\"v3-GTSAbbreviation-JHNUSMEM5\"> </a></td><td>JHNUSMEM5</td><td>\n                        Friday before Memorial Day Weekend<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSMEM6<a name=\"v3-GTSAbbreviation-JHNUSMEM6\"> </a></td><td>JHNUSMEM6</td><td>\n                        Saturday of Memorial Day Weekend<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSMLK<a name=\"v3-GTSAbbreviation-JHNUSMLK\"> </a></td><td>JHNUSMLK</td><td>\n                        Dr. Martin Luther King, Jr. Day, the third Monday in January.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSPRE<a name=\"v3-GTSAbbreviation-JHNUSPRE\"> </a></td><td>JHNUSPRE</td><td>\n                        Washington\'s Birthday (Presidential Day) the third Monday in February.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSTKS<a name=\"v3-GTSAbbreviation-JHNUSTKS\"> </a></td><td>JHNUSTKS</td><td>\n                        Thanksgiving Day, the fourth Thursday in November.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSTKS5<a name=\"v3-GTSAbbreviation-JHNUSTKS5\"> </a></td><td>JHNUSTKS5</td><td>\n                        Friday after Thanksgiving.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240JHNUSVET<a name=\"v3-GTSAbbreviation-JHNUSVET\"> </a></td><td>JHNUSVET</td><td>\n                        Veteran\'s Day, November 11.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>MO<a name=\"v3-GTSAbbreviation-MO\"> </a></td><td>monthly</td><td>\n                        Monthly at institution specified time.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PM<a name=\"v3-GTSAbbreviation-PM\"> </a></td><td>PM</td><td>\n                        Every afternoon at institution specified times.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Q1H<a name=\"v3-GTSAbbreviation-Q1H\"> </a></td><td>every hour</td><td>\n                        Every hour at institution specified times.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Q2H<a name=\"v3-GTSAbbreviation-Q2H\"> </a></td><td>every 2 hours</td><td>\n                        Every 2 hours at institution specified times.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Q3H<a name=\"v3-GTSAbbreviation-Q3H\"> </a></td><td>every 3 hours</td><td>\n                        Every 3 hours at institution specified times.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Q4H<a name=\"v3-GTSAbbreviation-Q4H\"> </a></td><td>Q4H</td><td>\n                        Every 4 hours at institution specified time <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Q6H<a name=\"v3-GTSAbbreviation-Q6H\"> </a></td><td>Q6H</td><td>\n                        Every 6 hours at institution specified time <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Q8H<a name=\"v3-GTSAbbreviation-Q8H\"> </a></td><td>every 8 hours</td><td>\n                        Every 8 hours at institution specified times.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>QD<a name=\"v3-GTSAbbreviation-QD\"> </a></td><td>QD</td><td>\n                        Every day at institution specified times. <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>QID<a name=\"v3-GTSAbbreviation-QID\"> </a></td><td>QID</td><td>\n                        Four times a day at institution specified time<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>QOD<a name=\"v3-GTSAbbreviation-QOD\"> </a></td><td>QOD</td><td>\n                        Every other day at institution specified times. <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>TID<a name=\"v3-GTSAbbreviation-TID\"> </a></td><td>TID</td><td>\n                        Three times a day at institution specified time<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>WK<a name=\"v3-GTSAbbreviation-WK\"> </a></td><td>weekly</td><td>\n                        Weekly at institution specified time.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
