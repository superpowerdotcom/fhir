entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-RoleLinkType"
  }
  resource {
    value_set {
      id {
        value: "v3-RoleLinkType"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>REL<a name=\"v3-RoleLinkType-REL\"> </a></td><td>related</td><td>\n                        An action taken with respect to a subject Entity by a regulatory or authoritative body with supervisory capacity over that entity. The action is taken in response to behavior by the subject Entity that body finds to be undesirable.<br/>\r\n\n                        Suspension, license restrictions, monetary fine, letter of reprimand, mandated training, mandated supervision, etc.Examples:\n                        <br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240BACKUP<a name=\"v3-RoleLinkType-BACKUP\"> </a></td><td>is backup for</td><td>\n                        This relationship indicates the source Role is available to the target Role as a backup. An entity in a backup role will be available as a substitute or replacement in the event that the entity assigned the role is unavailable. In medical roles where it is critical that the function be performed and there is a possibility that the individual assigned may be ill or otherwise indisposed, another individual is assigned to cover for the individual originally assigned the role. A backup may be required to be identified, but unless the backup is actually used, he/she would not assume the assigned entity role.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CONT<a name=\"v3-RoleLinkType-CONT\"> </a></td><td>has contact</td><td>This relationship indicates the target Role provides or receives information regarding the target role.  For example, AssignedEntity is a contact for a ServiceDeliveryLocation.</td></tr>\r\n <tr><td>2</td><td>\302\240\302\240DIRAUTH<a name=\"v3-RoleLinkType-DIRAUTH\"> </a></td><td>has direct authority over</td><td>\n                        The source Role has direct authority over the target role in a chain of authority.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240IDENT<a name=\"v3-RoleLinkType-IDENT\"> </a></td><td>Identification</td><td>\n                        \n                           Description: The source role provides identification for the target role. The source role must be IDENT. The player entity of the source role is constrained to be the same as (i.e. the equivalent of, or equal to) the player of the target role if present. If the player is absent from the source role, then it is assumed to be the same as the player of the target role.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240INDAUTH<a name=\"v3-RoleLinkType-INDAUTH\"> </a></td><td>has indirect authority over</td><td>\n                        The source Role has indirect authority over the target role in a chain of authority.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PART<a name=\"v3-RoleLinkType-PART\"> </a></td><td>has part</td><td>\n                        The target Role is part of the Source Role.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240REPL<a name=\"v3-RoleLinkType-REPL\"> </a></td><td>replaces</td><td>\n                        This relationship indicates that the source Role replaces (or subsumes) the target Role.  Allows for new identifiers and/or new effective time for a registry entry or a certification, etc.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-RoleLinkType"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.11603"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.RoleLinkType"
      }
      title {
        value: "v3 Code System RoleLinkType"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "**** MISSING DEFINITIONS ****"
      }
      immutable {
        value: true
