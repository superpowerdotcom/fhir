        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_Algic)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AmericanIndianAlaskaNativeLanguages-_Algic\">\302\240</a></td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Algonquian)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AmericanIndianAlaskaNativeLanguages-_Algonquian\">\302\240</a></td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_Arapahoan)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AmericanIndianAlaskaNativeLanguages-_Arapahoan\">\302\240</a></td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_ArapahoGrosVentre)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AmericanIndianAlaskaNativeLanguages-_ArapahoGrosVentre\">\302\240</a></td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240x-ARP<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-ARP\"> </a></td><td>Arapaho</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240x-ATS<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-ATS\"> </a></td><td>Gros Ventre</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_CreeMontagnais)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AmericanIndianAlaskaNativeLanguages-_CreeMontagnais\">\302\240</a></td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240<span style=\"color: grey\"><i>(_Cree)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AmericanIndianAlaskaNativeLanguages-_Cree\">\302\240</a></td><td/></tr>\r\n <tr><td>5</td><td>\302\2