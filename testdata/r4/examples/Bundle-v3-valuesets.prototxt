entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-ProvenanceEventCurrentState-AS"
  }
  resource {
    value_set {
      id {
        value: "v3-ProvenanceEventCurrentState-AS"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetProvenanceEventCurrentState-AS</h2><div><p>Specifies the state change of a target Act, using ActStatus codes, from its previous state as a predecessor Act. For example, if the target Act is the result of a predecessor Act being &quot;obsoleted&quot; and replaced with the target Act, the source ProvenanceEventCurrentState Act code would be &quot;obsoleted&quot;.</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include these codes as defined in <a href=\"../../v3/ActStatus/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ActStatus</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td><a href=\"../../v3/ActStatus/cs.html#v3-ActStatus-aborted\">aborted</a></td><td>aborted</td><td>The Act has been terminated prior to the originally intended completion.</td></tr><tr><td><a href=\"../../v3/ActStatus/cs.html#v3-ActStatus-cancelled\">cancelled</a></td><td>cancelled</td><td>The Act has been abandoned before activation.</td></tr><tr><td><a href=\"../../v3/ActStatus/cs.html#v3-ActStatus-completed\">completed</a></td><td>completed</td><td>An Act that has terminated normally after all of its constituents have been performed.</td></tr><tr><td><a href=\"../../v3/ActStatus/cs.html#v3-ActStatus-new\">new</a></td><td>new</td><td>An Act that is in the preparatory stages and may not yet be acted upon</td></tr><tr><td><a href=\"../../v3/ActStatus/cs.html#v3-ActStatus-nullified\">nullified</a></td><td>nullified</td><td>This Act instance was created in error and has been \'removed\' and is treated as though it never existed.  A record is retained for audit purposes only.</td></tr><tr><td><a href=\"../../v3/ActStatus/cs.html#v3-ActStatus-obsolete\">obsolete</a></td><td>obsolete</td><td>This Act instance has been replaced by a new instance.</td></tr></table></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-ProvenanceEventCurrentState-AS"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.20545"
        }
      }
      version {
        value: "2014-08-07"
      }
      name {
        value: "v3.ProvenanceEventCurrentState-AS"
      }
      title {
        value: "V3 Value SetProvenanceEventCurrentState-AS"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7 v3"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://www.hl7.org"
          }
        }
      }
      description {
        value: " Specifies the state change of a target Act, using ActStatus codes, from its previous state as a predecessor Act. For example, if the target Act is the result of a predecessor Act being \"obsoleted\" and replaced with the target Act, the source ProvenanceEventCurrentState Act code would be \"obsoleted\"."
      }
      immutable {
      }
      compose {
        include {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-ActStatus"
          }
          concept {
            code {
              value: "aborted"
            }
          }
          concept {
            code {
              value: "cancelled"
            }
          }
          concept {
            code {
              value: "completed"
            }
          }
          concept {
            code {
              value: "new"
            }
          }
          concept {
            code {
              value: "nullified"
            }
          }
          concept {
            code {
              value: "obsolete"
            }
          }
        }
      }
    }
  }
}
