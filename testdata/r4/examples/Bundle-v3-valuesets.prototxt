entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-CommunicationFunctionType"
  }
  resource {
    code_system {
      id {
        value: "v3-CommunicationFunctionType"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>RCV<a name=\"v3-CommunicationFunctionType-RCV\"> </a></td><td>receiver</td><td>\n                        The entity is the receiver of the transmission.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>RSP<a name=\"v3-CommunicationFunctionType-RSP\"> </a></td><td>respond to</td><td>\n                        The entity is the one to which the response or reply to the transmission should be sent.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>SND<a name=\"v3-CommunicationFunctionType-SND\"> </a></td><td>sender</td><td>\n                        The entity is the sender of the transmission.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-CommunicationFunctionType"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1056"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.CommunicationFunctionType"
      }
      title {
        value: "v3 Code System CommunicationFunctionType"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " Describes the type of communication function that the associated entity plays in the associated transmission."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-CommunicationFunctionType"
      }
      hierarchy_meaning {
