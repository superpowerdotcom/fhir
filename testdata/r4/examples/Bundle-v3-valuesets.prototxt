        definition {
          value: "The deflate compressed data format as specified in RFC 1951 [http://www.ietf.org/rfc/rfc1951.txt]."
        }
      }
      concept {
        code {
          value: "GZ"
        }
        display {
          value: "gzip"
        }
        definition {
          value: "A compressed data format that is compatible with the widely used GZIP utility as specified in RFC 1952 [http://www.ietf.org/rfc/rfc1952.txt] (uses the deflate algorithm)."
        }
      }
      concept {
        code {
          value: "Z"
        }
        display {
          value: "compress"
        }
        definition {
          value: "Original UNIX compress algorithm and file format using the LZC algorithm (a variant of LZW).  Patent encumbered and less efficient than deflate."
        }
      }
      concept {
        code {
          value: "Z7"
        }
        display {
          value: "Z7"
        }
        definition {
          value: "7z compression file format. See [http://www.7-zip.org/7z.html] for more information."
        }
      }
      concept {
        code {
          value: "ZL"
        }
        display {
          value: "zlib"
        }
        definition {
          value: "A compressed data format that also uses the deflate algorithm.  Specified as RFC 1950 [http://www.ietf.org/rfc/rfc1952.txt]"
        }
      }
    }
  }
}
