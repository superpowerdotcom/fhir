                  display {
                    value: "Delayed Release Tablet"
                  }
                  definition {
                    value: "Delayed Release Tablet"
                  }
                }
                concept {
                  code {
                    value: "ECTAB"
                  }
                  display {
                    value: "Enteric Coated Tablet"
                  }
                  definition {
