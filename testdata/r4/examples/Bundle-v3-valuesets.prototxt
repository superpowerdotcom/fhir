      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_Conditional)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-SubstitutionCondition-_Conditional\">\302\240</a></td><td>\n                        Some conditions may be attached to an allowable substitution.  An allowable substitution is based on a match to any other attributes that may be specified.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CONFIRM<a name=\"v3-SubstitutionCondition-CONFIRM\"> </a></td><td>Confirm first</td><td>\n                        Confirmation with Contact Person prior to making any substitutions has or will occur.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NOTIFY<a name=\"v3-SubstitutionCondition-NOTIFY\"> </a></td><td>Notify first</td><td>\n                        Notification to the Contact Person, prior to substitution and through normal institutional procedures, has or will be made.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>NOSUB<a name=\"v3-SubstitutionCondition-NOSUB\"> </a></td><td>No substitution</td><td>\n                        Substitution is not permitted.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>UNCOND<a name=\"v3-SubstitutionCondition-UNCOND\"> </a></td><td>Unconditional</td><td>\n                        No conditions are required.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-SubstitutionCondition"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1071"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.SubstitutionCondition"
      }
      title {
        value: "v3 Code System SubstitutionCondition"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
