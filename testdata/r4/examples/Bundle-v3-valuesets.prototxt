      concept {
        code {
          value: "_ActUSPrivacyLaw"
        }
        display {
          value: "ActUSPrivacyLaw"
        }
        definition {
          value: "Definition: A jurisdictional mandate in the U.S. relating to privacy.\r\n\n                        \n                           Usage Note: ActPrivacyLaw codes may be associated with an Act or a Role to indicate the legal provision to which the assignment of an Act.confidentialityCode or Role.confidentialtyCode complies.  May be used to further specify rationale for assignment of other ActPrivacyPolicy codes in the US realm, e.g., ETH and 42CFRPart2 can be differentiated from ETH and Title38Part1."
        }
        property {
          code {
            value: "status"
          }
          value {
