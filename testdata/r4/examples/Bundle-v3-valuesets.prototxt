entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-ObservationCategory"
  }
  resource {
    value_set {
      id {
        value: "v3-ObservationCategory"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>exam<a name=\"v3-ObservationCategory-exam\"> </a></td><td>Exam</td><td>\n                        Observations generated by physical exam findings including direct observations made by a clinician and use of simple instruments and the result of simple maneuvers performed directly on the patient\'s body.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>imaging<a name=\"v3-ObservationCategory-imaging\"> </a></td><td>Imaging</td><td>\n                        Observations generated by imaging. The scope includes observations, plain x-ray, ultrasound, CT, MRI, angiography, echocardiography, nuclear medicine.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>laboratory<a name=\"v3-ObservationCategory-laboratory\"> </a></td><td>Laboratory</td><td>\n                        The results of observations generated by laboratories. Laboratory results are typically generated by laboratories providing analytic services in areas such as chemistry, hematology, serology, histology, cytology, anatomic pathology, microbiology, and/or virology. These observations are based on analysis of specimens obtained from the patient and submitted to the laboratory.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>procedure<a name=\"v3-ObservationCategory-procedure\"> </a></td><td>Procedure</td><td>\n                        Observations generated by other procedures. This category includes observations resulting from interventional and non-interventional procedures excluding lab and imaging (e.g. cardiology catheterization, endoscopy, electrodiagnostics, etc.). Procedure results are typically generated by a clinician to provide more granular information about component observations made during a procedure, such as where a gastroenterologist reports the size of a polyp observed during a colonoscopy.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>social-history<a name=\"v3-ObservationCategory-social-history\"> </a></td><td>Social History</td><td>\n                        The Social History Observations define the patient\'s occupational, personal (e.g. lifestyle), social, and environmental history and health risk factors, as well as administrative data such as marital status, race, ethnicity and religious affiliation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>survey<a name=\"v3-ObservationCategory-survey\"> </a></td><td>Survey</td><td>\n                        Assessment tool/survey instrument observations (e.g. Apgar Scores, Montreal Cognitive Assessment (MoCA))<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>therapy<a name=\"v3-ObservationCategory-therapy\"> </a></td><td>Therapy</td><td>\n                        Observations generated by non-interventional treatment protocols (e.g. occupational, physical, radiation, nutritional and medication therapy)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>vital-signs<a name=\"v3-ObservationCategory-vital-signs\"> </a></td><td>Vital Signs</td><td>\n                        Clinical observations measure the body\'s basic functions such as such as blood pressure, heart rate, respiratory rate, height, weight, body mass index, head circumference, pulse oximetry, temperature, and body surface area.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-ObservationCategory"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.4.642.2.222"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.ObservationCategory"
      }
      title {
        value: "v3 Code System ObservationCategory"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " High level observation categories for the general type of observation being made. URL: http://hl7-fhir.github.io/valueset-observation-category.html This is an inline code system http://hl7.org/fhir/observation-category."
      }
      immutable {
        value: true
      }
      compose {
        include {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-ObservationCategory"
          }
        }
      }
    }
