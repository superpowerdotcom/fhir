entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-ActRelationshipJoin"
  }
  resource {
    value_set {
      id {
        value: "v3-ActRelationshipJoin"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>D<a name=\"v3-ActRelationshipJoin-D\"> </a></td><td>detached</td><td>\n                        Detach this branch from the other branches so it will not be resynchronized with the other branches.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>K<a name=\"v3-ActRelationshipJoin-K\"> </a></td><td>kill</td><td>\n                        When all other concurrent branches are terminated, interrupt and discontinue this branch.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>W<a name=\"v3-ActRelationshipJoin-W\"> </a></td><td>wait</td><td>\n                        Wait for this branch to terminate.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>X<a name=\"v3-ActRelationshipJoin-X\"> </a></td><td>exclusive wait</td><td>\n                        Wait for any one of the branches in the set of exclusive wait branches to terminate, then discontinue all the other exclusive wait branches.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
