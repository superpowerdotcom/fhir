        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>GREG<a name=\"v3-Calendar-GREG\"> </a></td><td>Gregorian</td><td>\n                        The Gregorian calendar is the calendar in effect in most countries of Christian influence since approximately 1582. This calendar superceded the Julian calendar.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
