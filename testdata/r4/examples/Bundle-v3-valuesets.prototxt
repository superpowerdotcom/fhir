      compose {
        include {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-RoleCode"
          }
          filter {
            property {
              value: "concept"
            }
            op {
              value: IS_A
            }
            value {
              value: "_ServiceDeliveryLocationRoleType"
            }
          }
        }
        exclude {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-RoleCode"
          }
          concept {
            code {
              value: "_ServiceDeliveryLocationRoleType"
            }
          }
        }
      }
    }
  }
}
entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-CompressionAlgorithm"
  }
  resource {
    value_set {
      id {
        value: "v3-CompressionAlgorithm"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>BZ<a name=\"v3-CompressionAlgorithm-BZ\"> </a></td><td>bzip</td><td>\n                        bzip-2 compression format. See [http://www.bzip.org/] for more information.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>DF<a name=\"v3-CompressionAlgorithm-DF\"> </a></td><td>deflate</td><td>\n                        The deflate compressed data format as specified in RFC 1951 [http://www.ietf.org/rfc/rfc1951.txt].<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>GZ<a name=\"v3-CompressionAlgorithm-GZ\"> </a></td><td>gzip</td><td>\n                        A compressed data format that is compatible with the widely used GZIP utility as specified in RFC 1952 [http://www.ietf.org/rfc/rfc1952.txt] (uses the deflate algorithm).<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Z<a name=\"v3-CompressionAlgorithm-Z\"> </a></td><td>compress</td><td>\n                        Original UNIX compress algorithm and file format using the LZC algorithm (a variant of LZW).  Patent encumbered and less efficient than deflate.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>Z7<a name=\"v3-CompressionAlgorithm-Z7\"> </a></td><td>Z7</td><td>\n                        7z compression file format. See [http://www.7-zip.org/7z.html] for more information.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>ZL<a name=\"v3-CompressionAlgorithm-ZL\"> </a></td><td>zlib</td><td>\n                        A compressed data format that also uses the deflate algorithm.  Specified as RFC 1950 [http://www.ietf.org/rfc/rfc1952.txt]<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
