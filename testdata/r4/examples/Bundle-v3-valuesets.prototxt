          }
          definition {
            value: "Description: Responsible group has recommended that the negative vote be considered not-related.  (Issue raised is not related to the current scope of the item under ballot, or does not prevent the item under ballot for being used for its defined intent.  Recommended changes may be considered as part of future versions.)  (Perhaps after further reading or explanation)."
          }
        }
        concept {
          code {
            value: "notrelv"
          }
          display {
            value: "not related voted"
          }
          definition {
            value: "Description: Ballot group has voted and declared the negative vote non-related."
          }
        }
        concept {
          code {
            value: "prevcons"
          }
          display {
            value: "previously considered"
          }
          definition {
            value: "Description: Committee identifies that the same issue has been raised as part of a previous ballot on the same element version and was found by the ballot group to be non-substantive or not related.)"
          }
        }
        concept {
          code {
            value: "retract"
          }
          display {
            value: "retracted"
          }
          definition {
            value: "Description: Voter has formally withdrawn their vote or comment as having been in error.  (Perhaps after further reading or explanation)."
          }
        }
        concept {
          code {
            value: "unresolved"
          }
          display {
            value: "unresolved"
          }
          definition {
            value: "Description: Vote has not yet gone through resolution."
          }
        }
        concept {
          code {
            value: "withdraw"
          }
          display {
            value: "withdrawn"
          }
          definition {
            value: "Description: Voter has formally withdrawn their vote or comment on the basis of agreed changes or proposed future changes."
          }
        }
      }
    }
  }
}
