entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-ActPriority"
  }
  resource {
    code_system {
      id {
        value: "v3-ActPriority"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>A<a name=\"v3-ActPriority-A\"> </a></td><td>ASAP</td><td>\n                        As soon as possible, next highest priority after stat.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>CR<a name=\"v3-ActPriority-CR\"> </a></td><td>callback results</td><td>\n                        Filler should contact the placer as soon as results are available, even for preliminary results.  (Was &quot;C&quot; in HL7 version 2.3\'s reporting priority.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>CS<a name=\"v3-ActPriority-CS\"> </a></td><td>callback for scheduling</td><td>\n                        Filler should contact the placer (or target) to schedule the service.  (Was &quot;C&quot; in HL7 version 2.3\'s TQ-priority component.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CSP<a name=\"v3-ActPriority-CSP\"> </a></td><td>callback placer for scheduling</td><td>\n                        Filler should contact the placer to schedule the service.  (Was &quot;C&quot; in HL7 version 2.3\'s TQ-priority component.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CSR<a name=\"v3-ActPriority-CSR\"> </a></td><td>contact recipient for scheduling</td><td>\n                        Filler should contact the service recipient (target) to schedule the service.  (Was &quot;C&quot; in HL7 version 2.3\'s TQ-priority component.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>EL<a name=\"v3-ActPriority-EL\"> </a></td><td>elective</td><td>\n                        Beneficial to the patient but not essential for survival.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>EM<a name=\"v3-ActPriority-EM\"> </a></td><td>emergency</td><td>\n                        An unforeseen combination of circumstances or the resulting state that calls for immediate action.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>P<a name=\"v3-ActPriority-P\"> </a></td><td>preop</td><td>\n                        Used to indicate that a service is to be performed prior to a scheduled surgery.  When ordering a service and using the pre-op priority, a check is done to see the amount of time that must be allowed for performance of the service.  When the order is placed, a message can be generated indicating the time needed for the service so that it is not ordered in conflict with a scheduled operation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PRN<a name=\"v3-ActPriority-PRN\"> </a></td><td>as needed</td><td>\n                        An &quot;as needed&quot; order should be accompanied by a description of what constitutes a need. This description is represented by an observation service predicate as a precondition.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>R<a name=\"v3-ActPriority-R\"> </a></td><td>routine</td><td>\n                        Routine service, do at usual work hours.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>RR<a name=\"v3-ActPriority-RR\"> </a></td><td>rush reporting</td><td>\n                        A report should be prepared and sent as quickly as possible.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>S<a name=\"v3-ActPriority-S\"> </a></td><td>stat</td><td>\n                        With highest priority (e.g., emergency).<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>T<a name=\"v3-ActPriority-T\"> </a></td><td>timing critical</td><td>\n                        It is critical to come as close as possible to the requested time (e.g., for a through antimicrobial level).<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>UD<a name=\"v3-ActPriority-UD\"> </a></td><td>use as directed</td><td>\n                        Drug is to be used as directed by the prescriber.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>UR<a name=\"v3-ActPriority-UR\"> </a></td><td>urgent</td><td>\n                        Calls for prompt action.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "draft"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 1
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "pa"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-ActPriority"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.7"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.ActPriority"
      }
      title {
        value: "v3 Code System ActPriority"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " A set of codes (e.g., for routine, emergency), specifying the urgency under which the Act happened, can happen, is happening, is intended to happen, or is requested/demanded to happen."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-ActPriority"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "A"
        }
        display {
          value: "ASAP"
        }
        definition {
          value: "As soon as possible, next highest priority after stat."
        }
      }
      concept {
        code {
          value: "CR"
        }
        display {
          value: "callback results"
        }
        definition {
          value: "Filler should contact the placer as soon as results are available, even for preliminary results.  (Was \"C\" in HL7 version 2.3\'s reporting priority.)"
        }
      }
      concept {
        code {
          value: "CS"
        }
        display {
          value: "callback for scheduling"
        }
        definition {
          value: "Filler should contact the placer (or target) to schedule the service.  (Was \"C\" in HL7 version 2.3\'s TQ-priority component.)"
        }
        concept {
          code {
            value: "CSP"
          }
          display {
            value: "callback placer for scheduling"
          }
          definition {
            value: "Filler should contact the placer to schedule the service.  (Was \"C\" in HL7 version 2.3\'s TQ-priority component.)"
          }
        }
        concept {
          code {
            value: "CSR"
          }
          display {
            value: "contact recipient for scheduling"
          }
          definition {
            value: "Filler should contact the service recipient (target) to schedule the service.  (Was \"C\" in HL7 version 2.3\'s TQ-priority component.)"
          }
        }
      }
      concept {
        code {
          value: "EL"
        }
        display {
          value: "elective"
        }
        definition {
          value: "Beneficial to the patient but not essential for survival."
        }
      }
      concept {
        code {
          value: "EM"
        }
        display {
          value: "emergency"
        }
        definition {
          value: "An unforeseen combination of circumstances or the resulting state that calls for immediate action."
        }
      }
      concept {
        code {
          value: "P"
        }
        display {
          value: "preop"
        }
        definition {
          value: "Used to indicate that a service is to be performed prior to a scheduled surgery.  When ordering a service and using the pre-op priority, a check is done to see the amount of time that must be allowed for performance of the service.  When the order is placed, a message can be generated indicating the time needed for the service so that it is not ordered in conflict with a scheduled operation."
        }
      }
      concept {
        code {
          value: "PRN"
        }
        display {
          value: "as needed"
        }
        definition {
          value: "An \"as needed\" order should be accompanied by a description of what constitutes a need. This description is represented by an observation service predicate as a precondition."
        }
      }
      concept {
        code {
          value: "R"
        }
        display {
          value: "routine"
        }
        definition {
          value: "Routine service, do at usual work hours."
        }
      }
      concept {
        code {
          value: "RR"
        }
        display {
          value: "rush reporting"
        }
        definition {
          value: "A report should be prepared and sent as quickly as possible."
        }
      }
      concept {
        code {
          value: "S"
        }
        display {
          value: "stat"
        }
        definition {
          value: "With highest priority (e.g., emergency)."
        }
      }
      concept {
        code {
          value: "T"
        }
        display {
          value: "timing critical"
        }
        definition {
          value: "It is critical to come as close as possible to the requested time (e.g., for a through antimicrobial level)."
        }
      }
      concept {
        code {
          value: "UD"
        }
        display {
          value: "use as directed"
        }
        definition {
          value: "Drug is to be used as directed by the prescriber."
        }
      }
      concept {
        code {
          value: "UR"
        }
        display {
          value: "urgent"
        }
        definition {
          value: "Calls for prompt action."
        }
      }
    }
  }
}
entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-hl7ApprovalStatus"
  }
  resource {
    code_system {
      id {
        value: "v3-hl7ApprovalStatus"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>affd<a name=\"v3-hl7ApprovalStatus-affd\"> </a></td><td>affiliate ballot - DSTU</td><td>\n                        \n                           Description: Content that is being presented to an international affiliate for consideration as a realm-specific draft standard for trial use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>affi<a name=\"v3-hl7ApprovalStatus-affi\"> </a></td><td>affiliate ballot - informative</td><td>\n                        \n                           Description: Content that is being presented to an international affiliate for consideration as a realm-specific informative standard.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>affn<a name=\"v3-hl7ApprovalStatus-affn\"> </a></td><td>affiliate ballot - normative</td><td>\n                        \n                           Description: Content that is being presented to an international affiliate for consideration as a realm-specific normative standard.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>appad<a name=\"v3-hl7ApprovalStatus-appad\"> </a></td><td>approved affiliate DSTU</td><td>\n                        \n                           Description: Content that has passed ballot as a realm-specific draft standard for trial use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>appai<a name=\"v3-hl7ApprovalStatus-appai\"> </a></td><td>approved affiliate informative</td><td>\n                        \n                           Description: Content that has passed ballot as a realm-specific informative standard.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>appan<a name=\"v3-hl7ApprovalStatus-appan\"> </a></td><td>approved affiliate normative</td><td>\n                        \n                           Description: Content that has passed ballot as a realm-specific normative standard<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>appd<a name=\"v3-hl7ApprovalStatus-appd\"> </a></td><td>approved DSTU</td><td>\n                        \n                           Description: Content that has passed ballot as a draft standard for trial use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>appi<a name=\"v3-hl7ApprovalStatus-appi\"> </a></td><td>approved informative</td><td>\n                        \n                           Description: Content that has passed ballot as a normative standard.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>appn<a name=\"v3-hl7ApprovalStatus-appn\"> </a></td><td>approved normative</td><td>\n                        \n                           Description: Content that has passed ballot as a normative standard.<br/>\r\n\n                     </td></tr>\r\n <tr style=\"background: #EFEFEF\"><td>1</td><td>comi<a name=\"v3-hl7ApprovalStatus-comi\"> </a> <b><i>Deprecated</i></b></td><td>committee ballot - informative</td><td>\n                        \n                           Description: Content prepared by a committee and submitted for internal consideration as an informative standard.<br/>\r\n\n                        \n                           \n                              Deprecation Comment\n                            No longer supported as ballot statuses within the HL7 Governance and Operations Manual.  Use normative or informative variants instead.<br/>\r\n\n                     </td></tr>\r\n <tr style=\"background: #EFEFEF\"><td>1</td><td>comn<a name=\"v3-hl7ApprovalStatus-comn\"> </a> <b><i>Deprecated</i></b></td><td>committee ballot - normative</td><td>\n                        \n                           Description: Content prepared by a committee and submitted for internal consideration as an informative standard.<br/>\r\n\n                        \n                           \n                              Deprecation Comment\n                            No longer supported as ballot statuses within the HL7 Governance and Operations Manual.  Use normative or informative variants instead.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>draft<a name=\"v3-hl7ApprovalStatus-draft\"> </a></td><td>draft</td><td>\n                        \n                           Description: Content that is under development and is not intended to be used.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>loc<a name=\"v3-hl7ApprovalStatus-loc\"> </a></td><td>localized adaptation</td><td>\n                        \n                           Description: Content that represents an adaption of a implementable balloted material to represent the needs or capabilities of a particular installation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>memd<a name=\"v3-hl7ApprovalStatus-memd\"> </a></td><td>membership ballot - DSTU</td><td>\n                        \n                           Description: Content prepared by a committee and submitted for membership consideration as a draft standard for trial use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>memi<a name=\"v3-hl7ApprovalStatus-memi\"> </a></td><td>membership ballot - informative</td><td>\n                        \n                           Description: Content prepared by a committee and submitted for membership consideration as an informative standard.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>memn<a name=\"v3-hl7ApprovalStatus-memn\"> </a></td><td>membership ballot - normative</td><td>\n                        \n                           Description: Content prepared by a committee and submitted for membership consideration as a normative standard.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>ns<a name=\"v3-hl7ApprovalStatus-ns\"> </a></td><td>non-standard - available for use</td><td>\n                        \n                           Description: Content developed independently by an organization or individual that is declared to be \'usable\' but for which there is no present intention to submit through the standards submission and review process.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>prop<a name=\"v3-hl7ApprovalStatus-prop\"> </a></td><td>proposal</td><td>\n                        \n                           Description: Content submitted to a committee for consideration for future inclusion in the standard.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>ref<a name=\"v3-hl7ApprovalStatus-ref\"> </a></td><td>reference</td><td>\n                        \n                           Description: Content intended to support other content that is subject to approval, but which is not itself subject to formal approval.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>wd<a name=\"v3-hl7ApprovalStatus-wd\"> </a></td><td>withdrawn</td><td>\n                        \n                           Description: Content that represents an item that was at one point a normative or informative standard, but was subsequently withdrawn.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
