        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-ActExposureLevelCode"
