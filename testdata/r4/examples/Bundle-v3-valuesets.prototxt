        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
            value: 1
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "pc"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-ParticipationMode"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1064"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.ParticipationMode"
      }
      title {
        value: "v3 Code System ParticipationMode"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " A set of codes specifying the modality by which the Entity playing the Role is participating in the Act.  Examples:\r\nPhysically present, over the telephone, written communication.  Rationale:\r\nParticularly for author (originator) participants this is used to specify whether the information represented by the act was initially provided verbally, (hand-)written, or electronically.  Open Issue:\r\nThere needs to be a reexamination of the hierarchies as there seems to be some muddling between ELECTRONIC and other concepts that involve electronic communication that are in other hierarchies."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-ParticipationMode"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "ELECTRONIC"
        }
        display {
          value: "electronic data"
        }
        definition {
          value: "Participation by non-human-languaged based electronic signal"
        }
      }
      concept {
        code {
          value: "PHYSICAL"
        }
        display {
          value: "physical presence"
        }
        definition {
          value: "Participation by direct action where subject and actor are in the same location. (The participation involves more than communication.)"
        }
      }
      concept {
        code {
          value: "REMOTE"
        }
        display {
          value: "remote presence"
        }
        definition {
          value: "Participation by direct action where subject and actor are in separate locations, and the actions of the actor are transmitted by electronic or mechanical means. (The participation involves more than communication.)"
        }
      }
      concept {
        code {
          value: "VERBAL"
        }
        display {
          value: "verbal"
        }
        definition {
          value: "Participation by voice communication"
        }
        concept {
          code {
            value: "DICTATE"
          }
          display {
            value: "dictated"
          }
          definition {
            value: "Participation by pre-recorded voice.  Communication is limited to one direction (from the recorder to recipient)."
          }
        }
        concept {
          code {
            value: "FACE"
          }
          display {
            value: "face-to-face"
          }
          definition {
            value: "Participation by voice communication where parties speak to each other directly."
          }
        }
        concept {
          code {
            value: "PHONE"
          }
          display {
            value: "telephone"
          }
          definition {
            value: "Participation by voice communication where the voices of the communicating parties are transported over an electronic medium"
          }
        }
        concept {
          code {
            value: "VIDEOCONF"
          }
          display {
            value: "videoconferencing"
          }
          definition {
            value: "Participation by voice and visual communication where the voices and images of the communicating parties are transported over an electronic medium"
          }
        }
      }
      concept {
        code {
          value: "WRITTEN"
        }
        display {
          value: "written"
        }
        definition {
          value: "Participation by human language recorded on a physical material"
        }
        concept {
          code {
            value: "FAXWRIT"
          }
          display {
            value: "telefax"
          }
          definition {
            value: "Participation by text or diagrams printed on paper that have been transmitted over a fax device"
          }
        }
        concept {
          code {
            value: "HANDWRIT"
          }
          display {
            value: "handwritten"
          }
          definition {
            value: "Participation by text or diagrams printed on paper or other recording medium"
          }
        }
        concept {
          code {
            value: "MAILWRIT"
          }
          display {
            value: "mail"
          }
          definition {
            value: "Participation by text or diagrams printed on paper transmitted physically (e.g. by courier service, postal service)."
          }
        }
        concept {
          code {
            value: "ONLINEWRIT"
          }
          display {
            value: "online written"
          }
          definition {
            value: "Participation by text or diagrams submitted by computer network, e.g. online survey."
          }
          concept {
            code {
              value: "EMAILWRIT"
            }
            display {
              value: "email"
            }
            definition {
              value: "Participation by text or diagrams transmitted over an electronic mail system."
            }
          }
        }
        concept {
          code {
            value: "TYPEWRIT"
          }
          display {
            value: "typewritten"
          }
          definition {
            value: "Participation by text or diagrams printed on paper or other recording medium where the recording was performed using a typewriter, typesetter, computer or similar mechanism."
          }
        }
      }
    }
  }
}
