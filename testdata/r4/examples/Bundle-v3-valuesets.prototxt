          }
          display {
            value: "Unsupported processing id"
          }
          definition {
            value: "The Processing ID is not supported."
          }
        }
        concept {
          code {
            value: "NS203"
          }
          display {
            value: "Unsupported version id"
          }
          definition {
            value: "The Version ID is not supported."
          }
        }
        concept {
          code {
            value: "NS250"
          }
          display {
            value: "Unsupported processing Mode"
          }
          definition {
            value: "The processing mode is not supported."
          }
        }
        concept {
          code {
            value: "NS260"
          }
          display {
            value: "Unknown sender"
          }
          definition {
            value: "The Device.id of the sender is unknown."
          }
        }
        concept {
          code {
            value: "NS261"
          }
          display {
            value: "Unrecognized attentionline"
          }
          definition {
            value: "The receiver requires information in the attentionLine classes for routing purposes."
          }
        }
      }
      concept {
        code {
          value: "INTERR"
        }
        display {
          value: "Internal system error"
        }
        definition {
          value: "An internal software component (database, application, queue mechanism, etc.) has failed, leading to inability to process the message."
        }
      }
      concept {
        code {
          value: "NOSTORE"
        }
        display {
          value: "No storage space for message."
        }
        definition {
          value: "Rejection: The message can\'t be stored by the receiver due to an unspecified internal application issue. The message was neither processed nor stored by the receiving application."
        }
      }
      concept {
        code {
          value: "RTEDEST"
        }
        display {
          value: "Message routing error, destination unreachable."
        }
        definition {
          value: "Error: The destination of this message is known to the receiving application. Messages have been successfully routed to that destination in the past. The link to the destination application or an intermediate application is unavailable."
        }
      }
      concept {
        code {
          value: "RTUDEST"
        }
        display {
          value: "Error: Message routing error, unknown destination."
        }
        definition {
          value: "The destination of this message is unknown to the receiving application. The receiving application in the message does not match the application which received the message. The message was neither routed, processed nor stored by the receiving application."
        }
      }
      concept {
        code {
          value: "RTWDEST"
        }
        display {
          value: "Message routing warning, destination unreachable."
        }
        definition {
          value: "Warning: The destination of this message is known to the receiving application. Messages have been successfully routed to that destination in the past. The link to the destination application or an intermediate application is (temporarily) unavailable. The receiving application will forward the message as soon as the destination can be reached again."
        }
      }
      concept {
        code {
          value: "SYN"
        }
        display {
          value: "Syntax error"
        }
        definition {
          value: "Reflects errors in the syntax or structure of the communication."
        }
        concept {
          code {
            value: "SYN102"
          }
          display {
            value: "Data type error"
          }
          definition {
            value: "The attribute contained data of the wrong data type, e.g. a numeric attribute contained \"FOO\"."
          }
        }
        concept {
          code {
            value: "SYN105"
          }
          display {
            value: "Required element missing"
          }
          definition {
            value: "Description: Required association or attribute missing in message; or the sequence of the classes is different than required by the standard or one of the conformance profiles identified in the message."
          }
          concept {
            code {
              value: "SYN100"
            }
            display {
              value: "Required association missing"
            }
            definition {
              value: "Required association missing in message; or the sequence of the classes is different than required by the standard or one of the conformance profiles identified in the message."
            }
          }
          concept {
            code {
              value: "SYN101"
            }
            display {
              value: "Required attribute missing"
            }
            definition {
              value: "A required attribute is missing in a class."
            }
          }
          concept {
            code {
              value: "SYN114"
            }
            display {
              value: "Insufficient repetitions"
            }
            definition {
              value: "Description: The number of repetitions of a group of association or attributes is less than the required minimum for the standard or of one of the conformance profiles or templates identified in the message."
            }
          }
        }
        concept {
          code {
            value: "SYN106"
          }
          display {
            value: "Terminology error"
          }
          definition {
            value: "Description: A coded attribute or datatype property violates one of the terminology constraints specified in the standard or one of the conformance profiles or templates declared by the instance."
          }
          concept {
            code {
              value: "SYN103"
            }
            display {
              value: "Value not found in code system"
            }
            definition {
              value: "An attribute value was compared against the corresponding code system, and no match was found."
            }
          }
          concept {
            code {
              value: "SYN104"
            }
            display {
              value: "Invalid code system in CNE"
            }
            definition {
              value: "An attribute value referenced a code system that is not valid for an attribute constrained to CNE."
            }
          }
          concept {
            code {
              value: "SYN107"
            }
            display {
              value: "Deprecated code"
            }
            definition {
              value: "Description: A coded attribute is referencing a code that has been deprecated by the owning code system."
            }
          }
        }
        concept {
          code {
            value: "SYN108"
          }
          display {
            value: "Number of repetitions exceeds limit"
          }
          definition {
            value: "Description: The number of repetitions of a (group of) association(s) or attribute(s) exceeds the limits of the standard or of one of the conformance profiles or templates identified in the message."
          }
          concept {
            code {
              value: "SYN110"
            }
            display {
              value: "Number of association repetitions exceeds limit"
            }
            definition {
              value: "The number of repetitions of a (group of) association(s) exceeds the limits of the standard or of one of the conformance profiles identified in the message."
            }
          }
          concept {
            code {
              value: "SYN112"
            }
            display {
              value: "Number of attribute repetitions exceeds limit"
            }
            definition {
              value: "The number of repetitions of an attribute exceeds the limits of the standard or of one of the conformance profiles identified in the message."
            }
          }
        }
        concept {
          code {
            value: "SYN109"
          }
          display {
            value: "Mandatory element with null value"
          }
          definition {
            value: "Description: An attribute or association identified as mandatory in a specification or declared conformance profile or template has been specified with a null flavor."
          }
        }
        concept {
          code {
            value: "SYN111"
          }
          display {
            value: "Value does not match fixed value"
          }
          definition {
            value: "Description: The value of an attribute or property differs from the fixed value asserted in the standard or one of the conformance profiles or templates declared in the message."
          }
        }
        concept {
          code {
            value: "SYN113"
          }
          display {
            value: "Formal constraint violation"
          }
          definition {
            value: "Description: A formal constraint asserted in the standard or one of the conformance profiles or templates declared in the message has been violated."
          }
        }
      }
    }
  }
}
