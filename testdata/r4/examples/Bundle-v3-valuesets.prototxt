entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-RoleClassPassive"
  }
  resource {
    value_set {
      id {
        value: "v3-RoleClassPassive"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetRoleClassPassive</h2><div><p>An association for a playing Entity that is used, known, treated, handled, built, or destroyed, etc. under the auspices of the scoping Entity. The playing Entity is passive in these roles (even though it may be active in other roles), in the sense that the kinds of things done to it in this role happen without an agreement from the playing Entity.</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include codes from <a href=\"../../v3/RoleClass/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-RoleClass</code></a> where concept  is-a  <a href=\"../../v3/RoleClass/cs.html#v3-RoleClass-_RoleClassPassive\">_RoleClassPassive</a></li><li>Exclude these codes as defined in <a href=\"../../v3/RoleClass/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-RoleClass</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td><a href=\"../../v3/RoleClass/cs.html#v3-RoleClass-_RoleClassPassive\">_RoleClassPassive</a></td><td>RoleClassPassive</td><td>An association for a playing Entity that is used, known, treated, handled, built, or destroyed, etc. under the auspices of the scoping Entity. The playing Entity is passive in these roles (even though it may be active in other roles), in the sense that the kinds of things done to it in this role happen without an agreement from the playing Entity.</td></tr></table></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-RoleClassPassive"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.19105"
        }
      }
      version {
        value: "2014-03-26"
      }
      name {
        value: "v3.RoleClassPassive"
      }
      title {
        value: "V3 Value SetRoleClassPassive"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7 v3"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://www.hl7.org"
          }
        }
      }
      description {
        value: " An association for a playing Entity that is used, known, treated, handled, built, or destroyed, etc. under the auspices of the scoping Entity. The playing Entity is passive in these roles (even though it may be active in other roles), in the sense that the kinds of things done to it in this role happen without an agreement from the playing Entity."
      }
      immutable {
        value: true
      }
      compose {
        include {
