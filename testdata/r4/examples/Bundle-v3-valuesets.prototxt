                  definition {
                    value: "Caplet"
                  }
                }
                concept {
                  code {
                    value: "CHEWTAB"
                  }
                  display {
                    value: "Chewable Tablet"
                  }
                  definition {
                    value: "A solid dosage form containing medicinal substances with or without suitable diluents that is intended to be chewed, producing a pleasant tasting residue in the oral cavity that is easily swallowed and does not leave a bitter or unpleasant after-taste."
                  }
                }
                concept {
                  code {
                    value: "CPTAB"
