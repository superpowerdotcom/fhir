                  display {
                    value: "Lozenge/Oral Troche"
                  }
                  definition {
                    value: "A solid preparation containing one or more medicaments, usually in a flavored, sweetened base which is intended to dissolve or disintegrate slowly in the mouth."
                  }
                }
                concept {
                  code {
                    value: "SLTAB"
