          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetActMoodPredicate</h2><div><p>Any of the above service moods (e.g., event, intent, or goal) can be turned into a predicate used as a criterion to express conditionals (or queries.)  However, currently we allow only criteria on service events.</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include codes from <a href=\"../../v3/ActMood/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ActMood</code></a> where concept  is-a  <a href=\"../../v3/ActMood/cs.html#v3-ActMood-_ActMoodPredicate\">_ActMoodPredicate</a></li><li>Exclude these codes as defined in <a href=\"../../v3/ActMood/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ActMood</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td><a href=\"../../v3/ActMood/cs.html#v3-ActMood-_ActMoodPredicate\">_ActMoodPredicate</a></td><td>ActMoodPredicate</td><td>Definition: An act that expresses condition statements for other acts.</td></tr></table></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-ActMoodPredicate"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.10202"
        }
      }
      version {
        value: "2014-03-26"
      }
      name {
        value: "v3.ActMoodPredicate"
      }
      title {
        value: "V3 Value SetActMoodPredicate"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
