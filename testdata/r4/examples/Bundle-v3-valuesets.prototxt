entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-hl7PublishingSection"
  }
  resource {
    value_set {
      id {
        value: "v3-hl7PublishingSection"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>AM<a name=\"v3-hl7PublishingSection-AM\"> </a></td><td>administrative management</td><td>\n                        \n                           Description: Represents the HL7 V3 publishing section that deals with the administration and management of health care activities and organizations.<br/>\r\n\n                        \n                           UsageNote: V3 Specifications are published in a set of &quot;domains&quot;, which contain interactions and related specifications for a single area of health care within which can be supported by a single, coherent set of interoperability specifications.<br/>\r\n\n                        For publishing purposes, these domains are aggregated into sub-sections of related health care areas and these sub-sections are further aggregated into three major sets.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>HM<a name=\"v3-hl7PublishingSection-HM\"> </a></td><td>health and clinical management</td><td>\n                        \n                           Description: Represents the HL7 V3 publishing section that deals with the health care provision and clinical management.<br/>\r\n\n                        \n                           UsageNote: V3 Specifications are published in a set of &quot;domains&quot;, which contain interactions and related specifications for a single area of health care within which can be supported by a single, coherent set of interoperability specifications.<br/>\r\n\n                        For publishing purposes, these domains are aggregated into sub-sections of related health care areas and these sub-sections are further aggregated into three major sets.   <br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>IM<a name=\"v3-hl7PublishingSection-IM\"> </a></td><td>infrastructure management</td><td>\n                        \n                           Description: Represents the HL7 V3 publishing section that deals with the definition and management of the computing and communication infrastructure necessary to support health care.<br/>\r\n\n                        \n                           UsageNote: V3 Specifications are published in a set of &quot;domains&quot;, which contain interactions and related specifications for a single area of health care within which can be supported by a single, coherent set of interoperability specifications.<br/>\r\n\n                        For publishing purposes, these domains are aggregated into sub-sections of related health care areas and these sub-sections are further aggregated into three major sets.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>UU<a name=\"v3-hl7PublishingSection-UU\"> </a></td><td>unknown</td><td>\n                        \n                           Description: Represents the HL7 V3 publishing section that holds specifications that are unassigned - that have not yet been assigned to one of the formal publishing sections.<br/>\r\n\n                        \n                           UsageNote: V3 Specifications are published in a set of &quot;domains&quot;, which contain interactions and related specifications for a single area of health care within which can be supported by a single, coherent set of interoperability specifications.<br/>\r\n\n                        For publishing purposes, these domains are aggregated into sub-sections of related health care areas and these sub-sections are further aggregated into three major sets.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
