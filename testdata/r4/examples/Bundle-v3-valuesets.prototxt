        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>SEQL<a name=\"v3-TransmissionRelationshipTypeCode-SEQL\"> </a></td><td>sequence</td><td>\n                        \n                           Description:A transmission relationship indicating that the source transmission follows the target transmission.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
