        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr style=\"background: #EFEFEF\"><td>1</td><td><span style=\"color: grey\"><i>(_CalendarCycleOneLetter)</i></span> <b><i>Abstract</i></b> <b><i>Deprecated</i></b></td><td><a name=\"v3-CalendarCycle-_CalendarCycleOneLetter\">\302\240</a></td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CW<a name=\"v3-CalendarCycle-CW\"> </a></td><td>week (continuous)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CY<a name=\"v3-CalendarCycle-CY\"> </a></td><td>year</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240D<a name=\"v3-CalendarCycle-D\"> </a></td><td>day of the month</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240DW<a name=\"v3-CalendarCycle-DW\"> </a></td><td>day of the week (begins with Monday)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240H<a name=\"v3-CalendarCycle-H\"> </a></td><td>hour of the day</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240M<a name=\"v3-CalendarCycle-M\"> </a></td><td>month of the year</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240N<a name=\"v3-CalendarCycle-N\"> </a></td><td>minute of the hour</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240S<a name=\"v3-CalendarCycle-S\"> </a></td><td>second of the minute</td><td/></tr>\r\n <tr style=\"background: #EFEFEF\"><td>1</td><td><span style=\"color: grey\"><i>(_CalendarCycleTwoLetter)</i></span> <b><i>Abstract</i></b> <b><i>Deprecated</i></b></td><td><a name=\"v3-CalendarCycle-_CalendarCycleTwoLetter\">\302\240</a></td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#CW\">CW</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#CY\">CY</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#D\">D</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#DW\">DW</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#H\">H</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#M\">M</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#N\">N</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#S\">S</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CD<a name=\"v3-CalendarCycle-CD\"> </a></td><td>day (continuous)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CH<a name=\"v3-CalendarCycle-CH\"> </a></td><td>hour (continuous)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CM<a name=\"v3-CalendarCycle-CM\"> </a></td><td>month (continuous)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CN<a name=\"v3-CalendarCycle-CN\"> </a></td><td>minute (continuous)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CS<a name=\"v3-CalendarCycle-CS\"> </a></td><td>second (continuous)</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240DY<a name=\"v3-CalendarCycle-DY\"> </a></td><td>day of the year</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240WY<a name=\"v3-CalendarCycle-WY\"> </a></td><td>week of the year</td><td/></tr>\r\n <tr><td>1</td><td>WM<a name=\"v3-CalendarCycle-WM\"> </a></td><td>week of the month</td><td>\n                        The week with the month\'s first Thursday in it (analagous to the ISO 8601 definition for week of the year).<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
