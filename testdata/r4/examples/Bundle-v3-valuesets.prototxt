}
entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-AcknowledgementCondition"
  }
  resource {
    code_system {
      id {
        value: "v3-AcknowledgementCondition"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>AL<a name=\"v3-AcknowledgementCondition-AL\"> </a></td><td>Always</td><td>\n                        Always send an acknowledgement.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>ER<a name=\"v3-AcknowledgementCondition-ER\"> </a></td><td>Error/reject only</td><td>\n                        Send an acknowledgement for error/reject conditions only.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>NE<a name=\"v3-AcknowledgementCondition-NE\"> </a></td><td>Never</td><td>\n                        Never send an acknowledgement.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>SU<a name=\"v3-AcknowledgementCondition-SU\"> </a></td><td>Successful only</td><td>\n                        Send an acknowledgement for successful completions only.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
