entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-RoleLinkStatus"
  }
  resource {
    code_system {
      id {
        value: "v3-RoleLinkStatus"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>NORMAL<a name=\"v3-RoleLinkStatus-NORMAL\"> </a></td><td>normal</td><td>\n                        \n                           Description: The \'typical\' state. Excludes &quot;nullified&quot; which represents the termination state of a RoleLink instance that was created in error.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ACTIVE<a name=\"v3-RoleLinkStatus-ACTIVE\"> </a></td><td>active</td><td>\n                        \n                           Description: The state indicates the RoleLink is in progress.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CANCELLED<a name=\"v3-RoleLinkStatus-CANCELLED\"> </a></td><td>cancelled</td><td>\n                        \n                           Description: The terminal state resulting from abandoning the RoleLink prior to or after activation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240COMPLETED<a name=\"v3-RoleLinkStatus-COMPLETED\"> </a></td><td>completed</td><td>\n                        \n                           Description: The terminal state representing the successful completion of the RoleLink.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PENDING<a name=\"v3-RoleLinkStatus-PENDING\"> </a></td><td>pending</td><td>\n                        \n                           Description: The state indicates the RoleLink has not yet become active.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>NULLIFIED<a name=\"v3-RoleLinkStatus-NULLIFIED\"> </a></td><td>nullified</td><td>\n                        \n                           Description: The state representing the termination of a RoleLink instance that was created in error.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-RoleLinkStatus"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1137"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.RoleLinkStatus"
      }
      title {
        value: "v3 Code System RoleLinkStatus"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "  Description:\r\nCodes representing possible states of a RoleLink, as defined by the RoleLink class state machine."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-RoleLinkStatus"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "NORMAL"
        }
        display {
          value: "normal"
        }
        definition {
          value: "Description: The \'typical\' state. Excludes \"nullified\" which represents the termination state of a RoleLink instance that was created in error."
        }
        concept {
          code {
            value: "ACTIVE"
          }
          display {
            value: "active"
          }
          definition {
            value: "Description: The state indicates the RoleLink is in progress."
          }
        }
        concept {
          code {
            value: "CANCELLED"
          }
          display {
            value: "cancelled"
          }
          definition {
            value: "Description: The terminal state resulting from abandoning the RoleLink prior to or after activation."
          }
        }
        concept {
          code {
            value: "COMPLETED"
          }
          display {
            value: "completed"
          }
          definition {
            value: "Description: The terminal state representing the successful completion of the RoleLink."
          }
        }
        concept {
          code {
            value: "PENDING"
          }
          display {
            value: "pending"
          }
          definition {
            value: "Description: The state indicates the RoleLink has not yet become active."
          }
        }
      }
      concept {
        code {
          value: "NULLIFIED"
        }
        display {
          value: "nullified"
        }
        definition {
          value: "Description: The state representing the termination of a RoleLink instance that was created in error."
        }
      }
    }
  }
}
