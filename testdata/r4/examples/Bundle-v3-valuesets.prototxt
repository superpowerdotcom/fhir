          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>I<a name=\"v3-ParticipationSignature-I\"> </a></td><td>intended</td><td>\n                        The particpant intends to provide a signature.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>S<a name=\"v3-ParticipationSignature-S\"> </a></td><td>signed</td><td>\n                        Signature has been affixed, either written on file, or electronic (incl. digital) signature in Participation.signatureText.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>X<a name=\"v3-ParticipationSignature-X\"> </a></td><td>required</td><td>\n                        A signature for the service is required of this actor.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
