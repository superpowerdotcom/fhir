      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " Specifies whether a response is expected from the addressee of this interaction and what level of detail that response should include"
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-ResponseLevel"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "C"
        }
        display {
          value: "completion"
        }
        definition {
          value: "Respond with exceptions and a notification of completion"
        }
      }
      concept {
        code {
          value: "D"
        }
        display {
          value: "detail"
        }
        definition {
          value: "Respond with exceptions, completion, modifications and include more detail information (if applicable)"
        }
      }
      concept {
        code {
          value: "E"
        }
        display {
          value: "exception"
        }
        definition {
          value: "Respond with exceptions only"
        }
      }
      concept {
        code {
          value: "F"
        }
        display {
          value: "confirmation"
        }
        definition {
          value: "Respond with exceptions, completion, and modification with detail (as above), and send positive confirmations even if no modifications are being made."
        }
      }
      concept {
        code {
          value: "N"
        }
        display {
          value: "message-control"
        }
        definition {
          value: "Respond only with message level acknowledgements, i.e., only notify acceptance or rejection of the message, do not include any application-level detail"
        }
      }
      concept {
        code {
          value: "R"
        }
        display {
          value: "modification"
        }
        definition {
          value: "Respond with exceptions, completions and modifications or revisions done before completion"
        }
      }
      concept {
        code {
          value: "X"
        }
        display {
          value: "none"
        }
        definition {
          value: "Do not send any kind of response"
        }
      }
    }
  }
}
