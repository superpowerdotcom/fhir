          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_AdministrableDrugForm)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_AdministrableDrugForm\">\302\240</a></td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240APPFUL<a name=\"v3-orderableDrugForm-APPFUL\"> </a></td><td>Applicatorful</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240DROP<a name=\"v3-orderableDrugForm-DROP\"> </a></td><td>Drops</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240NDROP<a name=\"v3-orderableDrugForm-NDROP\"> </a></td><td>Nasal Drops</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240OPDROP<a name=\"v3-orderableDrugForm-OPDROP\"> </a></td><td>Ophthalmic Drops</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ORDROP<a name=\"v3-orderableDrugForm-ORDROP\"> </a></td><td>Oral Drops</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240OTDROP<a name=\"v3-orderableDrugForm-OTDROP\"> </a></td><td>Otic Drops</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240PUFF<a name=\"v3-orderableDrugForm-PUFF\"> </a></td><td>Puff</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240SCOOP<a name=\"v3-orderableDrugForm-SCOOP\"> </a></td><td>Scoops</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240SPRY<a name=\"v3-orderableDrugForm-SPRY\"> </a></td><td>Sprays</td><td/></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_DispensableDrugForm)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_DispensableDrugForm\">\302\240</a></td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_GasDrugForm)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_GasDrugForm\">\302\240</a></td><td>\n                        Any elastic aeriform fluid in which the molecules are separated from one another and have free paths.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240GASINHL<a name=\"v3-orderableDrugForm-GASINHL\"> </a></td><td>Gas for Inhalation</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_GasLiquidMixture)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_GasLiquidMixture\">\302\240</a></td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240AER<a name=\"v3-orderableDrugForm-AER\"> </a></td><td>Aerosol</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240BAINHL<a name=\"v3-orderableDrugForm-BAINHL\"> </a></td><td>Breath Activated Inhaler</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240INHLSOL<a name=\"v3-orderableDrugForm-INHLSOL\"> </a></td><td>Inhalant Solution</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240MDINHL<a name=\"v3-orderableDrugForm-MDINHL\"> </a></td><td>Metered Dose Inhaler</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240NASSPRY<a name=\"v3-orderableDrugForm-NASSPRY\"> </a></td><td>Nasal Spray</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240DERMSPRY<a name=\"v3-orderableDrugForm-DERMSPRY\"> </a></td><td>Dermal Spray</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240FOAM<a name=\"v3-orderableDrugForm-FOAM\"> </a></td><td>Foam</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240FOAMAPL<a name=\"v3-orderableDrugForm-FOAMAPL\"> </a></td><td>Foam with Applicator</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240RECFORM<a name=\"v3-orderableDrugForm-RECFORM\"> </a></td><td>Rectal foam</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240VAGFOAM<a name=\"v3-orderableDrugForm-VAGFOAM\"> </a></td><td>Vaginal foam</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240VAGFOAMAPL<a name=\"v3-orderableDrugForm-VAGFOAMAPL\"> </a></td><td>Vaginal foam with applicator</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RECSPRY<a name=\"v3-orderableDrugForm-RECSPRY\"> </a></td><td>Rectal Spray</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240VAGSPRY<a name=\"v3-orderableDrugForm-VAGSPRY\"> </a></td><td>Vaginal Spray</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_GasSolidSpray)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_GasSolidSpray\">\302\240</a></td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240INHL<a name=\"v3-orderableDrugForm-INHL\"> </a></td><td>Inhalant</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240BAINHLPWD<a name=\"v3-orderableDrugForm-BAINHLPWD\"> </a></td><td>Breath Activated Powder Inhaler</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240INHLPWD<a name=\"v3-orderableDrugForm-INHLPWD\"> </a></td><td>Inhalant Powder</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240MDINHLPWD<a name=\"v3-orderableDrugForm-MDINHLPWD\"> </a></td><td>Metered Dose Powder Inhaler</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240NASINHL<a name=\"v3-orderableDrugForm-NASINHL\"> </a></td><td>Nasal Inhalant</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240ORINHL<a name=\"v3-orderableDrugForm-ORINHL\"> </a></td><td>Oral Inhalant</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PWDSPRY<a name=\"v3-orderableDrugForm-PWDSPRY\"> </a></td><td>Powder Spray</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SPRYADAPT<a name=\"v3-orderableDrugForm-SPRYADAPT\"> </a></td><td>Spray with Adaptor</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Liquid)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_Liquid\">\302\240</a></td><td>\n                        A state of substance that is an intermediate one entered into as matter goes from solid to gas; liquids are also intermediate in that they have neither the orderliness of a crystal nor the randomness of a gas. (Note: This term should not be used to describe solutions, only pure chemicals in their liquid state.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LIQCLN<a name=\"v3-orderableDrugForm-LIQCLN\"> </a></td><td>Liquid Cleanser</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240LIQSOAP<a name=\"v3-orderableDrugForm-LIQSOAP\"> </a></td><td>Medicated Liquid Soap</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240SHMP<a name=\"v3-orderableDrugForm-SHMP\"> </a></td><td>Shampoo</td><td>\n                        A liquid soap or detergent used to clean the hair and scalp and is often used as a vehicle for dermatologic agents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240OIL<a name=\"v3-orderableDrugForm-OIL\"> </a></td><td>Oil</td><td>\n                        An unctuous, combustible substance which is liquid, or easily liquefiable, on warming, and is soluble in ether but insoluble in water. Such substances, depending on their origin, are classified as animal, mineral, or vegetable oils.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TOPOIL<a name=\"v3-orderableDrugForm-TOPOIL\"> </a></td><td>Topical Oil</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SOL<a name=\"v3-orderableDrugForm-SOL\"> </a></td><td>Solution</td><td>\n                        A liquid preparation that contains one or more chemical substances dissolved, i.e., molecularly dispersed, in a suitable solvent or mixture of mutually miscible solvents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240<a href=\"#DROP\">DROP</a></td><td/><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240IPSOL<a name=\"v3-orderableDrugForm-IPSOL\"> </a></td><td>Intraperitoneal Solution</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240IRSOL<a name=\"v3-orderableDrugForm-IRSOL\"> </a></td><td>Irrigation Solution</td><td>\n                        A sterile solution intended to bathe or flush open wounds or body cavities; they\'re used topically, never parenterally.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DOUCHE<a name=\"v3-orderableDrugForm-DOUCHE\"> </a></td><td>Douche</td><td>\n                        A liquid preparation, intended for the irrigative cleansing of the vagina, that is prepared from powders, liquid solutions, or liquid concentrates and contains one or more chemical substances dissolved in a suitable solvent or mutually miscible solvents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ENEMA<a name=\"v3-orderableDrugForm-ENEMA\"> </a></td><td>Enema</td><td>\n                        A rectal preparation for therapeutic, diagnostic, or nutritive purposes.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240OPIRSOL<a name=\"v3-orderableDrugForm-OPIRSOL\"> </a></td><td>Ophthalmic Irrigation Solution</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240IVSOL<a name=\"v3-orderableDrugForm-IVSOL\"> </a></td><td>Intravenous Solution</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240ORALSOL<a name=\"v3-orderableDrugForm-ORALSOL\"> </a></td><td>Oral Solution</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240<a href=\"#ORDROP\">ORDROP</a></td><td/><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ELIXIR<a name=\"v3-orderableDrugForm-ELIXIR\"> </a></td><td>Elixir</td><td>\n                        A clear, pleasantly flavored, sweetened hydroalcoholic liquid containing dissolved medicinal agents; it is intended for oral use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240RINSE<a name=\"v3-orderableDrugForm-RINSE\"> </a></td><td>Mouthwash/Rinse</td><td>\n                        An aqueous solution which is most often used for its deodorant, refreshing, or antiseptic effect.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240SYRUP<a name=\"v3-orderableDrugForm-SYRUP\"> </a></td><td>Syrup</td><td>\n                        An oral solution containing high concentrations of sucrose or other sugars; the term has also been used to include any other liquid dosage form prepared in a sweet and viscid vehicle, including oral suspensions.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240RECSOL<a name=\"v3-orderableDrugForm-RECSOL\"> </a></td><td>Rectal Solution</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TOPSOL<a name=\"v3-orderableDrugForm-TOPSOL\"> </a></td><td>Topical Solution</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240LIN<a name=\"v3-orderableDrugForm-LIN\"> </a></td><td>Liniment</td><td>\n                        A solution or mixture of various substances in oil, alcoholic solutions of soap, or emulsions intended for external application.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240MUCTOPSOL<a name=\"v3-orderableDrugForm-MUCTOPSOL\"> </a></td><td>Mucous Membrane Topical Solution</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TINC<a name=\"v3-orderableDrugForm-TINC\"> </a></td><td>Tincture</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_LiquidLiquidEmulsion)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_LiquidLiquidEmulsion\">\302\240</a></td><td>\n                        A two-phase system in which one liquid is dispersed throughout another liquid in the form of small droplets.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CRM<a name=\"v3-orderableDrugForm-CRM\"> </a></td><td>Cream</td><td>\n                        A semisolid dosage form containing one or more drug substances dissolved or dispersed in a suitable base; more recently, the term has been restricted to products consisting of oil-in-water emulsions or aqueous microcrystalline dispersions of long chain fatty acids or alcohols that are water washable and more cosmetically and aesthetically acceptable.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240NASCRM<a name=\"v3-orderableDrugForm-NASCRM\"> </a></td><td>Nasal Cream</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OPCRM<a name=\"v3-orderableDrugForm-OPCRM\"> </a></td><td>Ophthalmic Cream</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240ORCRM<a name=\"v3-orderableDrugForm-ORCRM\"> </a></td><td>Oral Cream</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OTCRM<a name=\"v3-orderableDrugForm-OTCRM\"> </a></td><td>Otic Cream</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240RECCRM<a name=\"v3-orderableDrugForm-RECCRM\"> </a></td><td>Rectal Cream</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TOPCRM<a name=\"v3-orderableDrugForm-TOPCRM\"> </a></td><td>Topical Cream</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240VAGCRM<a name=\"v3-orderableDrugForm-VAGCRM\"> </a></td><td>Vaginal Cream</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240VAGCRMAPL<a name=\"v3-orderableDrugForm-VAGCRMAPL\"> </a></td><td>Vaginal Cream with Applicator</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LTN<a name=\"v3-orderableDrugForm-LTN\"> </a></td><td>Lotion</td><td>\n                        The term &quot;lotion&quot; has been used to categorize many topical suspensions, solutions and emulsions intended for application to the skin.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TOPLTN<a name=\"v3-orderableDrugForm-TOPLTN\"> </a></td><td>Topical Lotion</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240OINT<a name=\"v3-orderableDrugForm-OINT\"> </a></td><td>Ointment</td><td>\n                        A semisolid preparation intended for external application to the skin or mucous membranes.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240NASOINT<a name=\"v3-orderableDrugForm-NASOINT\"> </a></td><td>Nasal Ointment</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OINTAPL<a name=\"v3-orderableDrugForm-OINTAPL\"> </a></td><td>Ointment with Applicator</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OPOINT<a name=\"v3-orderableDrugForm-OPOINT\"> </a></td><td>Ophthalmic Ointment</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OTOINT<a name=\"v3-orderableDrugForm-OTOINT\"> </a></td><td>Otic Ointment</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240RECOINT<a name=\"v3-orderableDrugForm-RECOINT\"> </a></td><td>Rectal Ointment</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TOPOINT<a name=\"v3-orderableDrugForm-TOPOINT\"> </a></td><td>Topical Ointment</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240VAGOINT<a name=\"v3-orderableDrugForm-VAGOINT\"> </a></td><td>Vaginal Ointment</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240VAGOINTAPL<a name=\"v3-orderableDrugForm-VAGOINTAPL\"> </a></td><td>Vaginal Ointment with Applicator</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_LiquidSolidSuspension)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_LiquidSolidSuspension\">\302\240</a></td><td>\n                        A liquid preparation which consists of solid particles dispersed throughout a liquid phase in which the particles are not soluble.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240GEL<a name=\"v3-orderableDrugForm-GEL\"> </a></td><td>Gel</td><td>\n                        A semisolid system consisting of either suspensions made up of small inorganic particles or large organic molecules interpenetrated by a liquid.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240GELAPL<a name=\"v3-orderableDrugForm-GELAPL\"> </a></td><td>Gel with Applicator</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240NASGEL<a name=\"v3-orderableDrugForm-NASGEL\"> </a></td><td>Nasal Gel</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OPGEL<a name=\"v3-orderableDrugForm-OPGEL\"> </a></td><td>Ophthalmic Gel</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OTGEL<a name=\"v3-orderableDrugForm-OTGEL\"> </a></td><td>Otic Gel</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TOPGEL<a name=\"v3-orderableDrugForm-TOPGEL\"> </a></td><td>Topical Gel</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240URETHGEL<a name=\"v3-orderableDrugForm-URETHGEL\"> </a></td><td>Urethral Gel</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240VAGGEL<a name=\"v3-orderableDrugForm-VAGGEL\"> </a></td><td>Vaginal Gel</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240VGELAPL<a name=\"v3-orderableDrugForm-VGELAPL\"> </a></td><td>Vaginal Gel with Applicator</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PASTE<a name=\"v3-orderableDrugForm-PASTE\"> </a></td><td>Paste</td><td>\n                        A semisolid dosage form that contains one or more drug substances intended for topical application.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240PUD<a name=\"v3-orderableDrugForm-PUD\"> </a></td><td>Pudding</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TPASTE<a name=\"v3-orderableDrugForm-TPASTE\"> </a></td><td>Toothpaste</td><td>\n                        A paste formulation intended to clean and/or polish the teeth, and which may contain certain additional agents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SUSP<a name=\"v3-orderableDrugForm-SUSP\"> </a></td><td>Suspension</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240ITSUSP<a name=\"v3-orderableDrugForm-ITSUSP\"> </a></td><td>Intrathecal Suspension</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OPSUSP<a name=\"v3-orderableDrugForm-OPSUSP\"> </a></td><td>Ophthalmic Suspension</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240ORSUSP<a name=\"v3-orderableDrugForm-ORSUSP\"> </a></td><td>Oral Suspension</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERSUSP<a name=\"v3-orderableDrugForm-ERSUSP\"> </a></td><td>Extended-Release Suspension</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERSUSP12<a name=\"v3-orderableDrugForm-ERSUSP12\"> </a></td><td>12 Hour Extended-Release Suspension</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERSUSP24<a name=\"v3-orderableDrugForm-ERSUSP24\"> </a></td><td>24 Hour Extended Release Suspension</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240OTSUSP<a name=\"v3-orderableDrugForm-OTSUSP\"> </a></td><td>Otic Suspension</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240RECSUSP<a name=\"v3-orderableDrugForm-RECSUSP\"> </a></td><td>Rectal Suspension</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_SolidDrugForm)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-orderableDrugForm-_SolidDrugForm\">\302\240</a></td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BAR<a name=\"v3-orderableDrugForm-BAR\"> </a></td><td>Bar</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240BARSOAP<a name=\"v3-orderableDrugForm-BARSOAP\"> </a></td><td>Bar Soap</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240MEDBAR<a name=\"v3-orderableDrugForm-MEDBAR\"> </a></td><td>Medicated Bar Soap</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240CHEWBAR<a name=\"v3-orderableDrugForm-CHEWBAR\"> </a></td><td>Chewable Bar</td><td>\n                        A solid dosage form usually in the form of a rectangle that is meant to be chewed.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BEAD<a name=\"v3-orderableDrugForm-BEAD\"> </a></td><td>Beads</td><td>\n                        A solid dosage form in the shape of a small ball.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CAKE<a name=\"v3-orderableDrugForm-CAKE\"> </a></td><td>Cake</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CEMENT<a name=\"v3-orderableDrugForm-CEMENT\"> </a></td><td>Cement</td><td>\n                        A substance that serves to produce solid union between two surfaces.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CRYS<a name=\"v3-orderableDrugForm-CRYS\"> </a></td><td>Crystals</td><td>\n                        A naturally produced angular solid of definite form in which the ultimate units from which it is built up are systematically arranged; they are usually evenly spaced on a regular space lattice.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240DISK<a name=\"v3-orderableDrugForm-DISK\"> </a></td><td>Disk</td><td>\n                        A circular plate-like organ or structure.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240FLAKE<a name=\"v3-orderableDrugForm-FLAKE\"> </a></td><td>Flakes</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240GRAN<a name=\"v3-orderableDrugForm-GRAN\"> </a></td><td>Granules</td><td>\n                        A small particle or grain.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240GUM<a name=\"v3-orderableDrugForm-GUM\"> </a></td><td>ChewingGum</td><td>\n                        A sweetened and flavored insoluble plastic material of various shapes which when chewed, releases a drug substance into the oral cavity.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PAD<a name=\"v3-orderableDrugForm-PAD\"> </a></td><td>Pad</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240MEDPAD<a name=\"v3-orderableDrugForm-MEDPAD\"> </a></td><td>Medicated Pad</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PATCH<a name=\"v3-orderableDrugForm-PATCH\"> </a></td><td>Patch</td><td>\n                        A drug delivery system that contains an adhesived backing and that permits its ingredients to diffuse from some portion of it (e.g., the backing itself, a reservoir, the adhesive, or some other component) into the body from the external site where it is applied.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TPATCH<a name=\"v3-orderableDrugForm-TPATCH\"> </a></td><td>Transdermal Patch</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TPATH16<a name=\"v3-orderableDrugForm-TPATH16\"> </a></td><td>16 Hour Transdermal Patch</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TPATH24<a name=\"v3-orderableDrugForm-TPATH24\"> </a></td><td>24 Hour Transdermal Patch</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TPATH2WK<a name=\"v3-orderableDrugForm-TPATH2WK\"> </a></td><td>Biweekly Transdermal Patch</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TPATH72<a name=\"v3-orderableDrugForm-TPATH72\"> </a></td><td>72 Hour Transdermal Patch</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240TPATHWK<a name=\"v3-orderableDrugForm-TPATHWK\"> </a></td><td>Weekly Transdermal Patch</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PELLET<a name=\"v3-orderableDrugForm-PELLET\"> </a></td><td>Pellet</td><td>\n                        A small sterile solid mass consisting of a highly purified drug (with or without excipients) made by the formation of granules, or by compression and molding.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PILL<a name=\"v3-orderableDrugForm-PILL\"> </a></td><td>Pill</td><td>\n                        A small, round solid dosage form containing a medicinal agent intended for oral administration.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240CAP<a name=\"v3-orderableDrugForm-CAP\"> </a></td><td>Capsule</td><td>\n                        A solid dosage form in which the drug is enclosed within either a hard or soft soluble container or &quot;shell&quot; made from a suitable form of gelatin.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ORCAP<a name=\"v3-orderableDrugForm-ORCAP\"> </a></td><td>Oral Capsule</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ENTCAP<a name=\"v3-orderableDrugForm-ENTCAP\"> </a></td><td>Enteric Coated Capsule</td><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERENTCAP<a name=\"v3-orderableDrugForm-ERENTCAP\"> </a></td><td>Extended Release Enteric Coated Capsule</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERCAP<a name=\"v3-orderableDrugForm-ERCAP\"> </a></td><td>Extended Release Capsule</td><td>\n                        A solid dosage form in which the drug is enclosed within either a hard or soft soluble container made from a suitable form of gelatin, and which releases a drug (or drugs) in such a manner to allow a reduction in dosing frequency as compared to that drug (or drugs) presented as a conventional dosage form.<br/>\r\n\n                     </td></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240<a href=\"#ERENTCAP\">ERENTCAP</a></td><td/><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERCAP12<a name=\"v3-orderableDrugForm-ERCAP12\"> </a></td><td>12 Hour Extended Release Capsule</td><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERCAP24<a name=\"v3-orderableDrugForm-ERCAP24\"> </a></td><td>24 Hour Extended Release Capsule</td><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERECCAP<a name=\"v3-orderableDrugForm-ERECCAP\"> </a></td><td>Extended Release Enteric Coated Capsule</td><td>\n                        <br/>\r\n\n                        Rationale: Duplicate of code ERENTCAP. Use code ERENTCAP instead.</td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TAB<a name=\"v3-orderableDrugForm-TAB\"> </a></td><td>Tablet</td><td>\n                        A solid dosage form containing medicinal substances with or without suitable diluents.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ORTAB<a name=\"v3-orderableDrugForm-ORTAB\"> </a></td><td>Oral Tablet</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240BUCTAB<a name=\"v3-orderableDrugForm-BUCTAB\"> </a></td><td>Buccal Tablet</td><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240SRBUCTAB<a name=\"v3-orderableDrugForm-SRBUCTAB\"> </a></td><td>Sustained Release Buccal Tablet</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CAPLET<a name=\"v3-orderableDrugForm-CAPLET\"> </a></td><td>Caplet</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CHEWTAB<a name=\"v3-orderableDrugForm-CHEWTAB\"> </a></td><td>Chewable Tablet</td><td>\n                        A solid dosage form containing medicinal substances with or without suitable diluents that is intended to be chewed, producing a pleasant tasting residue in the oral cavity that is easily swallowed and does not leave a bitter or unpleasant after-taste.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CPTAB<a name=\"v3-orderableDrugForm-CPTAB\"> </a></td><td>Coated Particles Tablet</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DISINTAB<a name=\"v3-orderableDrugForm-DISINTAB\"> </a></td><td>Disintegrating Tablet</td><td>\n                        A solid dosage form containing medicinal substances which disintegrates rapidly, usually within a matter of seconds, when placed upon the tongue.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240DRTAB<a name=\"v3-orderableDrugForm-DRTAB\"> </a></td><td>Delayed Release Tablet</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ECTAB<a name=\"v3-orderableDrugForm-ECTAB\"> </a></td><td>Enteric Coated Tablet</td><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERECTAB<a name=\"v3-orderableDrugForm-ERECTAB\"> </a></td><td>Extended Release Enteric Coated Tablet</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERTAB<a name=\"v3-orderableDrugForm-ERTAB\"> </a></td><td>Extended Release Tablet</td><td>\n                        A solid dosage form containing a drug which allows at least a reduction in dosing frequency as compared to that drug presented in conventional dosage form.<br/>\r\n\n                     </td></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240<a href=\"#ERECTAB\">ERECTAB</a></td><td/><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERTAB12<a name=\"v3-orderableDrugForm-ERTAB12\"> </a></td><td>12 Hour Extended Release Tablet</td><td/></tr>\r\n <tr><td>7</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ERTAB24<a name=\"v3-orderableDrugForm-ERTAB24\"> </a></td><td>24 Hour Extended Release Tablet</td><td/></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240ORTROCHE<a name=\"v3-orderableDrugForm-ORTROCHE\"> </a></td><td>Lozenge/Oral Troche</td><td>\n                        A solid preparation containing one or more medicaments, usually in a flavored, sweetened base which is intended to dissolve or disintegrate slowly in the mouth.<br/>\r\n\n                     </td></tr>\r\n <tr><td>6</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240SLTAB<a name=\"v3-orderableDrugForm-SLTAB\"> </a></td><td>Sublingual Tablet</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240VAGTAB<a name=\"v3-orderableDrugForm-VAGTAB\"> </a></td><td>Vaginal Tablet</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240POWD<a name=\"v3-orderableDrugForm-POWD\"> </a></td><td>Powder</td><td>\n                        An intimate mixture of dry, finely divided drugs and/or chemicals that may be intended for internal or external use.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240TOPPWD<a name=\"v3-orderableDrugForm-TOPPWD\"> </a></td><td>Topical Powder</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240RECPWD<a name=\"v3-orderableDrugForm-RECPWD\"> </a></td><td>Rectal Powder</td><td/></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240VAGPWD<a name=\"v3-orderableDrugForm-VAGPWD\"> </a></td><td>Vaginal Powder</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SUPP<a name=\"v3-orderableDrugForm-SUPP\"> </a></td><td>Suppository</td><td>\n                        A solid body of various weights and shapes, adapted for introduction into the rectal, vaginal, or urethral orifice of the human body; they usually melt, soften, or dissolve at body temperature.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240RECSUPP<a name=\"v3-orderableDrugForm-RECSUPP\"> </a></td><td>Rectal Suppository</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240URETHSUPP<a name=\"v3-orderableDrugForm-URETHSUPP\"> </a></td><td>Urethral suppository</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240VAGSUPP<a name=\"v3-orderableDrugForm-VAGSUPP\"> </a></td><td>Vaginal Suppository</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SWAB<a name=\"v3-orderableDrugForm-SWAB\"> </a></td><td>Swab</td><td>\n                        A wad of absorbent material usually wound around one end of a small stick and used for applying medication or for removing material from an area.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240MEDSWAB<a name=\"v3-orderableDrugForm-MEDSWAB\"> </a></td><td>Medicated swab</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240WAFER<a name=\"v3-orderableDrugForm-WAFER\"> </a></td><td>Wafer</td><td>\n                        A thin slice of material containing a medicinal agent.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
