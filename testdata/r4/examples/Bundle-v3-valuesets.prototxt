      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_ValueSetOperator)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-SetOperator-_ValueSetOperator\">\302\240</a></td><td>\n                        Operations that can be used to associate concepts in a terminology.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240E<a name=\"v3-SetOperator-E\"> </a></td><td>exclude</td><td>\n                        Form the set-difference with this value, i.e., exclude this element or set from the resulting set.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240I<a name=\"v3-SetOperator-I\"> </a></td><td>include</td><td>\n                        Form the union with this value, i.e., include this element or set in the resulting set.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>A<a name=\"v3-SetOperator-A\"> </a></td><td>intersect</td><td>\n                        Form the intersection with the value.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>H<a name=\"v3-SetOperator-H\"> </a></td><td>convex hull</td><td>\n                        Form the convex hull with the value. The convex hull is defined over ordered domains and is the smallest contiguous superset (interval) that of all the operand sets.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>P<a name=\"v3-SetOperator-P\"> </a></td><td>periodic hull</td><td>\n                        Form the periodic hull with the value. The periodic hull is defined over ordered domains and is the periodic set that contains all contiguous supersets of pairs of intervals generated by the operand periodic intervals.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
