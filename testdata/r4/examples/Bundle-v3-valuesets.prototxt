        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_ExposureMode)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ExposureMode-_ExposureMode\">\302\240</a></td><td>\n                        Code for the mechanism by which the exposure agent was exchanged or potentially exchanged by the participants involved in the exposure.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240AIRBORNE<a name=\"v3-ExposureMode-AIRBORNE\"> </a></td><td>airborne</td><td>\n                        \n                           Description: Communication of an agent from a living subject or environmental source to a living subject through indirect contact via oral or nasal inhalation. <br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CONTACT<a name=\"v3-ExposureMode-CONTACT\"> </a></td><td>contact</td><td>\n                        \n                           Description: Communication of an agent from a living subject or environmental source to a living subject through direct physical contact.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240FOODBORNE<a name=\"v3-ExposureMode-FOODBORNE\"> </a></td><td>foodborne</td><td>\n                        \n                           Description: Communication of an agent from a food source to a living subject via oral consumption.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240WATERBORNE<a name=\"v3-ExposureMode-WATERBORNE\"> </a></td><td>waterborne</td><td>\n                        \n                           Description: Communication of an agent to a living subject by contact and/or consumption via an aqueous medium<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
