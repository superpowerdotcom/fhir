        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>D<a name=\"v3-TargetAwareness-D\"> </a></td><td>denying</td><td>\n                        Target person has been informed about the issue but currently denies it.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>F<a name=\"v3-TargetAwareness-F\"> </a></td><td>full awareness</td><td>\n                        Target person is fully aware of the issue.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>I<a name=\"v3-TargetAwareness-I\"> </a></td><td>incapable</td><td>\n                        Target person is not capable of comprehending the issue.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>M<a name=\"v3-TargetAwareness-M\"> </a></td><td>marginal</td><td>\n                        Target person is marginally aware of the issue.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>P<a name=\"v3-TargetAwareness-P\"> </a></td><td>partial</td><td>\n                        Target person is partially aware of the issue.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>U<a name=\"v3-TargetAwareness-U\"> </a></td><td>uninformed</td><td>\n                        Target person has not yet been informed of the issue.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
