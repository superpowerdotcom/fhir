entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-styleType"
  }
  resource {
    value_set {
      id {
        value: "v3-styleType"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_FontStyle)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-styleType-_FontStyle\">\302\240</a></td><td>\n                        Defines font rendering characteristics<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240bold<a name=\"v3-styleType-bold\"> </a></td><td>Bold Font</td><td>\n                        Render with a bold font<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240emphasis<a name=\"v3-styleType-emphasis\"> </a></td><td>Emphasised Font</td><td>\n                        Render with with some type of emphasis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240italics<a name=\"v3-styleType-italics\"> </a></td><td>Italics Font</td><td>\n                        Render italicized<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240underline<a name=\"v3-styleType-underline\"> </a></td><td>Underline Font</td><td>\n                        Render with an underline font<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_ListStyle)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-styleType-_ListStyle\">\302\240</a></td><td>\n                        Defines list rendering characteristics<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_OrderedListStyle)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-styleType-_OrderedListStyle\">\302\240</a></td><td>\n                        Defines rendering characteristics for ordered lists<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240Arabic<a name=\"v3-styleType-Arabic\"> </a></td><td>Arabic</td><td>\n                        List is ordered using Arabic numerals: 1, 2, 3<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BigAlpha<a name=\"v3-styleType-BigAlpha\"> </a></td><td>Big Alpha</td><td>\n                        List is ordered using big alpha characters: A, B, C<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240BigRoman<a name=\"v3-styleType-BigRoman\"> </a></td><td>Big Roman</td><td>\n                        List is ordered using big Roman numerals: I, II, III<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LittleAlpha<a name=\"v3-styleType-LittleAlpha\"> </a></td><td>Little Alpha</td><td>\n                        List is order using little alpha characters: a, b, c<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240LittleRoman<a name=\"v3-styleType-LittleRoman\"> </a></td><td>Little Roman</td><td>\n                        List is ordered using little Roman numerals: i, ii, iii<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_UnorderedListStyle)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-styleType-_UnorderedListStyle\">\302\240</a></td><td>\n                        Defines rendering characteristics for unordered lists<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240Circle<a name=\"v3-styleType-Circle\"> </a></td><td>Circle</td><td>\n                        List bullets are hollow discs<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240Disc<a name=\"v3-styleType-Disc\"> </a></td><td>Disc</td><td>\n                        List bullets are simple solid discs<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240Square<a name=\"v3-styleType-Square\"> </a></td><td>Square</td><td>\n                        List bullets are solid squares<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_TableRuleStyle)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-styleType-_TableRuleStyle\">\302\240</a></td><td>\n                        Defines table cell rendering characteristics<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240Botrule<a name=\"v3-styleType-Botrule\"> </a></td><td>Bottom Rule</td><td>\n                        Render cell with rule on bottom<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240Lrule<a name=\"v3-styleType-Lrule\"> </a></td><td>Left-sided rule</td><td>\n                        Render cell with left-sided rule<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240Rrule<a name=\"v3-styleType-Rrule\"> </a></td><td>Right-sided rule</td><td>\n                        Render cell with right-sided rule<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240Toprule<a name=\"v3-styleType-Toprule\"> </a></td><td>Top Rule</td><td>\n                        Render cell with rule on top<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
