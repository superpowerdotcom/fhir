entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-IdentifierReliability"
  }
  resource {
    code_system {
      id {
        value: "v3-IdentifierReliability"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>ISS<a name=\"v3-IdentifierReliability-ISS\"> </a></td><td>Issued by System</td><td>\n                        \n                           Description: The identifier was issued by the system responsible for constructing the instance.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>UNV<a name=\"v3-IdentifierReliability-UNV\"> </a></td><td>Unverified by system</td><td>\n                        \n                           Description: The identifier was provided to the system that constructed the instance, but has not been verified. e.g. a Drivers  license entered manually into a system by a user.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>VRF<a name=\"v3-IdentifierReliability-VRF\"> </a></td><td>Verified by system</td><td>\n                        \n                           Description: The identifier was not issued by the system responsible for constructing the instance, but the system that captured the id has verified the identifier with the issuing authority, or with another system that has verified the identifier.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-IdentifierReliability"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1117"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.IdentifierReliability"
      }
      title {
        value: "v3 Code System IdentifierReliability"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " Specifies the reliability with which the identifier is known. This attribute MAY be used to assist with identifier matching algorithms."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-IdentifierReliability"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "ISS"
        }
        display {
          value: "Issued by System"
        }
        definition {
          value: "Description: The identifier was issued by the system responsible for constructing the instance."
        }
      }
      concept {
        code {
          value: "UNV"
        }
        display {
          value: "Unverified by system"
        }
        definition {
          value: "Description: The identifier was provided to the system that constructed the instance, but has not been verified. e.g. a Drivers  license entered manually into a system by a user."
        }
      }
      concept {
        code {
          value: "VRF"
        }
        display {
          value: "Verified by system"
        }
        definition {
          value: "Description: The identifier was not issued by the system responsible for constructing the instance, but the system that captured the id has verified the identifier with the issuing authority, or with another system that has verified the identifier."
        }
      }
    }
  }
}
entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-ParticipationMode"
  }
  resource {
    code_system {
      id {
        value: "v3-ParticipationMode"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>ELECTRONIC<a name=\"v3-ParticipationMode-ELECTRONIC\"> </a></td><td>electronic data</td><td>\n                        Participation by non-human-languaged based electronic signal<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PHYSICAL<a name=\"v3-ParticipationMode-PHYSICAL\"> </a></td><td>physical presence</td><td>\n                        Participation by direct action where subject and actor are in the same location. (The participation involves more than communication.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>REMOTE<a name=\"v3-ParticipationMode-REMOTE\"> </a></td><td>remote presence</td><td>\n                        Participation by direct action where subject and actor are in separate locations, and the actions of the actor are transmitted by electronic or mechanical means. (The participation involves more than communication.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>VERBAL<a name=\"v3-ParticipationMode-VERBAL\"> </a></td><td>verbal</td><td>\n                        Participation by voice communication<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240DICTATE<a name=\"v3-ParticipationMode-DICTATE\"> </a></td><td>dictated</td><td>\n                        Participation by pre-recorded voice.  Communication is limited to one direction (from the recorder to recipient).<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240FACE<a name=\"v3-ParticipationMode-FACE\"> </a></td><td>face-to-face</td><td>\n                        Participation by voice communication where parties speak to each other directly.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PHONE<a name=\"v3-ParticipationMode-PHONE\"> </a></td><td>telephone</td><td>\n                        Participation by voice communication where the voices of the communicating parties are transported over an electronic medium<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240VIDEOCONF<a name=\"v3-ParticipationMode-VIDEOCONF\"> </a></td><td>videoconferencing</td><td>\n                        Participation by voice and visual communication where the voices and images of the communicating parties are transported over an electronic medium<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>WRITTEN<a name=\"v3-ParticipationMode-WRITTEN\"> </a></td><td>written</td><td>\n                        Participation by human language recorded on a physical material<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240FAXWRIT<a name=\"v3-ParticipationMode-FAXWRIT\"> </a></td><td>telefax</td><td>\n                        Participation by text or diagrams printed on paper that have been transmitted over a fax device<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240HANDWRIT<a name=\"v3-ParticipationMode-HANDWRIT\"> </a></td><td>handwritten</td><td>\n                        Participation by text or diagrams printed on paper or other recording medium<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MAILWRIT<a name=\"v3-ParticipationMode-MAILWRIT\"> </a></td><td>mail</td><td>\n                        Participation by text or diagrams printed on paper transmitted physically (e.g. by courier service, postal service).<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ONLINEWRIT<a name=\"v3-ParticipationMode-ONLINEWRIT\"> </a></td><td>online written</td><td>\n                        Participation by text or diagrams submitted by computer network, e.g. online survey.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240EMAILWRIT<a name=\"v3-ParticipationMode-EMAILWRIT\"> </a></td><td>email</td><td>\n                        Participation by text or diagrams transmitted over an electronic mail system.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TYPEWRIT<a name=\"v3-ParticipationMode-TYPEWRIT\"> </a></td><td>typewritten</td><td>\n                        Participation by text or diagrams printed on paper or other recording medium where the recording was performed using a typewriter, typesetter, computer or similar mechanism.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
