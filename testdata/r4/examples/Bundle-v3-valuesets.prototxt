entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-ActConsentType"
  }
  resource {
    value_set {
      id {
        value: "v3-ActConsentType"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetActConsentType</h2><div><p>Definition:\nThe type of consent directive, e.g., to consent or dissent to collect, access, or use in specific ways within an EHRS or for health information exchange; or to disclose  health information  for purposes such as research.</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include codes from <a href=\"../../v3/ActCode/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ActCode</code></a> where concept  is-a  <a href=\"../../v3/ActCode/cs.html#v3-ActCode-_ActConsentType\">_ActConsentType</a></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
