entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-employmentStatusODH"
  }
  resource {
    value_set {
      id {
        value: "v3-employmentStatusODH"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetemploymentStatusODH</h2><div><p>Concepts representing whether a person does or does not currently have a job or is not currently in the labor pool seeking employment.</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include codes from <a href=\"../../v3/ObservationValue/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ObservationValue</code></a> where concept  is-a  <a href=\"../../v3/ObservationValue/cs.html#v3-ObservationValue-_EmploymentStatus\">_EmploymentStatus</a></li><li>Exclude these codes as defined in <a href=\"../../v3/ObservationValue/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ObservationValue</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td><a href=\"../../v3/ObservationValue/cs.html#v3-ObservationValue-_EmploymentStatus\">_EmploymentStatus</a></td><td>_EmploymentStatus</td><td>Concepts representing whether a person does or does not currently have a job or is not currently in the labor pool seeking employment.</td></tr></table></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-employmentStatusODH"
      }
