          }
        }
        concept {
          code {
            value: "LE"
          }
          display {
            value: "Large extent"
          }
          definition {
            value: "Value for Act.partialCompletionCode attribute that implies 61-80% completion"
          }
        }
        concept {
          code {
            value: "ME"
          }
          display {
            value: "Medium extent"
          }
