entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-RouteOfAdministration"
  }
  resource {
    code_system {
      id {
        value: "v3-RouteOfAdministration"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_RouteByMethod)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_RouteByMethod\">\302\240</a></td><td>\n                        Route of substance administration classified by administration method.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SOAK<a name=\"v3-RouteOfAdministration-SOAK\"> </a></td><td>Immersion (soak)</td><td>\n                        Immersion (soak)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SHAMPOO<a name=\"v3-RouteOfAdministration-SHAMPOO\"> </a></td><td>Shampoo</td><td>\n                        Shampoo<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TRNSLING<a name=\"v3-RouteOfAdministration-TRNSLING\"> </a></td><td>Translingual</td><td>\n                        Translingual<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PO<a name=\"v3-RouteOfAdministration-PO\"> </a></td><td>Swallow, oral</td><td>\n                        Swallow, oral<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240GARGLE<a name=\"v3-RouteOfAdministration-GARGLE\"> </a></td><td>Gargle</td><td>\n                        Gargle<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SUCK<a name=\"v3-RouteOfAdministration-SUCK\"> </a></td><td>Suck, oromucosal</td><td>\n                        Suck, oromucosal<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Chew)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Chew\">\302\240</a></td><td>\n                        Chew<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CHEW<a name=\"v3-RouteOfAdministration-CHEW\"> </a></td><td>Chew, oral</td><td>\n                        Chew, oral<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Diffusion)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Diffusion\">\302\240</a></td><td>\n                        Diffusion<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240EXTCORPDIF<a name=\"v3-RouteOfAdministration-EXTCORPDIF\"> </a></td><td>Diffusion, extracorporeal</td><td>\n                        Diffusion, extracorporeal<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240HEMODIFF<a name=\"v3-RouteOfAdministration-HEMODIFF\"> </a></td><td>Diffusion, hemodialysis</td><td>\n                        Diffusion, hemodialysis<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240TRNSDERMD<a name=\"v3-RouteOfAdministration-TRNSDERMD\"> </a></td><td>Diffusion, transdermal</td><td>\n                        Diffusion, transdermal<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Dissolve)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Dissolve\">\302\240</a></td><td>\n                        Dissolve<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240DISSOLVE<a name=\"v3-RouteOfAdministration-DISSOLVE\"> </a></td><td>Dissolve, oral</td><td>\n                        Dissolve, oral<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SL<a name=\"v3-RouteOfAdministration-SL\"> </a></td><td>Dissolve, sublingual</td><td>\n                        Dissolve, sublingual<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Douche)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Douche\">\302\240</a></td><td>\n                        Douche<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240DOUCHE<a name=\"v3-RouteOfAdministration-DOUCHE\"> </a></td><td>Douche, vaginal</td><td>\n                        Douche, vaginal<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_ElectroOsmosisRoute)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_ElectroOsmosisRoute\">\302\240</a></td><td>\n                        Electro-osmosis<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ELECTOSMOS<a name=\"v3-RouteOfAdministration-ELECTOSMOS\"> </a></td><td>Electro-osmosis</td><td>\n                        Electro-osmosis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Enema)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Enema\">\302\240</a></td><td>\n                        Enema<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ENEMA<a name=\"v3-RouteOfAdministration-ENEMA\"> </a></td><td>Enema, rectal</td><td>\n                        Enema, rectal<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RETENEMA<a name=\"v3-RouteOfAdministration-RETENEMA\"> </a></td><td>Enema, rectal retention</td><td>\n                        Enema, rectal retention<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Flush)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Flush\">\302\240</a></td><td>\n                        Flush<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IVFLUSH<a name=\"v3-RouteOfAdministration-IVFLUSH\"> </a></td><td>Flush, intravenous catheter</td><td>\n                        Flush, intravenous catheter<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Implantation)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Implantation\">\302\240</a></td><td>\n                        Implantation<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IDIMPLNT<a name=\"v3-RouteOfAdministration-IDIMPLNT\"> </a></td><td>Implantation, intradermal</td><td>\n                        Implantation, intradermal<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IVITIMPLNT<a name=\"v3-RouteOfAdministration-IVITIMPLNT\"> </a></td><td>Implantation, intravitreal</td><td>\n                        Implantation, intravitreal<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SQIMPLNT<a name=\"v3-RouteOfAdministration-SQIMPLNT\"> </a></td><td>Implantation, subcutaneous</td><td>\n                        Implantation, subcutaneous<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Infusion)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Infusion\">\302\240</a></td><td>\n                        Infusion<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240EPI<a name=\"v3-RouteOfAdministration-EPI\"> </a></td><td>Infusion, epidural</td><td>\n                        Infusion, epidural<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IA<a name=\"v3-RouteOfAdministration-IA\"> </a></td><td>Infusion, intraarterial catheter</td><td>\n                        Infusion, intraarterial catheter<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IC<a name=\"v3-RouteOfAdministration-IC\"> </a></td><td>Infusion, intracardiac</td><td>\n                        Infusion, intracardiac<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240ICOR<a name=\"v3-RouteOfAdministration-ICOR\"> </a></td><td>Infusion, intracoronary</td><td>\n                        Infusion, intracoronary<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IOSSC<a name=\"v3-RouteOfAdministration-IOSSC\"> </a></td><td>Infusion, intraosseous, continuous</td><td>\n                        Infusion, intraosseous, continuous<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IT<a name=\"v3-RouteOfAdministration-IT\"> </a></td><td>Infusion, intrathecal</td><td>\n                        Infusion, intrathecal<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IV<a name=\"v3-RouteOfAdministration-IV\"> </a></td><td>Infusion, intravenous</td><td>\n                        Infusion, intravenous<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240IVC<a name=\"v3-RouteOfAdministration-IVC\"> </a></td><td>Infusion, intravenous catheter</td><td>\n                        Infusion, intravenous catheter<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240IVCC<a name=\"v3-RouteOfAdministration-IVCC\"> </a></td><td>Infusion, intravenous catheter, continuous</td><td>\n                        Infusion, intravenous catheter, continuous<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240IVCI<a name=\"v3-RouteOfAdministration-IVCI\"> </a></td><td>Infusion, intravenous catheter, intermittent</td><td>\n                        Infusion, intravenous catheter, intermittent<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240PCA<a name=\"v3-RouteOfAdministration-PCA\"> </a></td><td>Infusion, intravenous catheter, pca pump</td><td>\n                        Infusion, intravenous catheter, pca pump<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IVASCINFUS<a name=\"v3-RouteOfAdministration-IVASCINFUS\"> </a></td><td>Infusion, intravascular</td><td>\n                        Infusion, intravascular<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SQINFUS<a name=\"v3-RouteOfAdministration-SQINFUS\"> </a></td><td>Infusion, subcutaneous</td><td>\n                        Infusion, subcutaneous<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<span style=\"color: grey\"><i>(_Inhalation)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-RouteOfAdministration-_Inhalation\">\302\240</a></td><td>\n                        Inhalation<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IPINHL<a name=\"v3-RouteOfAdministration-IPINHL\"> </a></td><td>Inhalation, respiratory</td><td>\n                        Inhalation, oral<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240ORIFINHL<a name=\"v3-RouteOfAdministration-ORIFINHL\"> </a></td><td>Inhalation, oral intermittent flow</td><td>\n                        Inhalation, oral intermittent flow<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240REBREATH<a name=\"v3-RouteOfAdministration-REBREATH\"> </a></td><td>Inhalation, oral rebreather mask</td><td>\n                        Inhalation, oral rebreather mask<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240IPPB<a name=\"v3-RouteOfAdministration-IPPB