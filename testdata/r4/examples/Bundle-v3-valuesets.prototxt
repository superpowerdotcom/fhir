        }
        definition {
          value: "In a typical anesthesia setting an anesthesiologist or anesthesia resident in charge of the anesthesia and life support, but only a witness to the surgical procedure itself.  To clarify responsibilities anesthesia should always be represented as a separate service related to the surgery."
        }
      }
      concept {
        code {
          value: "ANRS"
        }
        display {
          value: "anesthesia nurse"
        }
        definition {
          value: "In a typical anesthesia setting the nurse principally assisting the anesthesiologist during the critical periods."
        }
      }
      concept {
        code {
          value: "ASSEMBLER"
        }
        display {
          value: "assembly software"
        }
        definition {
          value: "A device that operates independently of an author on custodian\'s algorithms for data extraction of existing information for purpose of generating a new artifact.\n                           UsageConstraint: ASSEMBLER ParticipationFunction should be used with DEV (device) ParticipationType."
        }
      }
      concept {
        code {
          value: "ATTPHYS"
        }
        display {
          value: "attending physician"
        }
        definition {
          value: "A physician who is primarily responsible for a patient during the hospitalization, which is the context of the service."
        }
      }
      concept {
        code {
          value: "COMPOSER"
        }
        display {
          value: "composer software"
        }
        definition {
          value: "A device used by an author to record new information, which may also be used by the author to select existing information for aggregation with newly recorded information for the purpose of generating a new artifact.\n                           UsageConstraint: COMPOSER ParticipationFunction should be used with DEV (device) ParticipationType.\r\n\n                        \n                           Usage Note: This code will enable implementers to more specifically represent the manner in which a Device participated in and facilitated the generation of a CDA Clinical Document or a CDA Entry by the responsible Author, which is comprised of the Author\'s newly entered content, and may include the pre-existing content selected by the Author, for the purpose of establishing the provenance and accountability for these acts."
        }
      }
      concept {
        code {
          value: "DISPHYS"
        }
        display {
          value: "discharging physician"
        }
        definition {
          value: "A physician who discharged a patient from a hospital or other care unit that is the context of this service."
        }
      }
      concept {
        code {
          value: "FASST"
        }
        display {
          value: "first assistant surgeon"
        }
        definition {
          value: "In a typical surgery setting the assistant facing the primary surgeon.  The first assistant performs parts of the operation and assists in others (e.g., incision, approach, electrocoutering, ligatures, sutures)."
        }
      }
      concept {
        code {
          value: "MDWF"
        }
        display {
          value: "midwife"
        }
        definition {
          value: "A person (usually female) helping a woman deliver a baby. Responsibilities vary locally, ranging from a mere optional assistant to a full required participant, responsible for (normal) births and pre- and post-natal care for both mother and baby."
        }
      }
      concept {
        code {
          value: "NASST"
        }
        display {
          value: "nurse assistant"
        }
        definition {
          value: "In a typical surgery setting the non-sterile nurse handles material supply from the stock, forwards specimen to pathology, and helps with other non-sterile tasks (e.g., phone calls, etc.)."
        }
      }
      concept {
        code {
          value: "PCP"
        }
        display {
          value: "primary care physician"
        }
        definition {
          value: "The healthcare provider that holds primary responsibility for the overall care of a patient."
        }
      }
      concept {
        code {
          value: "PRISURG"
        }
        display {
          value: "primary surgeon"
        }
        definition {
          value: "In a typical surgery setting the primary performing surgeon."
        }
      }
      concept {
        code {
          value: "REVIEWER"
        }
        display {
          value: "reviewer"
        }
        definition {
          value: "A verifier who is accountable for reviewing and asserting that the verification of an Act complies with jurisdictional or organizational policy.\r\n\n                        \n                           UsageConstraint: UsageConstraint:  Specifies the exact function that an actor is authorized to have as a verifier of an Act.  Connotes that a specialized verifier asserts compliance for veracity of the review per jurisdictional or organizational policy.  E.g., The Provider who takes responsibility for authenticity of a record submitted to a payer.\r\n\n                        REVIEW ParticipationFunction should be used with VFR (verifier)"
        }
      }
      concept {
        code {
          value: "RNDPHYS"
        }
        display {
          value: "rounding physician"
        }
        definition {
          value: "A physician who made rounds on a patient in a hospital or other care center."
        }
      }
      concept {
        code {
          value: "SASST"
        }
        display {
          value: "second assistant surgeon"
        }
        definition {
          value: "In a typical surgery setting the assistant who primarily holds the hooks."
        }
      }
      concept {
        code {
          value: "SNRS"
        }
        display {
          value: "scrub nurse"
        }
        definition {
          value: "In a typical surgery setting the nurse in charge of the instrumentation."
        }
      }
      concept {
        code {
          value: "TASST"
        }
        display {
          value: "third assistant"
        }
        definition {
          value: "In a typical surgery setting there is rarely a third assistant (e.g., in some Hip operations the third assistant postures the affected leg)."
        }
      }
    }
  }
}
entry {
  full_url {
