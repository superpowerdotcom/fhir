ary maxillary right third molar<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID20s<a name=\"v3-Dentition-TID20s\"> </a></td><td>20s</td><td>\n                        Supernumerary mandibular left second premolar<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID21s<a name=\"v3-Dentition-TID21s\"> </a></td><td>21s</td><td>\n                        Supernumerary mandibular left first premolar<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID22s<a name=\"v3-Dentition-TID22s\"> </a></td><td>22s</td><td>\n                        Supernumerary mandibular left canine<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID23s<a name=\"v3-Dentition-TID23s\"> </a></td><td>23s</td><td>\n                        Supernumerary mandibular left lateral incisor<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID24s<a name=\"v3-Dentition-TID24s\"> </a></td><td>24s</td><td>\n                        Supernumerary mandibular left central incisor<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID25s<a name=\"v3-Dentition-TID25s\"> </a></td><td>25s</td><td>\n                        Supernumerary mandibular right central incisor<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID26s<a name=\"v3-Dentition-TID26s\"> </a></td><td>26s</td><td>\n                        Supernumerary mandibular right lateral incisor<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID27s<a name=\"v3-Dentition-TID27s\"> </a></td><td>27s</td><td>\n                        Supernumerary mandibular right canine<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID28s<a name=\"v3-Dentition-TID28s\"> </a></td><td>28s</td><td>\n                        Supernumerary mandibular right first premolar<br/>\r\n\n                     </td></tr