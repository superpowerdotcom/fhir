entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-EntityNameUseR2"
  }
  resource {
    code_system {
      id {
        value: "v3-EntityNameUseR2"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(Assumed)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityNameUseR2-Assumed\">\302\240</a></td><td>\n                        \n                           Description:A name that a person has assumed or has been assumed to them. <br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240A<a name=\"v3-EntityNameUseR2-A\"> </a></td><td>business name</td><td>\n                        \n                           Description:A name used in a Professional or Business context .  Examples: Continuing to use a maiden name in a professional context, or using a stage performing name (some of these names are also pseudonyms)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ANON<a name=\"v3-EntityNameUseR2-ANON\"> </a></td><td>Anonymous</td><td>\n                        \n                           Description:Anonymous assigned name (used to protect a persons identity for privacy reasons)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240I<a name=\"v3-EntityNameUseR2-I\"> </a></td><td>Indigenous/Tribal</td><td>\n                        \n                           Description:e.g .  Chief Red Cloud<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240P<a name=\"v3-EntityNameUseR2-P\"> </a></td><td>Other/Pseudonym/Alias</td><td>\n                        \n                           Description:A non-official name by which the person is sometimes known.  (This may also be used to record informal names such as a nickname)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240R<a name=\"v3-EntityNameUseR2-R\"> </a></td><td>religious</td><td>\n                        \n                           Description:A name assumed as part of a religious vocation .  e.g .  Sister Mary Francis, Brother John<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>C<a name=\"v3-EntityNameUseR2-C\"> </a></td><td>customary</td><td>\n                        \n                           Description:Known as/conventional/the one you normally use<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>M<a name=\"v3-EntityNameUseR2-M\"> </a></td><td>maiden name</td><td>\n                        \n                           Description:A name used prior to marriage.Note that marriage naming customs vary greatly around the world.  This name use is for use by applications that collect and store maiden names.  Though the concept of maiden name is often gender specific, the use of this term is not gender specific.  The use of this term does not imply any particular history for a person\'s name, nor should the maiden name be determined algorithmically<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(NameRepresentationUse)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityNameUseR2-NameRepresentationUse\">\302\240</a></td><td>\n                        \n                           Description:Identifies the different representations of a name .  The representation may affect how the name is used .  (E.g .  use of Ideographic for formal communications.) <br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ABC<a name=\"v3-EntityNameUseR2-ABC\"> </a></td><td>alphabetic</td><td>\n                        \n                           Description:Alphabetic transcription of name in latin alphabet (Japanese: romaji)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240IDE<a name=\"v3-EntityNameUseR2-IDE\"> </a></td><td>ideographic</td><td>\n                        \n                           Description:Ideographic representation of name (e.g., Japanese kanji, Chinese characters)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYL<a name=\"v3-EntityNameUseR2-SYL\"> </a></td><td>syllabic</td><td>\n                        \n                           Description:Syllabic transcription of name (e.g., Japanese kana, Korean hangul)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>OLD<a name=\"v3-EntityNameUseR2-OLD\"> </a></td><td>no longer in use</td><td>\n                        \n                           Description:This name is no longer in use (note: Names may also carry valid time ranges .  This code is used to cover the situations where it is known that the name is no longer valid, but no particular time range for its use is known)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240DN<a name=\"v3-EntityNameUseR2-DN\"> </a></td><td>do not use</td><td>\n                        \n                           Description:This name should no longer be used when interacting with the person (i.e .  in addition to no longer being used, the name should not be even mentioned when interacting with the person)Note: applications are not required to compare names labeled &quot;Do Not Use&quot; and other names in order to eliminate name parts that are common between the other name and a name labeled &quot;Do Not Use&quot;.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>OR<a name=\"v3-EntityNameUseR2-OR\"> </a></td><td>official registry name</td><td>\n                        \n                           Description:The formal name as registered in an official (government) registry, but which name might not be commonly used .  May correspond to the concept of legal name<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>PHON<a name=\"v3-EntityNameUseR2-PHON\"> </a></td><td>phonetic</td><td>\n                        \n                           Description:The name as understood by the data enterer, i.e. a close approximation of a phonetic spelling of the name, not based on a phonetic algorithm.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>SRCH<a name=\"v3-EntityNameUseR2-SRCH\"> </a></td><td>search</td><td>\n                        \n                           Description:A name intended for use in searching or matching.  This is used when the name is incomplete and contains enough details for search matching, but not enough for other uses.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>T<a name=\"v3-EntityNameUseR2-T\"> </a></td><td>temporary</td><td>\n                        \n                           Description:A temporary name.  Note that a name valid time can provide more detailed information.  This may also be used for temporary names assigned at birth or in emergency situations.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
