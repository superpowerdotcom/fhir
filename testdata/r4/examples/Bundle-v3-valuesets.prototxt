          value: "urn:oid:2.16.840.1.113883.5.110"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.RoleClass"
      }
      title {
        value: "v3 Code System RoleClass"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
