entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-EntityClass"
  }
  resource {
    value_set {
      id {
        value: "v3-EntityClass"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>ENT<a name=\"v3-EntityClass-ENT\"> </a></td><td>entity</td><td>\n                        Corresponds to the Entity class<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240HCE<a name=\"v3-EntityClass-HCE\"> </a></td><td>health chart entity</td><td>\n                        A health chart included to serve as a document receiving entity in the management of medical records.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240LIV<a name=\"v3-EntityClass-LIV\"> </a></td><td>living subject</td><td>\n                        Anything that essentially has the property of life, independent of current state (a dead human corpse is still essentially a living subject).<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240NLIV<a name=\"v3-EntityClass-NLIV\"> </a></td><td>non-person living subject</td><td>A subtype of living subject that includes all living things except the species Homo Sapiens.</td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240ANM<a name=\"v3-EntityClass-ANM\"> </a></td><td>animal</td><td>\n                        A living subject from the animal kingdom.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240MIC<a name=\"v3-EntityClass-MIC\"> </a></td><td>microorganism</td><td>\n                        All single celled living organisms including protozoa, bacteria, yeast, viruses, etc.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240PLNT<a name=\"v3-EntityClass-PLNT\"> </a></td><td>plant</td><td>\n                        A living subject from the order of plants.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PSN<a name=\"v3-EntityClass-PSN\"> </a></td><td>person</td><td>\n                        A living subject of the species homo sapiens.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MAT<a name=\"v3-EntityClass-MAT\"> </a></td><td>material</td><td>\n                        Any thing that has extension in space and mass, may be of living or non-living origin.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CHEM<a name=\"v3-EntityClass-CHEM\"> </a></td><td>chemical substance</td><td>\n                        A substance that is fully defined by an organic or inorganic chemical formula, includes mixtures of other chemical substances. Refine using, e.g., IUPAC codes.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240FOOD<a name=\"v3-EntityClass-FOOD\"> </a></td><td>food</td><td>\n                        Naturally occurring, processed or manufactured entities that are primarily used as food for humans and animals.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240MMAT<a name=\"v3-EntityClass-MMAT\"> </a></td><td>manufactured material</td><td>\n                        Corresponds to the ManufacturedMaterial class<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240CONT<a name=\"v3-EntityClass-CONT\"> </a></td><td>container</td><td>\n                        A container of other entities.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240HOLD<a name=\"v3-EntityClass-HOLD\"> </a></td><td>holder</td><td>\n                        A type of container that can hold other containers or other holders.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240DEV<a name=\"v3-EntityClass-DEV\"> </a></td><td>device</td><td>\n                        A subtype of ManufacturedMaterial used in an activity, without being substantially changed through that activity.  The kind of device is identified by the code attribute inherited from Entity.<br/>\r\n\n                        \n                           Usage: This includes durable (reusable) medical equipment as well as disposable equipment.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240CER<a name=\"v3-EntityClass-CER\"> </a></td><td>certificate representation</td><td>\n                        A physical artifact that stores information about the granting of authorization.<br/>\r\n\n                     </td></tr>\r\n <tr><td>5</td><td>\302\240\302\240\302\240\302\240\302\240\302\240\302\240\302\240MODDV<a name=\"v3-EntityClass-MODDV\"> </a></td><td>imaging modality</td><td>\n                        Class to contain unique attributes of diagnostic imaging equipment.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ORG<a name=\"v3-EntityClass-ORG\"> </a></td><td>organization</td><td>\n                        A social or legal structure formed by human beings.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PUB<a name=\"v3-EntityClass-PUB\"> </a></td><td>public institution</td><td>\n                        An agency of the people of a state often assuming some authority over a certain matter. Includes government, governmental agencies, associations.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240STATE<a name=\"v3-EntityClass-STATE\"> </a></td><td>state</td><td>\n                        A politically organized body of people bonded by territory, culture, or ethnicity, having sovereignty (to a certain extent) granted by other states (enclosing or neighboring states). This includes countries (nations), provinces (e.g., one of the United States of America or a French departement), counties or municipalities. Refine using, e.g., ISO country codes, FIPS-PUB state codes, etc.<br/>\r\n\n                     </td></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\240NAT<a name=\"v3-EntityClass-NAT\"> </a></td><td>Nation</td><td>\n                        A politically organized body of people bonded by territory and known as a nation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PLC<a name=\"v3-EntityClass-PLC\"> </a></td><td>place</td><td>\n                        A physical place or site with its containing structure. May be natural or man-made. The geographic position of a place may or may not be constant.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240CITY<a name=\"v3-EntityClass-CITY\"> </a></td><td>city or town</td><td>\n                        The territory of a city, town or other municipality.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240COUNTRY<a name=\"v3-EntityClass-COUNTRY\"> </a></td><td>country</td><td>\n                        The territory of a sovereign nation.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240COUNTY<a name=\"v3-EntityClass-COUNTY\"> </a></td><td>county or parish</td><td>\n                        The territory of a county, parish or other division of a state or province.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240PROVINCE<a name=\"v3-EntityClass-PROVINCE\"> </a></td><td>state or province</td><td>\n                        The territory of a state, province, department or other division of a sovereign country.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240RGRP<a name=\"v3-EntityClass-RGRP\"> </a></td><td>group</td><td>\n                        A grouping of resources (personnel, material, or places) to be used for scheduling purposes.  May be a pool of like-type resources, a team, or combination of personnel, material and places.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-wg"
        }
        value {
          code {
            value: "vocab"
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-EntityClass"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.10882"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.EntityClass"
      }
      title {
        value: "v3 Code System EntityClass"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "Australia/Sydney"
        precision: DAY
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " Classifies the Entity class and all of its subclasses.  The terminology is hierarchical.  At the top is this  HL7-defined domain of high-level categories (such as represented by the Entity subclasses). Each of these terms must be harmonized and is specializable. The value sets beneath are drawn from multiple, frequently external, domains that reflect much more fine-grained typing."
      }
      immutable {
        value: true
      }
      compose {
        include {
          system {
            value: "http://terminology.hl7.org/CodeSystem/v3-EntityClass"
          }
        }
      }
    }
  }
}
