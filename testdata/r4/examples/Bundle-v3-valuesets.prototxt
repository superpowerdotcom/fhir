entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-EntityNameUse"
  }
  resource {
    code_system {
      id {
        value: "v3-EntityNameUse"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_NameRepresentationUse)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-EntityNameUse-_NameRepresentationUse\">\302\240</a></td><td>\n                        Identifies the different representations of a name.  The representation may affect how the name is used.  (E.g. use of Ideographic for formal communications.)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240ABC<a name=\"v3-EntityNameUse-ABC\"> </a></td><td>Alphabetic</td><td>\n                        Alphabetic transcription of name (Japanese: romaji)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240IDE<a name=\"v3-EntityNameUse-IDE\"> </a></td><td>Ideographic</td><td>\n                        Ideographic representation of name (e.g., Japanese kanji, Chinese characters)<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYL<a name=\"v3-EntityNameUse-SYL\"> </a></td><td>Syllabic</td><td>\n                        Syllabic transcription of name (e.g., Japanese kana, Korean hangul)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>ASGN<a name=\"v3-EntityNameUse-ASGN\"> </a></td><td>assigned</td><td>\n                        A name assigned to a person. Reasons some organizations assign alternate names may include not knowing the person\'s name, or to maintain anonymity. Some, but not necessarily all, of the name types that people call &quot;alias&quot; may fit into this category.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>C<a name=\"v3-EntityNameUse-C\"> </a></td><td>License</td><td>\n                        As recorded on a license, record, certificate, etc. (only if different from legal name)<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>I<a name=\"v3-EntityNameUse-I\"> </a></td><td>Indigenous/Tribal</td><td>\n                        e.g. Chief Red Cloud<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>L<a name=\"v3-EntityNameUse-L\"> </a></td><td>Legal</td><td>\n                        Known as/conventional/the one you use<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240OR<a name=\"v3-EntityNameUse-OR\"> </a></td><td>official registry</td><td>\n                        \n                           Definition:The formal name as registered in an official (government) registry, but which name might not be commonly used. Particularly used in countries with a law system based on Napoleonic law.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>P<a name=\"v3-EntityNameUse-P\"> </a></td><td>pseudonym</td><td>\n                        A self asserted name that the person is using or has used.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240A<a name=\"v3-EntityNameUse-A\"> </a></td><td>Artist/Stage</td><td>\n                        Includes writer\'s pseudonym, stage name, etc<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>R<a name=\"v3-EntityNameUse-R\"> </a></td><td>Religious</td><td>\n                        e.g. Sister Mary Francis, Brother John<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>SRCH<a name=\"v3-EntityNameUse-SRCH\"> </a></td><td>search</td><td>\n                        A name intended for use in searching or matching.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240PHON<a name=\"v3-EntityNameUse-PHON\"> </a></td><td>phonetic</td><td>\n                        A name spelled phonetically.<br/>\r\n\n                        There are a variety of phonetic spelling algorithms. This code value does not distinguish between these.Discussion: \n                        <br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SNDX<a name=\"v3-EntityNameUse-SNDX\"> </a></td><td>Soundex</td><td>\n                        A name spelled according to the SoundEx algorithm.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
