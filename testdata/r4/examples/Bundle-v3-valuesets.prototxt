                    }
                    display {
                      value: "Extended Release Enteric Coated Tablet"
                    }
                    definition {
                      value: "Extended Release Enteric Coated Tablet"
                    }
                  }
                }
                concept {
                  code {
                    value: "ERTAB"
                  }
                  display {
                    value: "Extended Release Tablet"
                  }
                  definition {
                    value: "A solid dosage form containing a drug which allows at least a reduction in dosing frequency as compared to that drug presented in conventional dosage form."
                  }
                  property {
                    code {
                      value: "child"
                    }
                    value {
