entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v3-ParticipationInformationGenerator"
  }
  resource {
    value_set {
      id {
        value: "v3-ParticipationInformationGenerator"
      }
      meta {
        last_updated {
          value_us: 1572560963356000
          timezone: "+11:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetParticipationInformationGenerator</h2><div><p>Parties that may or should contribute or have contributed information to the Act. Such information includes information leading to the decision to perform the Act and how to perform the Act (e.g., consultant), information that the Act itself seeks to reveal (e.g., informant of clinical history), or information about what Act was performed (e.g., informant witness).</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include codes from <a href=\"../../v3/ParticipationType/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ParticipationType</code></a> where concept  is-a  <a href=\"../../v3/ParticipationType/cs.html#v3-ParticipationType-_ParticipationInformationGenerator\">_ParticipationInformationGenerator</a></li><li>Exclude these codes as defined in <a href=\"../../v3/ParticipationType/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-ParticipationType</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td><a href=\"../../v3/ParticipationType/cs.html#v3-ParticipationType-_ParticipationInformationGenerator\">_ParticipationInformationGenerator</a></td><td>ParticipationInformationGenerator</td><td>Parties that may or should contribute or have contributed information to the Act. Such information includes information leading to the decision to perform the Act and how to perform the Act (e.g., consultant), information that the Act itself seeks to reveal (e.g., informant of clinical history), or information about what Act was performed (e.g., informant witness).</td></tr></table></li></ul></div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/ValueSet/v3-ParticipationInformationGenerator"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.1.11.10251"
        }
      }
      version {
        value: "2014-03-26"
      }
      name {
        value: "v3.ParticipationInformationGenerator"
      }
      title {
        value: "V3 Value SetParticipationInformationGenerator"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7 v3"
      }
      contact {
        telecom {
          system {
            value: URL
