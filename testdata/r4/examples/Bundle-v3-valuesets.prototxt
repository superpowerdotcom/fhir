                  display {
                    value: "Coated Particles Tablet"
                  }
                  definition {
                    value: "Coated Particles Tablet"
                  }
                }
                concept {
                  code {
                    value: "DISINTAB"
                  }
                  display {
                    value: "Disintegrating Tablet"
                  }
                  definition {
                    value: "A solid dosage form containing medicinal substances which disintegrates rapidly, usually within a matter of seconds, when placed upon the tongue."
                  }
                }
                concept {
                  code {
                    value: "DRTAB"
