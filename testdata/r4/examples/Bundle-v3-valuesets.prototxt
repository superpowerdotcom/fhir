        value: "2018-08-12"
      }
      name {
        value: "v3.ActMood"
      }
      title {
        value: "v3 Code System ActMood"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      date {
        value_us: 1533996000000000
        timezone: "+10:00"
        precision: SECOND
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: " OpenIssue:  In Ballot 2009May, a strong Negative vote was lodged against several of the concept definitions in the vocabulary used for Act.moodCode. The vote was found \"Persuasive With Mod\", with the understanding that M and M would undertake a detailed review of these concept definitions for a future release of the RIM."
      }
      case_sensitive {
        value: true
      }
      value_set {
        value: "http://terminology.hl7.org/ValueSet/v3-ActMood"
      }
      hierarchy_meaning {
        value: IS_A
      }
      content {
        value: COMPLETE
      }
      property {
        code {
          value: "notSelectable"
        }
        uri {
          value: "http://hl7.org/fhir/concept-properties#notSelectable"
        }
        description {
          value: "Indicates that the code is abstract - only intended to be used as a selector for other concepts"
        }
