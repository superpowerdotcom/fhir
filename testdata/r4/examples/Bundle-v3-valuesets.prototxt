entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v3-AcknowledgementDetailCode"
  }
  resource {
    code_system {
      id {
        value: "v3-AcknowledgementDetailCode"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_AcknowledgementDetailNotSupportedCode)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-AcknowledgementDetailCode-_AcknowledgementDetailNotSupportedCode\">\302\240</a></td><td>\n                        Refelects rejections because elements of the communication are not supported in the current context.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NS200<a name=\"v3-AcknowledgementDetailCode-NS200\"> </a></td><td>Unsupported interaction</td><td>\n                        The interaction (or: this version of the interaction) is not supported.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NS202<a name=\"v3-AcknowledgementDetailCode-NS202\"> </a></td><td>Unsupported processing id</td><td>\n                        The Processing ID is not supported.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NS203<a name=\"v3-AcknowledgementDetailCode-NS203\"> </a></td><td>Unsupported version id</td><td>\n                        The Version ID is not supported.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NS250<a name=\"v3-AcknowledgementDetailCode-NS250\"> </a></td><td>Unsupported processing Mode</td><td>\n                        The processing mode is not supported.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NS260<a name=\"v3-AcknowledgementDetailCode-NS260\"> </a></td><td>Unknown sender</td><td>\n                        The Device.id of the sender is unknown.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240NS261<a name=\"v3-AcknowledgementDetailCode-NS261\"> </a></td><td>Unrecognized attentionline</td><td>\n                        The receiver requires information in the attentionLine classes for routing purposes.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>INTERR<a name=\"v3-AcknowledgementDetailCode-INTERR\"> </a></td><td>Internal system error</td><td>\n                        An internal software component (database, application, queue mechanism, etc.) has failed, leading to inability to process the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>NOSTORE<a name=\"v3-AcknowledgementDetailCode-NOSTORE\"> </a></td><td>No storage space for message.</td><td>\n                        \n                           Rejection: The message can\'t be stored by the receiver due to an unspecified internal application issue. The message was neither processed nor stored by the receiving application.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>RTEDEST<a name=\"v3-AcknowledgementDetailCode-RTEDEST\"> </a></td><td>Message routing error, destination unreachable.</td><td>\n                        \n                           Error: The destination of this message is known to the receiving application. Messages have been successfully routed to that destination in the past. The link to the destination application or an intermediate application is unavailable.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>RTUDEST<a name=\"v3-AcknowledgementDetailCode-RTUDEST\"> </a></td><td>Error: Message routing error, unknown destination.</td><td>\n                        The destination of this message is unknown to the receiving application. The receiving application in the message does not match the application which received the message. The message was neither routed, processed nor stored by the receiving application.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>RTWDEST<a name=\"v3-AcknowledgementDetailCode-RTWDEST\"> </a></td><td>Message routing warning, destination unreachable.</td><td>\n                        \n                           Warning: The destination of this message is known to the receiving application. Messages have been successfully routed to that destination in the past. The link to the destination application or an intermediate application is (temporarily) unavailable. The receiving application will forward the message as soon as the destination can be reached again.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>SYN<a name=\"v3-AcknowledgementDetailCode-SYN\"> </a></td><td>Syntax error</td><td>\n                        Reflects errors in the syntax or structure of the communication.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYN102<a name=\"v3-AcknowledgementDetailCode-SYN102\"> </a></td><td>Data type error</td><td>\n                        The attribute contained data of the wrong data type, e.g. a numeric attribute contained &quot;FOO&quot;.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYN105<a name=\"v3-AcknowledgementDetailCode-SYN105\"> </a></td><td>Required element missing</td><td>\n                        \n                           Description: Required association or attribute missing in message; or the sequence of the classes is different than required by the standard or one of the conformance profiles identified in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN100<a name=\"v3-AcknowledgementDetailCode-SYN100\"> </a></td><td>Required association missing</td><td>\n                        Required association missing in message; or the sequence of the classes is different than required by the standard or one of the conformance profiles identified in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN101<a name=\"v3-AcknowledgementDetailCode-SYN101\"> </a></td><td>Required attribute missing</td><td>\n                        A required attribute is missing in a class.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN114<a name=\"v3-AcknowledgementDetailCode-SYN114\"> </a></td><td>Insufficient repetitions</td><td>\n                        \n                           Description: The number of repetitions of a group of association or attributes is less than the required minimum for the standard or of one of the conformance profiles or templates identified in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYN106<a name=\"v3-AcknowledgementDetailCode-SYN106\"> </a></td><td>Terminology error</td><td>\n                        \n                           Description: A coded attribute or datatype property violates one of the terminology constraints specified in the standard or one of the conformance profiles or templates declared by the instance.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN103<a name=\"v3-AcknowledgementDetailCode-SYN103\"> </a></td><td>Value not found in code system</td><td>\n                        An attribute value was compared against the corresponding code system, and no match was found.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN104<a name=\"v3-AcknowledgementDetailCode-SYN104\"> </a></td><td>Invalid code system in CNE</td><td>\n                        An attribute value referenced a code system that is not valid for an attribute constrained to CNE.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN107<a name=\"v3-AcknowledgementDetailCode-SYN107\"> </a></td><td>Deprecated code</td><td>\n                        \n                           Description: A coded attribute is referencing a code that has been deprecated by the owning code system.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYN108<a name=\"v3-AcknowledgementDetailCode-SYN108\"> </a></td><td>Number of repetitions exceeds limit</td><td>\n                        \n                           Description: The number of repetitions of a (group of) association(s) or attribute(s) exceeds the limits of the standard or of one of the conformance profiles or templates identified in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN110<a name=\"v3-AcknowledgementDetailCode-SYN110\"> </a></td><td>Number of association repetitions exceeds limit</td><td>\n                        The number of repetitions of a (group of) association(s) exceeds the limits of the standard or of one of the conformance profiles identified in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SYN112<a name=\"v3-AcknowledgementDetailCode-SYN112\"> </a></td><td>Number of attribute repetitions exceeds limit</td><td>\n                        The number of repetitions of an attribute exceeds the limits of the standard or of one of the conformance profiles identified in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYN109<a name=\"v3-AcknowledgementDetailCode-SYN109\"> </a></td><td>Mandatory element with null value</td><td>\n                        \n                           Description: An attribute or association identified as mandatory in a specification or declared conformance profile or template has been specified with a null flavor.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYN111<a name=\"v3-AcknowledgementDetailCode-SYN111\"> </a></td><td>Value does not match fixed value</td><td>\n                        \n                           Description: The value of an attribute or property differs from the fixed value asserted in the standard or one of the conformance profiles or templates declared in the message.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240SYN113<a name=\"v3-AcknowledgementDetailCode-SYN113\"> </a></td><td>Formal constraint violation</td><td>\n                        \n                           Description: A formal constraint asserted in the standard or one of the conformance profiles or templates declared in the message has been violated.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v3-AcknowledgementDetailCode"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.5.1100"
        }
      }
      version {
        value: "2018-08-12"
      }
      name {
        value: "v3.AcknowledgementDetailCode"
      }
      title {
        value: "v3 Code System AcknowledgementDetailCode"
      }
      status {
        value: ACTIVE
      }
      experimental {
