              definition {
                value: "Security metadata observation value used to indicate that the veracity or trustworthiness of an IT resource (data, information object, service, or system capability) for a specified purpose of use is perceived to be or deemed by policy to be adequate."
              }
            }
            concept {
              code {
                value: "UNCERTREL"
