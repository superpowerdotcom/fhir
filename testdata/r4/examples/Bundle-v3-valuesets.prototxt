        value: "v3-PersonDisabilityType"
      }
      meta {
        last_updated {
          value_us: 1533996000000000
          timezone: "+10:00"
          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>1<a name=\"v3-PersonDisabilityType-1\"> </a></td><td>Vision impaired</td><td>\n                        Vision impaired<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>2<a name=\"v3-PersonDisabilityType-2\"> </a></td><td>Hearing impaired</td><td>\n                        Hearing impaired<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>3<a name=\"v3-PersonDisabilityType-3\"> </a></td><td>Speech impaired</td><td>\n                        Speech impaired<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>4<a name=\"v3-PersonDisabilityType-4\"> </a></td><td>Mentally impaired</td><td>\n                        Mentally impaired<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>5<a name=\"v3-PersonDisabilityType-5\"> </a></td><td>Mobility impaired</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240CB<a name=\"v3-PersonDisabilityType-CB\"> </a></td><td>Requires crib</td><td>\n                        A crib is required to move the person<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240CR<a name=\"v3-PersonDisabilityType-CR\"> </a></td><td>Requires crutches</td><td>\n                        Person requires crutches to ambulate<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240G<a name=\"v3-PersonDisabilityType-G\"> </a></td><td>Requires gurney</td><td>\n                        A gurney is required to move the person<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240WC<a name=\"v3-PersonDisabilityType-WC\"> </a></td><td>Requires wheelchair</td><td>\n                        Person requires a wheelchair to be ambulatory<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240WK<a name=\"v3-PersonDisabilityType-WK\"> </a></td><td>Requires walker</td><td>\n                        Person requires a walker to ambulate<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
