        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>ArtificialDentition<a name=\"v3-Dentition-ArtificialDentition\"> </a></td><td>Artificial dentition</td><td>\n                        Artificial dentition, artificial subsitutes for the natural dentition<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10a<a name=\"v3-Dentition-TID10a\"> </a></td><td>10a</td><td>\n                        Maxillary left lateral incisor abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10i<a name=\"v3-Dentition-TID10i\"> </a></td><td>10i</td><td>\n                        Maxillary left lateral incisor implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10p<a name=\"v3-Dentition-TID10p\"> </a></td><td>10p</td><td>\n                        Maxillary left lateral incisor prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10pd<a name=\"v3-Dentition-TID10pd\"> </a></td><td>10pd</td><td>\n                        Maxillary left lateral incisor distal prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID10pm<a name=\"v3-Dentition-TID10pm\"> </a></td><td>10pm</td><td>\n                        Maxillary left lateral incisor mesial prosthesis<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID11a<a name=\"v3-Dentition-TID11a\"> </a></td><td>11a</td><td>\n                        Maxillary left canine abutment<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240TID11i<a name=\"v3-Dentition-TID11i\"> </a></td><td>11i</td><td>\n                        Maxillary left canine implant<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\30