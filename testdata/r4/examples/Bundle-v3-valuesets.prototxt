        }
      }
      concept {
        code {
          value: "PWLG"
        }
        display {
          value: "Paid work, local government, not armed forces"
        }
        definition {
          value: "A situation in which an individual works for a government organization with jurisdiction below the level of state/provincial/territorial/tribal government (e.g., city, town, township), not armed forces, and receives a paid salary or wage."
        }
      }
      concept {
        code {
          value: "PWNSE"
        }
        display {
          value: "Paid non-governmental work, not self-employed"
        }
        definition {
          value: "A situation in which an individual works for a business (not government) that they do not own and receives a paid salary or wage."
        }
      }
      concept {
        code {
          value: "PWSE"
        }
        display {
          value: "Paid work, self-employed"
        }
        definition {
          value: "A situation in which an individual earns a salary or wage working for himself or herself instead of working for an employer."
        }
      }
      concept {
        code {
          value: "PWSG"
        }
        display {
          value: "Paid work, state government, not armed forces"
        }
        definition {
          value: "A situation in which an individual works for a government organization with jurisdiction immediately below the level of national government (between national government and local government), not armed forces and receives a paid salary or wage.  Often called a state, provincial, territorial, or tribal government."
        }
      }
      concept {
        code {
          value: "UWNSE"
        }
        display {
          value: "Unpaid non-governmental work, not self-employed"
        }
        definition {
          value: "A situation in which an individual works for a business (not government) that they do not own without receiving a paid salary or wage."
        }
      }
      concept {
        code {
          value: "UWSE"
        }
        display {
          value: "Unpaid work, self-employed"
        }
        definition {
          value: "A situation in which an individual works for himself or herself without receiving a paid salary or wage."
        }
      }
      concept {
        code {
          value: "VW"
        }
        display {
          value: "Voluntary work"
        }
        definition {
          value: "A situation in which an individual chooses to do something, especially for other people or for an organization, willingly and without being forced or compensated to do it.  This can include formal activity undertaken through public, private and voluntary organizations as well as informal community participation."
        }
      }
    }
