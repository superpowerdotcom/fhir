<tr><td>3</td><td>\302\240\302\240\302\240\302\240RO<a name=\"v3-hl7Realm-RO\"> </a></td><td>Romania</td><td>\n                        \n                           Description: Realm code for use of Romania<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240RU<a name=\"v3-hl7Realm-RU\"> </a></td><td>Russian Federation</td><td>\n                        \n                           Description: Realm code for use of Russian Federation<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SE<a name=\"v3-hl7Realm-SE\"> </a></td><td>Sweden</td><td>\n                        \n                           Description: Realm code for use of Sweden<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SG<a name=\"v3-hl7Realm-SG\"> </a></td><td>Singapore</td><td>\n                        \n                           Description: Realm code for use of Localized Version<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240SOA<a name=\"v3-hl7Realm-SOA\"> </a></td><td>Southern Africa</td><td>\n                        \n                           Description: Realm code for use of Southern Africa<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240TR<a name=\"v3-hl7Realm-TR\"> </a></td><td>Turkey</td><td>\n                        \n                           Description: Realm code for use of Turkey<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240TW<a name=\"v3-hl7Realm-TW\"> </a></td><td>Taiwan</td><td>\n                        \n                           Description: Realm code for use of Taiwan<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240UK<a name=\"v3-hl7Realm-UK\"> </a></td><td>United Kingdom</td><td>\n                        \n                           Description: Realm code for use of United Kingdom<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240US<a name=\"v3-hl7Realm-US\"> </a></td><td>United States of America</td><td>\n                        \n                           Description: Realm code for use of United States of America<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240UV<a name=\"v3-hl7Realm-UV\"> </a></td><td>Universal</td><td>\n                        \n                           Description: Realm code for use of Universal realm or context, used in every instance<br/>\r\n\n                     </td></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\240UY<a name=\"v3-hl7Realm-UY\"> </a></td><td>Uruguay</td><td>\n                        \n                           Description: Realm code for use of Uruguay<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240C1<a name=\"v3-hl7Realm-C1\"> </a></td><td>Unclassified Realm</td><td>\n                        \n                           Description: Realm code for use of Unclassified Realm<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240GB<a name=\"v3-hl7Realm-GB\"> </a></td><td>Great Britain</td><td>\n                        \n                           Description: Realm code for use of Great Britain<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240R1<a name=\"v3-hl7Realm-R1\"> </a></td><td>Representative Realm</td><td>\n                        \n                           Description: Realm code for use of Representative Realm<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240X1<a name=\"v3-hl7Realm-X1\"> </a></td><td>Example Realm</td><td>\n                        \n                           Description: Realm code for use of Example Realm<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(NamespaceRealms)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-hl7Realm-NamespaceRealms\">\302\240</a></td><td>\n                        \n                           Description: Codes that can be used in the &quot;realm&quot; portion of HL7 v3 artifact identifiers.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#AffiliateRealms\">AffiliateRealms</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240<a href=\"#GB\">GB</a></td><td/><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240ZZ<a name=\"v3-hl7Realm-ZZ\"> </a></td><td>Localized Version</td><td>\n                        \n                           Description: An artifact created for local use only.  This realm namespace has no owning affiliate.  Its use is uncontrolled, i.e. anyone can create artifacts using this realm namespace.  Because of this, there is a significant likelihood of artifact identifier collisions.  Implementers are encouraged to register their artifacts under an affiliate owned and controlled namespace to avoid such collision problems where possible.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
