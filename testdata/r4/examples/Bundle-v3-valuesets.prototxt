      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td>RCV<a name=\"v3-CommunicationFunctionType-RCV\"> </a></td><td>receiver</td><td>\n                        The entity is the receiver of the transmission.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>RSP<a name=\"v3-CommunicationFunctionType-RSP\"> </a></td><td>respond to</td><td>\n                        The entity is the one to which the response or reply to the transmission should be sent.<br/>\r\n\n                     </td></tr>\r\n <tr><td>1</td><td>SND<a name=\"v3-CommunicationFunctionType-SND\"> </a></td><td>sender</td><td>\n                        The entity is the sender of the transmission.<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
