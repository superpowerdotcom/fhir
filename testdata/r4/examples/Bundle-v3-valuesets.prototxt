73-6<a name=\"v3-Race-1073-6\"> </a></td><td>South American Indian</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401074-4<a name=\"v3-Race-1074-4\"> </a></td><td>Spanish American Indian</td><td/></tr>\r\n <tr><td>3</td><td>\302\240\302\240\302\240\302\2401076-9<a name=\"v3-Race-1076-9\"> </a></td><td>Catawba</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401741-8<a name=\"v3-Race-1741-8\"> </a></td><td>Alatna</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401742-6<a name=\"v3-Race-1742-6\"> </a></td><td>Alexander</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401743-4<a name=\"v3-Race-1743-4\"> </a></td><td>Allakaket</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401744-2<a name=\"v3-Race-1744-2\"> </a></td><td>Alanvik</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401745-9<a name=\"v3-Race-1745-9\"> </a></td><td>Anvik</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401746-7<a name=\"v3-Race-1746-7\"> </a></td><td>Arctic</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401747-5<a name=\"v3-Race-1747-5\"> </a></td><td>Beaver</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401748-3<a name=\"v3-Race-1748-3\"> </a></td><td>Birch Creek</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401749-1<a name=\"v3-Race-1749-1\"> </a></td><td>Cantwell</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401750-9<a name=\"v3-Race-1750-9\"> </a></td><td>Chalkyitsik</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401751-7<a name=\"v3-Race-1751-7\"> </a></td><td>Chickaloon</td><td/></tr>\r\n <tr><td>4</td><td>\302\240\302\240\302\240\302\240\302\240\302\2401752-5<a name=\"v3-Race-1752-5\">