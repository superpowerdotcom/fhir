            display {
              value: "Swab"
            }
            definition {
              value: "A wad of absorbent material usually wound around one end of a small stick and used for applying medication or for removing material from an area."
            }
            concept {
              code {
                value: "MEDSWAB"
              }
              display {
                value: "Medicated swab"
              }
              definition {
                value: "Medicated swab"
              }
            }
