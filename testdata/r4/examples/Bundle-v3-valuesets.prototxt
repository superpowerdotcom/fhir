anguages-x-WAO\"> </a></td><td>Wappo</td><td/></tr>\r\n <tr><td>2</td><td>\302\240\302\240x-YUK<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-YUK\"> </a></td><td>Yuki</td><td/></tr>\r\n <tr><td>1</td><td>x-HAI<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-HAI\"> </a></td><td>Haida</td><td/></tr>\r\n <tr><td>1</td><td>x-KUN<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-KUN\"> </a></td><td>Kootenai</td><td/></tr>\r\n <tr><td>1</td><td>x-PSD<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-PSD\"> </a></td><td>Plains Indian Sign Language</td><td/></tr>\r\n <tr><td>1</td><td>x-YUC<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-YUC\"> </a></td><td>Yuchi</td><td/></tr>\r\n <tr><td>1</td><td>x-ZUN<a name=\"v3-AmericanIndianAlaskaNativeLanguages-x-ZUN\"> </a></td><td>Zuni</td><td/></tr>\r\n</table>\r\n</div>"
