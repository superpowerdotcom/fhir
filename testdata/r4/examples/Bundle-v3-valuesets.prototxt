        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Release Date: 2018-08-12</p>\r\n<table class=\"grid\">\r\n <tr><td><b>Level</b></td><td><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr>\r\n <tr><td>1</td><td><span style=\"color: grey\"><i>(_ActExposureLevelCode)</i></span> <b><i>Abstract</i></b></td><td><a name=\"v3-ActExposureLevelCode-_ActExposureLevelCode\">\302\240</a></td><td>\n                        A qualitative measure of the degree of exposure to the causative agent.  This includes concepts such as &quot;low&quot;, &quot;medium&quot; and &quot;high&quot;.  This quantifies how the quantity that was available to be administered to the target differs from typical or background levels of the substance.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240HIGH<a name=\"v3-ActExposureLevelCode-HIGH\"> </a></td><td>high</td><td>\n                        \n                           Description: Exposure to an agent at a relatively high level above background.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240LOW<a name=\"v3-ActExposureLevelCode-LOW\"> </a></td><td>low</td><td>\n                        \n                           Description: Exposure to an agent at a relatively low level above background.<br/>\r\n\n                     </td></tr>\r\n <tr><td>2</td><td>\302\240\302\240MEDIUM<a name=\"v3-ActExposureLevelCode-MEDIUM\"> </a></td><td>medium</td><td>\n                        \n                           Description: Exposure to an agent at a relatively moderate level above background.A<br/>\r\n\n                     </td></tr>\r\n</table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
