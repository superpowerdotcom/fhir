          precision: MILLISECOND
        }
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      text {
        status {
          value: GENERATED
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><h2>V3 Value SetRoleClassMutualRelationship</h2><div><p>A relationship that is based on mutual behavior of the two Entities as being related. The basis of such relationship may be agreements (e.g., spouses, contract parties) or they may bede facto\nbehavior (e.g. friends) or may be an incidental involvement with each other (e.g. parties over a dispute, siblings, children).</p>\n</div><p>This value set includes codes from the following code systems:</p><ul><li>Include codes from <a href=\"../../v3/RoleClass/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-RoleClass</code></a> where concept  is-a  <a href=\"../../v3/RoleClass/cs.html#v3-RoleClass-_RoleClassMutualRelationship\">_RoleClassMutualRelationship</a></li><li>Exclude these codes as defined in <a href=\"../../v3/RoleClass/cs.html\"><code>http://terminology.hl7.org/CodeSystem/v3-RoleClass</code></a><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td><a href=\"../../v3/RoleClass/cs.html#v3-RoleClass-_RoleClassMutualRelationship\">_RoleClassMutualRelationship</a></td><td>RoleClassMutualRelationship</td><td>A relationship that is based on mutual behavior of the two Entities as being related. The basis of such relationship may be agreements (e.g., spouses, contract parties) or they may be de facto behavior (e.g. friends) or may be an incidental involvement with each other (e.g. parties over a dispute, siblings, children).</td></tr></table></li></ul></div>"
        }
      }
      extension {
