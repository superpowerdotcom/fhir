          short {
            value: "Additional identifier for the evidence"
          }
          definition {
            value: "A formal identifier that is used to identify this evidence when it is represented in other formats, or referenced in a specification, model, design or an instance."
          }
          comment {
            value: "Typically, this is used for identifiers that can go in an HL7 V3 II (instance identifier) data type, and can then identify this evidence outside of FHIR, where it is not possible to use the logical URI."
          }
          requirements {
            value: "Allows externally provided and/or usable business identifiers to be easily associated with the module."
          }
          min {
