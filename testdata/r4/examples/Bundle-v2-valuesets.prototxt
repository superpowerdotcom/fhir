          }
          value {
            string_value {
              value: "Class: Financial\r\nA more precise definition of an account number: sometimes two distinct account numbers must be transmitted in the same message, one as the creditor, the other as the debitor.\r\nKreditorenkontonummer"
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
