      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Bacterial strain inhibited by in vitro concentration of an antimicrobial agent that is associated with a high likelihood of therapeutic success.\r\nReference: CLSI (http://www.clsi.org/Content/NavigationMenu/Resources/HarmonizedTerminologyDatabase/Harmonized_Terminolo.htm) \r\nProjects: ISO 20776-1, ISO 20776-2\r\n\r\nSynonym (earlier term): Sensitive\r\n\r\nNote 1: Bacterial strains are categorized as susceptible by applying the appropriate breakpoints in a defined phenotypic system.\r\n\r\nNote 2: This breakpoint can be altered due to changes in circumstances (e.g., changes in commonly used drug dosages, emergence of new resistance mechanisms)."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Bacteri\303\253le stam geblokkeerd door in vitro concentratie van een anti-bacteri\303\253le agens die is gekoppeld aan een hoge kans op therapeutisch succes. Referentie: CLSI (http://www.clsi.org/Content/NavigationMenu/Resources/HarmonizedTerminologyDatabase/Harmoniz"
                    }
                  }
                }
              }
            }
          }
