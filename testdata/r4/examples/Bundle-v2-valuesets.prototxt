              value: "deprecated"
            }
          }
        }
        property {
          code {
            value: "deprecationDate"
          }
          value {
            date_time {
              value_us: 1293800400000000
              timezone: "Australia/Sydney"
              precision: MONTH
            }
          }
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "ISO\'s currency codes, which are based on the ISO country codes are published in the standard ISO 4217:2008 Codes for the representation of currencies and funds.  This International Standard specifies the structure for a three-letter alphabetic code and an equivalent three-digit numeric code for the representation of currencies and funds. For those currencies having minor units, it also shows the decimal relationship between such units and the currency itself."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "ISO Munteenheden, gebaseerd op ISO Landcodes worden gepubliceerd in de standaard ISO 4217:2008 Codes voor representatie van munteenheden en fondsen. Deze internationale standaard specificeert de structuur voor een drieletterige code en een equivalente driecijferige code voor de representatie van munteenheden en fondsen. Voor munteenheden met kleinere eenheden, kan ook de decimale relatie tussen zulke eenheden en de hoofdeenheid worden gelegd."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "ISO4217"
        }
        display {
          value: "ISO4217 Currency Codes"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "ISO 4217 Munteenheden"
          }
        }
        property {
          code {
            value: "status"
          }
          value {
            code {
              value: "deprecated"
            }
          }
        }
        property {
          code {
            value: "deprecationDate"
          }
          value {
            date_time {
              value_us: 1293800400000000
              timezone: "Australia/Sydney"
              precision: MONTH
            }
          }
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "International Standards Organization codes for the representation of names of languages.  ISO 639 provides two sets of language codes, one as a two-character code set (639-1) and another as a three-character code set (639-2) for the representation of names of languages.  ISO 639-3, Codes for the representation of names of languages - Part 3: Alpha-3 code for comprehensive coverage of languages, is a code list that aims to define three-letter identifiers for all known human languages."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "International Standards Organization codes voor de representie van taalnamen. ISO 639 biedt twee sets met taalcodes, E\303\251n als codes set met codes van twee tekens (639-1) en een andere met codes van drie tekens (639-2) voor de representatie van taalnamen. ISO 639-3, Codes voor de representatie van taalnamen - Deel 3: Alfa-3 code voor uitgebreide dekking van talen, is een codelijst met als doel een drieletterige code voor alle bekende mensenlijke talen."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "ISO639"
