entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v2-0472"
  }
  resource {
    code_system {
      id {
        value: "v2-0472"
      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>TQ Conjunction ID</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>A<a name=\"A\"> </a></td><td>Asynchronous</td><td>Do the next specification in parallel with this one (unless otherwise constrained by the following fields: TQ1-7-start date/time and TQ1-8-end date/time).  The conjunction of &quot;A&quot; specifies two parallel instructions, as are sometimes used in medication, e.g., prednisone given at 1 tab on Monday, Wednesday, Friday, and at 1/2 tab on Tuesday, Thursday, Saturday, Sunday.</td><td>added v2.4</td></tr><tr><td>C<a name=\"C\"> </a></td><td>Actuation Time</td><td>It will be followed by a completion time for the service.  This code allows one to distinguish between the time and priority at which a service should be actuated (e.g., blood should be drawn) and the time and priority at which a service should be completed (e.g., results should be reported).</td><td>added v2.4</td></tr><tr><td>S<a name=\"S\"> </a></td><td>Synchronous</td><td>Do the next specification after this one (unless otherwise constrained by the following fields: TQ1-7-start date/time and TQ1-8-end date/time). An &quot;S&quot; specification implies that the second timing sequence follows the first, e.g., when a service request is written to measure blood pressure Q15 minutes for the 1st hour, then every 2 hours for the next day.</td><td>added v2.4</td></tr></table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v2-0472"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.18.300"
        }
      }
      version {
        value: "2.9"
      }
      name {
        value: "v2.0472"
      }
      title {
        value: "v2 TQ Conjunction ID"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "FHIR Value set/code system definition for HL7 v2 table 0472 ( TQ Conjunction ID)"
      }
      content {
        value: COMPLETE
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Do the next specification in parallel with this one (unless otherwise constrained by the following fields: TQ1-7-start date/time and TQ1-8-end date/time).  The conjunction of \"A\" specifies two parallel instructions, as are sometimes used in medication, e.g., prednisone given at 1 tab on Monday, Wednesday, Friday, and at 1/2 tab on Tuesday, Thursday, Saturday, Sunday."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Doe de volgende specificatie parallel aan deze (tenzij anders aangegeven ion de volgende velden: TQ1-7-start date/time en TQ1-8-end date/time). Een specificatie \"A\" specificeert twee parallelle instructies, zoals soms bij medicatiedosering gebruikt, bijv. prednison 1 tablet op maandag, woesndag, vrijdag en een half tablet op dinsdag, donderdag, zaterdag en zondag."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "A"
        }
        display {
          value: "Asynchronous"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Asynchroon"
          }
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "It will be followed by a completion time for the service.  This code allows one to distinguish between the time and priority at which a service should be actuated (e.g., blood should be drawn) and the time and priority at which a service should be completed (e.g., results should be reported)."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Deze wordt gevolgd door een voltooiingstijd voor de service. Met deze code kan het verschil worden gemaakt tussen tijd en prioriteit waarop de service moet worden geactueerd (bijv. bloed moet worden afgenomen) en de tijd en prioriteit waarop de service moet zijn voltooid (bijv. wanneer resultaten moeten worden gemeld)."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "C"
        }
        display {
          value: "Actuation Time"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Actuatietijd"
          }
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Do the next specification after this one (unless otherwise constrained by the following fields: TQ1-7-start date/time and TQ1-8-end date/time). An \"S\" specification implies that the second timing sequence follows the first, e.g., when a service request is written to measure blood pressure Q15 minutes for the 1st hour, then every 2 hours for the next day."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Doe de volgende specificatie na deze (tenzij anders aangegeven ion de volgende velden: TQ1-7-start date/time en TQ1-8-end date/time). Een specificatie \"S\" impliceert dat de tweede tijdsequentie de eerste opvolgt, bijv. als een serviceverzoek wordt gedaan om bloeddruk te meten Q15 minuten na het eerste uur en dan de volgende dag elke twee uur."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "S"
        }
        display {
          value: "Synchronous"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Synchroon"
          }
        }
      }
    }
  }
}
