        }
        code {
          value: "ICDO"
        }
        display {
          value: "International Classification of Diseases for Oncology"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Internationale Classificatie van Ziektes voor Oncologie"
          }
        }
        property {
          code {
            value: "status"
          }
