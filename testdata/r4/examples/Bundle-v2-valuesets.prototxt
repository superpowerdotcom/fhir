      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>What subject filter</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>ADV<a name=\"ADV\"> </a></td><td>Advice/diagnosis</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>ANU<a name=\"ANU\"> </a></td><td>Nursing unit lookup (returns patients in beds, excluding empty beds)</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>APA<a name=\"APA\"> </a></td><td>Account number query, return matching visit</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>APM<a name=\"APM\"> </a></td><td>Medical record number query, returns visits for a medical record number</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>APN<a name=\"APN\"> </a></td><td>Patient name lookup</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>APP<a name=\"APP\"> </a></td><td>Physician lookup</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>ARN<a name=\"ARN\"> </a></td><td>Nursing unit lookup (returns patients in beds, including empty beds)</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>CAN<a name=\"CAN\"> </a></td><td>Cancel.  Used to cancel a query</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>DEM<a name=\"DEM\"> </a></td><td>Demographics</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>FIN<a name=\"FIN\"> </a></td><td>Financial</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>GID<a name=\"GID\"> </a></td><td>Generate new identifier</td><td>deprecated</td><td>added v2.4, removed after v2.6</td></tr><tr><td>GOL<a name=\"GOL\"> </a></td><td>Goals</td><td>deprecated</td><td>added v2.3, removed after v2.6</td></tr><tr><td>MFQ<a name=\"MFQ\"> </a></td><td>Master file query</td><td>deprecated</td><td>added v2.2, removed after v2.2</td></tr><tr><td>MRI<a name=\"MRI\"> </a></td><td>Most recent inpatient</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>MRO<a name=\"MRO\"> </a></td><td>Most recent outpatient</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>NCK<a name=\"NCK\"> </a></td><td>Network clock</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>NSC<a name=\"NSC\"> </a></td><td>Network status change</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>NST<a name=\"NST\"> </a></td><td>Network statistic</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>ORD<a name=\"ORD\"> </a></td><td>Order</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>OTH<a name=\"OTH\"> </a></td><td>Other</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>PRB<a name=\"PRB\"> </a></td><td>Problems</td><td>deprecated</td><td>added v2.3, removed after v2.6</td></tr><tr><td>PRO<a name=\"PRO\"> </a></td><td>Procedure</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>RAR<a name=\"RAR\"> </a></td><td>Pharmacy administration information</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>RDR<a name=\"RDR\"> </a></td><td>Pharmacy dispense information</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>RER<a name=\"RER\"> </a></td><td>Pharmacy encoded order information</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>RES<a name=\"RES\"> </a></td><td>Result</td><td>deprecated</td><td>from v2.1, removed after v2.6</td></tr><tr><td>RGR<a name=\"RGR\"> </a></td><td>Pharmacy give information</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>ROR<a name=\"ROR\"> </a></td><td>Pharmacy prescription information</td><td>deprecated</td><td>added v2.2, removed after v2.6</td></tr><tr><td>SAL<a name=\"SAL\"> </a></td><td>All schedule related