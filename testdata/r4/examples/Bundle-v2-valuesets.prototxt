      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>CP Range Type</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>F<a name=\"F\"> </a></td><td>Flat-rate. Apply the entire price to this interval, do not pro-rate the price if the full interval has not occurred/been consumed</td><td/><td>added v2.3</td></tr><tr><td>P<a name=\"P\"> </a></td><td>Pro-rate. Apply this price to this interval, pro-rated by whatever portion of the interval has occurred/been consumed</td><td/><td>added v2.3</td></tr></table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v2-0298"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.18.184"
        }
      }
      version {
        value: "2.9"
      }
      name {
        value: "v2.0298"
      }
      title {
        value: "v2 CP Range Type"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "FHIR Value set/code system definition for HL7 v2 table 0298 ( CP Range Type)"
      }
      content {
        value: COMPLETE
      }
      concept {
        code {
          value: "F"
        }
        display {
          value: "Flat-rate. Apply the entire price to this interval, do not pro-rate the price if the full interval has not occurred/been consumed"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Vaste prijs. Pas de gehele prijs toe op dit interval, bereken niet naar rato in het geval dat niet het hele interval is opgetreden/is verbruikt"
          }
        }
      }
      concept {
        code {
          value: "P"
        }
        display {
          value: "Pro-rate. Apply this price to this interval, pro-rated by whatever portion of the interval has occurred/been consumed"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Pro rato. Pas deze prijs toe op dit interval, naar rato van het deel van het interval dat is opgetreden/is verbruikt"
          }
        }
      }
    }
  }
}
