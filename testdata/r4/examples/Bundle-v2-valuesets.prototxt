            }
            code {
              value: "display"
            }
          }
          value {
            value: "Functionele behandeling die kan bestaan uit een of meer gerelateerde metingen (bijv. glucosetolerantietest, creatinineklaring),  meestal uitgevoerd op verschillende momenten en/of verschillende monsters"
          }
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "can be associated with one or more OM4 (specimen) segments\r\nSee comment for value S"
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
