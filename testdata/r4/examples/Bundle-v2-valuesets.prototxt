entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v2-0076"
  }
  resource {
    value_set {
      id {
        value: "v2-0076"
      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Message Type</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>ACK<a name=\"ACK\"> </a></td><td>General acknowledgment message</td><td>2</td><td>from v2.1</td></tr><tr><td>ADR<a name=\"ADR\"> </a></td><td>ADT response</td><td>3 - Deprecated</td><td>added v2.2</td></tr><tr><td>ADT<a name=\"ADT\"> </a></td><td>ADT message</td><td>3</td><td>added v2.2</td></tr><tr><td>ARD<a name=\"ARD\"> </a></td><td>Ancillary RPT (display) (for backward compatibility only)</td><td>deprecated</td><td>from v2.1, removed after v2.3.1</td></tr><tr><td>BAR<a name=\"BAR\"> </a></td><td>Add/change billing account</td><td>6</td><td>from v2.1</td></tr><tr><td>BPS<a name=\"BPS\"> </a></td><td>Blood product dispense status message</td><td>4</td><td>added v2.5</td></tr><tr><td>BRP<a name=\"BRP\"> </a></td><td>Blood product dispense status acknowledgement message</td><td>4</td><td>added v2.5</td></tr><tr><td>BRT<a name=\"BRT\"> </a></td><td>Blood product transfusion/disposition acknowledgement message</td><td>4</td><td>added v2.5</td></tr><tr><td>BTS<a name=\"BTS\"> </a></td><td>Blood product transfusion/disposition message</td><td>4</td><td>added v2.5</td></tr><tr><td>CCF<a name=\"CCF\"> </a></td><td>Collaborative Care Fetch</td><td>7</td><td>added v2.7</td></tr><tr><td>CCI<a name=\"CCI\"> </a></td><td>Collaborative Care Information</td><td>7</td><td>added v2.7</td></tr><tr><td>CCM<a name=\"CCM\"> </a></td><td>Collaborative Care Message</td><td>7</td><td>added v2.7</td></tr><tr><td>CCQ<a name=\"CCQ\"> </a></td><td>Collaborative Care Referral</td><td>7</td><td>added v2.7</td></tr><tr><td>CCU<a name=\"CCU\"> </a></td><td>Collaborative Care Referral</td><td>7</td><td>added v2.7</td></tr><tr><td>CNQ<a name=\"CNQ\"> </a></td><td>Cancel query</td><td>deprecated</td><td>added v2.3, removed after v2.3</td></tr><tr><td>CQU<a name=\"CQU\"> </a></td><td>Co