          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "FHIR Value set/code system definition for HL7 v2 table 0480 ( Pharmacy Order Types)"
      }
      content {
        value: COMPLETE
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
