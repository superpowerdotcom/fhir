entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v2-0376"
  }
  resource {
    code_system {
      id {
        value: "v2-0376"
      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Special Handling Code</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>AMB<a name=\"AMB\"> </a></td><td>Ambient temperature</td><td>Keep at ambient (room) temperature, approximately 22 ( 2 degrees C. Accidental refrigeration or freezing is of little consequence</td><td>added v2.5</td></tr><tr><td>C37<a name=\"C37\"> </a></td><td>Body temperature</td><td>Critical to keep at body temperature: 36 - 38( C.</td><td>added v2.4</td></tr><tr><td>CAMB<a name=\"CAMB\"> </a></td><td>Critical ambient temperature</td><td>Critical ambient - must not be refrigerated or frozen.</td><td>added v2.4</td></tr><tr><td>CATM<a name=\"CATM\"> </a></td><td>Protect from air</td><td>Critical. Do not expose to atmosphere. Do not uncap.</td><td>added v2.4</td></tr><tr><td>CFRZ<a name=\"CFRZ\"> </a></td><td>Critical frozen temperature</td><td>Critical frozen - must not be allowed to thaw until immediately prior to testing</td><td>added v2.4</td></tr><tr><td>CREF<a name=\"CREF\"> </a></td><td>Critical refrigerated temperature</td><td>Critical refrigerated -  must not be allowed to freeze or warm until immediately prior to testing</td><td>added v2.4</td></tr><tr><td>DFRZ<a name=\"DFRZ\"> </a></td><td>Deep frozen</td><td>Deep frozen: -16 to -20( C.</td><td>added v2.5</td></tr><tr><td>DRY<a name=\"DRY\"> </a></td><td>Dry</td><td>Keep in a dry environment.</td><td>added v2.5</td></tr><tr><td>FRZ<a name=\"FRZ\"> </a></td><td>Frozen temperature</td><td>Keep at frozen temperature: -4( C. Accidental thawing is of little consequence</td><td>added v2.5</td></tr><tr><td>MTLF<a name=\"MTLF\"> </a></td><td>Metal Free</td><td>Container is free of heavy metals including lead.</td><td>added v2.5</td></tr><tr><td>NTR<a name=\"NTR\"> </a></td><td>Liquid nitrogen</td><td>Keep in liquid nitrogen.</td><td>added v2.5</td></tr><tr><td>PRTL<a name=\"PRTL\"> </a></td><td>Protect from light</td><td>Protect from light (e.g., wrap in aluminum foil).</td><td>added v2.4</td></tr><tr><td>PSA<a name=\"PSA\"> </a></td><td>Do not shake</td><td>Do not shake.</td><td>added v2.5</td></tr><tr><td>PSO<a name=\"PSO\"> </a></td><td>No shock</td><td>Protect from shock.</td><td>added v2.5</td></tr><tr><td>REF<a name=\"REF\"> </a></td><td>Refrigerated temperature</td><td>Keep at refrigerated temperature: 4-8( C. Accidental warming or freezing is of little consequence</td><td>added v2.5</td></tr><tr><td>UFRZ<a name=\"UFRZ\"> </a></td><td>Ultra frozen</td><td>Ultra cold frozen: ~ -75 to -85( C. (ultra cold freezer is typically at temperature of dry ice).</td><td>added v2.5</td></tr><tr><td>UPR<a name=\"UPR\"> </a></td><td>Upright</td><td>Keep upright. Do not turn upside down.</td><td>added v2.5</td></tr></table>\r\n</div>"
        }
      }
