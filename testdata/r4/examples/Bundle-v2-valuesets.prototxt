            }
            code {
              value: "display"
            }
          }
          value {
            value: "Dauernder Wohnsitz"
          }
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Permanent"
          }
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Refers to the information system, typically managed by a public health agency that stores patient information such as immunization histories or cancer data, regardless of where the patient obtains services"
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Verwijst naar het informatiesysteem, meestal beheerd door een volksgezondheiddienst, die pati\303\253ntinformatie bijhoudt zoals vaccinatiegegevens of kankergegevens, ongeacht waar de pati\303\253nt zijn services betrekt."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "RH"
