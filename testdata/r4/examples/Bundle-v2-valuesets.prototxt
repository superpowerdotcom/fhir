        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Vaccines Administered</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>01<a name=\"01\"> </a></td><td>DTP</td><td>diphtheria, tetanus toxoids and pertussis vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>02<a name=\"02\"> </a></td><td>OPV</td><td>poliovirus vaccine, live, oral</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>03<a name=\"03\"> </a></td><td>MMR</td><td>measles, mumps and rubella virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>04<a name=\"04\"> </a></td><td>M/R</td><td>measles and rubella virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>05<a name=\"05\"> </a></td><td>measles</td><td>measles virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>06<a name=\"06\"> </a></td><td>rubella</td><td>rubella virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>07<a name=\"07\"> </a></td><td>mumps</td><td>mumps virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>08<a name=\"08\"> </a></td><td>Hep B, adolescent or pediatric</td><td>hepatitis B vaccine, pediatric or pediatric/adolescent dosage</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>09<a name=\"09\"> </a></td><td>Td (adult)</td><td>tetanus and diphtheria toxoids, adsorbed for adult use</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>10<a name=\"10\"> </a></td><td>IPV</td><td>poliovirus vaccine, inactivated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>100<a name=\"100\"> </a></td><td>pneumococcal conjugate</td><td>pneumococcal conjugate vaccine, polyvalent</td><td>added v2.4, removed after v2.8.2</td></tr><tr><td>101<a name=\"101\"> </a></td><td>typhoid, ViCPs</td><td>typhoid Vi capsular polysaccharide vaccine</td><td>added v2.4, removed after v2.8.2</td></tr><tr><td>102<a name=\"102\"> </a></td><td>DTP-Hib-Hep B</td><td>DTP- Haemophilus influenzae type b conjugate and hepatitis b vaccine</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>103<a name=\"103\"> </a></td><td>meningococcal C conjugate</td><td>meningococcal C conjugate vaccine</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>104<a name=\"104\"> </a></td><td>Hep A-Hep B</td><td>hepatitis A and hepatitis B vaccine</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>105<a name=\"105\"> </a></td><td>vaccinia (smallpox) diluted</td><td>vaccinia (smallpox) vaccine, diluted</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>106<a name=\"106\"> </a></td><td>DTaP, 5 pertussis antigens6</td><td>diphtheria, tetanus toxoids and acellular pertussis vaccine, 5 pertussis antigens</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>107<a name=\"107\"> </a></td><td>DTaP, NOS</td><td>diphtheria, tetanus toxoids and acellular pertussis vaccine, NOS</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>108<a name=\"108\"> </a></td><td>meningococcal, NOS</td><td>meningococcal vaccine, NOS</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>109<a name=\"109\"> </a></td><td>pneumococcal, NOS</td><td>pneumococcal vaccine, NOS</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>11<a name=\"11\"> </a></td><td>pertussis</td><td>pertussis vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>110<a name=\"110\"> </a></td><td>DTaP-Hep B-IPV</td><td>DTaP-hepatitis B and poliovirus vaccine</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>111<a name=\"111\"> </a></td><td>influenza, live, intranasal</td><td>influenza virus vaccine, live, attenuated, for intranasal use</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>112<a name=\"112\"> </a></td><td>tetanus toxoid, NOS</td><td>tetanus toxoid, NOS</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>113<a name=\"113\"> </a></td><td>Td (adult)</td><td>tetanus and diphtheria toxoids, adsorbed, preservative free, for adult use</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>114<a name=\"114\"> </a></td><td>meningococcal A,C,Y,W-135 diphtheria conjugate</td><td>meningococcal polysaccharide (groups A, C, Y and W-135) diphtheria toxoid conjugate vaccine (MCV4)</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>115<a name=\"115\"> </a></td><td>Tdap</td><td>tetanus toxoid, reduced diphtheria toxoid, and acellular pertussis vaccine, adsorbed</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>116<a name=\"116\"> </a></td><td>rotavirus, pentavalent</td><td>rotavirus, live, pentavalent vaccine</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>117<a name=\"117\"> </a></td><td>VZIG (IND)</td><td>varicella zoster immune globulin (Investigational New Drug)</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>118<a name=\"118\"> </a></td><td>HPV, bivalent</td><td>human papilloma virus vaccine, bivalent</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>119<a name=\"119\"> </a></td><td>rotavirus, monovalent</td><td>rotavirus, live, monovalent vaccine</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>12<a name=\"12\"> </a></td><td>diphtheria antitoxin</td><td>diphtheria antitoxin</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>120<a name=\"120\"> </a></td><td>DTaP-Hib-IPV</td><td>diphtheria, tetanus toxoids and acellular pertussis vaccine, Haemophilus influenzae type b conjugate, and poliovirus vaccine, inactivated (DTaP-Hib-IPV)</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>121<a name=\"121\"> </a></td><td>zoster</td><td>zoster vaccine, live</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>122<a name=\"122\"> </a></td><td>rotavirus, NOS1</td><td>rotavirus vaccine, NOS</td><td>added v2.6, removed after v2.8.2</td></tr><tr><td>13<a name=\"13\"> </a></td><td>TIG</td><td>tetanus immune globulin</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>14<a name=\"14\"> </a></td><td>IG, NOS</td><td>