      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Refers to an address specific to an organization, such as an insurance company or employer, versus an individual\342\200\231s work location or place of employment. It would be specific to a firm or organization that has some sort of business relationship with the subject"
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
