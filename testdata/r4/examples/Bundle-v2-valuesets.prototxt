          value {
            string_value {
              value: "The result or observation value is outside a reference range or expected norm at a level at which immediate action should be considered for patient safety (as defined for the respective test procedure).\r\n[Note: Typically applies to non-numeric results.  Analogous to critical/panic limits for numeric results.]"
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
