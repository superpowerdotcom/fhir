          }
          value {
            string_value {
              value: "Refers to the location in which service is rendered. This would be used if reimbursement is based on the location of the service (to take into account the cost of those services)."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
