        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Date Format</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>1<a name=\"1\"> </a></td><td>mm/dd/yy</td><td>USA standard</td><td>added v2.6</td></tr><tr><td>2<a name=\"2\"> </a></td><td>yy.mm.dd</td><td>ANSI standard</td><td>added v2.6</td></tr><tr><td>3<a name=\"3\"> </a></td><td>dd/mm/yy</td><td>Britain/France standard</td><td>added v2.6</td></tr><tr><td>4<a name=\"4\"> </a></td><td>dd.mm.yy</td><td>Germany standard</td><td>added v2.6</td></tr><tr><td>5<a name=\"5\"> </a></td><td>yy/mm/dd</td><td>Japan standard</td><td>added v2.6</td></tr><tr><td>6<a name=\"6\"> </a></td><td>Yymmdd</td><td>ISO standard</td><td>added v2.6</td></tr></table>\r\n</div>"
