        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Time Delay Post Challenge</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>10D<a name=\"10D\"> </a></td><td>10 days</td><td/><td>added v2.3</td></tr><tr><td>10M<a name=\"10M\"> </a></td><td>10 minutes post challenge</td><td/><td>added v2.3</td></tr><tr><td>12H<a name=\"12H\"> </a></td><td>12 hours post challenge</td><td/><td>added v2.3</td></tr><tr><td>15M<a name=\"15M\"> </a></td><td>15 minutes post challenge</td><td/><td>added v2.3</td></tr><tr><td>1H<a name=\"1H\"> </a></td><td>1 hour post challenge</td><td/><td>added v2.3</td></tr><tr><td>1L<a name=\"1L\"> </a></td><td>1 month (30 days) post challenge</td><td/><td>added v2.3</td></tr><tr><td>1M<a name=\"1M\"> </a></td><td>1 minute post challenge</td><td/><td>added v2.3</td></tr><tr><td>1W<a name=\"1W\"> </a></td><td>1 week</td><td/><td>added v2.3</td></tr><tr><td>2.5H<a name=\"2.465H\"> </a></td><td>2 1/2 hours post challenge</td><td/><td>added v2.3</td></tr><tr><td>20M<a name=\"20M\"> </a></td><td>20 minutes post challenge</td><td/><td>added v2.3</td></tr><tr><td>24H<a name=\"24H\"> </a></td><td>24 hours post challenge</td><td/><td>added v2.3</td></tr><tr><td>25M<a name=\"25M\"> </a></td><td>25 minutes post challenge</td><td/><td>added v2.3</td></tr><tr><td>2D<a name=\"2D\"> </a></td><td>2 days</td><td/><td>added v2.3</td></tr><tr><td>2H<a name=\"2H\"> </a></td><td>2 hours post challenge</td><td/><td>added v2.3</td></tr><tr><td>2L<a name=\"2L\"> </a></td><td>2 months (60 days) post challenge</td><td/><td>added v2.3</td></tr><tr><td>2M<a name=\"2M\"> </a></td><td>2 minutes post challenge</td><td/><td>added v2.3</td></tr><tr><td>2W<a name=\"2W\"> </a></td><td>2 weeks</td><td/><td>added v2.3</td></tr><tr><td>30M<a name=\"30M\"> </a></td><td>30 minutes post challenge</td><td/><td>added v2.3</td></tr><tr><td>3D<a name=\"3D\"> </a></td><td>3 days</td><td/><td>added