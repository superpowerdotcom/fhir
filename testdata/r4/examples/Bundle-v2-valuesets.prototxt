      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Packaging Status Code</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>0<a name=\"0\"> </a></td><td>Not packaged</td><td/><td>added v2.4</td></tr><tr><td>1<a name=\"1\"> </a></td><td>Packaged service (status indicator N, or no HCPCS code and certain revenue codes)</td><td/><td>added v2.4</td></tr><tr><td>2<a name=\"2\"> </a></td><td>Packaged as part of partial hospitalization per diem or daily mental health service per diem</td><td/><td>added v2.4</td></tr></table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
