      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Placer Applications.\r\nPR indicates that this ORC is part of an ORU structure containing previous observation, which is embedded in the order.\r\n\r\nAt least two main use cases require that the complete results of the previous observations be transmitted with the order. \r\n\r\n\342\200\242\tDiagnostic laboratories referring tests to another lab for either confirmation of results (HIV, etc.) or due to not being equipped to do the tests (genetic testing, etc.). \r\n\r\n\342\200\242\tDiagnostic laboratories sending test results to Knowledge Bases for the automated generation of diagnostic comments for inclusion into the lab report."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Placer applicaties. PR geeft aan dat deze ORC deel is van een ORU "
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "PR"
        }
        display {
          value: "Previous Results with new order/service"
