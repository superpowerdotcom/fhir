          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Intended Procedure Type</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>2RC<a name=\"2RC\"> </a></td><td>Double Red Cells</td><td/><td>added v2.8</td></tr><tr><td>GRN<a name=\"GRN\"> </a></td><td>Granulocytes</td><td/><td>added v2.8</td></tr><tr><td>HEM<a name=\"HEM\"> </a></td><td>Hemachromatosis</td><td/><td>added v2.8</td></tr><tr><td>HPC<a name=\"HPC\"> </a></td><td>Hematopoietic Progenitor Cells</td><td>Stem Cells and other cells classified as Hematopoietic</td><td>added v2.8</td></tr><tr><td>LYM<a name=\"LYM\"> </a></td><td>Lymphocytes</td><td/><td>added v2.8</td></tr><tr><td>PLS<a name=\"PLS\"> </a></td><td>Plasma</td><td/><td>added v2.8</td></tr><tr><td>PLT<a name=\"PLT\"> </a></td><td>Platelets</td><td/><td>added v2.8</td></tr><tr><td>PNP<a name=\"PNP\"> </a></td><td>Platelets and Plasma</td><td/><td>added v2.8</td></tr><tr><td>PNR<a name=\"PNR\"> </a></td><td>Platelets and Red Cells</td><td/><td>added v2.8</td></tr><tr><td>PPR<a name=\"PPR\"> </a></td><td>Platelets, Plasma, and Red Cells</td><td/><td>added v2.8</td></tr><tr><td>THA<a name=\"THA\"> </a></td><td>Therapeutic Apheresis</td><td/><td>added v2.8</td></tr><tr><td>THW<a name=\"THW\"> </a></td><td>Therapeutic Whole Blood</td><td/><td>added v2.8</td></tr><tr><td>WBL<a name=\"WBL\"> </a></td><td>Whole Blood</td><td/><td>added v2.8</td></tr></table>\r\n</div>"
