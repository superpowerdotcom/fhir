        }
      }
      version {
        value: "2.9"
      }
      name {
        value: "v2.0480"
      }
      title {
        value: "v2 Pharmacy Order Types"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
