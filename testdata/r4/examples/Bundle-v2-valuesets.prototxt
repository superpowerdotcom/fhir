entry {
  full_url {
    value: "http://hl7.org/fhir/ValueSet/v2-0397"
  }
  resource {
    value_set {
      id {
        value: "v2-0397"
      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
