          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Diagnostic Service Section ID</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>AU<a name=\"AU\"> </a></td><td>Audiology</td><td/><td>added v2.2</td></tr><tr><td>BG<a name=\"BG\"> </a></td><td>Blood Gases</td><td/><td>from v2.1</td></tr><tr><td>BLB<a name=\"BLB\"> </a></td><td>Blood Bank</td><td/><td>added v2.2</td></tr><tr><td>CG<a name=\"CG\"> </a></td><td>Cytogenetics</td><td/><td>added v2.8.2</td></tr><tr><td>CH<a name=\"CH\"> </a></td><td>Chemistry</td><td/><td>from v2.1</td></tr><tr><td>CP<a name=\"CP\"> </a></td><td>Cytopathology</td><td/><td>from v2.1</td></tr><tr><td>CT<a name=\"CT\"> </a></td><td>CAT Scan</td><td/><td>from v2.1</td></tr><tr><td>CTH<a name=\"CTH\"> </a></td><td>Cardiac Catheterization</td><td/><td>added v2.2</td></tr><tr><td>CUS<a name=\"CUS\"> </a></td><td>Cardiac Ultrasound</td><td/><td>from v2.1</td></tr><tr><td>EC<a name=\"EC\"> </a></td><td>Electrocardiac (e.g., EKG,  EEC, Holter)</td><td/><td>from v2.1</td></tr><tr><td>EN<a name=\"EN\"> </a></td><td>Electroneuro (EEG, EMG,EP,PSG)</td><td/><td>added v2.2</td></tr><tr><td>GE<a name=\"GE\"> </a></td><td>Genetics</td><td/><td>added v2.8.2</td></tr><tr><td>HM<a name=\"HM\"> </a></td><td>Hematology</td><td/><td>from v2.1</td></tr><tr><td>ICU<a name=\"ICU\"> </a></td><td>Bedside ICU Monitoring</td><td/><td>added v2.3</td></tr><tr><td>IMG<a name=\"IMG\"> </a></td><td>Diagnostic Imaging</td><td>deprecated</td><td>added v2.4, removed after v2.4</td></tr><tr><td>IMM<a name=\"IMM\"> </a></td><td>Immunology</td><td/><td>from v2.1</td></tr><tr><td>LAB<a name=\"LAB\"> </a></td><td>Laboratory</td><td/><td>added v2.3</td></tr><tr><td>MB<a name=\"MB\"> </a></td><td>Microbiology</td><td/><td>from v2.1</td></tr><tr><td>MCB<a name=\"MCB\"> </a></td><td>Mycobacteriology</td><td/><td>from v2.1</td></tr><tr><td>MYC<a name=\"MYC\"> </a></td><td>Mycology</td>