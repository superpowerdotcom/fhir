      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "NCPDP maintain code list associated with the specified Data Element (nnnn) and Segment (sss).  The Segment portion is optional if there is no specialization of the Data Element codes between segments.\r\nExamples:\r\n   NCPDP1131RES = code set defined for NCPDP data element 1131 as used in the RES segment (Code List Qualifier \342\200\223 Response Code)\r\n   NCPDP1131STS = code set defined for NCPDP data element 1131 as used in the STS segment (Code List Qualifier \342\200\223 Reject Code)\r\n   NCPDP9701 = code set defined for NCPDP data element 9701 (Individual Relationship, Coded).  No specialization to a segment exists for this data element.\r\n\r\nNational Council for Prescription Drug Programs, 924\303\230 ast Raintree Drive, Scottsdale, AZ  8526\303\230.\r\n\r\nPhone: (48\303\230) 477-1\303\230\303\230\303\230\r\nFax: (48\303\230) 767-1\303\23042\r\ne-mail: ncpdp@ncpdp.org\r\nwww.ncpdp.org"
            }
          }
        }
        code {
          value: "NCPDPnnnnsss"
        }
        display {
          value: "NCPDP code list for data element nnnn [as used in segment sss]"
        }
