                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Klasse: financieel. Een preciesere definitie van een accountnummer: soms moeten 2 verschillende accountnummers moeten worden doorgegeven in hetzelfde bericht, een als crediteur, de andere als debiteur. Crediteuraccountnummer."
                    }
                  }
                }
              }
            }
          }
        }
