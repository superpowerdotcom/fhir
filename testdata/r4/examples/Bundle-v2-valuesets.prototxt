        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablevalueset"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Vaccines Administered</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>01<a name=\"01\"> </a></td><td>DTP</td><td>diphtheria, tetanus toxoids and pertussis vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>02<a name=\"02\"> </a></td><td>OPV</td><td>poliovirus vaccine, live, oral</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>03<a name=\"03\"> </a></td><td>MMR</td><td>measles, mumps and rubella virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>04<a name=\"04\"> </a></td><td>M/R</td><td>measles and rubella virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>05<a name=\"05\"> </a></td><td>measles</td><td>measles virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>06<a name=\"06\"> </a></td><td>rubella</td><td>rubella virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>07<a name=\"07\"> </a></td><td>mumps</td><td>mumps virus vaccine</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>08<a name=\"08\"> </a></td><td>Hep B, adolescent or pediatric</td><td>hepatitis B vaccine, pediatric or pediatric/adolescent dosage</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>09<a name=\"09\"> </a></td><td>Td (adult)</td><td>tetanus and diphtheria toxoids, adsorbed for adult use</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>10<a name=\"10\"> </a></td><td>IPV</td><td>poliovirus vaccine, inactivated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>100<a name=\"100\"> </a></td><td>pneumococcal conjugate</td><td>pneumococcal conjugate vaccine, polyvalent</td><td>added v2.4, removed after v2.8.2</td></tr><tr><td>101<a name=\"101\"> </a></td><td>typhoid, ViCPs</td><td>typhoid Vi capsular polysaccharide vaccine</td><td>added v2.4, removed after v2.8.2</td></tr><tr><td>102<a name=\"102\"> </a></td>