                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Merk op dat de escape-tekens in deze modus het ASCII-teken \"esc\", zoals gedefinieerd in ISO 2022-1994 niet gebruiken. Het zijn \"HL7 escape-tekens\" zoals voor het eerst gedefinieerd in HL7 2.3, sectie 2.9.2 (Merk ook op dat secties 2.8.28.6.1 en 2.9.2 in HL7 2.3 overeenkomen met"
                    }
                  }
                }
              }
            }
          }
        }
