          value {
            string_value {
              value: "Includes drugs having currently accepted medical use in the United States and a high abuse potential, with severe psychological or physical dependence liability."
            }
          }
        }
        code {
          value: "II"
        }
        display {
          value: "Schedule II"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Includes drugs having an abuse potential less than that of drugs listed in Schedules I and II. All CS III drugs have a currently accepted medical use in the United States."
            }
          }
        }
        code {
          value: "III"
        }
        display {
          value: "Schedule III"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Includes drugs having a lesser potential for abuse than those listed in Schedule III. CS IV drugs have a currently accepted medical use in the United States."
            }
          }
        }
        code {
          value: "IV"
        }
        display {
          value: "Schedule IV"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Includes drugs having low abuse potential and limited physical or psychological dependence relative to those listed in IV and have an accepted medical use in the United States."
            }
          }
        }
        code {
          value: "V"
        }
        display {
          value: "Schedule V"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "State defined"
            }
          }
        }
        code {
          value: "VI"
        }
        display {
          value: "Schedule VI"
        }
      }
    }
  }
}
