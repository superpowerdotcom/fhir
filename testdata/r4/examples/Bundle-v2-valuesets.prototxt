          }
          value {
            string_value {
              value: "International Standards Organization standard 3166 contains 3 parts.  Part 1 contains three tables for codes for countries of the world.  These are 2-character alphabetic, 3-character alphabetic, and numeric codes."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "International Standards Organization standaard 3166 bevat 3 delen. Deel 1 bevat drie tabellen met codes voor landen in de wereld. Deze zijn 2-tekens alfabetisch, 3-tekens alfabetisch en numeriekw codes."
                    }
                  }
                }
              }
            }
          }
        }
        code {
