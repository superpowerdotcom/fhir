                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Placer of filer applicaties. Een verzoek van de placer aan de filler, of van de filler aan de placer, om een eerder aangevraagde service af te breken. Het verschil tussen afbreken en annuleren is dat afbreken de aanvraag/service betreft en alle "
                    }
                  }
                }
              }
            }
          }
        }
