      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "An identifier for a living subject whose real identity is protected or suppressed\r\nJustification: For public health reporting purposes, anonymous identifiers are occasionally used for protecting patient identity in reporting certain results. For instance, a state health department may choose to use a scheme for generating an anonymous identifier for reporting a patient that has had a positive human immunodeficiency virus antibody test. Anonymous identifiers can be used in PID 3 by replacing the medical record number or other non-anonymous identifier. The assigning authority for an anonymous identifier would be the state/local health department."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Verklaring: t.b.v. volksgezondheid-doeleinden worden anonieme identificaties soms gebruikt voor bescherming van de identiteit van de pati\303\253nt bij melden van bepaalde resultaten. Zo kan een gezondheidsafdeling van een overheid voor een algoritme voor het genereren van nummers kiezen bij pati\303\253nten met een positieve HIV-antilichamentest. Anonieme identificaties kunnen worden gebruikt in PID-3 door het medisch dossiernummer of ander niet-anonieme identificatie te vervangen. De toekennende autoriteit voor de anonieme identificatie is dan de betreffende overheidsafdeling."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "ANON"
        }
        display {
          value: "Anonymous identifier"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Anonieme identificatie"
          }
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Class: Financial\r\nTemporary version of an Account Number.\r\nUse Case: An ancillary system that does not normally assign account numbers is the first time to register a patient. This ancillary system will generate a temporary account number that will only be used until an official account number is assigned."
              extension {
                url {
                  value: "http://hl7.org/fhir/StructureDefinition/translation"
                }
                extension {
                  url {
                    value: "lang"
                  }
                  value {
                    code {
                      value: "nl"
                    }
                  }
                }
                extension {
                  url {
                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Klasse: financieel. Tijdelijke versie van een accountnummer. Use case: een satellietsysteem dat normaal geen accountnummers toekent, is de eerste plaats waar een pati\303\253nt wordt geregistreerd. Dit satellietsysteem zal een tijdelijk accountnummer genereren dat wordt gebruikt totdat een officieel accountnummer wordt toegekend."
                    }
                  }
                }
              }
            }
          }
        }
        code {
          value: "ANT"
        }
        display {
          value: "Temporary Account Number"
        }
        designation {
          language {
            value: "nl"
          }
          use {
            system {
              value: "http://terminology.hl7.org/CodeSystem/designation-usage"
            }
            code {
              value: "display"
            }
          }
          value {
            value: "Tijdelijk accountnummer"
          }
        }
      }
