        value: "v2.0211"
      }
      title {
        value: "v2 Alternate Character Sets"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "FHIR Value set/code system definition for HL7 v2 table 0211 ( Alternate Character Sets)"
      }
      immutable {
