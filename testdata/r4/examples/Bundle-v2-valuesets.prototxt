  }
  resource {
    code_system {
      id {
        value: "v2-0335"
      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Repeat Pattern</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>A<a name=\"A\"> </a></td><td>Ante (before)</td><td/><td>added v2.4</td></tr><tr><td>BID<a name=\"BID\"> </a></td><td>twice a day at institution-specified times</td><td>(e.g., 9AM-4PM)</td><td>added v2.4</td></tr><tr><td>C<a name=\"C\"> </a></td><td>service is provided continuously between start time and stop time</td><td/><td>added v2.4</td></tr><tr><td>D<a name=\"D\"> </a></td><td>Cibus Diurnus (lunch)</td><td/><td>added v2.4</td></tr><tr><td>I<a name=\"I\"> </a></td><td>Inter</td><td>(e.g., between this meal and the next, between dinner and sleep</td><td>added v2.4</td></tr><tr><td>M<a name=\"M\"> </a></td><td>Cibus Matutinus (breakfast)</td><td/><td>added v2.4</td></tr><tr><td>Meal Related Timings<a name=\"MealRelatedTimings\"> </a></td><td>&lt;timing&gt;C (&quot;cum&quot;)&lt;meal&gt;</td><td/><td>added v2.4</td></tr><tr><td>Once<a name=\"Once\"> </a></td><td>one time only.</td><td>This is also the default when this component is null.</td><td>added v2.4</td></tr><tr><td>P<a name=\"P\"> </a></td><td>Post (after)</td><td/><td>added v2.4</td></tr><tr><td>PRN<a name=\"PRN\"> </a></td><td>given as needed</td><td/><td>added v2.4</td></tr><tr><td>PRNxxx<a name=\"PRNxxx\"> </a></td><td>where xxx is some frequency code</td><td>(e.g., PRNQ6H); given as needed over the frequency period.</td><td>added v2.4</td></tr><tr><td>Q&lt;integer&gt;D<a name=\"Q.60integer.62D\"> </a></td><td>every &lt;integer&gt; days</td><td/><td>added v2.4</td></tr><tr><td>Q&lt;integer&gt;H<a name=\"Q.60integer.62H\"> </a></td><td>every &lt;integer&gt; hours</td><td/><td>added v2.4</td></tr><tr><td>Q&lt;integer&gt;J&lt;day#&gt;<a name=\"Q.60integer.62J.60day.35.62\"> </a></td><td>repeats on a particular day of the week,</td><td>From the French jour (day). If &lt;integer&gt; is missing, the repeat rate is assumed to be 1. Day numbers are counted from 1=Monday to 7=Sunday. So Q2J2 means every second Tuesday; Q1J6 means every Saturday.</td><td>added v2.4</td></tr><tr><td>Q&lt;integer&gt;L<a name=\"Q.60integer.62L\"> </a></td><td>every &lt;integer&gt; months (Lunar cycle)</td><td/><td>added v2.4</td></tr><tr><td>Q&lt;integer&gt;M<a name=\"Q.60integer.62M\"> </a></td><td>every &lt;integer&gt; minutes</td><td/><td>added v2.4</td></tr><tr><td>Q&lt;integer&gt;S<a name=\"Q.60integer.62S\"> </a></td><td>every &lt;integer&gt; seconds</td><td/><td>added v2.4</td></tr><tr><td>Q&lt;integer&gt;W<a name=\"Q.60integer.62W\"> </a></td><td>every &lt;integer&gt; weeks</td><td/><td>added v2.4</td></tr><tr><td>QAM<a name=\"QAM\"> </a></td><td>in the morning at institution-specified time</td><td/><td>added v2.4</td></tr><tr><td>QHS<a name=\"QHS\"> </a></td><td>every day before the hour of sleep</td><td/><td>added v2.4</td></tr><tr><td>QID<a name=\"QID\"> </a></td><td>four times a day at institution-specified times</td><td>(e.g., 9AM-11AM-4PM-9PM)</td><td>added v2.4</td></tr><tr><td>QOD<a name=\"QOD\"> </a></td><td>every other day</td><td>(same as Q2D)</td><td>added v2.4</td></tr><tr><td>QPM<a name=\"QPM\"> </a></td><td>in the evening at institution-specified time</td><td/><td>added v2.4</td></tr><tr><td>QSHIFT<a name=\"QSHIFT\"> </a></td><td>during each of three eight-hour shifts at institution-specified times</td><td/><td>added v2.4</td></tr><tr><td>TID<a name=\"TID\"> </a></td><td>three times a day at institution-specified times</td><td>(e.g., 9AM-4PM-9PM)</td><td>added v2.4</td></tr><tr><td>U &lt;spec&gt;<a name=\"U.60spec.62\"> </a></td><td>for future use, where &lt;spec&gt; is an interval specification as defined by the UNIX cron specification.</td><td/><td>added v2.4</td></tr><tr><td>V<a name=\"V\"> </a></td><td>Cibus Vespertinus (dinner)</td><td/><td>added v2.4</td></tr><tr><td>xID<a name=\"xID\"> </a></td><td>&quot;X&quot; times per day at institution-specified times, where X is a numeral 5 or greater.</td><td>(e.g., 5ID=five times per day; 8ID=8 times per day)</td><td>added v2.4</td></tr></table>\r\n</div>"
        }
