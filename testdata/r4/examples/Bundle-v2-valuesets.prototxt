          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Processing Priority</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>A<a name=\"A\"> </a></td><td>As soon as possible (a priority lower than stat)</td><td/><td>added v2.2</td></tr><tr><td>B<a name=\"B\"> </a></td><td>Do at bedside or portable (may be used with other codes)</td><td/><td>added v2.2</td></tr><tr><td>C<a name=\"C\"> </a></td><td>Measure continuously (e.g., arterial line blood pressure)</td><td/><td>added v2.2</td></tr><tr><td>P<a name=\"P\"> </a></td><td>Preoperative (to be done prior to surgery)</td><td/><td>added v2.2</td></tr><tr><td>R<a name=\"R\"> </a></td><td>Routine</td><td/><td>added v2.2</td></tr><tr><td>S<a name=\"S\"> </a></td><td>Stat (do immediately)</td><td/><td>added v2.2</td></tr><tr><td>T<a name=\"T\"> </a></td><td>Timing critical (do as near as possible to requested time)</td><td/><td>added v2.2</td></tr></table>\r\n</div>"
