entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v2-0440"
  }
  resource {
    code_system {
      id {
        value: "v2-0440"
      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Data Types</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>AD<a name=\"AD\"> </a></td><td>Address</td><td>Replaced by XAD as of v 2.3</td><td>added v2.4</td></tr><tr><td>AUI<a name=\"AUI\"> </a></td><td>Authorization information</td><td>Replaces the CM data type used in sections 6.5.6.14 IN1-14, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>CCD<a name=\"CCD\"> </a></td><td>Charge code and date</td><td>Replaces the CM data type used in section 4.5.2.1 BLG-1, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>CCP<a name=\"CCP\"> </a></td><td>Channel calibration parameters</td><td>Replaces the CM data type used in 7.14.1.5 OBX-5.3 where OBX-5Observation value (*) is data type CD as of v 2.5.</td><td>added v2.5</td></tr><tr><td>CD<a name=\"CD\"> </a></td><td>Channel definition</td><td>For waveform data only;.</td><td>added v2.4</td></tr><tr><td>CE<a name=\"CE\"> </a></td><td>Coded element</td><td>WITHDRAWN</td><td>added v2.4</td></tr><tr><td>CF<a name=\"CF\"> </a></td><td>Coded element with formatted values</td><td>65536</td><td>added v2.4</td></tr><tr><td>CK<a name=\"CK\"> </a></td><td>Composite ID with check digit</td><td>WITHDRAWN</td><td>added v2.4</td></tr><tr><td>CM<a name=\"CM\"> </a></td><td>Composite</td><td>WITHDRAWN Replaced by numerous new unambiguous data types in v 2.5</td><td>added v2.4</td></tr><tr><td>CN<a name=\"CN\"> </a></td><td>Composite ID number and name</td><td>WITHDRAWN. Replaced by XCN as of v 2.3</td><td>added v2.4</td></tr><tr><td>CNE<a name=\"CNE\"> </a></td><td>Coded with no exceptions</td><td>705</td><td>added v2.4</td></tr><tr><td>CNN<a name=\"CNN\"> </a></td><td>Composite ID number and name simplified</td><td>Restores the original data type CN as was initially implementable in the CM used in sections 4.5.3.32 and 7.4.1.32-(OBR-32), 4.5.3.33 and 7.4.1.33 - (OBR-33) 4.5.3.34 and 7.4.1.34 - (OBR-34) 4.5.3.35 and 7.4.1.35 - (OBR-35). Components 7 and 8, however, have been promoted to data type IS to be consistent with current practice without violating backward compatibility.</td><td>added v2.7</td></tr><tr><td>CNS<a name=\"CNS\"> </a></td><td>Composite ID number and name simplified</td><td>deprecated</td><td>added v2.5, removed after v2.6</td></tr><tr><td>CP<a name=\"CP\"> </a></td><td>Composite price</td><td>.</td><td>added v2.4</td></tr><tr><td>CQ<a name=\"CQ\"> </a></td><td>Composite quantity with units</td><td>CQ cannot be legally expressed when embedded within another data type. Its use is constrained to a segment field.</td><td>added v2.4</td></tr><tr><td>CSU<a name=\"CSU\"> </a></td><td>Channel sensitivity and units</td><td>Replaces the CM data type used in 7.14.1.5 OBX-5.3 where OBX-5Observation value (*) is data type CD as of v 2.5.</td><td>added v2.5</td></tr><tr><td>CWE<a name=\"CWE\"> </a></td><td>Coded with exceptions</td><td>705</td><td>added v2.4</td></tr><tr><td>CX<a name=\"CX\"> </a></td><td>Extended composite ID with check digit</td><td>1913</td><td>added v2.4</td></tr><tr><td>DDI<a name=\"DDI\"> </a></td><td>Daily deductible information</td><td>Replaces the CM data type used in section 6.5.7.30  IN2-30, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>DIN<a name=\"DIN\"> </a></td><td>Date and institution name</td><td>Replaces the CM data type used in sections 15.4.6.12 STF-12 and 15.4.6.14 STF-13, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>DLD<a name=\"DLD\"> </a></td><td>Discharge to location and date</td><td>Replaces the CM data type used in section 8.8.4.9 - OM2-9, as of v 2.5</td><td>added v2.5</td></tr><tr><td>DLN<a name=\"DLN\"> </a></td><td>Driver\'s license number</td><td>66</td><td>added v2.4</td></tr><tr><td>DLT<a name=\"DLT\"> </a></td><td>Delta</td><td>45</td><td>added v2.5</td></tr><tr><td>DR<a name=\"DR\"> </a></td><td>Date/time range</td><td>53</td><td>added v2.4</td></tr><tr><td>DT<a name=\"DT\"> </a></td><td>Date</td><td>8</td><td>added v2.4</td></tr><tr><td>DTM<a name=\"DTM\"> </a></td><td>Date/time</td><td>24</td><td>added v2.5</td></tr><tr><td>DTN<a name=\"DTN\"> </a></td><td>Day type and number</td><td>Replaces the CM data type used in section 6.5.8.11  IN3-11, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>ED<a name=\"ED\"> </a></td><td>Encapsulated data</td><td>Supports ASCII MIME-encoding of binary data.</td><td>added v2.4</td></tr><tr><td>EI<a name=\"EI\"> </a></td><td>Entity identifier</td><td>427</td><td>added v2.4</td></tr><tr><td>EIP<a name=\"EIP\"> </a></td><td>Entity identifier pair</td><td>Replaces the CM data type used in sections 4.5.1.8 - ORC-8, 4.5.3.29 - OBR-29, 7.3.1.29 - OBR-29, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>ELD<a name=\"ELD\"> </a></td><td>Error location and description</td><td>WITHDRAWN</td><td>added v2.5</td></tr><tr><td>ERL<a name=\"ERL\"> </a></td><td>Error location</td><td>18</td><td>added v2.5</td></tr><tr><td>FC<a name=\"FC\"> </a></td><td>Financial class</td><td>47</td><td>added v2.4</td></tr><tr><td>FN<a name=\"FN\"> </a></td><td>Family name</td><td>Appears ONLY in the PPN, XCN, and XPN.</td><td>added v2.4</td></tr><tr><td>FT<a name=\"FT\"> </a></td><td>Formatted text</td><td>65536</td><td>added v2.4</td></tr><tr><td>GTS<a name=\"GTS\"> </a></td><td>General timing specification</td><td>199</td><td>added v2.5</td></tr><tr><td>HD<a name=\"HD\"> </a></td><td>Hierarchic designator</td><td>227</td><td>added v2.4</td></tr><tr><td>ICD<a name=\"ICD\"> </a></td><td>Insurance certification definition</td><td>Replaces the CM data type used in section 6.5.8.20  IN3-20, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>ID<a name=\"ID\"> </a></td><td>Coded values for HL7 tables</td><td>Variable</td><td>added v2.4</td></tr><tr><td>IS<a name=\"IS\"> </a></td><td>Coded value for user-defined tables</td><td>20</td><td>added v2.4</td></tr><tr><td>JCC<a name=\"JCC\"> </a></td><td>Job code/class</td><td>292</td><td>added v2.4</td></tr><tr><td>LA1<a name=\"LA1\"> </a></td><td>Location with address variation 1</td><td>Replaces the CM data type used in 4.14.1.8 RXO-8 and 4.14.4.8 RXE-8 as of v 2.5. Retained for backward compatibility only as of v 2.5</td><td>added v2.5</td></tr><tr><td>LA2<a name=\"LA2\"> </a></td><td>Location with address variation 2</td><td>Replaces the CM data type used in 4.14.5.13 RXD-13, 4.14.6.11 RXG-11 and 4.14.7.11 RXA-11 as of v 2.5. Retained for backward compatibility only as of v 2.5,</td><td>added v2.5</td></tr><tr><td>MA<a name=\"MA\"> </a></td><td>Multiplexed array</td><td>For waveform data only</td><td>added v2.4</td></tr><tr><td>MO<a name=\"MO\"> </a></td><td>Money</td><td>20</td><td>added v2.4</td></tr><tr><td>MOC<a name=\"MOC\"> </a></td><td>Money and charge code</td><td>Replaces the CM data type used in sections 4.5.3.23 OBR-23 and 7.4.1.23- OBR-23 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>MOP<a name=\"MOP\"> </a></td><td>Money or percentage</td><td>Replaces the CM data type used in section 6.5.8.5  IN3-5, as of v 2.5. This data type is restricted to this field.</td><td>added v2.5</td></tr><tr><td>MSG<a name=\"MSG\"> </a></td><td>Message type</td><td>Replaces the CM data type used in 2.16.9.9 MSH-9 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>NA<a name=\"NA\"> </a></td><td>Numeric array</td><td>For waveform data only</td><td>added v2.4</td></tr><tr><td>NDL<a name=\"NDL\"> </a></td><td>Name with date and location</td><td>Replaces the CM data type used in sections 4.5.3.32 and 7.4.1.32-( OBR-32) , 4.5.3.33 and 7.4.1.33  - ( OBR-33) 4.5.3.34 and 7.4.1.34 - ( OBR-34) 4.5.3.35 and 7.4.1.35 - ( OBR-35) as of v 2.5.</td><td>added v2.5</td></tr><tr><td>NM<a name=\"NM\"> </a></td><td>Numeric</td><td>16</td><td>added v2.4</td></tr><tr><td>NR<a name=\"NR\"> </a></td><td>Numeric range</td><td>Replaces the CM data type used in sections 8.8.4.6.1- OM2-6.1, 8.8.4.6.3- OM2-6.3and 8.8.4.6.4- OM2-6.4, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>OCD<a name=\"OCD\"> </a></td><td>Occurrence code and date</td><td>Replaces the CM data type used in sections 6.5.10.10 UB1-16 and 6.5.11.7 UB2-7, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>OSD<a name=\"OSD\"> </a></td><td>Order sequence definition</td><td>WITHDRAWN</td><td>added v2.5</td></tr><tr><td>OSP<a name=\"OSP\"> </a></td><td>Occurrence span code and date</td><td>Replaces the CM data type used in section 6.5.11.8 UB2-8, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>PIP<a name=\"PIP\"> </a></td><td>Practitioner institutional privileges</td><td>Replaces the CM data type used in 15.4.5.7 PRA-7 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>PL<a name=\"PL\"> </a></td><td>Person location</td><td>1230</td><td>added v2.4</td></tr><tr><td>PLN<a name=\"PLN\"> </a></td><td>Practitioner license or other ID number</td><td>Replaces the CM data type used in 15.4.5.6 PRA-6, 11.6.3.7 PRD-7 and 11.6.4.7 CTD-7 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>PN<a name=\"PN\"> </a></td><td>Person name</td><td>WITHDRAWN</td><td>added v2.4</td></tr><tr><td>PPN<a name=\"PPN\"> </a></td><td>Performing person time stamp</td><td>equivalent of an XCN joined with a TS</td><td>added v2.4</td></tr><tr><td>PRL<a name=\"PRL\"> </a></td><td>Parent result link</td><td>Replaces the CM data type used in sections 4.5.3.26 - OBR-26 and 7.4.1.26 - OBR-26 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>PT<a name=\"PT\"> </a></td><td>Processing type</td><td>3</td><td>added v2.4</td></tr><tr><td>PTA<a name=\"PTA\"> </a></td><td>Policy type and amount</td><td>Replaces the CM data type used in section 6.5.7.29  IN2-29, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>QIP<a name=\"QIP\"> </a></td><td>Query input parameter list</td><td>212</td><td>added v2.4</td></tr><tr><td>QSC<a name=\"QSC\"> </a></td><td>Query selection criteria</td><td>219</td><td>added v2.4</td></tr><tr><td>RCD<a name=\"RCD\"> </a></td><td>Row column definition</td><td>19</td><td>added v2.4</td></tr><tr><td>RFR<a name=\"RFR\"> </a></td><td>Reference range</td><td>Replaces the CM data type used in sections 8.8.4.6 - OM2-6, 8.8.4.7 - OM2-7 and8.8.4.8 - OM2-8 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>RI<a name=\"RI\"> </a></td><td>Repeat interval</td><td>206</td><td>added v2.4</td></tr><tr><td>RMC<a name=\"RMC\"> </a></td><td>Room coverage</td><td>Replaces the CM data type used in section 6.5.7.28  IN2-28, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>RP<a name=\"RP\"> </a></td><td>Reference pointer</td><td>273</td><td>added v2.4</td></tr><tr><td>RPT<a name=\"RPT\"> </a></td><td>Repeat pattern</td><td>984</td><td>added v2.5</td></tr><tr><td>SAD<a name=\"SAD\"> </a></td><td>Street Address</td><td>Appears ONLY in the XAD data type.</td><td>added v2.4</td></tr><tr><td>SCV<a name=\"SCV\"> </a></td><td>Scheduling class value pair</td><td>For scheduling data only. See Chapter 10</td><td>added v2.4</td></tr><tr><td>SI<a name=\"SI\"> </a></td><td>Sequence ID</td><td>4</td><td>added v2.4</td></tr><tr><td>SN<a name=\"SN\"> </a></td><td>Structured numeric</td><td>36</td><td>added v2.4</td></tr><tr><td>SNM<a name=\"SNM\"> </a></td><td>String of telephone number digits</td><td>Definition: a string whose characters are limited to &quot;+&quot; and the decimal digits 0 through 9.  As a string, leading zeros are always considered significant.  Maximum length: Not specified for the type. May be specified in the context of use.</td><td>added v2.7</td></tr><tr><td>SPD<a name=\"SPD\"> </a></td><td>Specialty description</td><td>Replaces the CM data type used in 15.4.5.5 PRA-5 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>SPS<a name=\"SPS\"> </a></td><td>Specimen source</td><td>WITHDRAWN</td><td>added v2.5</td></tr><tr><td>SRT<a name=\"SRT\"> </a></td><td>Sort order</td><td>15</td><td>added v2.4</td></tr><tr><td>ST<a name=\"ST\"> </a></td><td>String data</td><td>199</td><td>added v2.4</td></tr><tr><td>TM<a name=\"TM\"> </a></td><td>Time</td><td>16</td><td>added v2.4</td></tr><tr><td>TN<a name=\"TN\"> </a></td><td>Telephone number</td><td>WITHDRAWN</td><td>added v2.4</td></tr><tr><td>TQ<a name=\"TQ\"> </a></td><td>Timing/quantity</td><td>WITHDRAWN</td><td>added v2.4</td></tr><tr><td>TS<a name=\"TS\"> </a></td><td>Time stamp</td><td>WITHDRAWN</td><td>added v2.4</td></tr><tr><td>TX<a name=\"TX\"> </a></td><td>Text data</td><td>65536</td><td>added v2.4</td></tr><tr><td>UVC<a name=\"UVC\"> </a></td><td>UB value code and amount</td><td>Replaces the CM data type used in sections 6.5.10.10 UB1-10 and 6.5.11.6 UB2-6, as of v 2.5.</td><td>added v2.5</td></tr><tr><td>VH<a name=\"VH\"> </a></td><td>Visiting hours</td><td>41</td><td>added v2.4</td></tr><tr><td>VID<a name=\"VID\"> </a></td><td>Version identifier</td><td>973</td><td>added v2.4</td></tr><tr><td>VR<a name=\"VR\"> </a></td><td>Value range</td><td>Replaces the CM data type used in 5.10.5.3.11 QRD-11 as of v 2.5.</td><td>added v2.5</td></tr><tr><td>WVI<a name=\"WVI\"> </a></td><td>Channel Identifier</td><td>Replaces the CM data type used in 7.14.1.3.1 OBX-5.1 where OBX-5 Observation value (*) is data type CD as of v 2.5.</td><td>added v2.5</td></tr><tr><td>WVS<a name=\"WVS\"> </a></td><td>Waveform source</td><td>Replaces the CM data type used in 7.14.1.4 OBX-5.2 where OBX-5 Observation value (*) is data type CD as of v 2.5.</td><td>added v2.5</td></tr><tr><td>XAD<a name=\"XAD\"> </a></td><td>Extended address</td><td>Replaces AD as of v 2.3</td><td>added v2.4</td></tr><tr><td>XCN<a name=\"XCN\"> </a></td><td>Extended composite ID number and name for persons</td><td>Replaces CN as of v 2.3</td><td>added v2.4</td></tr><tr><td>XON<a name=\"XON\"> </a></td><td>Extended composite name and ID number for organizations</td><td>567</td><td>added v2.4</td></tr><tr><td>XPN<a name=\"XPN\"> </a></td><td>Extended person name</td><td>Replaces PN as of v 2.3.</td><td>added v2.4</td></tr><tr><td>XTN<a name=\"XTN\"> </a></td><td>Extended telecommunications number</td><td>Replaces TN as of v 2.3</td><td>added v2.4</td></tr></table>\r\n</div>"
        }
