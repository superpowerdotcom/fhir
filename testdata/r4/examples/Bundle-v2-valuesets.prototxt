      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Time Selection Criteria Parameter Class Codes</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>Fri<a name=\"Fri\"> </a></td><td>An indicator that Friday is or is not preferred for the day on which the appointment will occur.</td><td>In component 2, specify OK or NO.\r\nOK = Preferred appointment day NO = Day is not preferred</td><td>added v2.3</td></tr><tr><td>Mon<a name=\"Mon\"> </a></td><td>An indicator that Monday is or is not preferred for the day on which the appointment will occur.</td><td>In component 2, specify OK or NO.\r\nOK = Preferred appointment day NO = Day is not preferred</td><td>added v2.3</td></tr><tr><td>Prefend<a name=\"Prefend\"> </a></td><td>An indicator that there is a preferred end time for the appointment request, service or resource.</td><td>In component 2, specify any valid time in the format HHMM, using 24-hour clock notation where HH = hour and MM = minutes</td><td>added v2.3</td></tr><tr><td>Prefstart<a name=\"Prefstart\"> </a></td><td>An indicator that there is a preferred start time for the appointment request, service or resource.</td><td>In component 2, specify any valid time in the format HHMM, using 24-hour clock notation where HH = hour and MM = minutes</td><td>added v2.3</td></tr><tr><td>Sat<a name=\"Sat\"> </a></td><td>An indicator that Saturday is or is not preferred for the day on which the appointment will occur.</td><td>In component 2, specify OK or NO.\r\nOK = Preferred appointment day NO = Day is not preferred</td><td>added v2.3</td></tr><tr><td>Sun<a name=\"Sun\"> </a></td><td>An indicator that Sunday is or is not preferred for the day on which the appointment will occur.</td><td>In component 2, specify OK or NO.\r\nOK = Preferred appointment day NO = Day is not preferred</td><td>added v2.3</td></tr><tr><td>Thu<a name=\"Thu\"> </a></td><td>An indicator that Thursday is or is not preferred for the day on which the appointment will occur.</td><td>In component 2, specify OK or NO.\r\nOK = Preferred appointment day NO = Day is not preferred</td><td>added v2.3</td></tr><tr><td>Tue<a name=\"Tue\"> </a></td><td>An indicator that Tuesday is or is not preferred for the day on which the appointment will occur.</td><td>In component 2, specify OK or NO.\r\nOK = Preferred appointment day NO = Day is not preferred</td><td>added v2.3</td></tr><tr><td>Wed<a name=\"Wed\"> </a></td><td>An indicator that Wednesday is or is not preferred for the day on which the appointment will occur.</td><td>In component 2, specify OK or NO.\r\nOK = Preferred appointment day NO = Day is not preferred</td><td>added v2.3</td></tr></table>\r\n</div>"
        }
      }
      extension {
