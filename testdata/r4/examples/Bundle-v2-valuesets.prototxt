        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Specimen Action Code</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>A<a name=\"A\"> </a></td><td>Add ordered tests to the existing specimen</td><td/><td>from v2.1</td></tr><tr><td>C<a name=\"C\"> </a></td><td>Cancel order for battery or tests named</td><td>deprecated</td><td>from v2.1, removed after v2.1</td></tr><tr><td>G<a name=\"G\"> </a></td><td>Generated order; reflex order</td><td/><td>from v2.1</td></tr><tr><td>L<a name=\"L\"> </a></td><td>Lab to obtain specimen from patient</td><td/><td>from v2.1</td></tr><tr><td>O<a name=\"O\"> </a></td><td>Specimen obtained by service other than Lab</td><td/><td>from v2.1</td></tr><tr><td>P<a name=\"P\"> </a></td><td>Pending specimen; Order sent prior to delivery</td><td/><td>from v2.1</td></tr><tr><td>R<a name=\"R\"> </a></td><td>Revised order</td><td/><td>added v2.2</td></tr><tr><td>S<a name=\"S\"> </a></td><td>Schedule the tests specified below</td><td/><td>from v2.1</td></tr></table>\r\n</div>"
