      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Container Condition</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>...<a name=\".46.46.46\"> </a></td><td>No suggested values</td><td>deprecated</td><td>added v2.5.1, removed after v2.6</td></tr><tr><td>CC<a name=\"CC\"> </a></td><td>Container Cracked</td><td>Container is cracked.</td><td>added v2.7</td></tr><tr><td>CL<a name=\"CL\"> </a></td><td>Container Leaking</td><td>Container is leaking</td><td>added v2.7</td></tr><tr><td>CT<a name=\"CT\"> </a></td><td>Container Torn</td><td>Container is torn</td><td>added v2.7</td></tr><tr><td>SB<a name=\"SB\"> </a></td><td>Seal Broken</td><td>Container seal is broken.</td><td>added v2.7</td></tr><tr><td>XAMB<a name=\"XAMB\"> </a></td><td>Not Ambient temperature</td><td>Failed to keep at ambient (room) temperature, approximately 22 +/- 2 degrees C. Accidental refrigeration or freezing is of little consequence</td><td>added v2.7</td></tr><tr><td>XC37<a name=\"XC37\"> </a></td><td>Not Body temperature</td><td>Failed to keep at body temperature: 36 - 38 degrees C.</td><td>added v2.7</td></tr><tr><td>XCAMB<a name=\"XCAMB\"> </a></td><td>Not Critical ambient temperature</td><td>Failed to keep critical ambient.</td><td>added v2.7</td></tr><tr><td>XCATM<a name=\"XCATM\"> </a></td><td>Exposed to Air</td><td>Exposed to atmosphere.</td><td>added v2.7</td></tr><tr><td>XCFRZ<a name=\"XCFRZ\"> </a></td><td>Not Critical frozen temperature</td><td>Failed to keep critical frozen</td><td>added v2.7</td></tr><tr><td>XCREF<a name=\"XCREF\"> </a></td><td>Not Critical refrigerated temperature</td><td>Failed to keep critical refrigerated.</td><td>added v2.7</td></tr><tr><td>XDFRZ<a name=\"XDFRZ\"> </a></td><td>Not Deep frozen</td><td>Failed to keep deep frozen: -16 to -20 degree C.</td><td>added v2.7</td></tr><tr><td>XDRY<a name=\"XDRY\"> </a></td><td>Not Dry</td><td>Failed to keep in a dry environment.</td><td>added v2.7</td></tr><tr><td>XFRZ<a name=\"XFRZ\"> </a></td><td>Not Frozen temperature</td><td>Failed to keep at frozen temperature: -4 degrees C.</td><td>added v2.7</td></tr><tr><td>XMTLF<a name=\"XMTLF\"> </a></td><td>Metal Exposed</td><td>Failed to keep container is free of heavy metals.</td><td>added v2.7</td></tr><tr><td>XNTR<a name=\"XNTR\"> </a></td><td>Not Liquid nitrogen</td><td>Failed to keep in liquid nitrogen.</td><td>added v2.7</td></tr><tr><td>XPRTL<a name=\"XPRTL\"> </a></td><td>Not Protected from light</td><td>Failed to protect from light.</td><td>added v2.7</td></tr><tr><td>XPSA<a name=\"XPSA\"> </a></td><td>Shaken</td><td>Shaken.</td><td>added v2.7</td></tr><tr><td>XPSO<a name=\"XPSO\"> </a></td><td>Exposed to shock</td><td>Failed to protect from shock.</td><td>added v2.7</td></tr><tr><td>XREF<a name=\"XREF\"> </a></td><td>Not Refrigerated temperature</td><td>Failed to keep at refrigerated temperature: 4-8 degrees C.</td><td>added v2.7</td></tr><tr><td>XUFRZ<a name=\"XUFRZ\"> </a></td><td>Not Ultra frozen</td><td>Failed to keep ultra cold frozen: ~ -75 to -85 degree C. (ultra cold freezer is typically at temperature of dry ice).</td><td>added v2.7</td></tr><tr><td>XUPR<a name=\"XUPR\"> </a></td><td>Not Upright</td><td>Failed to keep upright.</td><td>added v2.7</td></tr></table>\r\n</div>"
        }
      }
