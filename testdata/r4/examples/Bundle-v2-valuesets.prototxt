                    value: "content"
                  }
                  value {
                    string_value {
                      value: "Is de locatie waar de dienst verleend wordt. Deze wordt gebruikt als vergoeding is gebaseerd op de locatie van de service (om rekening te kunnen houden met de kosten van de service)."
                    }
                  }
