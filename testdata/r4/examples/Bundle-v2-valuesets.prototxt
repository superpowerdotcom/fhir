        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Modality</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>AS<a name=\"AS\"> </a></td><td>Angioscopy</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>BS<a name=\"BS\"> </a></td><td>Biomagnetic imaging</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>CD<a name=\"CD\"> </a></td><td>Color flow Doppler</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>CP<a name=\"CP\"> </a></td><td>Colposcopy</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>CR<a name=\"CR\"> </a></td><td>Computed radiography</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>CS<a name=\"CS\"> </a></td><td>Cystoscopy</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>CT<a name=\"CT\"> </a></td><td>Computed tomography</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>DD<a name=\"DD\"> </a></td><td>Duplex Doppler</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>DG<a name=\"DG\"> </a></td><td>Diapanography</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>DM<a name=\"DM\"> </a></td><td>Digital microscopy</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>EC<a name=\"EC\"> </a></td><td>Echocardiography</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>ES<a name=\"ES\"> </a></td><td>Endoscopy</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>FA<a name=\"FA\"> </a></td><td>Fluorescein angiography</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>FS<a name=\"FS\"> </a></td><td>Fundoscopy</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>LP<a name=\"LP\"> </a></td><td>Laparoscopy</td><td>d