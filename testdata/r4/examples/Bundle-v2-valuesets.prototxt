                  }
                  value {
                    string_value {
                      value: "Bacteri\303\253le stam geblokkeerd door in vitro concentratie van een anti-bacteri\303\253le agens die is gekoppeld aan een hoge kans op therapeutisch falen. Referentie: CLSI (http://www.clsi.org/Content/NavigationMenu/Resources/HarmonizedTerminologyDatabase/Harmoniz"
                    }
                  }
                }
              }
            }
          }
        }
