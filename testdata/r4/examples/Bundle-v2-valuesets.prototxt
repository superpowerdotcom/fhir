        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Manufacturers of Vaccines (code=MVX)</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>AB<a name=\"AB\"> </a></td><td>Abbott Laboratories</td><td>(includes Ross Products Division)</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>AD<a name=\"AD\"> </a></td><td>Adams Laboratories, Inc.</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>ALP<a name=\"ALP\"> </a></td><td>Alpha Therapeutic Corporation</td><td>deprecated</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>AR<a name=\"AR\"> </a></td><td>Armour</td><td>[Inactive--use AVB]</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>AVB<a name=\"AVB\"> </a></td><td>Aventis Behring L.L.C.</td><td>(formerly Centeon L.L.C.; includes Armour Pharmaceutical Company) [Inactive--use ZLB] CDC Changes made on: Feb. 28, 2006</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>AVI<a name=\"AVI\"> </a></td><td>Aviron</td><td>deprecated</td><td>added v2.3.1, removed after v2.8.2</td></tr><tr><td>BA<a name=\"BA\"> </a></td><td>Baxter Healthcare Corporation</td><td>[Inactive--use BAH]</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>BAH<a name=\"BAH\"> </a></td><td>Baxter Healthcare Corporation</td><td>(includes Hyland Immuno, Immuno International AG, and North American Vaccine, Inc.)</td><td>added v2.5, removed after v2.8.2</td></tr><tr><td>BAY<a name=\"BAY\"> </a></td><td>Bayer Corporation</td><td>(includes Miles, Inc. and Cutter Laboratories)</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>BP<a name=\"BP\"> </a></td><td>Berna Products</td><td>[Inactive--use BPC]</td><td>added v2.3, removed after v2.8.2</td></tr><tr><td>BPC<a name=\"BPC\"> </a></td><td>Berna Products Corporation</td><td>(includes Swiss Serum and Vaccine Institute Berne)</td><td>added v2.3.1, removed after v2.8.2</td></tr><tr><td>CEN<a name=\"C