        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Primary Key Value Type</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>CE<a name=\"CE\"> </a></td><td>Coded element</td><td>Withdrawn as of v2.6 - CE has been replaced by CNE and CWE</td><td>added v2.3.1</td></tr><tr><td>CWE<a name=\"CWE\"> </a></td><td>Coded with Exceptions</td><td/><td>added v2.6</td></tr><tr><td>PL<a name=\"PL\"> </a></td><td>Person location</td><td/><td>added v2.3.1</td></tr></table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
