        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Pharmacy Order Types</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>M<a name=\"M\"> </a></td><td>Medication</td><td>Default value.  Includes, but is not limited to, tables, capsules, powders, puffs, and other non-injected/non-infused products.</td><td>added v2.5</td></tr><tr><td>O<a name=\"O\"> </a></td><td>Other solution as medication orders</td><td>Includes, but is not limited to, piggybacks and syringes</td><td>added v2.5</td></tr><tr><td>S<a name=\"S\"> </a></td><td>IV Large Volume Solutions</td><td>Includes, but is not limited to, TPNs, admixtures, solutions and drips.</td><td>added v2.5</td></tr></table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
