entry {
  full_url {
    value: "http://hl7.org/fhir/CodeSystem/v2-0503"
  }
  resource {
    code_system {
      id {
        value: "v2-0503"
      }
      meta {
        profile {
          value: "http://hl7.org/fhir/StructureDefinition/shareablecodesystem"
        }
      }
      language {
        value: "en"
      }
      text {
        status {
          value: ADDITIONAL
        }
        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Sequence/Results Flag</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>C<a name=\"C\"> </a></td><td>Cyclical</td><td>Used for indicating a repeating cycle of service requests; for example, individual intravenous solutions used in a cyclical sequence (a.k.a. &quot;Alternating IVs&quot;). This value would be compatible with linking separate service requests or with having all cyclical service request components in a single service request. Likewise, the value would be compatible with either Parent-Child messages or a single service request message to communicate the service requests\' sequencing</td><td>added v2.5</td></tr><tr><td>R<a name=\"R\"> </a></td><td>Reserved for future use</td><td/><td>added v2.5</td></tr><tr><td>S<a name=\"S\"> </a></td><td>Sequential</td><td/><td>added v2.5</td></tr></table>\r\n</div>"
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-standards-status"
        }
        value {
          code {
            value: "external"
          }
        }
      }
      extension {
        url {
          value: "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm"
        }
        value {
          integer {
          }
        }
      }
      url {
        value: "http://terminology.hl7.org/CodeSystem/v2-0503"
      }
      identifier {
        system {
          value: "urn:ietf:rfc:3986"
        }
        value {
          value: "urn:oid:2.16.840.1.113883.18.327"
        }
      }
      version {
        value: "2.9"
      }
      name {
        value: "v2.0503"
      }
      title {
        value: "v2 Sequence/Results Flag"
      }
      status {
        value: ACTIVE
      }
      experimental {
      }
      publisher {
        value: "HL7, Inc"
      }
      contact {
        telecom {
          system {
            value: URL
          }
          value {
            value: "http://hl7.org"
          }
        }
      }
      description {
        value: "FHIR Value set/code system definition for HL7 v2 table 0503 ( Sequence/Results Flag)"
      }
      content {
        value: COMPLETE
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
            string_value {
              value: "Used for indicating a repeating cycle of service requests; for example, individual intravenous solutions used in a cyclical sequence (a.k.a. \"Alternating IVs\"). This value would be compatible with linking separate service requests or with having all cyclical service request components in a single service request. Likewise, the value would be compatible with either Parent-Child messages or a single service request message to communicate the service requests\' sequencing"
            }
          }
        }
        code {
          value: "C"
        }
        display {
          value: "Cyclical"
        }
      }
      concept {
        code {
          value: "R"
        }
        display {
          value: "Reserved for future use"
        }
      }
      concept {
        code {
          value: "S"
        }
        display {
          value: "Sequential"
        }
      }
    }
  }
}
