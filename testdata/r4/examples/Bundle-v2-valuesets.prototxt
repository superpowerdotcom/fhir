          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Reimbursement Action Code</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>0<a name=\"0\"> </a></td><td>OCE line item denial or rejection is not ignored</td><td/><td>added v2.4</td></tr><tr><td>1<a name=\"1\"> </a></td><td>OCE line item denial or rejection is ignored</td><td/><td>added v2.4</td></tr><tr><td>2<a name=\"2\"> </a></td><td>External line item denial. Line item is denied even if no OCE edits</td><td/><td>added v2.4</td></tr><tr><td>3<a name=\"3\"> </a></td><td>External line item rejection. Line item is rejected even if no OCE edits</td><td/><td>added v2.4</td></tr></table>\r\n</div>"
