                  }
                  value {
                    string_value {
                      value: "Een categorie voor isolaten waarvoor alleen een gevoelig interpretabel criterium is ontworpen vanwege de afwezigheid of zeldzaam voorkomen van resistente stammen. Isolaten met MIC\'s boven of zonediameters onder de waarde aangewezen voor de gevoeli"
                    }
                  }
                }
              }
            }
          }
        }
