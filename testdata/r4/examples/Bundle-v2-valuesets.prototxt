          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Employment Status</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>...<a name=\".46.46.46\"> </a></td><td>see chapter 6</td><td>deprecated</td><td>added v2.6, removed after v2.6</td></tr><tr><td>1<a name=\"1\"> </a></td><td>Full time employed</td><td/><td>added v2.4</td></tr><tr><td>2<a name=\"2\"> </a></td><td>Part time employed</td><td/><td>added v2.4</td></tr><tr><td>3<a name=\"3\"> </a></td><td>Unemployed</td><td/><td>added v2.4</td></tr><tr><td>4<a name=\"4\"> </a></td><td>Self-employed</td><td/><td>added v2.4</td></tr><tr><td>5<a name=\"5\"> </a></td><td>Retired</td><td/><td>added v2.4</td></tr><tr><td>6<a name=\"6\"> </a></td><td>On active military duty</td><td/><td>added v2.4</td></tr><tr><td>9<a name=\"9\"> </a></td><td>Unknown</td><td/><td>added v2.4</td></tr><tr><td>C<a name=\"C\"> </a></td><td>Contract, per diem</td><td/><td>added v2.4</td></tr><tr><td>D<a name=\"D\"> </a></td><td>Per Diem</td><td>deprecated</td><td>added v2.4, removed after v2.4</td></tr><tr><td>F<a name=\"F\"> </a></td><td>Full Time</td><td>deprecated</td><td>added v2.4, removed after v2.4</td></tr><tr><td>L<a name=\"L\"> </a></td><td>Leave of absence (e.g., family leave, sabbatical, etc.)</td><td/><td>added v2.4</td></tr><tr><td>O<a name=\"O\"> </a></td><td>Other</td><td/><td>added v2.4</td></tr><tr><td>P<a name=\"P\"> </a></td><td>Part Time</td><td>deprecated</td><td>added v2.4, removed after v2.4</td></tr><tr><td>T<a name=\"T\"> </a></td><td>Temporarily unemployed</td><td/><td>added v2.4</td></tr></table>\r\n</div>"
