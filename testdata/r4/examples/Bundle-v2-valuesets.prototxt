              value: "Enter (AP) when ANALYSIS PROCESS is the reason due to:\r\n\342\200\242 Product or supply failure (reagents, calibrators, QC material)\r\n\342\200\242 Equipment or instrumentation failure"
            }
          }
        }
        code {
          value: "AP"
        }
        display {
          value: "Analysis Process"
        }
      }
      concept {
        extension {
          url {
            value: "http://hl7.org/fhir/StructureDefinition/codesystem-concept-comments"
          }
          value {
