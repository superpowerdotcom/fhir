        div {
          value: "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Order status</p>\r\n<table class=\"grid\"><tr><td><b>Code</b></td><td><b>Description</b></td><td><b>Comment</b></td><td><b>Version</b></td></tr><tr><td>A<a name=\"A\"> </a></td><td>Some, but not all, results available</td><td/><td>added v2.3</td></tr><tr><td>CA<a name=\"CA\"> </a></td><td>Order was canceled</td><td/><td>from v2.1</td></tr><tr><td>CM<a name=\"CM\"> </a></td><td>Order is completed</td><td/><td>from v2.1</td></tr><tr><td>DC<a name=\"DC\"> </a></td><td>Order was discontinued</td><td/><td>from v2.1</td></tr><tr><td>ER<a name=\"ER\"> </a></td><td>Error, order not found</td><td/><td>from v2.1</td></tr><tr><td>HD<a name=\"HD\"> </a></td><td>Order is on hold</td><td/><td>from v2.1</td></tr><tr><td>IP<a name=\"IP\"> </a></td><td>In process, unspecified</td><td/><td>from v2.1</td></tr><tr><td>RP<a name=\"RP\"> </a></td><td>Order has been replaced</td><td/><td>added v2.2</td></tr><tr><td>SC<a name=\"SC\"> </a></td><td>In process, scheduled</td><td/><td>from v2.1</td></tr></table>\r\n</div>"
        }
